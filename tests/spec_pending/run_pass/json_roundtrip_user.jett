# SPEC: structs round-trip through `json.serialize[T]` and `json.parse[T]`.
struct User:
    id: string
    name: string

verify user_roundtrip:
    User original = User(id: "123", name: "alice")
    string raw = json.serialize[User](view original)
    User restored = json.parse[User](raw) handle error:
        assert false "round-trip parse failed"
    assert restored.id == "123"
    assert restored.name == "alice"

# SPEC: `json.parse` validates refinement fields during deserialization.
type NonEmpty = string where string.char_count(value) > 0

struct User:
    name: NonEmpty

verify parse_refinement_valid_user:
    string raw = "{\"name\":\"alice\"}"
    User user = json.parse[User](raw) handle error:
        assert false "expected valid refined user"
    string name = coarsen user.name
    assert name == "alice"

# SPEC: `json.serialize_public` omits secret fields from the output.
struct Session:
    id: string
    user_name: string
    token: secret[string]

verify serialize_public_omits_secret_fields:
    Session session = Session(id: "s1", user_name: "alice", token: "secret-token")
    string raw = json.serialize_public[Session](view session)
    assert raw == "{\"id\":\"s1\",\"user_name\":\"alice\"}"

namespace test
type ApiKey = secret[string] where string.char_count(value) == 3
type StrictApiKey = ApiKey where string.starts_with(value, "a")
type SecretCount = secret[int64] where value > 0
function public_identity(value: string) returns string:
    return value
function declassify_refined(key: ApiKey) returns string:
    return declassify key
function declassify_nested_refinement(key: StrictApiKey) returns string:
    return declassify key
function redact_refined(key: ApiKey) returns string:
    return secret.redact(key)
function compare_refined(left: ApiKey, right: StrictApiKey) returns bool:
    return secret.compare(left, right)
function operate_on_refined(value: SecretCount) returns secret[int64]:
    return value + 1
function lift_pure_call(key: ApiKey) returns secret[string]:
    return public_identity(key)
function preserve_secret_when_coarsened(key: ApiKey) returns secret[string]:
    return coarsen key

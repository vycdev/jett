function secret_abs_int(value: secret[int64]) returns secret[int64]:
    return math.abs(value)
function secret_min_float(value: secret[float64], fallback: float64) returns secret[float64]:
    return math.min(value, fallback)
function secret_max_float(value: float64, fallback: secret[float64]) returns secret[float64]:
    return math.max(value, fallback)

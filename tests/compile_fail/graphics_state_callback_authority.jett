namespace app
struct State:
    perform: function() returns int64
function effect(view stdout: Stdout) returns int64:
    Stdout.write(view stdout, "effect hidden in state")
    return 0
function update(state: State, key: graphics.Key) returns State:
    int64 observed = state.perform()
    return state
function render(view state: State) returns graphics.Scene:
    graphics.Color color = graphics.Color(red: 0, green: 0, blue: 0)
    return graphics.Scene(background: color, rectangles: list.new[graphics.Rect](), texts: list.new[graphics.Text]())
function main(display: Graphics, stdout: Stdout) returns result[nothing, string]:
    State initial = State(perform: function() returns int64: return effect(view stdout))
    graphics.Config config = graphics.Config(title: "State review", width: 32, height: 32)
    return graphics.run[State](view display, config, initial, update, render)

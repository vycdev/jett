namespace app
function print_digest(input: secret[string]) returns nothing:
    print(crypto.sha256(input))
function interpolate_digest(input: secret[string]) returns string:
    return "digest={crypto.sha256(input)}"
function serialize_digest(input: secret[string]) returns string:
    secret[string] digest = crypto.sha256(input)
    return json.serialize[secret[string]](view digest)

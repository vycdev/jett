namespace test
type ApiKey = secret[string] where string.char_count(value) == 3
function expose_print(key: ApiKey) returns nothing:
    print(key)
function expose_println(key: ApiKey) returns nothing:
    println(key)
function expose_interpolation(key: ApiKey) returns string:
    return "key={key}"
function expose_stdout(view stdout: Stdout, key: ApiKey) returns nothing:
    Stdout.write(view stdout, key)
function expose_filesystem(view fs: Filesystem, key: ApiKey) returns nothing:
    Filesystem.write_file(view fs, "secret.txt", key) handle error:
        return nothing
function expose_serialization(view key: ApiKey) returns string:
    return json.serialize[ApiKey](view key)

namespace test

type NonEmpty = string where string.char_count(value) > 0
type NonEmptyNames = list[string] where list.length(value) > 0

enum Direction:
    north
    south

enum Shape:
    circle(radius: float64)
    rect(width: float64, height: float64)

enum Protocol:
    tcp = 6
    udp = 17

bitfield Header:
    version: 4 bits
    protocol: 8 bits as Protocol

struct Profile:
    display_name: string serialize "displayName"
    note: string

struct User:
    id: string
    profile: Profile serialize "profileData"
    tags: list[string]
    scores: map[string, int64]
    nickname: optional[string]

struct Box[T]:
    value: T
    label: string

struct RefinedUser:
    name: NonEmpty

struct Credential:
    name: string
    token: secret[string]

function parse_user_id() returns string:
    string raw = "{{\"id\":\"u1\",\"profileData\":{{\"displayName\":\"Alice\",\"note\":\"ok\"}},\"tags\":[\"admin\",\"beta\"],\"scores\":{{\"wins\":3}},\"nickname\":\"ally\"}}"
    User user = json.parse[User](raw) handle error:
        return error
    return user.id

function parse_nested_serialize_name() returns string:
    string raw = "{{\"id\":\"u1\",\"profileData\":{{\"displayName\":\"Alice\",\"note\":\"ok\"}},\"tags\":[\"admin\"],\"scores\":{{\"wins\":3}},\"nickname\":\"ally\"}}"
    User user = json.parse[User](raw) handle error:
        return error
    return user.profile.display_name

function parse_list_field_count() returns int64:
    string raw = "{{\"id\":\"u1\",\"profileData\":{{\"displayName\":\"Alice\",\"note\":\"ok\"}},\"tags\":[\"admin\",\"beta\"],\"scores\":{{\"wins\":3}},\"nickname\":null}}"
    User user = json.parse[User](raw) handle error:
        return -1
    return list.length(user.tags)

function parse_map_field_value() returns int64:
    string raw = "{{\"id\":\"u1\",\"profileData\":{{\"displayName\":\"Alice\",\"note\":\"ok\"}},\"tags\":[\"admin\"],\"scores\":{{\"wins\":3}},\"nickname\":null}}"
    User user = json.parse[User](raw) handle error:
        return -1
    optional[int64] wins = map.get[string, int64](user.scores, "wins")
    return wins handle:
        default -2

function parse_missing_optional() returns string:
    string raw = "{{\"id\":\"u1\",\"profileData\":{{\"displayName\":\"Alice\",\"note\":\"ok\"}},\"tags\":[\"admin\"],\"scores\":{{\"wins\":3}}}}"
    User user = json.parse[User](raw) handle error:
        return error
    string nickname = user.nickname handle:
        default "none"
    return nickname

function parse_result_ok_value() returns int64:
    result[int64, string] parsed = json.parse[result[int64, string]]("{{\"ok\":7}}") handle error:
        return -1
    return parsed handle error:
        default -2

function parse_result_fail_value() returns string:
    result[int64, string] parsed = json.parse[result[int64, string]]("{{\"fail\":\"bad\"}}") handle error:
        return error
    int64 ignored = parsed handle error:
        return error
    return "{ignored}"

function parse_result_multiple_keys_error() returns string:
    result[int64, string] parsed = json.parse[result[int64, string]]("{{\"ok\":7,\"fail\":\"bad\"}}") handle error:
        return error
    int64 ignored = parsed handle error:
        return error
    return "{ignored}"

function parse_result_unknown_key_error() returns string:
    result[int64, string] parsed = json.parse[result[int64, string]]("{{\"value\":7}}") handle error:
        return error
    int64 ignored = parsed handle error:
        return error
    return "{ignored}"

function parse_generic_struct_value() returns string:
    Box[string] box = json.parse[Box[string]]("{{\"value\":\"stored\",\"label\":\"name\"}}") handle error:
        return error
    return box.value

function parse_refinement_ok() returns string:
    RefinedUser user = json.parse[RefinedUser]("{{\"name\":\"alice\"}}") handle error:
        return error
    string name = coarsen user.name
    return name

function parse_refinement_error() returns string:
    RefinedUser user = json.parse[RefinedUser]("{{\"name\":\"\"}}") handle error:
        return error
    string name = coarsen user.name
    return name

function parse_refined_list_count() returns int64:
    NonEmptyNames names = json.parse[NonEmptyNames]("[\"alpha\",\"beta\"]") handle error:
        return -1
    list[string] raw = coarsen names
    return list.length(raw)

function parse_refined_list_error() returns string:
    NonEmptyNames names = json.parse[NonEmptyNames]("[]") handle error:
        return error
    list[string] raw = coarsen names
    return "{list.length(raw)}"

function parse_enum_unit() returns bool:
    Direction direction = json.parse[Direction]("\"north\"") handle error:
        return false
    return direction == Direction.north

function parse_enum_payload_area() returns float64:
    Shape shape = json.parse[Shape]("{{\"rect\":[3.0,4.0]}}") handle error:
        return -1.0
    match shape:
        circle(radius):
            return radius
        rect(width, height):
            return width * height

function parse_enum_payload_error() returns string:
    Shape shape = json.parse[Shape]("{{\"rect\":[3.0]}}") handle error:
        return error
    match shape:
        circle(radius):
            return "{radius}"
        rect(width, height):
            return "{width * height}"

function parse_bitfield_version() returns int64:
    Header header = json.parse[Header]("{{\"version\":4,\"protocol\":\"tcp\"}}") handle error:
        return -1
    return header.version

function parse_bitfield_protocol() returns bool:
    Header header = json.parse[Header]("{{\"version\":4,\"protocol\":\"tcp\"}}") handle error:
        return false
    return header.protocol == Protocol.tcp

function parse_bitfield_width_error() returns string:
    Header header = json.parse[Header]("{{\"version\":16,\"protocol\":\"tcp\"}}") handle error:
        return error
    return "{header.version}"

function parse_missing_required_error() returns string:
    string raw = "{{\"id\":\"u1\",\"tags\":[],\"scores\":{{}}}}"
    User user = json.parse[User](raw) handle error:
        return error
    return user.id

function parse_top_level_float() returns float64:
    float64 value = json.parse[float64]("2.5") handle error:
        return -1.0
    return value

function parse_null_as_nothing() returns string:
    nothing value = json.parse[nothing]("null") handle error:
        return error
    return "null"

function parse_invalid_nothing_error() returns string:
    nothing value = json.parse[nothing]("0") handle error:
        return error
    return "unexpected"

function parse_bytes_length() returns int64:
    bytes value = json.parse[bytes]("\"0x4869\"") handle error:
        return -1
    return bytes.length(value)

function parse_bytes_without_prefix_first() returns int64:
    bytes value = json.parse[bytes]("\"4869\"") handle error:
        return -1
    int64 first = bytes.get(value, 0) handle:
        default -1
    return first

function parse_json_value_field() returns string:
    JsonValue root = json.parse[JsonValue]("{{\"name\":\"Ada\",\"score\":5}}") handle error:
        return error
    JsonValue name_raw = json.field(root, "name") handle:
        return "missing name"
    return json.as_string(name_raw) handle error:
        default error

function parse_invalid_bytes_error() returns string:
    bytes value = json.parse[bytes]("\"0xzz\"") handle error:
        return error
    return "{bytes.length(value)}"

function parse_top_level_secret_redaction() returns string:
    secret[string] token = json.parse[secret[string]]("\"secret-token\"") handle error:
        return error
    return secret.redact(token)

function parse_secret_field_redaction() returns string:
    Credential credential = json.parse[Credential]("{{\"name\":\"svc\",\"token\":\"secret-token\"}}") handle error:
        return error
    return "{credential.name}:{secret.redact(credential.token)}"

function parse_secret_field_type_error() returns string:
    Credential credential = json.parse[Credential]("{{\"name\":\"svc\",\"token\":7}}") handle error:
        return error
    return credential.name

function parse_missing_secret_field_error() returns string:
    Credential credential = json.parse[Credential]("{{\"name\":\"svc\"}}") handle error:
        return error
    return credential.name

verify json_parse:
    assert parse_user_id() == "u1"
    assert parse_nested_serialize_name() == "Alice"
    assert parse_list_field_count() == 2
    assert parse_map_field_value() == 3
    assert parse_missing_optional() == "none"
    assert parse_result_ok_value() == 7
    assert parse_result_fail_value() == "bad"
    assert parse_result_multiple_keys_error() == "expected result object with exactly one key"
    assert parse_result_unknown_key_error() == "expected result object with key 'ok' or 'fail'"
    assert parse_generic_struct_value() == "stored"
    assert parse_refinement_ok() == "alice"
    assert parse_refinement_error() == "refinement type constraint failed for 'NonEmpty'"
    assert parse_refined_list_count() == 2
    assert parse_refined_list_error() == "refinement type constraint failed for 'NonEmptyNames'"
    assert parse_enum_unit() == true
    assert parse_enum_payload_area() == 12.0
    assert parse_enum_payload_error() == "enum variant 'Shape.rect' expects 2 payload field(s), got 1"
    assert parse_bitfield_version() == 4
    assert parse_bitfield_protocol() == true
    assert parse_bitfield_width_error() == "bitfield 'Header' field 'version' is 4 bit(s) wide and cannot hold '16'"
    assert parse_missing_required_error() == "missing required field 'profileData' for User"
    assert parse_top_level_float() == 2.5
    assert parse_null_as_nothing() == "null"
    assert parse_invalid_nothing_error() == "expected null, got number"
    assert parse_bytes_length() == 2
    assert parse_bytes_without_prefix_first() == 72
    assert parse_json_value_field() == "Ada"
    assert parse_invalid_bytes_error() == "expected hex bytes string"
    assert parse_top_level_secret_redaction() == "***"
    assert parse_secret_field_redaction() == "svc:***"
    assert parse_secret_field_type_error() == "token: expected string, got number"
    assert parse_missing_secret_field_error() == "missing required field 'token' for Credential"

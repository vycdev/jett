namespace test

struct User:
    id: string
    age: int64
    api_key: secret[string]

struct TokenBox:
    tokens: list[secret[string]]

struct Pair[T, U]:
    first: T
    second: U

struct ApiResponse:
    user_name: string serialize "userName"
    total_count: int64 serialize "totalCount"

function user_field_count() returns int64:
    list[TypeField] fields = type.fields[User]()
    return list.length(fields)

function user_field_type(field_name: string) returns string:
    list[TypeField] fields = type.fields[User]()
    string found = "missing"
    for field in fields:
        if field.name == field_name:
            found = field.type_name
    return found

function user_field_secret(field_name: string) returns bool:
    list[TypeField] fields = type.fields[User]()
    bool found = false
    for field in fields:
        if field.name == field_name:
            found = field.has_secret
    return found

function user_field_serialize_name(field_name: string) returns string:
    list[TypeField] fields = type.fields[User]()
    string found = "missing"
    for field in fields:
        if field.name == field_name:
            found = field.serialize_name
    return found

function pair_field_type(field_name: string) returns string:
    list[TypeField] fields = type.fields[Pair[int64, string]]()
    string found = "missing"
    for field in fields:
        if field.name == field_name:
            found = field.type_name
    return found

function api_field_serialize_name(field_name: string) returns string:
    list[TypeField] fields = type.fields[ApiResponse]()
    string found = "missing"
    for field in fields:
        if field.name == field_name:
            found = field.serialize_name
    return found

function user_string_field_value(field_name: string) returns string:
    User user = User(id: "u1", age: 42, api_key: "secret-token")
    list[TypeField] fields = type.fields[User]()
    string found = "missing"
    for field in fields:
        if field.name == field_name:
            found = type.field_value[User, string](view user, view field)
    return found

function user_age_field_value() returns int64:
    User user = User(id: "u1", age: 42, api_key: "secret-token")
    list[TypeField] fields = type.fields[User]()
    int64 found = 0
    for field in fields:
        if field.name == "age":
            found = type.field_value[User, int64](view user, view field)
    return found

function user_secret_field_redacted() returns string:
    User user = User(id: "u1", age: 42, api_key: "secret-token")
    list[TypeField] fields = type.fields[User]()
    string found = "missing"
    for field in fields:
        if field.name == "api_key":
            found = secret.redact(type.field_value[User, secret[string]](view user, view field))
    return found

function pair_first_field_value() returns int64:
    Pair[int64, string] pair = Pair[int64, string](first: 7, second: "seven")
    list[TypeField] fields = type.fields[Pair[int64, string]]()
    int64 found = 0
    for field in fields:
        if field.name == "first":
            found = type.field_value[Pair[int64, string], int64](view pair, view field)
    return found

function reflected_name[T]() returns string:
    return type.name[T]()

function reflected_field_count[T]() returns int64:
    list[TypeField] fields = type.fields[T]()
    return list.length(fields)

verify type_reflection:
    assert type.name[int64]() == "int64"
    assert type.name[list[string]]() == "list[string]"
    assert reflected_name[Pair[string, int64]]() == "Pair[string, int64]"
    assert type.kind[int64]() == "primitive"
    assert type.kind[list[string]]() == "list"
    assert type.kind[User]() == "struct"
    assert user_field_count() == 3
    assert reflected_field_count[User]() == 3
    assert user_field_type("id") == "string"
    assert user_field_type("age") == "int64"
    assert user_field_serialize_name("id") == "id"
    assert api_field_serialize_name("user_name") == "userName"
    assert api_field_serialize_name("total_count") == "totalCount"
    assert user_field_secret("api_key") == true
    assert type.has_secret[User]() == true
    assert type.has_secret[TokenBox]() == true
    assert type.has_secret[Pair[int64, string]]() == false
    assert pair_field_type("first") == "int64"
    assert pair_field_type("second") == "string"
    assert user_string_field_value("id") == "u1"
    assert user_age_field_value() == 42
    assert user_secret_field_redacted() == "***"
    assert pair_first_field_value() == 7

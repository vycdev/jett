namespace test
function parse_tree_summary(raw: string) returns string:
    json.JsonTree tree = json.json_tree_parse(raw) handle error:
        return error
    return json.json_tree_serialize(tree)
function raw_from_hex(hex: string) returns string:
    bytes raw = bytes.from_hex(hex) handle error:
        return error
    return bytes.to_string(raw) handle error:
        default error
verify json_tree_parse_compound:
    assert parse_tree_summary("[]") == "[]"
    assert parse_tree_summary("[1, true, null, \"Ada\"]") == "[1,true,null,\"Ada\"]"
    assert parse_tree_summary("[{{\"x\":[1,2]}},\"comma, inside\"]") == "[{{\"x\":[1,2]}},\"comma, inside\"]"
    assert parse_tree_summary("[\"comma, inside\", \"{{not delimiter}}\", \"quote\\\", comma\"]") == "[\"comma, inside\",\"{{not delimiter}}\",\"quote\\\", comma\"]"
    assert parse_tree_summary("{{}}") == "{{}}"
    assert parse_tree_summary("{{\"name\":\"Ada\",\"items\":[1,true,null]}}") == "{{\"name\":\"Ada\",\"items\":[1,true,null]}}"
    assert parse_tree_summary("{{ \"a\":1}}") == "{{\"a\":1}}"
    assert parse_tree_summary("{{\"a\" :1}}") == "{{\"a\":1}}"
    assert parse_tree_summary("{{\"a\":1, \"b\":2}}") == "{{\"a\":1,\"b\":2}}"
    assert parse_tree_summary("{{ \"a\" : 1, \"b\" : [true] }}") == "{{\"a\":1,\"b\":[true]}}"
    assert parse_tree_summary("{{\"name\":\"Ada\",\"items\":[1,true,null],\"profile\":{{\"city\":\"Cluj\"}}}}") == "{{\"name\":\"Ada\",\"items\":[1,true,null],\"profile\":{{\"city\":\"Cluj\"}}}}"
    assert parse_tree_summary("{{\"a:b\":\"c,d\",\"nested\":[{{\"x,y\":1}}]}}") == "{{\"a:b\":\"c,d\",\"nested\":[{{\"x,y\":1}}]}}"
    assert parse_tree_summary("[1,]") == "expected JSON value"
    assert parse_tree_summary("[,1]") == "expected JSON value"
    assert parse_tree_summary("[1,,2]") == "expected JSON value"
    assert parse_tree_summary("[1") == "unterminated JSON array"
    assert parse_tree_summary("[\"bad]") == "unterminated string in JSON value"
    assert parse_tree_summary("[1 2]") == "expected ',' between JSON values"
    assert parse_tree_summary("[true false]") == "expected ',' between JSON values"
    assert parse_tree_summary("[[1] [2]]") == "expected ',' between JSON values"
    assert parse_tree_summary(raw_from_hex("5b310c5d")) == "invalid JSON number"
    assert parse_tree_summary("[1] trailing") == "unexpected trailing characters after JSON value"
    assert parse_tree_summary("[1}}") == "mismatched closing delimiter in JSON array"
    assert parse_tree_summary("{{name:1}}") == "expected JSON string"
    assert parse_tree_summary("{{:1}}") == "expected JSON string"
    assert parse_tree_summary("{{\"name\"}}") == "expected object field separator"
    assert parse_tree_summary("{{\"name\":}}") == "expected JSON value"
    assert parse_tree_summary(raw_from_hex("7b2261223a0c317d")) == "expected JSON scalar"
    assert parse_tree_summary("{{\"a\":1 \"b\":2}}") == "expected ',' between object fields"
    assert parse_tree_summary("{{\"a\":[1] \"b\":2}}") == "expected ',' between object fields"
    assert parse_tree_summary("{{\"name\":1,}}") == "expected object field"
    assert parse_tree_summary("{{,\"a\":1}}") == "expected object field"
    assert parse_tree_summary("{{\"a\":1,,\"b\":2}}") == "expected object field"
    assert parse_tree_summary("{{\"a\":1,\"a\":2}}") == "duplicate object field 'a'"
    assert parse_tree_summary("{{\"\\u0061\":1,\"a\":2}}") == "duplicate object field 'a'"
    assert parse_tree_summary("{{\"name\":1") == "unterminated JSON object"
    assert parse_tree_summary("{{\"name\":1}} trailing") == "unexpected trailing characters after JSON value"
    assert parse_tree_summary("{{\"name\":1]") == "mismatched closing delimiter in JSON object"
    assert parse_tree_summary("[{{\"a\":1]]") == "mismatched closing delimiter in JSON object"
    assert parse_tree_summary("[{{\"a\":1]}}") == "mismatched closing delimiter in JSON array"
    assert parse_tree_summary("[1]]") == "unexpected trailing characters after JSON value"
    assert parse_tree_summary("]") == "unexpected closing delimiter in JSON value"

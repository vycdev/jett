namespace test
type Names = list[string]
struct Person:
    name: string
    age: int64
enum Direction:
    north
    south
function list_length_or_zero[T](value: T) returns int64:
    if type.kind_tag[T]() == TypeKind.list_type:
        list[int64] items = value
        return list.length[int64](view items)
    return 0
function type_info_list_length_or_zero[T](value: T) returns int64:
    if type.info[T]().kind_tag == TypeKind.list_type:
        list[int64] items = value
        return list.length[int64](view items)
    return 0
function not_list_marker[T](value: T) returns string:
    if type.kind_tag[T]() != TypeKind.list_type:
        string text = value
        return text
    return "list"
function kind_branch[T]() returns string:
    if type.kind_tag[T]() == TypeKind.alias_type:
        return "alias"
    if type.kind_tag[T]() == TypeKind.list_type:
        return "list"
    return "other"
function type_info_kind_branch[T]() returns string:
    if type.info[T]().kind_tag == TypeKind.alias_type:
        return "alias"
    if type.info[T]().kind_tag == TypeKind.list_type:
        return "list"
    return "other"
function local_info_list_length_or_zero[T](value: T) returns int64:
    TypeInfo info = type.info[T]()
    if info.kind_tag == TypeKind.list_type:
        list[int64] items = value
        return list.length[int64](view items)
    return 0
function local_kind_list_length_or_zero[T](value: T) returns int64:
    TypeInfo info = type.info[T]()
    TypeKind kind = info.kind_tag
    if kind == TypeKind.list_type:
        list[int64] items = value
        return list.length[int64](view items)
    return 0
function copied_local_info_kind_branch[T]() returns string:
    TypeInfo reflected = type.info[T]()
    TypeInfo copied = reflected
    TypeKind kind = copied.kind_tag
    if kind == TypeKind.alias_type:
        return "alias"
    if kind == TypeKind.list_type:
        return "list"
    return "other"
function helper_kind_list_length_or_zero[T](value: T, kind: TypeKind) returns int64:
    if kind == TypeKind.list_type:
        list[int64] items = value
        return list.length[int64](view items)
    return 0
function local_kind_helper_list_length_or_zero[T](value: T) returns int64:
    TypeInfo info = type.info[T]()
    TypeKind kind = info.kind_tag
    return helper_kind_list_length_or_zero[T](value, kind)
function helper_info_list_length_or_zero[T](value: T, info: TypeInfo) returns int64:
    if info.kind_tag == TypeKind.list_type:
        list[int64] items = value
        return list.length[int64](view items)
    return 0
function local_info_helper_list_length_or_zero[T](value: T) returns int64:
    TypeInfo info = type.info[T]()
    return helper_info_list_length_or_zero[T](value, info)
function helper_view_info_list_length_or_zero[T](value: T, view info: TypeInfo) returns int64:
    if info.kind_tag == TypeKind.list_type:
        list[int64] items = value
        return list.length[int64](view items)
    return 0
function local_view_info_helper_list_length_or_zero[T](value: T) returns int64:
    TypeInfo info = type.info[T]()
    return helper_view_info_list_length_or_zero[T](value, view info)
function direct_view_info_helper_list_length_or_zero[T](value: T) returns int64:
    return helper_view_info_list_length_or_zero[T](value, view type.info[T]())
function helper_view_info_primitive_string_or_other[T](value: T, view info: TypeInfo) returns string:
    TypePrimitive primitive = info.primitive_tag handle:
        default TypePrimitive.unknown_type
    if primitive == TypePrimitive.string_type:
        string text = value
        return text
    return "other"
function local_view_info_primitive_string_or_other[T](value: T) returns string:
    TypeInfo info = type.info[T]()
    return helper_view_info_primitive_string_or_other[T](value, view info)
function direct_view_info_primitive_string_or_other[T](value: T) returns string:
    return helper_view_info_primitive_string_or_other[T](value, view type.info[T]())
function local_primitive_string_or_other[T](value: T) returns string:
    TypeInfo info = type.info[T]()
    TypePrimitive primitive = info.primitive_tag handle:
        default TypePrimitive.unknown_type
    if primitive == TypePrimitive.string_type:
        string text = value
        return text
    return "other"
function helper_primitive_string_or_other[T](value: T, primitive: TypePrimitive) returns string:
    if primitive == TypePrimitive.string_type:
        string text = value
        return text
    return "other"
function local_primitive_helper_string_or_other[T](value: T) returns string:
    TypePrimitive primitive = type.primitive_tag[T]() handle:
        default TypePrimitive.unknown_type
    return helper_primitive_string_or_other[T](value, primitive)
function guarded_type_arg_length_or_zero[T](value: T) returns int64:
    TypeInfo info = type.info[T]()
    TypeKind kind = info.kind_tag
    if kind == TypeKind.list_type:
        comptime type Elem = type.arg[T](0):
            list[Elem] items = value
            return list.length[Elem](view items)
    return 0
function top_level_type_arg_length[T](value: T) returns int64:
    comptime type Elem = type.arg[T](0):
        list[Elem] items = value
        return list.length[Elem](view items)
function direct_field_count[T]() returns int64:
    mutable int64 count = 0
    for field in type.fields[T]():
        count = count + 1
    return count
function selected_variant_name[T](value: T) returns string:
    TypeVariant selected = type.variant_value[T](view value)
    return selected.name
verify generic_reflection_branch_specialization:
    list[int64] numbers = list(1, 2, 3)
    assert list_length_or_zero[list[int64]](numbers) == 3
    assert list_length_or_zero[string]("Ada") == 0
    list[int64] more = list(4, 5)
    assert type_info_list_length_or_zero[list[int64]](more) == 2
    assert type_info_list_length_or_zero[string]("Ada") == 0
    assert not_list_marker[string]("Ada") == "Ada"
    list[int64] empty = list.new[int64]()
    assert not_list_marker[list[int64]](empty) == "list"
    assert kind_branch[Names]() == "alias"
    assert kind_branch[list[string]]() == "list"
    assert type_info_kind_branch[Names]() == "alias"
    assert type_info_kind_branch[string]() == "other"
    assert local_info_list_length_or_zero[list[int64]](numbers) == 3
    assert local_info_list_length_or_zero[string]("Ada") == 0
    assert local_kind_list_length_or_zero[list[int64]](more) == 2
    assert local_kind_list_length_or_zero[string]("Ada") == 0
    assert copied_local_info_kind_branch[Names]() == "alias"
    assert copied_local_info_kind_branch[list[int64]]() == "list"
    assert local_kind_helper_list_length_or_zero[list[int64]](numbers) == 3
    assert local_kind_helper_list_length_or_zero[string]("Ada") == 0
    assert local_info_helper_list_length_or_zero[list[int64]](more) == 2
    assert local_info_helper_list_length_or_zero[string]("Ada") == 0
    assert local_view_info_helper_list_length_or_zero[list[int64]](numbers) == 3
    assert local_view_info_helper_list_length_or_zero[string]("Ada") == 0
    assert direct_view_info_helper_list_length_or_zero[list[int64]](more) == 2
    assert direct_view_info_helper_list_length_or_zero[string]("Ada") == 0
    assert local_view_info_primitive_string_or_other[string]("Ada") == "Ada"
    assert local_view_info_primitive_string_or_other[int64](7) == "other"
    assert direct_view_info_primitive_string_or_other[string]("Ada") == "Ada"
    assert direct_view_info_primitive_string_or_other[int64](7) == "other"
    assert local_primitive_string_or_other[string]("Ada") == "Ada"
    assert local_primitive_string_or_other[int64](7) == "other"
    assert local_primitive_helper_string_or_other[string]("Ada") == "Ada"
    assert local_primitive_helper_string_or_other[int64](7) == "other"
    assert guarded_type_arg_length_or_zero[list[int64]](numbers) == 3
    assert guarded_type_arg_length_or_zero[string]("Ada") == 0
    assert top_level_type_arg_length[list[int64]](numbers) == 3
    assert direct_field_count[Person]() == 2
    assert direct_field_count[string]() == 0
    assert selected_variant_name[Direction](Direction.north) == "north"

namespace test
struct Credential:
    name: string
    token: secret[string]
struct PublicCredential:
    name: string
struct CallbackHolder:
    name: string
    callback: secret[function(int64) returns int64]
function parse_secret_then_public_omits() returns string:
    Credential credential = json.parse[Credential]("{{\"name\":\"svc\",\"token\":\"secret-token\"}}") handle error:
        return error
    string raw = json.serialize_public[Credential](view credential)
    bool has_name = string.contains(raw, "\"name\":\"svc\"")
    bool has_token = string.contains(raw, "token")
    return "{credential.name}:{secret.redact(credential.token)}:{has_name}:{has_token}"
function parse_exact_secret_then_public_omits() returns string:
    Credential credential = json.parse_exact[Credential]("{{\"name\":\"svc\",\"token\":\"secret-token\"}}") handle error:
        return error
    string raw = json.serialize_public[Credential](view credential)
    bool has_name = string.contains(raw, "\"name\":\"svc\"")
    bool has_token = string.contains(raw, "token")
    return "{credential.name}:{secret.redact(credential.token)}:{has_name}:{has_token}"
function public_projection_back_to_secret_fails() returns string:
    Credential credential = json.parse[Credential]("{{\"name\":\"svc\",\"token\":\"secret-token\"}}") handle error:
        return error
    string raw = json.serialize_public[Credential](view credential)
    Credential restored = json.parse[Credential](raw) handle error:
        return error
    return restored.name
function parse_exact_public_projection_back_to_secret_fails() returns string:
    Credential credential = json.parse_exact[Credential]("{{\"name\":\"svc\",\"token\":\"secret-token\"}}") handle error:
        return error
    string raw = json.serialize_public[Credential](view credential)
    Credential restored = json.parse_exact[Credential](raw) handle error:
        return error
    return restored.name
function public_projection_to_dto_succeeds() returns string:
    Credential credential = json.parse[Credential]("{{\"name\":\"svc\",\"token\":\"secret-token\"}}") handle error:
        return error
    string raw = json.serialize_public[Credential](view credential)
    PublicCredential public = json.parse[PublicCredential](raw) handle error:
        return error
    return public.name
function public_projection_optional_record_summary() returns string:
    Credential credential = json.parse[Credential]("{{\"name\":\"svc\",\"token\":\"secret-token\"}}") handle error:
        return error
    optional[Credential] maybe = some(credential)
    string raw = json.serialize_public[optional[Credential]](view maybe)
    bool has_name = string.contains(raw, "\"name\":\"svc\"")
    bool has_token = string.contains(raw, "token")
    bool has_secret = string.contains(raw, "secret-token")
    return "{has_name}:{has_token}:{has_secret}"
function public_projection_result_record_summary() returns string:
    Credential credential = json.parse[Credential]("{{\"name\":\"svc\",\"token\":\"secret-token\"}}") handle error:
        return error
    result[Credential, Credential] success = ok(credential)
    result[Credential, Credential] failure = fail(credential)
    string ok_raw = json.serialize_public[result[Credential, Credential]](view success)
    string fail_raw = json.serialize_public[result[Credential, Credential]](view failure)
    bool has_ok = string.contains(ok_raw, "\"ok\":{{\"name\":\"svc\"}}")
    bool has_fail = string.contains(fail_raw, "\"fail\":{{\"name\":\"svc\"}}")
    bool has_token = string.contains(ok_raw, "token") or string.contains(fail_raw, "token")
    bool has_secret = string.contains(ok_raw, "secret-token") or string.contains(fail_raw, "secret-token")
    return "{has_ok}:{has_fail}:{has_token}:{has_secret}"
function public_projection_map_record_summary() returns string:
    Credential credential = json.parse[Credential]("{{\"name\":\"svc\",\"token\":\"secret-token\"}}") handle error:
        return error
    map[string, Credential] by_name = map("primary": credential)
    string raw = json.serialize_public[map[string, Credential]](view by_name)
    bool has_primary = string.contains(raw, "\"primary\":{{\"name\":\"svc\"}}")
    bool has_token = string.contains(raw, "token")
    bool has_secret = string.contains(raw, "secret-token")
    return "{has_primary}:{has_token}:{has_secret}"
function public_projection_set_record_summary() returns string:
    set[Credential] credentials = json.parse[set[Credential]]("[{{\"name\":\"svc\",\"token\":\"secret-token\"}}]") handle error:
        return error
    string raw = json.serialize_public[set[Credential]](view credentials)
    bool has_name = string.contains(raw, "{{\"name\":\"svc\"}}")
    bool has_token = string.contains(raw, "token")
    bool has_secret = string.contains(raw, "secret-token")
    return "{has_name}:{has_token}:{has_secret}"
function public_projection_omits_secret_unsupported_field(callback: function(int64) returns int64) returns string:
    CallbackHolder holder = CallbackHolder(name: "svc", callback: callback)
    string raw = json.serialize_public[CallbackHolder](view holder)
    bool has_name = string.contains(raw, "\"name\":\"svc\"")
    bool has_callback = string.contains(raw, "callback")
    return "{has_name}:{has_callback}"
function public_projection_list_omits_secret_unsupported_field(callback: function(int64) returns int64) returns string:
    CallbackHolder holder = CallbackHolder(name: "svc", callback: callback)
    list[CallbackHolder] holders = list(holder)
    string raw = json.serialize_public[list[CallbackHolder]](view holders)
    bool has_name = string.contains(raw, "\"name\":\"svc\"")
    bool has_callback = string.contains(raw, "callback")
    return "{has_name}:{has_callback}"
function public_projection_map_omits_secret_unsupported_field(callback: function(int64) returns int64) returns string:
    CallbackHolder holder = CallbackHolder(name: "svc", callback: callback)
    map[string, CallbackHolder] holders = map("primary": holder)
    string raw = json.serialize_public[map[string, CallbackHolder]](view holders)
    bool has_primary = string.contains(raw, "\"primary\":{{\"name\":\"svc\"}}")
    bool has_callback = string.contains(raw, "callback")
    return "{has_primary}:{has_callback}"
function public_projection_optional_omits_secret_unsupported_field(callback: function(int64) returns int64) returns string:
    CallbackHolder holder = CallbackHolder(name: "svc", callback: callback)
    optional[CallbackHolder] maybe = some(holder)
    string raw = json.serialize_public[optional[CallbackHolder]](view maybe)
    bool has_name = string.contains(raw, "\"name\":\"svc\"")
    bool has_callback = string.contains(raw, "callback")
    return "{has_name}:{has_callback}"
function public_projection_result_omits_secret_unsupported_field(callback: function(int64) returns int64) returns string:
    CallbackHolder holder = CallbackHolder(name: "svc", callback: callback)
    result[CallbackHolder, string] parsed = ok(holder)
    string raw = json.serialize_public[result[CallbackHolder, string]](view parsed)
    bool has_ok = string.contains(raw, "\"ok\":{{\"name\":\"svc\"}}")
    bool has_callback = string.contains(raw, "callback")
    return "{has_ok}:{has_callback}"
verify json_public_secret_policy:
    assert parse_secret_then_public_omits() == "svc:***:true:false"
    assert parse_exact_secret_then_public_omits() == "svc:***:true:false"
    assert public_projection_back_to_secret_fails() == "missing required field 'token' for test.Credential"
    assert parse_exact_public_projection_back_to_secret_fails() == "missing required field 'token' for test.Credential"
    assert public_projection_to_dto_succeeds() == "svc"
    assert public_projection_optional_record_summary() == "true:false:false"
    assert public_projection_result_record_summary() == "true:true:false:false"
    assert public_projection_map_record_summary() == "true:false:false"
    assert public_projection_set_record_summary() == "true:false:false"
    assert public_projection_omits_secret_unsupported_field(function(value: int64) returns int64: return value + 1) == "true:false"
    assert public_projection_list_omits_secret_unsupported_field(function(value: int64) returns int64: return value + 1) == "true:false"
    assert public_projection_map_omits_secret_unsupported_field(function(value: int64) returns int64: return value + 1) == "true:false"
    assert public_projection_optional_omits_secret_unsupported_field(function(value: int64) returns int64: return value + 1) == "true:false"
    assert public_projection_result_omits_secret_unsupported_field(function(value: int64) returns int64: return value + 1) == "true:false"

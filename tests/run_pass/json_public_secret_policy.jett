namespace test
struct Credential:
    name: string
    token: secret[string]
struct PublicCredential:
    name: string
function parse_secret_then_public_omits() returns string:
    Credential credential = json.parse[Credential]("{{\"name\":\"svc\",\"token\":\"secret-token\"}}") handle error:
        return error
    string raw = json.serialize_public[Credential](view credential)
    bool has_name = string.contains(raw, "\"name\":\"svc\"")
    bool has_token = string.contains(raw, "token")
    return "{credential.name}:{secret.redact(credential.token)}:{has_name}:{has_token}"
function parse_exact_secret_then_public_omits() returns string:
    Credential credential = json.parse_exact[Credential]("{{\"name\":\"svc\",\"token\":\"secret-token\"}}") handle error:
        return error
    string raw = json.serialize_public[Credential](view credential)
    bool has_name = string.contains(raw, "\"name\":\"svc\"")
    bool has_token = string.contains(raw, "token")
    return "{credential.name}:{secret.redact(credential.token)}:{has_name}:{has_token}"
function public_projection_back_to_secret_fails() returns string:
    Credential credential = json.parse[Credential]("{{\"name\":\"svc\",\"token\":\"secret-token\"}}") handle error:
        return error
    string raw = json.serialize_public[Credential](view credential)
    Credential restored = json.parse[Credential](raw) handle error:
        return error
    return restored.name
function parse_exact_public_projection_back_to_secret_fails() returns string:
    Credential credential = json.parse_exact[Credential]("{{\"name\":\"svc\",\"token\":\"secret-token\"}}") handle error:
        return error
    string raw = json.serialize_public[Credential](view credential)
    Credential restored = json.parse_exact[Credential](raw) handle error:
        return error
    return restored.name
function public_projection_to_dto_succeeds() returns string:
    Credential credential = json.parse[Credential]("{{\"name\":\"svc\",\"token\":\"secret-token\"}}") handle error:
        return error
    string raw = json.serialize_public[Credential](view credential)
    PublicCredential public = json.parse[PublicCredential](raw) handle error:
        return error
    return public.name
verify json_public_secret_policy:
    assert parse_secret_then_public_omits() == "svc:***:true:false"
    assert parse_exact_secret_then_public_omits() == "svc:***:true:false"
    assert public_projection_back_to_secret_fails() == "missing required field 'token' for test.Credential"
    assert parse_exact_public_projection_back_to_secret_fails() == "missing required field 'token' for test.Credential"
    assert public_projection_to_dto_succeeds() == "svc"

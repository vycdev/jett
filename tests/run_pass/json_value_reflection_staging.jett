namespace test
type LocalRaw = json.JsonTree
type LocalRawAlias = json.JsonValue
function bare_json_value_reflection_summary() returns string:
    TypeInfo info = type.info[JsonValue]()
    TypePrimitive primitive = info.primitive_tag handle:
        int64 arg_count = list.length[TypeInfo](info.args)
        TypeInfo base = list.get[TypeInfo](info.args, 0) handle:
            return "missing base"
        bool alias_kind = info.kind_tag == TypeKind.alias_type
        TypePrimitive direct_primitive = type.primitive_tag[JsonValue]() handle:
            default TypePrimitive.unknown_type
        bool direct_is_unknown = direct_primitive == TypePrimitive.unknown_type
        return "{info.kind}:{info.type_name}:{alias_kind}:{base.kind}:{base.type_name}:{arg_count}:{direct_is_unknown}"
    return "unexpected primitive"
function alias_json_value_reflection_summary() returns string:
    TypeInfo info = type.info[json.JsonValue]()
    TypePrimitive primitive = info.primitive_tag handle:
        int64 arg_count = list.length[TypeInfo](info.args)
        TypeInfo base = list.get[TypeInfo](info.args, 0) handle:
            return "missing base"
        bool alias_kind = info.kind_tag == TypeKind.alias_type
        return "{info.kind}:{info.type_name}:{alias_kind}:{base.kind}:{base.type_name}:{arg_count}"
    return "unexpected primitive"
function bare_json_value_raw_behavior() returns string:
    JsonValue parsed = json.parse[JsonValue]("{{\"name\":\"Ada\",\"score\":5}}") handle error:
        return error
    JsonValue exact = json.parse_exact[JsonValue]("{{\"name\":\"Grace\",\"score\":7}}") handle error:
        return error
    string serialized = json.serialize[JsonValue](view parsed)
    string public = json.serialize_public[JsonValue](view exact)
    bool serialized_name = string.contains(serialized, "\"name\":\"Ada\"")
    bool public_score = string.contains(public, "\"score\":7")
    return "{json.kind(parsed)}:{serialized_name}:{public_score}"
function alias_json_value_raw_behavior() returns string:
    json.JsonValue parsed = json.parse[json.JsonValue]("{{\"name\":\"Lin\",\"score\":11}}") handle error:
        return error
    json.JsonValue exact = json.parse_exact[json.JsonValue]("{{\"name\":\"Edsger\",\"score\":13}}") handle error:
        return error
    string serialized = json.serialize[json.JsonValue](view parsed)
    string public = json.serialize_public[json.JsonValue](view exact)
    bool serialized_name = string.contains(serialized, "\"name\":\"Lin\"")
    bool public_score = string.contains(public, "\"score\":13")
    return "{json.kind(view parsed)}:{serialized_name}:{public_score}"
function local_raw_alias_behavior() returns string:
    LocalRaw parsed = json.parse_exact[LocalRaw]("{{\"extra\":{{\"kept\":true}}}}") handle error:
        return error
    LocalRawAlias alias = json.parse[LocalRawAlias]("{{\"name\":\"Mira\"}}") handle error:
        return error
    LocalRaw extra = json.require_field(view parsed, "extra") handle error:
        return error
    string public = json.serialize_public[LocalRaw](view parsed)
    string encoded = json.serialize[LocalRawAlias](view alias)
    bool kept_extra = string.contains(public, "\"extra\":")
    bool kept_name = string.contains(encoded, "\"name\":\"Mira\"")
    bool extra_is_object = json.is_object(view extra)
    return "{json.kind(view parsed)}:{json.kind(view alias)}:{extra_is_object}:{kept_extra}:{kept_name}"
verify json_value_reflection_staging:
    assert bare_json_value_reflection_summary() == "alias:JsonValue:true:enum:json.JsonTree:1:true"
    assert alias_json_value_reflection_summary() == "alias:json.JsonValue:true:enum:json.JsonTree:1"
    assert bare_json_value_raw_behavior() == "object:true:true"
    assert alias_json_value_raw_behavior() == "object:true:true"
    assert local_raw_alias_behavior() == "object:object:true:true:true"

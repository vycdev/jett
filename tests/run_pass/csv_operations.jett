namespace test
# --- csv.parse ---------------------------------------------------------
function csv_parse_row_count_test() returns int64:
    string data = "name,age,city\nalice,30,new york\nbob,25,london"
    list[list[string]] rows = csv.parse(data) handle error:
        return -1
    return list.length(rows)
verify csv_parse_row_count_test:
    assert csv_parse_row_count_test() == 3
function csv_parse_col_count_test() returns int64:
    string data = "a,b,c\n1,2,3"
    list[list[string]] rows = csv.parse(data) handle error:
        return -1
    list[string] first_row = list.get[list[string]](rows, 0) handle:
        default list("err")
    return list.length(first_row)
verify csv_parse_col_count_test:
    assert csv_parse_col_count_test() == 3
function csv_parse_cell_test() returns string:
    string data = "name,age\nalice,30"
    list[list[string]] rows = csv.parse(data) handle error:
        return error
    list[string] second_row = list.get[list[string]](rows, 1) handle:
        default list("err")
    return list.get[string](second_row, 0) handle:
        default "err"
verify csv_parse_cell_test:
    assert csv_parse_cell_test() == "alice"
function csv_parse_quoted_test() returns string:
    string data = "name,desc\nalice,\"hello, world\""
    list[list[string]] rows = csv.parse(data) handle error:
        return error
    list[string] row = list.get[list[string]](rows, 1) handle:
        default list("err")
    return list.get[string](row, 1) handle:
        default "err"
verify csv_parse_quoted_test:
    assert csv_parse_quoted_test() == "hello, world"
function csv_parse_quoted_newline_test() returns string:
    string data = "name,desc\nalice,\"hello\nworld\"\nbob,ok"
    list[list[string]] rows = csv.parse(data) handle error:
        return error
    list[string] row = list.get[list[string]](rows, 1) handle:
        default list("err")
    return list.get[string](row, 1) handle:
        default "err"
verify csv_parse_quoted_newline_test:
    assert csv_parse_quoted_newline_test() == "hello\nworld"
function csv_parse_empty_test() returns int64:
    string data = ""
    list[list[string]] rows = csv.parse(data) handle error:
        return -1
    return list.length(rows)
verify csv_parse_empty_test:
    assert csv_parse_empty_test() == 0
function csv_parse_single_blank_line_test() returns string:
    list[list[string]] rows = csv.parse("\n") handle error:
        return error
    list[string] blank = list.get[list[string]](rows, 0) handle:
        return "missing blank record"
    string value = list.get[string](blank, 0) handle:
        return "missing empty field"
    return "{list.length[list[string]](rows)}:{list.length[string](blank)}:{value}"
verify csv_parse_single_blank_line_test:
    assert csv_parse_single_blank_line_test() == "1:1:"
function csv_parse_blank_record_test() returns string:
    list[list[string]] rows = csv.parse("first\n\nthird") handle error:
        return error
    list[string] blank = list.get[list[string]](rows, 1) handle:
        return "missing blank record"
    string value = list.get[string](blank, 0) handle:
        return "missing empty field"
    return "{list.length[list[string]](rows)}:{list.length[string](blank)}:{value}"
verify csv_parse_blank_record_test:
    assert csv_parse_blank_record_test() == "3:1:"
function csv_parse_ragged_rows_test() returns string:
    list[list[string]] rows = csv.parse("a,b\n1\n2,3,4") handle error:
        return error
    list[string] short = list.get[list[string]](rows, 1) handle:
        return "missing short row"
    list[string] long = list.get[list[string]](rows, 2) handle:
        return "missing long row"
    return "{list.length[list[string]](rows)}:{list.length[string](short)}:{list.length[string](long)}"
verify csv_parse_ragged_rows_test:
    assert csv_parse_ragged_rows_test() == "3:1:3"
# --- csv.stringify -----------------------------------------------------
function csv_stringify_basic_test() returns string:
    list[list[string]] rows = list(list("name", "age"), list("alice", "30"))
    return csv.stringify(rows)
verify csv_stringify_basic_test:
    assert csv_stringify_basic_test() == "name,age\nalice,30"
function csv_stringify_quoting_test() returns string:
    list[list[string]] rows = list(list("a", "b,c"))
    return csv.stringify(rows)
verify csv_stringify_quoting_test:
    assert csv_stringify_quoting_test() == "a,\"b,c\""
function csv_stringify_newline_roundtrip_test() returns string:
    list[list[string]] rows = list(list("name", "desc"), list("alice", "hello\nworld"))
    string text = csv.stringify(rows)
    list[list[string]] parsed = csv.parse(text) handle error:
        return error
    list[string] row = list.get[list[string]](parsed, 1) handle:
        default list("err")
    return list.get[string](row, 1) handle:
        default "err"
verify csv_stringify_newline_roundtrip_test:
    assert csv_stringify_newline_roundtrip_test() == "hello\nworld"
function csv_stringify_canonical_newlines_test() returns string:
    list[list[string]] rows = csv.parse("a,b\r\nc,d\r\n") handle error:
        return error
    return csv.stringify(rows)
verify csv_stringify_canonical_newlines_test:
    assert csv_stringify_canonical_newlines_test() == "a,b\nc,d"
# --- csv.parse_with_header ---------------------------------------------
function csv_header_row_count_test() returns int64:
    string data = "name,age,city\nalice,30,new york\nbob,25,london"
    list[map[string, string]] rows = csv.parse_with_header(data) handle error:
        return -1
    return list.length(rows)
verify csv_header_row_count_test:
    assert csv_header_row_count_test() == 2
function csv_header_get_name_test() returns string:
    string data = "name,age\nalice,30\nbob,25"
    list[map[string, string]] rows = csv.parse_with_header(data) handle error:
        return error
    map[string, string] first = list.get[map[string, string]](rows, 0) handle:
        default map("err": "err")
    optional[string] val = map.get(first, "name")
    return val handle:
        default "missing"
verify csv_header_get_name_test:
    assert csv_header_get_name_test() == "alice"
function csv_header_get_age_test() returns string:
    string data = "name,age\nalice,30\nbob,25"
    list[map[string, string]] rows = csv.parse_with_header(data) handle error:
        return error
    map[string, string] second = list.get[map[string, string]](rows, 1) handle:
        default map("err": "err")
    optional[string] val = map.get(second, "age")
    return val handle:
        default "missing"
verify csv_header_get_age_test:
    assert csv_header_get_age_test() == "25"
function csv_header_empty_test() returns int64:
    string data = ""
    list[map[string, string]] rows = csv.parse_with_header(data) handle error:
        return -1
    return list.length(rows)
verify csv_header_empty_test:
    assert csv_header_empty_test() == 0
# --- roundtrip ---------------------------------------------------------
function csv_roundtrip_test() returns string:
    list[list[string]] original = list(list("x", "y"), list("1", "2"))
    string text = csv.stringify(original)
    list[list[string]] parsed = csv.parse(text) handle error:
        return error
    list[string] row = list.get[list[string]](parsed, 1) handle:
        default list("err")
    return list.get[string](row, 1) handle:
        default "err"
verify csv_roundtrip_test:
    assert csv_roundtrip_test() == "2"
function csv_parse_escaped_quote_test() returns string:
    string data = "name,desc\nalice,\"say \"\"hello\"\"\""
    list[list[string]] rows = csv.parse(data) handle error:
        return error
    list[string] row = list.get[list[string]](rows, 1) handle:
        default list("err")
    return list.get[string](row, 1) handle:
        default "err"
verify csv_parse_escaped_quote_test:
    assert csv_parse_escaped_quote_test() == "say \"hello\""
function csv_parse_crlf_test() returns string:
    string data = "name,age\r\nalice,30\r\n"
    list[list[string]] rows = csv.parse(data) handle error:
        return error
    list[string] row = list.get[list[string]](rows, 1) handle:
        default list("err")
    return list.get[string](row, 1) handle:
        default "err"
verify csv_parse_crlf_test:
    assert csv_parse_crlf_test() == "30"
function csv_parse_quoted_carriage_return_test() returns string:
    list[list[string]] rows = csv.parse("name,note\nalice,\"hello\rworld\"") handle error:
        return error
    list[string] row = list.get[list[string]](rows, 1) handle:
        default list("err")
    return list.get[string](row, 1) handle:
        default "err"
verify csv_parse_quoted_carriage_return_test:
    assert csv_parse_quoted_carriage_return_test() == "hello\rworld"
# --- strict failures ---------------------------------------------------
function csv_bare_carriage_return_error_test() returns string:
    list[list[string]] rows = csv.parse("name,age\ralice,30") handle error:
        return error
    return "accepted {list.length[list[string]](rows)} rows"
verify csv_bare_carriage_return_error_test:
    assert csv_bare_carriage_return_error_test() == "CSV parse error at record 1, field 2: bare carriage return; use LF or CRLF record endings"
function csv_unterminated_quote_error_test() returns string:
    list[list[string]] rows = csv.parse("name,age\nalice,\"30") handle error:
        return error
    return "accepted {list.length[list[string]](rows)} rows"
verify csv_unterminated_quote_error_test:
    assert csv_unterminated_quote_error_test() == "CSV parse error at record 2, field 2: unterminated quoted field"
function csv_quote_in_unquoted_field_error_test() returns string:
    list[list[string]] rows = csv.parse("name\nal\"ice") handle error:
        return error
    return "accepted {list.length[list[string]](rows)} rows"
verify csv_quote_in_unquoted_field_error_test:
    assert csv_quote_in_unquoted_field_error_test() == "CSV parse error at record 2, field 1: unexpected quote in unquoted field"
function csv_character_after_quote_error_test() returns string:
    list[list[string]] rows = csv.parse("name\n\"alice\"x") handle error:
        return error
    return "accepted {list.length[list[string]](rows)} rows"
verify csv_character_after_quote_error_test:
    assert csv_character_after_quote_error_test() == "CSV parse error at record 2, field 1: unexpected character after closing quote"
function csv_duplicate_header_error_test() returns string:
    list[map[string, string]] rows = csv.parse_with_header("name,name\nalice,smith") handle error:
        return error
    return "accepted {list.length[map[string, string]](rows)} rows"
verify csv_duplicate_header_error_test:
    assert csv_duplicate_header_error_test() == "CSV header error at field 2: duplicate header 'name'"
function csv_empty_header_error_test() returns string:
    list[map[string, string]] rows = csv.parse_with_header("name,,age\nalice,smith,30") handle error:
        return error
    return "accepted {list.length[map[string, string]](rows)} rows"
verify csv_empty_header_error_test:
    assert csv_empty_header_error_test() == "CSV header error at field 2: header must not be empty"
function csv_short_header_row_error_test() returns string:
    list[map[string, string]] rows = csv.parse_with_header("name,age\nalice") handle error:
        return error
    return "accepted {list.length[map[string, string]](rows)} rows"
verify csv_short_header_row_error_test:
    assert csv_short_header_row_error_test() == "CSV header error at record 2: expected 2 fields, got 1"
function csv_long_header_row_error_test() returns string:
    list[map[string, string]] rows = csv.parse_with_header("name\nalice,30") handle error:
        return error
    return "accepted {list.length[map[string, string]](rows)} rows"
verify csv_long_header_row_error_test:
    assert csv_long_header_row_error_test() == "CSV header error at record 2: expected 1 fields, got 2"
function csv_blank_header_row_width_error_test() returns string:
    list[map[string, string]] rows = csv.parse_with_header("name,age\n\nalice,30") handle error:
        return error
    return "accepted {list.length[map[string, string]](rows)} rows"
verify csv_blank_header_row_width_error_test:
    assert csv_blank_header_row_width_error_test() == "CSV header error at record 2: expected 2 fields, got 1"

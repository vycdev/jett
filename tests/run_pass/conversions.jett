namespace app
# --- string from int64 ---
function int_to_str_test() returns string:
    return string.from_int64(42)
verify int_to_str_test:
    assert int_to_str_test() == "42"
# --- string from float64 ---
function float_to_str_test() returns string:
    return string.from_float64(3.14)
verify float_to_str_test:
    assert float_to_str_test() == "3.14"
# --- string from bool ---
function bool_to_str_test() returns string:
    string t = string.from_bool(true)
    string f = string.from_bool(false)
    return "{t},{f}"
verify bool_to_str_test:
    assert bool_to_str_test() == "true,false"
# --- int64 from string (result type) ---
function parse_int_test() returns int64:
    result[int64, string] r = int64.from_string("123")
    int64 val = r handle error:
        default 0
    return val
verify parse_int_test:
    assert parse_int_test() == 123
# --- uint64 from string (result type) ---
function parse_uint64_max_test() returns string:
    result[uint64, string] r = uint64.from_string("18446744073709551615")
    uint64 val = r handle error:
        return error
    return string.from_uint64(val)
function uint64_literal_max_test() returns string:
    uint64 val = 18446744073709551615
    return string.from_uint64(val)
function uint64_mutable_reassignment_test() returns string:
    mutable uint64 val = 0
    val = 18446744073709551615
    return string.from_uint64(val)
function uint64_arithmetic_max_edges_test() returns string:
    uint64 max = 18446744073709551615
    uint64 one = 1
    uint64 two = 2
    uint64 below_max = max - one
    uint64 half = max / two
    uint64 remainder = max modulo two
    uint64 rebuilt = half * two + one
    string below_text = string.from_uint64(below_max)
    string half_text = string.from_uint64(half)
    string remainder_text = string.from_uint64(remainder)
    string rebuilt_text = string.from_uint64(rebuilt)
    return "{below_text}:{half_text}:{remainder_text}:{rebuilt_text}"
function uint64_comparison_edges_test() returns string:
    uint64 max = 18446744073709551615
    uint64 above_int64 = 9223372036854775808
    uint64 int64_max = 9223372036854775807
    bool ordered = max > above_int64
    bool adjacent = above_int64 > int64_max
    bool equal = max == 18446744073709551615
    string ordered_text = string.from_bool(ordered)
    string adjacent_text = string.from_bool(adjacent)
    string equal_text = string.from_bool(equal)
    return "{ordered_text}:{adjacent_text}:{equal_text}"
function parse_uint64_negative_error_test() returns string:
    uint64 val = uint64.from_string("-1") handle error:
        return error
    return string.from_uint64(val)
function parse_uint64_overflow_error_test() returns string:
    uint64 val = uint64.from_string("18446744073709551616") handle error:
        return error
    return string.from_uint64(val)
verify parse_uint64_max_test:
    assert parse_uint64_max_test() == "18446744073709551615"
    assert uint64_literal_max_test() == "18446744073709551615"
    assert uint64_mutable_reassignment_test() == "18446744073709551615"
    assert uint64_arithmetic_max_edges_test() == "18446744073709551614:9223372036854775807:1:18446744073709551615"
    assert uint64_comparison_edges_test() == "true:true:true"
    assert parse_uint64_negative_error_test() == "uint64.from_string: cannot parse '-1' as uint64"
    assert parse_uint64_overflow_error_test() == "uint64.from_string: cannot parse '18446744073709551616' as uint64"
# --- float64 from string (result type) ---
function parse_float_test() returns float64:
    result[float64, string] r = float64.from_string("2.5")
    float64 val = r handle error:
        default 0.0
    return val
verify parse_float_test:
    assert parse_float_test() == 2.5
# --- int64 from float64 (result type) ---
function float_to_int_exact_test() returns int64:
    return int64.from_float64(42.0) handle error:
        default 0
function float_to_int_min_test() returns string:
    int64 value = int64.from_float64(-9223372036854775808.0) handle error:
        return error
    return string.from_int64(value)
function float_to_int_fraction_error_test() returns string:
    int64 value = int64.from_float64(3.14) handle error:
        return error
    return string.from_int64(value)
function float_to_int_overflow_error_test() returns string:
    int64 value = int64.from_float64(9223372036854775808.0) handle error:
        return error
    return string.from_int64(value)
verify float_to_int_test:
    assert float_to_int_exact_test() == 42
    assert float_to_int_min_test() == "-9223372036854775808"
    assert float_to_int_fraction_error_test() == "int64.from_float64: value is not exactly representable as int64"
    assert float_to_int_overflow_error_test() == "int64.from_float64: value is not exactly representable as int64"

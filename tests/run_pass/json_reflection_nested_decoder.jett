namespace test

type Scores = map[string, int64]
type NonEmpty = string where string.char_count(value) > 0
type NonEmptyNumbers = list[int64] where list.length(value) > 0

enum Direction:
    north
    south

enum Shape:
    empty
    point(x: int64, y: int64)

enum Protocol:
    tcp = 6
    udp = 17

struct Profile:
    city: string
    visits: list[int64]

struct Credential:
    name: string
    token: secret[string]

struct Blob:
    data: bytes

bitfield Header:
    version: 4 bits
    header_length: 4 bits
    protocol: 8 bits as Protocol

struct User:
    id: string serialize "userId"
    active: bool
    profile: Profile
    header: Header
    direction: Direction
    shape: Shape
    tags: list[string]
    nickname: optional[string]
    missing: optional[string]
    scores: Scores
    lucky: set[int64]
    display: NonEmpty
    outcome: result[int64, string]
    failed: result[int64, string]

function decoded_nested_summary() returns string:
    User user = json.parse[User]("{{\"userId\":\"u1\",\"active\":true,\"profile\":{{\"city\":\"Cluj\",\"visits\":[3,5]}},\"header\":{{\"version\":4,\"header_length\":5,\"protocol\":\"tcp\"}},\"direction\":\"south\",\"shape\":{{\"point\":[3,4]}},\"tags\":[\"admin\",\"beta\"],\"nickname\":\"ally\",\"scores\":{{\"wins\":3,\"losses\":1}},\"lucky\":[11,13],\"display\":\"ready\",\"outcome\":{{\"ok\":7}},\"failed\":{{\"fail\":\"bad\"}}}}") handle error:
        return error
    bool south = user.direction == Direction.south
    bool tcp = user.header.protocol == Protocol.tcp
    int64 shape_total = 0
    match user.shape:
        empty:
            shape_total = -1
        point(x, y):
            shape_total = x + y
    string nick = user.nickname handle:
        default "none"
    string missing = user.missing handle:
        default "none"
    int64 wins = map.get[string, int64](user.scores, "wins") handle:
        default 0
    int64 lucky_count = set.length[int64](user.lucky)
    bool lucky = set.contains[int64](user.lucky, 13)
    int64 outcome = user.outcome handle error:
        default -1
    return "{user.id}:{user.profile.city}:{user.header.version}:{user.header.header_length}:{tcp}:{south}:{shape_total}:{list.length[int64](user.profile.visits)}:{list.length[string](user.tags)}:{nick}:{missing}:{wins}:{lucky_count}:{lucky}:{coarsen user.display}:{outcome}:{user.active}"

function decoded_result_failure() returns string:
    User user = json.parse[User]("{{\"userId\":\"u1\",\"active\":true,\"profile\":{{\"city\":\"Cluj\",\"visits\":[3]}},\"header\":{{\"version\":4,\"header_length\":5,\"protocol\":\"tcp\"}},\"direction\":\"south\",\"shape\":{{\"point\":[3,4]}},\"tags\":[],\"nickname\":null,\"missing\":null,\"scores\":{{\"wins\":3}},\"lucky\":[13],\"display\":\"ready\",\"outcome\":{{\"ok\":7}},\"failed\":{{\"fail\":\"bad\"}}}}") handle error:
        return error
    int64 ignored = user.failed handle error:
        return error
    return "{ignored}"

function invalid_refinement_message() returns string:
    User user = json.parse[User]("{{\"userId\":\"u1\",\"active\":true,\"profile\":{{\"city\":\"Cluj\",\"visits\":[3]}},\"header\":{{\"version\":4,\"header_length\":5,\"protocol\":\"tcp\"}},\"direction\":\"south\",\"shape\":{{\"point\":[3,4]}},\"tags\":[],\"nickname\":null,\"missing\":null,\"scores\":{{\"wins\":3}},\"lucky\":[13],\"display\":\"\",\"outcome\":{{\"ok\":7}},\"failed\":{{\"fail\":\"bad\"}}}}") handle error:
        return error
    return user.id

function missing_nested_message() returns string:
    User user = json.parse[User]("{{\"userId\":\"u1\",\"active\":true,\"profile\":{{\"visits\":[3]}},\"header\":{{\"version\":4,\"header_length\":5,\"protocol\":\"tcp\"}},\"direction\":\"south\",\"shape\":{{\"point\":[3,4]}},\"tags\":[],\"nickname\":null,\"missing\":null,\"scores\":{{\"wins\":3}},\"lucky\":[13],\"display\":\"ready\",\"outcome\":{{\"ok\":7}},\"failed\":{{\"fail\":\"bad\"}}}}") handle error:
        return error
    return user.id

function wrong_struct_shape_message() returns string:
    User user = json.parse[User]("[1,2,3]") handle error:
        return error
    return user.id

function wrong_list_item_message() returns string:
    User user = json.parse[User]("{{\"userId\":\"u1\",\"active\":true,\"profile\":{{\"city\":\"Cluj\",\"visits\":[3]}},\"header\":{{\"version\":4,\"header_length\":5,\"protocol\":\"tcp\"}},\"direction\":\"south\",\"shape\":{{\"point\":[3,4]}},\"tags\":[1],\"nickname\":null,\"missing\":null,\"scores\":{{\"wins\":3}},\"lucky\":[13],\"display\":\"ready\",\"outcome\":{{\"ok\":7}},\"failed\":{{\"fail\":\"bad\"}}}}") handle error:
        return error
    return user.id

function invalid_bitfield_message() returns string:
    User user = json.parse[User]("{{\"userId\":\"u1\",\"active\":true,\"profile\":{{\"city\":\"Cluj\",\"visits\":[3]}},\"header\":{{\"version\":16,\"header_length\":5,\"protocol\":\"tcp\"}},\"direction\":\"south\",\"shape\":{{\"point\":[3,4]}},\"tags\":[],\"nickname\":null,\"missing\":null,\"scores\":{{\"wins\":3}},\"lucky\":[13],\"display\":\"ready\",\"outcome\":{{\"ok\":7}},\"failed\":{{\"fail\":\"bad\"}}}}") handle error:
        return error
    return "{user.header.version}"

function invalid_enum_payload_message() returns string:
    User user = json.parse[User]("{{\"userId\":\"u1\",\"active\":true,\"profile\":{{\"city\":\"Cluj\",\"visits\":[3]}},\"header\":{{\"version\":4,\"header_length\":5,\"protocol\":\"tcp\"}},\"direction\":\"south\",\"shape\":{{\"point\":[3]}},\"tags\":[],\"nickname\":null,\"missing\":null,\"scores\":{{\"wins\":3}},\"lucky\":[13],\"display\":\"ready\",\"outcome\":{{\"ok\":7}},\"failed\":{{\"fail\":\"bad\"}}}}") handle error:
        return error
    return "{user.active}"

function invalid_bitfield_enum_message() returns string:
    User user = json.parse[User]("{{\"userId\":\"u1\",\"active\":true,\"profile\":{{\"city\":\"Cluj\",\"visits\":[3]}},\"header\":{{\"version\":4,\"header_length\":5,\"protocol\":\"bogus\"}},\"direction\":\"south\",\"shape\":{{\"point\":[3,4]}},\"tags\":[],\"nickname\":null,\"missing\":null,\"scores\":{{\"wins\":3}},\"lucky\":[13],\"display\":\"ready\",\"outcome\":{{\"ok\":7}},\"failed\":{{\"fail\":\"bad\"}}}}") handle error:
        return error
    return "unexpected success"

function decoded_top_level_refinement() returns string:
    NonEmpty value = json.parse[NonEmpty]("\"ready\"") handle error:
        return error
    return coarsen value

function invalid_top_level_refinement_message() returns string:
    NonEmpty value = json.parse[NonEmpty]("\"\"") handle error:
        return error
    return coarsen value

function decoded_refined_list_count() returns int64:
    NonEmptyNumbers value = json.parse[NonEmptyNumbers]("[3,5]") handle error:
        return -1
    list[int64] raw = coarsen value
    return list.length[int64](raw)

function invalid_refined_list_message() returns string:
    NonEmptyNumbers value = json.parse[NonEmptyNumbers]("[]") handle error:
        return error
    list[int64] raw = coarsen value
    return "{list.length[int64](raw)}"

function decoded_top_level_float() returns float64:
    float64 value = json.parse[float64]("2.5") handle error:
        return -1.0
    return value

function decoded_null_as_nothing() returns string:
    nothing value = json.parse[nothing]("null") handle error:
        return error
    return "null"

function invalid_nothing_message() returns string:
    nothing value = json.parse[nothing]("0") handle error:
        return error
    return "unexpected"

function decoded_top_level_bytes_length() returns int64:
    bytes value = json.parse[bytes]("\"0x4869\"") handle error:
        return -1
    return bytes.length(value)

function decoded_blob_bytes_first() returns int64:
    Blob blob = json.parse[Blob]("{{\"data\":\"0x4869\"}}") handle error:
        return -1
    int64 first = bytes.get(blob.data, 0) handle:
        default -1
    return first

function invalid_bytes_message() returns string:
    bytes value = json.parse[bytes]("\"0xzz\"") handle error:
        return error
    return "{bytes.length(value)}"

function decoded_top_level_secret_redaction() returns string:
    secret[string] value = json.parse[secret[string]]("\"secret-token\"") handle error:
        return error
    return secret.redact(value)

function decoded_secret_field_summary() returns string:
    Credential credential = json.parse[Credential]("{{\"name\":\"svc\",\"token\":\"secret-token\"}}") handle error:
        return error
    return "{credential.name}:{secret.redact(credential.token)}"

function invalid_secret_field_message() returns string:
    Credential credential = json.parse[Credential]("{{\"name\":\"svc\",\"token\":7}}") handle error:
        return error
    return credential.name

function missing_secret_field_message() returns string:
    Credential credential = json.parse[Credential]("{{\"name\":\"svc\"}}") handle error:
        return error
    return credential.name

verify json_reflection_nested_decoder:
    assert decoded_nested_summary() == "u1:Cluj:4:5:true:true:7:2:2:ally:none:3:2:true:ready:7:true"
    assert decoded_result_failure() == "bad"
    assert string.contains(invalid_refinement_message(), "refinement type constraint failed") == true
    assert missing_nested_message() == "profile: missing required field 'city' for test.Profile"
    assert wrong_struct_shape_message() == "expected object, got array"
    assert string.contains(wrong_list_item_message(), "tags: 0: expected string") == true
    assert string.contains(invalid_bitfield_message(), "header: bitfield 'test.Header' field 'version'") == true
    assert string.contains(invalid_enum_payload_message(), "shape: enum variant 'test.Shape.point' expects 2 payload field(s), got 1") == true
    assert string.contains(invalid_bitfield_enum_message(), "header: protocol: unknown enum variant 'test.Protocol.bogus'") == true
    assert decoded_top_level_refinement() == "ready"
    assert string.contains(invalid_top_level_refinement_message(), "refinement type constraint failed for 'NonEmpty'") == true
    assert decoded_refined_list_count() == 2
    assert string.contains(invalid_refined_list_message(), "refinement type constraint failed for 'NonEmptyNumbers'") == true
    assert decoded_top_level_float() == 2.5
    assert decoded_null_as_nothing() == "null"
    assert invalid_nothing_message() == "expected null, got number"
    assert decoded_top_level_bytes_length() == 2
    assert decoded_blob_bytes_first() == 72
    assert invalid_bytes_message() == "expected hex bytes string"
    assert decoded_top_level_secret_redaction() == "***"
    assert decoded_secret_field_summary() == "svc:***"
    assert string.contains(invalid_secret_field_message(), "token: expected string") == true
    assert missing_secret_field_message() == "missing required field 'token' for test.Credential"

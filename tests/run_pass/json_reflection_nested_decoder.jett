namespace test

type Scores = map[string, int64]
type NonEmpty = string where string.char_count(value) > 0
type NonEmptyNumbers = list[int64] where list.length(value) > 0

enum Direction:
    north
    south

enum Shape:
    empty
    point(x: int64, y: int64)

enum Protocol:
    tcp = 6
    udp = 17

struct Profile:
    city: string
    visits: list[int64]

struct Credential:
    name: string
    token: secret[string]

bitfield Header:
    version: 4 bits
    header_length: 4 bits
    protocol: 8 bits as Protocol

struct User:
    id: string serialize "userId"
    active: bool
    profile: Profile
    header: Header
    direction: Direction
    shape: Shape
    tags: list[string]
    nickname: optional[string]
    missing: optional[string]
    scores: Scores
    lucky: set[int64]
    display: NonEmpty
    outcome: result[int64, string]
    failed: result[int64, string]

function decode_reflected[T](raw: JsonValue) returns result[T, string]:
    string kind = type.kind[T]()
    string type_name = type.name[T]()

    if type_name == "string":
        string item = json.as_string(raw) handle error:
            return fail(error)
        return ok(item)

    if type_name == "int64":
        int64 item = json.as_int64(raw) handle error:
            return fail(error)
        return ok(item)

    if type_name == "float64":
        float64 item = json.as_float64(raw) handle error:
            return fail(error)
        return ok(item)

    if type_name == "bool":
        bool item = json.as_bool(raw) handle error:
            return fail(error)
        return ok(item)

    if type_name == "nothing":
        if json.is_null(raw) == true:
            return ok(nothing)
        return fail("expected null, got {json.kind(raw)}")

    if kind == "alias":
        comptime type Base = type.arg[T](0):
            Base item = decode_reflected[Base](raw) handle error:
                return fail(error)
            T alias_value = item
            return ok(alias_value)

    if kind == "refinement":
        comptime type Base = type.arg[T](0):
            Base item = decode_reflected[Base](raw) handle error:
                return fail(error)
            T refined = item
            return ok(refined)

    if kind == "secret":
        comptime type Inner = type.arg[T](0):
            Inner item = decode_reflected[Inner](raw) handle error:
                return fail(error)
            T secret_value = item
            return ok(secret_value)

    if kind == "list":
        comptime type Elem = type.arg[T](0):
            int64 length = json.array_length(raw) handle error:
                return fail(error)
            mutable list[Elem] items = list.new[Elem]()
            for index in range(length):
                JsonValue raw_item = json.index(raw, index) handle:
                    return fail("missing array item {index}")
                Elem item = decode_reflected[Elem](raw_item) handle error:
                    return fail("{index}: {error}")
                items = list.append[Elem](items, item)
            return ok(items)

    if kind == "set":
        comptime type Elem = type.arg[T](0):
            int64 length = json.array_length(raw) handle error:
                return fail(error)
            mutable set[Elem] items = set.new[Elem]()
            for index in range(length):
                JsonValue raw_item = json.index(raw, index) handle:
                    return fail("missing array item {index}")
                Elem item = decode_reflected[Elem](raw_item) handle error:
                    return fail("{index}: {error}")
                items = set.add[Elem](items, item)
            return ok(items)

    if kind == "map":
        comptime type Val = type.arg[T](1):
            list[string] keys = json.object_keys(raw) handle error:
                return fail(error)
            mutable map[string, Val] entries = map.new[string, Val]()
            for key in keys:
                JsonValue raw_item = json.field(raw, key) handle:
                    return fail("missing object field '{key}'")
                Val item = decode_reflected[Val](raw_item) handle error:
                    return fail("{key}: {error}")
                entries = map.insert[string, Val](entries, key, item)
            return ok(entries)

    if kind == "optional":
        if json.is_null(raw) == true:
            return ok(none)
        comptime type Inner = type.arg[T](0):
            Inner item = decode_reflected[Inner](raw) handle error:
                return fail(error)
            return ok(some(item))

    if kind == "result":
        comptime type Ok = type.arg[T](0):
            JsonValue ok_raw = json.field(raw, "ok") handle:
                comptime type Err = type.arg[T](1):
                    JsonValue fail_raw = json.field(raw, "fail") handle:
                        return fail("expected result object with ok or fail")
                    Err failure = decode_reflected[Err](fail_raw) handle error:
                        return fail("fail: {error}")
                    return ok(fail(failure))
            Ok item = decode_reflected[Ok](ok_raw) handle error:
                return fail("ok: {error}")
            return ok(ok(item))

    if kind == "enum":
        if json.kind(raw) == "string":
            string variant_name = json.as_string(raw) handle error:
                return fail(error)
            for variant in type.variants[T]():
                if variant.name == variant_name:
                    if list.length[TypeField](variant.fields) != 0:
                        return fail("enum variant '{type_name}.{variant_name}' expects {list.length[TypeField](variant.fields)} payload field(s)")
                    TypeConstruction builder = type.construct_variant_start[T](view variant) handle error:
                        return fail(error)
                    return type.construct_finish[T](builder)
            return fail("unknown enum variant '{type_name}.{variant_name}'")

        list[string] keys = json.object_keys(raw) handle error:
            return fail("expected enum string or object, got {json.kind(raw)}")
        if list.length[string](keys) != 1:
            return fail("expected enum object with exactly one variant key")
        string variant_name = list.get[string](keys, 0) handle:
            return fail("expected enum object with exactly one variant key")
        JsonValue payload = json.field(raw, variant_name) handle:
            return fail("missing enum payload for '{variant_name}'")
        int64 payload_count = json.array_length(payload) handle error:
            return fail("expected array payload for enum variant '{type_name}.{variant_name}', got {json.kind(payload)}")
        for variant in type.variants[T]():
            if variant.name == variant_name:
                int64 expected_count = list.length[TypeField](variant.fields)
                if payload_count != expected_count:
                    return fail("enum variant '{type_name}.{variant_name}' expects {expected_count} payload field(s), got {payload_count}")
                mutable TypeConstruction builder = type.construct_variant_start[T](view variant) handle error:
                    return fail(error)
                mutable int64 index = 0
                for field in variant.fields:
                    comptime type Field = field.type_info:
                        JsonValue raw_item = json.index(payload, index) handle:
                            return fail("missing enum payload item {index}")
                        Field decoded = decode_reflected[Field](raw_item) handle error:
                            return fail("{variant_name}.{field.name}: {error}")
                        builder = type.construct_put[T, Field](builder, view field, decoded) handle error:
                            return fail(error)
                    index = index + 1
                return type.construct_finish[T](builder)
        return fail("unknown enum variant '{type_name}.{variant_name}'")

    if kind == "struct" or kind == "bitfield":
        mutable TypeConstruction builder = type.construct_start[T]()
        for field in type.fields[T]():
            comptime type Field = field.type_info:
                JsonValue raw_field = json.field(raw, field.serialize_name) handle:
                    if field.type_info.kind == "optional":
                        JsonValue missing_optional = json.parse_raw("null") handle error:
                            return fail(error)
                        default missing_optional
                    return fail("missing field '{field.serialize_name}'")
                Field decoded = decode_reflected[Field](raw_field) handle error:
                    return fail("{field.serialize_name}: {error}")
                builder = type.construct_put[T, Field](builder, view field, decoded) handle error:
                    return fail(error)
        return type.construct_finish[T](builder)

    return fail("unsupported reflected JSON type: {type_name}")

function decoded_nested_summary() returns string:
    JsonValue root = json.parse_raw("{{\"userId\":\"u1\",\"active\":true,\"profile\":{{\"city\":\"Cluj\",\"visits\":[3,5]}},\"header\":{{\"version\":4,\"header_length\":5,\"protocol\":\"tcp\"}},\"direction\":\"south\",\"shape\":{{\"point\":[3,4]}},\"tags\":[\"admin\",\"beta\"],\"nickname\":\"ally\",\"scores\":{{\"wins\":3,\"losses\":1}},\"lucky\":[11,13],\"display\":\"ready\",\"outcome\":{{\"ok\":7}},\"failed\":{{\"fail\":\"bad\"}}}}") handle error:
        return error
    User user = decode_reflected[User](root) handle error:
        return error
    bool south = user.direction == Direction.south
    bool tcp = user.header.protocol == Protocol.tcp
    int64 shape_total = 0
    match user.shape:
        empty:
            shape_total = -1
        point(x, y):
            shape_total = x + y
    string nick = user.nickname handle:
        default "none"
    string missing = user.missing handle:
        default "none"
    int64 wins = map.get[string, int64](user.scores, "wins") handle:
        default 0
    int64 lucky_count = set.length[int64](user.lucky)
    bool lucky = set.contains[int64](user.lucky, 13)
    int64 outcome = user.outcome handle error:
        default -1
    return "{user.id}:{user.profile.city}:{user.header.version}:{user.header.header_length}:{tcp}:{south}:{shape_total}:{list.length[int64](user.profile.visits)}:{list.length[string](user.tags)}:{nick}:{missing}:{wins}:{lucky_count}:{lucky}:{coarsen user.display}:{outcome}:{user.active}"

function decoded_result_failure() returns string:
    JsonValue root = json.parse_raw("{{\"userId\":\"u1\",\"active\":true,\"profile\":{{\"city\":\"Cluj\",\"visits\":[3]}},\"header\":{{\"version\":4,\"header_length\":5,\"protocol\":\"tcp\"}},\"direction\":\"south\",\"shape\":{{\"point\":[3,4]}},\"tags\":[],\"nickname\":null,\"missing\":null,\"scores\":{{\"wins\":3}},\"lucky\":[13],\"display\":\"ready\",\"outcome\":{{\"ok\":7}},\"failed\":{{\"fail\":\"bad\"}}}}") handle error:
        return error
    User user = decode_reflected[User](root) handle error:
        return error
    int64 ignored = user.failed handle error:
        return error
    return "{ignored}"

function invalid_refinement_message() returns string:
    JsonValue root = json.parse_raw("{{\"userId\":\"u1\",\"active\":true,\"profile\":{{\"city\":\"Cluj\",\"visits\":[3]}},\"header\":{{\"version\":4,\"header_length\":5,\"protocol\":\"tcp\"}},\"direction\":\"south\",\"shape\":{{\"point\":[3,4]}},\"tags\":[],\"nickname\":null,\"missing\":null,\"scores\":{{\"wins\":3}},\"lucky\":[13],\"display\":\"\",\"outcome\":{{\"ok\":7}},\"failed\":{{\"fail\":\"bad\"}}}}") handle error:
        return error
    User user = decode_reflected[User](root) handle error:
        return error
    return user.id

function missing_nested_message() returns string:
    JsonValue root = json.parse_raw("{{\"userId\":\"u1\",\"active\":true,\"profile\":{{\"visits\":[3]}},\"header\":{{\"version\":4,\"header_length\":5,\"protocol\":\"tcp\"}},\"direction\":\"south\",\"shape\":{{\"point\":[3,4]}},\"tags\":[],\"nickname\":null,\"missing\":null,\"scores\":{{\"wins\":3}},\"lucky\":[13],\"display\":\"ready\",\"outcome\":{{\"ok\":7}},\"failed\":{{\"fail\":\"bad\"}}}}") handle error:
        return error
    User user = decode_reflected[User](root) handle error:
        return error
    return user.id

function wrong_list_item_message() returns string:
    JsonValue root = json.parse_raw("{{\"userId\":\"u1\",\"active\":true,\"profile\":{{\"city\":\"Cluj\",\"visits\":[3]}},\"header\":{{\"version\":4,\"header_length\":5,\"protocol\":\"tcp\"}},\"direction\":\"south\",\"shape\":{{\"point\":[3,4]}},\"tags\":[1],\"nickname\":null,\"missing\":null,\"scores\":{{\"wins\":3}},\"lucky\":[13],\"display\":\"ready\",\"outcome\":{{\"ok\":7}},\"failed\":{{\"fail\":\"bad\"}}}}") handle error:
        return error
    User user = decode_reflected[User](root) handle error:
        return error
    return user.id

function invalid_bitfield_message() returns string:
    JsonValue root = json.parse_raw("{{\"userId\":\"u1\",\"active\":true,\"profile\":{{\"city\":\"Cluj\",\"visits\":[3]}},\"header\":{{\"version\":16,\"header_length\":5,\"protocol\":\"tcp\"}},\"direction\":\"south\",\"shape\":{{\"point\":[3,4]}},\"tags\":[],\"nickname\":null,\"missing\":null,\"scores\":{{\"wins\":3}},\"lucky\":[13],\"display\":\"ready\",\"outcome\":{{\"ok\":7}},\"failed\":{{\"fail\":\"bad\"}}}}") handle error:
        return error
    User user = decode_reflected[User](root) handle error:
        return error
    return "{user.header.version}"

function invalid_enum_payload_message() returns string:
    JsonValue root = json.parse_raw("{{\"userId\":\"u1\",\"active\":true,\"profile\":{{\"city\":\"Cluj\",\"visits\":[3]}},\"header\":{{\"version\":4,\"header_length\":5,\"protocol\":\"tcp\"}},\"direction\":\"south\",\"shape\":{{\"point\":[3]}},\"tags\":[],\"nickname\":null,\"missing\":null,\"scores\":{{\"wins\":3}},\"lucky\":[13],\"display\":\"ready\",\"outcome\":{{\"ok\":7}},\"failed\":{{\"fail\":\"bad\"}}}}") handle error:
        return error
    User user = decode_reflected[User](root) handle error:
        return error
    return "{user.active}"

function invalid_bitfield_enum_message() returns string:
    JsonValue root = json.parse_raw("{{\"userId\":\"u1\",\"active\":true,\"profile\":{{\"city\":\"Cluj\",\"visits\":[3]}},\"header\":{{\"version\":4,\"header_length\":5,\"protocol\":\"bogus\"}},\"direction\":\"south\",\"shape\":{{\"point\":[3,4]}},\"tags\":[],\"nickname\":null,\"missing\":null,\"scores\":{{\"wins\":3}},\"lucky\":[13],\"display\":\"ready\",\"outcome\":{{\"ok\":7}},\"failed\":{{\"fail\":\"bad\"}}}}") handle error:
        return error
    User user = decode_reflected[User](root) handle error:
        return error
    return "unexpected success"

function decoded_top_level_refinement() returns string:
    JsonValue root = json.parse_raw("\"ready\"") handle error:
        return error
    NonEmpty value = decode_reflected[NonEmpty](root) handle error:
        return error
    return coarsen value

function invalid_top_level_refinement_message() returns string:
    JsonValue root = json.parse_raw("\"\"") handle error:
        return error
    NonEmpty value = decode_reflected[NonEmpty](root) handle error:
        return error
    return coarsen value

function decoded_refined_list_count() returns int64:
    JsonValue root = json.parse_raw("[3,5]") handle error:
        return -1
    NonEmptyNumbers value = decode_reflected[NonEmptyNumbers](root) handle error:
        return -1
    list[int64] raw = coarsen value
    return list.length[int64](raw)

function invalid_refined_list_message() returns string:
    JsonValue root = json.parse_raw("[]") handle error:
        return error
    NonEmptyNumbers value = decode_reflected[NonEmptyNumbers](root) handle error:
        return error
    list[int64] raw = coarsen value
    return "{list.length[int64](raw)}"

function decoded_top_level_float() returns float64:
    JsonValue root = json.parse_raw("2.5") handle error:
        return -1.0
    float64 value = decode_reflected[float64](root) handle error:
        return -1.0
    return value

function decoded_null_as_nothing() returns string:
    JsonValue root = json.parse_raw("null") handle error:
        return error
    nothing value = decode_reflected[nothing](root) handle error:
        return error
    return "null"

function invalid_nothing_message() returns string:
    JsonValue root = json.parse_raw("0") handle error:
        return error
    nothing value = decode_reflected[nothing](root) handle error:
        return error
    return "unexpected"

function decoded_top_level_secret_redaction() returns string:
    JsonValue root = json.parse_raw("\"secret-token\"") handle error:
        return error
    secret[string] value = decode_reflected[secret[string]](root) handle error:
        return error
    return secret.redact(value)

function decoded_secret_field_summary() returns string:
    JsonValue root = json.parse_raw("{{\"name\":\"svc\",\"token\":\"secret-token\"}}") handle error:
        return error
    Credential credential = decode_reflected[Credential](root) handle error:
        return error
    return "{credential.name}:{secret.redact(credential.token)}"

function invalid_secret_field_message() returns string:
    JsonValue root = json.parse_raw("{{\"name\":\"svc\",\"token\":7}}") handle error:
        return error
    Credential credential = decode_reflected[Credential](root) handle error:
        return error
    return credential.name

function missing_secret_field_message() returns string:
    JsonValue root = json.parse_raw("{{\"name\":\"svc\"}}") handle error:
        return error
    Credential credential = decode_reflected[Credential](root) handle error:
        return error
    return credential.name

verify json_reflection_nested_decoder:
    assert decoded_nested_summary() == "u1:Cluj:4:5:true:true:7:2:2:ally:none:3:2:true:ready:7:true"
    assert decoded_result_failure() == "bad"
    assert string.contains(invalid_refinement_message(), "refinement type constraint failed") == true
    assert missing_nested_message() == "profile: missing field 'city'"
    assert string.contains(wrong_list_item_message(), "tags: 0: expected string") == true
    assert string.contains(invalid_bitfield_message(), "header: bitfield 'Header' field 'version'") == true
    assert string.contains(invalid_enum_payload_message(), "shape: enum variant 'Shape.point' expects 2 payload field(s), got 1") == true
    assert string.contains(invalid_bitfield_enum_message(), "header: protocol: unknown enum variant 'Protocol.bogus'") == true
    assert decoded_top_level_refinement() == "ready"
    assert string.contains(invalid_top_level_refinement_message(), "refinement type constraint failed for 'NonEmpty'") == true
    assert decoded_refined_list_count() == 2
    assert string.contains(invalid_refined_list_message(), "refinement type constraint failed for 'NonEmptyNumbers'") == true
    assert decoded_top_level_float() == 2.5
    assert decoded_null_as_nothing() == "null"
    assert invalid_nothing_message() == "expected null, got number"
    assert decoded_top_level_secret_redaction() == "***"
    assert decoded_secret_field_summary() == "svc:***"
    assert string.contains(invalid_secret_field_message(), "token: expected string") == true
    assert missing_secret_field_message() == "missing field 'token'"

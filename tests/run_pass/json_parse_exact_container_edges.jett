namespace test
struct Profile:
    display_name: string serialize "displayName"
    note: string
function parse_exact_list_profile_success() returns string:
    string raw = "[{{\"displayName\":\"Alice\",\"note\":\"ok\"}}]"
    list[Profile] profiles = json.parse_exact[list[Profile]](raw) handle error:
        return error
    return "{list.length[Profile](profiles)}"
function parse_exact_list_profile_extra_error() returns string:
    string raw = "[{{\"displayName\":\"Alice\",\"note\":\"ok\",\"extra\":1}}]"
    list[Profile] profiles = json.parse_exact[list[Profile]](raw) handle error:
        return error
    return "{list.length[Profile](profiles)}"
function parse_exact_map_list_profile_success() returns string:
    string raw = "{{\"primary\":[{{\"displayName\":\"Alice\",\"note\":\"ok\"}}]}}"
    map[string, list[Profile]] groups = json.parse_exact[map[string, list[Profile]]](raw) handle error:
        return error
    optional[list[Profile]] maybe_profiles = map.get[string, list[Profile]](groups, "primary")
    list[Profile] profiles = maybe_profiles handle:
        return "missing"
    return "{list.length[Profile](profiles)}"
function parse_exact_map_list_profile_extra_error() returns string:
    string raw = "{{\"primary\":[{{\"displayName\":\"Alice\",\"note\":\"ok\",\"extra\":1}}]}}"
    map[string, list[Profile]] groups = json.parse_exact[map[string, list[Profile]]](raw) handle error:
        return error
    return "{map.length[string, list[Profile]](groups)}"
function parse_exact_result_fail_profile_success() returns string:
    result[string, Profile] parsed = json.parse_exact[result[string, Profile]]("{{\"fail\":{{\"displayName\":\"Alice\",\"note\":\"bad\"}}}}") handle error:
        return error
    string ignored = parsed handle error:
        return error.display_name
    return ignored
function parse_exact_result_fail_profile_extra_error() returns string:
    result[string, Profile] parsed = json.parse_exact[result[string, Profile]]("{{\"fail\":{{\"displayName\":\"Alice\",\"note\":\"bad\",\"extra\":1}}}}") handle error:
        return error
    string ignored = parsed handle error:
        return error.display_name
    return ignored
function parse_exact_result_multiple_keys_error() returns string:
    result[string, Profile] parsed = json.parse_exact[result[string, Profile]]("{{\"ok\":\"value\",\"fail\":{{\"displayName\":\"Alice\",\"note\":\"bad\"}}}}") handle error:
        return error
    string ignored = parsed handle error:
        return error.display_name
    return ignored
function parse_exact_result_unknown_key_error() returns string:
    result[string, Profile] parsed = json.parse_exact[result[string, Profile]]("{{\"missing\":\"value\"}}") handle error:
        return error
    string ignored = parsed handle error:
        return error.display_name
    return ignored
function parse_exact_result_non_object_error() returns string:
    result[string, Profile] parsed = json.parse_exact[result[string, Profile]]("\"value\"") handle error:
        return error
    string ignored = parsed handle error:
        return error.display_name
    return ignored
verify json_parse_exact_container_edges:
    assert parse_exact_list_profile_success() == "1"
    assert parse_exact_list_profile_extra_error() == "0: unknown field 'extra' for test.Profile"
    assert parse_exact_map_list_profile_success() == "1"
    assert parse_exact_map_list_profile_extra_error() == "primary: 0: unknown field 'extra' for test.Profile"
    assert parse_exact_result_fail_profile_success() == "Alice"
    assert parse_exact_result_fail_profile_extra_error() == "fail: unknown field 'extra' for test.Profile"
    assert parse_exact_result_multiple_keys_error() == "expected result object with exactly one key"
    assert parse_exact_result_unknown_key_error() == "expected result object with key 'ok' or 'fail'"
    assert parse_exact_result_non_object_error() == "expected result object, got string"

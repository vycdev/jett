namespace test

struct SizedBundle:
    small: int8
    medium: uint16
    count: uint32
    serial: uint64
    ratio: float32
    values: list[uint8]
    metrics: map[string, uint16]
    maybe: optional[int8]
    outcome: result[uint32, string]

function parse_int8_min_text() returns string:
    int8 value = json.parse[int8]("-128") handle error:
        return error
    return "{value}"

function parse_int16_min_text() returns string:
    int16 value = json.parse[int16]("-32768") handle error:
        return error
    return "{value}"

function parse_int32_max_text() returns string:
    int32 value = json.parse[int32]("2147483647") handle error:
        return error
    return "{value}"

function parse_int64_min_text() returns string:
    int64 value = json.parse[int64]("-9223372036854775808") handle error:
        return error
    return "{value}"

function parse_int64_max_text() returns string:
    int64 value = json.parse[int64]("9223372036854775807") handle error:
        return error
    return "{value}"

function parse_uint8_max_text() returns string:
    uint8 value = json.parse[uint8]("255") handle error:
        return error
    return "{value}"

function parse_uint16_max_text() returns string:
    uint16 value = json.parse[uint16]("65535") handle error:
        return error
    return "{value}"

function parse_uint32_max_text() returns string:
    uint32 value = json.parse[uint32]("4294967295") handle error:
        return error
    return "{value}"

function parse_uint64_runtime_max_text() returns string:
    uint64 value = json.parse[uint64]("18446744073709551615") handle error:
        return error
    return "{value}"

function parse_float32_text() returns string:
    float32 value = json.parse[float32]("2.5") handle error:
        return error
    return "{value}"

function parse_int8_range_error() returns string:
    int8 value = json.parse[int8]("128") handle error:
        return error
    return "{value}"

function parse_int64_underflow_error() returns string:
    int64 value = json.parse[int64]("-9223372036854775809") handle error:
        return error
    return "{value}"

function parse_int64_overflow_error() returns string:
    int64 value = json.parse[int64]("9223372036854775808") handle error:
        return error
    return "{value}"

function parse_uint8_range_error() returns string:
    uint8 value = json.parse[uint8]("-1") handle error:
        return error
    return "{value}"

function parse_uint32_range_error() returns string:
    uint32 value = json.parse[uint32]("4294967296") handle error:
        return error
    return "{value}"

function parse_uint64_runtime_limit_error() returns string:
    uint64 value = json.parse[uint64]("18446744073709551616") handle error:
        return error
    return "{value}"

function parse_sized_bundle() returns string:
    string raw = "{{\"small\":-5,\"medium\":65535,\"count\":4294967295,\"serial\":18446744073709551615,\"ratio\":2.5,\"values\":[1,255],\"metrics\":{{\"max\":65535}},\"maybe\":-8,\"outcome\":{{\"ok\":9}}}}"
    SizedBundle bundle = json.parse[SizedBundle](raw) handle error:
        return error
    uint8 second = list.get[uint8](view bundle.values, 1) handle:
        default 0
    uint16 max = map.get[string, uint16](bundle.metrics, "max") handle:
        default 0
    int8 maybe = bundle.maybe handle:
        default 0
    uint32 outcome = bundle.outcome handle error:
        default 0
    return "{bundle.small}:{bundle.medium}:{bundle.count}:{bundle.serial}:{bundle.ratio}:{second}:{max}:{maybe}:{outcome}"

function serialize_uint8_max() returns string:
    uint8 value = 255
    return json.serialize[uint8](value)

function serialize_int16_min() returns string:
    int16 value = -32768
    return json.serialize[int16](value)

function serialize_uint32_max() returns string:
    uint32 value = 4294967295
    return json.serialize[uint32](value)

function serialize_uint64_runtime_max() returns string:
    uint64 value = uint64.from_string("18446744073709551615") handle error:
        return error
    return json.serialize[uint64](value)

function serialize_float32() returns string:
    float32 value = 2.5
    return json.serialize[float32](value)

function serialize_sized_bundle() returns string:
    uint8 first = 1
    uint8 second = 255
    uint16 max = 65535
    int8 small = -5
    int8 maybe_value = -8
    uint32 count = 4294967295
    uint32 outcome_value = 9
    uint64 serial = uint64.from_string("18446744073709551615") handle error:
        return error
    float32 ratio = 2.5
    list[uint8] values = list(first, second)
    map[string, uint16] metrics = map("max": max)
    SizedBundle bundle = SizedBundle(small: small, medium: max, count: count, serial: serial, ratio: ratio, values: values, metrics: metrics, maybe: some(maybe_value), outcome: ok(outcome_value))
    return json.serialize[SizedBundle](view bundle)

verify json_sized_primitives:
    assert parse_int8_min_text() == "-128"
    assert parse_int16_min_text() == "-32768"
    assert parse_int32_max_text() == "2147483647"
    assert parse_int64_min_text() == "-9223372036854775808"
    assert parse_int64_max_text() == "9223372036854775807"
    assert parse_uint8_max_text() == "255"
    assert parse_uint16_max_text() == "65535"
    assert parse_uint32_max_text() == "4294967295"
    assert parse_uint64_runtime_max_text() == "18446744073709551615"
    assert parse_float32_text() == "2.5"
    assert parse_int8_range_error() == "expected int8 in range -128..127"
    assert parse_int64_underflow_error() == "expected int64, got number"
    assert parse_int64_overflow_error() == "expected int64, got number"
    assert parse_uint8_range_error() == "expected uint8 in range 0..255"
    assert parse_uint32_range_error() == "expected uint32 in range 0..4294967295"
    assert parse_uint64_runtime_limit_error() == "expected uint64 in range 0..18446744073709551615"
    assert parse_sized_bundle() == "-5:65535:4294967295:18446744073709551615:2.5:255:65535:-8:9"
    assert serialize_uint8_max() == "255"
    assert serialize_int16_min() == "-32768"
    assert serialize_uint32_max() == "4294967295"
    assert serialize_uint64_runtime_max() == "18446744073709551615"
    assert serialize_float32() == "2.5"
    assert serialize_sized_bundle() == "{{\"small\":-5,\"medium\":65535,\"count\":4294967295,\"serial\":18446744073709551615,\"ratio\":2.5,\"values\":[1,255],\"metrics\":{{\"max\":65535}},\"maybe\":-8,\"outcome\":{{\"ok\":9}}}}"

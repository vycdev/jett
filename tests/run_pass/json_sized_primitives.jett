namespace test

function parse_int8_min_text() returns string:
    int8 value = json.parse[int8]("-128") handle error:
        return error
    return "{value}"

function parse_int16_min_text() returns string:
    int16 value = json.parse[int16]("-32768") handle error:
        return error
    return "{value}"

function parse_int32_max_text() returns string:
    int32 value = json.parse[int32]("2147483647") handle error:
        return error
    return "{value}"

function parse_uint8_max_text() returns string:
    uint8 value = json.parse[uint8]("255") handle error:
        return error
    return "{value}"

function parse_uint16_max_text() returns string:
    uint16 value = json.parse[uint16]("65535") handle error:
        return error
    return "{value}"

function parse_uint32_max_text() returns string:
    uint32 value = json.parse[uint32]("4294967295") handle error:
        return error
    return "{value}"

function parse_uint64_runtime_max_text() returns string:
    uint64 value = json.parse[uint64]("9223372036854775807") handle error:
        return error
    return "{value}"

function parse_float32_text() returns string:
    float32 value = json.parse[float32]("2.5") handle error:
        return error
    return "{value}"

function parse_int8_range_error() returns string:
    int8 value = json.parse[int8]("128") handle error:
        return error
    return "{value}"

function parse_uint8_range_error() returns string:
    uint8 value = json.parse[uint8]("-1") handle error:
        return error
    return "{value}"

function parse_uint32_range_error() returns string:
    uint32 value = json.parse[uint32]("4294967296") handle error:
        return error
    return "{value}"

function serialize_uint8_max() returns string:
    uint8 value = 255
    return json.serialize[uint8](value)

function serialize_int16_min() returns string:
    int16 value = -32768
    return json.serialize[int16](value)

function serialize_uint32_max() returns string:
    uint32 value = 4294967295
    return json.serialize[uint32](value)

function serialize_uint64_runtime_max() returns string:
    uint64 value = 9223372036854775807
    return json.serialize[uint64](value)

function serialize_float32() returns string:
    float32 value = 2.5
    return json.serialize[float32](value)

verify json_sized_primitives:
    assert parse_int8_min_text() == "-128"
    assert parse_int16_min_text() == "-32768"
    assert parse_int32_max_text() == "2147483647"
    assert parse_uint8_max_text() == "255"
    assert parse_uint16_max_text() == "65535"
    assert parse_uint32_max_text() == "4294967295"
    assert parse_uint64_runtime_max_text() == "9223372036854775807"
    assert parse_float32_text() == "2.5"
    assert parse_int8_range_error() == "expected int8 in range -128..127"
    assert parse_uint8_range_error() == "expected uint8 in range 0..255"
    assert parse_uint32_range_error() == "expected uint32 in range 0..4294967295"
    assert serialize_uint8_max() == "255"
    assert serialize_int16_min() == "-32768"
    assert serialize_uint32_max() == "4294967295"
    assert serialize_uint64_runtime_max() == "9223372036854775807"
    assert serialize_float32() == "2.5"

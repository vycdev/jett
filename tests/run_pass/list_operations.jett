namespace test

function sort_length_test() returns int64:
    list[int64] nums = list(3, 1, 4, 1, 5, 9, 2, 6, 5, 3)
    return list.length(list.sort(nums))

verify sort_length_test:
    assert sort_length_test() == 10

function sort_first_test() returns int64:
    list[int64] sorted = list.sort(list(3, 1, 4, 1, 5, 9, 2, 6, 5, 3))
    return list.first[int64](sorted) handle:
        default 0

verify sort_first_test:
    assert sort_first_test() == 1

function sort_last_test() returns int64:
    list[int64] sorted = list.sort(list(3, 1, 4, 1, 5, 9, 2, 6, 5, 3))
    return list.last[int64](sorted) handle:
        default 0

verify sort_last_test:
    assert sort_last_test() == 9

function unique_length_test() returns int64:
    list[int64] nums = list(3, 1, 4, 1, 5, 9, 2, 6, 5, 3)
    return list.length(list.unique(list.sort(nums)))

verify unique_length_test:
    assert unique_length_test() == 7

function take_length_test() returns int64:
    list[int64] sorted = list.sort(list(3, 1, 4, 1, 5, 9, 2, 6, 5, 3))
    return list.length(list.take(sorted, 3))

verify take_length_test:
    assert take_length_test() == 3

function skip_length_test() returns int64:
    list[int64] sorted = list.sort(list(3, 1, 4, 1, 5, 9, 2, 6, 5, 3))
    return list.length(list.skip(sorted, 7))

verify skip_length_test:
    assert skip_length_test() == 3

function reverse_first_test() returns int64:
    list[int64] rev = list.reverse(list(1, 2, 3))
    return list.first[int64](rev) handle:
        default 0

verify reverse_first_test:
    assert reverse_first_test() == 3

function reverse_last_test() returns int64:
    list[int64] rev = list.reverse(list(1, 2, 3))
    return list.last[int64](rev) handle:
        default 0

verify reverse_last_test:
    assert reverse_last_test() == 1

function concat_length_test() returns int64:
    return list.length(list.concat(list(1, 2, 3), list(4, 5, 6)))

verify concat_length_test:
    assert concat_length_test() == 6

function contains_true_test() returns bool:
    return list.contains(list.concat(list(1, 2, 3), list(4, 5, 6)), 4)

verify contains_true_test:
    assert contains_true_test() == true

function contains_false_test() returns bool:
    return list.contains(list.concat(list(1, 2, 3), list(4, 5, 6)), 99)

verify contains_false_test:
    assert contains_false_test() == false

function is_empty_true_test() returns bool:
    return list.is_empty(list())

verify is_empty_true_test:
    assert is_empty_true_test() == true

function is_empty_false_test() returns bool:
    return list.is_empty(list(1))

verify is_empty_false_test:
    assert is_empty_false_test() == false

function empty_literal_assignment_test() returns int64:
    list[int64] nums = list()
    return list.length(nums)

verify empty_literal_assignment_test:
    assert empty_literal_assignment_test() == 0

function empty_literal_argument_test() returns int64:
    return list.get[int64](list(), 0) handle:
        default 7

verify empty_literal_argument_test:
    assert empty_literal_argument_test() == 7

function negative_get_test() returns int64:
    list[int64] nums = list(10, 20)
    return list.get[int64](nums, -1) handle:
        default 7

verify negative_get_test:
    assert negative_get_test() == 7

namespace test
function alias_facade_root() returns json.JsonValue:
    return json.parse_raw("{{\"name\":\"Ada\",\"scores\":[3,5],\"active\":true,\"ratio\":2.5,\"serial\":18446744073709551615,\"missing\":null}}") handle error:
        default json.JsonTree.string_value(error)
function alias_facade_root_summary() returns string:
    json.JsonValue root = alias_facade_root()
    list[string] keys = json.object_keys(view root) handle error:
        return error
    string encoded = json.serialize_raw(view root)
    bool mentions_name = string.contains(encoded, "Ada")
    bool mentions_serial = string.contains(encoded, "18446744073709551615")
    return "{json.kind(view root)}:{json.is_object(view root)}:{list.length[string](view keys)}:{mentions_name}:{mentions_serial}"
function alias_facade_scalar_summary() returns string:
    json.JsonValue root = alias_facade_root()
    json.JsonValue name = json.require_field(view root, "name") handle error:
        return error
    json.JsonValue active = json.require_field(view root, "active") handle error:
        return error
    json.JsonValue ratio = json.require_field(view root, "ratio") handle error:
        return error
    json.JsonValue serial = json.require_field(view root, "serial") handle error:
        return error
    string name_text = json.as_string(view name) handle error:
        return error
    bool active_value = json.as_bool(view active) handle error:
        return error
    float64 ratio_value = json.as_float64(view ratio) handle error:
        return error
    uint64 serial_value = json.as_uint64(view serial) handle error:
        default 0
    return "{name_text}:{json.is_string(view name)}:{active_value}:{json.is_bool(view active)}:{ratio_value}:{json.is_number(view serial)}:{string.from_uint64(serial_value)}"
function alias_facade_array_summary() returns string:
    json.JsonValue root = alias_facade_root()
    json.JsonValue scores = json.require_field(view root, "scores") handle error:
        return error
    int64 count = json.array_length(view scores) handle error:
        return error
    json.JsonValue second = json.require_index(view scores, 1) handle error:
        return error
    int64 second_value = json.as_int64(view second) handle error:
        default -1
    return "{json.is_array(view scores)}:{count}:{second_value}"
function alias_facade_optional_summary() returns string:
    json.JsonValue root = alias_facade_root()
    optional[json.JsonValue] missing_field = json.object_field(view root, "absent") handle error:
        return error
    json.JsonValue missing_value = missing_field handle:
        default json.JsonTree.string_value("absent")
    json.JsonValue null_value = json.require_field(view root, "missing") handle error:
        return error
    string missing_text = json.as_string(view missing_value) handle error:
        return error
    return "{missing_text}:{json.is_null(view null_value)}"
verify json_raw_alias_facade_surface:
    assert alias_facade_root_summary() == "object:true:6:true:true"
    assert alias_facade_scalar_summary() == "Ada:true:true:true:2.5:true:18446744073709551615"
    assert alias_facade_array_summary() == "true:2:5"
    assert alias_facade_optional_summary() == "absent:true"

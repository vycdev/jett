namespace test
function missing_key_and_present_null() returns string:
    json.JsonTree root = json.parse_raw("{{\"present\":null}}") handle error:
        return error
    json.JsonTree missing = json.field(view root, "missing") handle:
        json.JsonTree present = json.field(view root, "present") handle:
            return "present missing"
        return "missing absent:present null {json.is_null(view present)}"
    return "missing present:{json.kind(view missing)}"
function index_out_of_bounds_is_absent() returns string:
    json.JsonTree values = json.parse_raw("[1,2]") handle error:
        return error
    json.JsonTree item = json.index(view values, 9) handle:
        return "absent"
    return "present:{json.kind(view item)}"
function negative_index_is_absent() returns string:
    json.JsonTree values = json.parse_raw("[1,2]") handle error:
        return error
    json.JsonTree item = json.index(view values, -1) handle:
        return "absent"
    return "present:{json.kind(view item)}"
function field_on_non_object_is_absent() returns string:
    json.JsonTree text = json.parse_raw("\"Ada\"") handle error:
        return error
    json.JsonTree field = json.field(view text, "name") handle:
        return "absent"
    return "present:{json.kind(view field)}"
function field_on_array_is_absent() returns string:
    json.JsonTree values = json.parse_raw("[1,2]") handle error:
        return error
    json.JsonTree field = json.field(view values, "name") handle:
        return "absent"
    return "present:{json.kind(view field)}"
function index_on_non_array_is_absent() returns string:
    json.JsonTree text = json.parse_raw("\"Ada\"") handle error:
        return error
    json.JsonTree item = json.index(view text, 0) handle:
        return "absent"
    return "present:{json.kind(view item)}"
function index_on_object_is_absent() returns string:
    json.JsonTree root = json.parse_raw("{{\"name\":\"Ada\"}}") handle error:
        return error
    json.JsonTree item = json.index(view root, 0) handle:
        return "absent"
    return "present:{json.kind(view item)}"
function object_keys_wrong_shape_error() returns string:
    json.JsonTree text = json.parse_raw("\"Ada\"") handle error:
        return error
    list[string] keys = json.object_keys(view text) handle error:
        return error
    return "{list.length(keys)}"
function array_length_wrong_shape_error() returns string:
    json.JsonTree root = json.parse_raw("{{\"name\":\"Ada\"}}") handle error:
        return error
    int64 length = json.array_length(view root) handle error:
        return error
    return "{length}"
function string_scalar_cast_wrong_shape_error() returns string:
    json.JsonTree number = json.parse_raw("42") handle error:
        return error
    string value = json.as_string(view number) handle error:
        return error
    return value
function int64_scalar_cast_wrong_shape_error() returns string:
    json.JsonTree text = json.parse_raw("\"Ada\"") handle error:
        return error
    int64 value = json.as_int64(view text) handle error:
        return error
    return "{value}"
function uint64_scalar_cast_wrong_shape_error() returns string:
    json.JsonTree text = json.parse_raw("\"Ada\"") handle error:
        return error
    uint64 value = json.as_uint64(view text) handle error:
        return error
    return string.from_uint64(value)
function float64_scalar_cast_wrong_shape_error() returns string:
    json.JsonTree text = json.parse_raw("\"Ada\"") handle error:
        return error
    float64 value = json.as_float64(view text) handle error:
        return error
    return "{value}"
function bool_scalar_cast_wrong_shape_error() returns string:
    json.JsonTree number = json.parse_raw("1") handle error:
        return error
    bool value = json.as_bool(view number) handle error:
        return error
    return "{value}"
function int64_scalar_cast_fraction_error() returns string:
    json.JsonTree number = json.parse_raw("2.5") handle error:
        return error
    int64 value = json.as_int64(view number) handle error:
        return error
    return "{value}"
function int64_scalar_cast_exponent_error() returns string:
    json.JsonTree number = json.parse_raw("1e0") handle error:
        return error
    int64 value = json.as_int64(view number) handle error:
        return error
    return "{value}"
function int64_scalar_cast_min() returns string:
    json.JsonTree number = json.parse_raw("-9223372036854775808") handle error:
        return error
    int64 value = json.as_int64(view number) handle error:
        return error
    return "{value}"
function int64_scalar_cast_max() returns string:
    json.JsonTree number = json.parse_raw("9223372036854775807") handle error:
        return error
    int64 value = json.as_int64(view number) handle error:
        return error
    return "{value}"
function int64_scalar_cast_underflow_error() returns string:
    json.JsonTree number = json.parse_raw("-9223372036854775809") handle error:
        return error
    int64 value = json.as_int64(view number) handle error:
        return error
    return "{value}"
function int64_scalar_cast_overflow_error() returns string:
    json.JsonTree number = json.parse_raw("9223372036854775808") handle error:
        return error
    int64 value = json.as_int64(view number) handle error:
        return error
    return "{value}"
function uint64_scalar_cast_negative_error() returns string:
    json.JsonTree number = json.parse_raw("-1") handle error:
        return error
    uint64 value = json.as_uint64(view number) handle error:
        return error
    return string.from_uint64(value)
function int64_scalar_cast_negative_zero() returns string:
    json.JsonTree number = json.parse_raw("-0") handle error:
        return error
    int64 value = json.as_int64(view number) handle error:
        return error
    return "{value}"
function float64_scalar_cast_exponent() returns bool:
    json.JsonTree number = json.parse_raw("1E+0") handle error:
        return false
    float64 value = json.as_float64(view number) handle error:
        return false
    return value == 1.0
verify json_raw_value_access_edges:
    assert missing_key_and_present_null() == "missing absent:present null true"
    assert index_out_of_bounds_is_absent() == "absent"
    assert negative_index_is_absent() == "absent"
    assert field_on_non_object_is_absent() == "absent"
    assert field_on_array_is_absent() == "absent"
    assert index_on_non_array_is_absent() == "absent"
    assert index_on_object_is_absent() == "absent"
    assert object_keys_wrong_shape_error() == "expected object, got string"
    assert array_length_wrong_shape_error() == "expected array, got object"
    assert string_scalar_cast_wrong_shape_error() == "expected string, got number"
    assert int64_scalar_cast_wrong_shape_error() == "expected int64, got string"
    assert uint64_scalar_cast_wrong_shape_error() == "expected uint64, got string"
    assert float64_scalar_cast_wrong_shape_error() == "expected float64, got string"
    assert bool_scalar_cast_wrong_shape_error() == "expected bool, got number"
    assert int64_scalar_cast_fraction_error() == "expected int64, got number"
    assert int64_scalar_cast_exponent_error() == "expected int64, got number"
    assert int64_scalar_cast_min() == "-9223372036854775808"
    assert int64_scalar_cast_max() == "9223372036854775807"
    assert int64_scalar_cast_underflow_error() == "expected int64 in range -9223372036854775808..9223372036854775807"
    assert int64_scalar_cast_overflow_error() == "expected int64 in range -9223372036854775808..9223372036854775807"
    assert uint64_scalar_cast_negative_error() == "expected uint64 in range 0..18446744073709551615"
    assert int64_scalar_cast_negative_zero() == "0"
    assert float64_scalar_cast_exponent() == true

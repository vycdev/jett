namespace outer.models
export struct User:
    id: string
    visits: list[int64]
export struct Box[T]:
    value: T
export enum Color:
    blue
    rgb(red: int64, green: int64, blue: int64)
export function double(value: int64) returns int64:
    return value * 2
namespace app
function dotted_namespace_summary() returns string:
    use outer.models
    models.User user = models.User(id: "u1", visits: list(2, 3))
    models.Box[models.User] box = models.Box[models.User](value: user)
    models.Color color = models.Color.blue
    models.Color rich = models.Color.rgb(1, 2, 3)
    string raw = json.serialize[models.User](view box.value)
    models.User decoded = json.parse[models.User](raw) handle error:
        return error
    return "{decoded.id}:{list.length[int64](decoded.visits)}:{models.double(21)}:{color == models.Color.blue}:{rich == models.Color.rgb(1, 2, 3)}:{type.name[models.User]()}:{type.name[models.Box[models.User]]()}"
verify namespace_dotted_qualified_types:
    assert dotted_namespace_summary() == "u1:2:42:true:true:outer.models.User:outer.models.Box[outer.models.User]"

namespace app

# --- Closure captures an immutable value from enclosing scope ---

function make_adder(n: int64) returns function(int64) returns int64:
    return function(x: int64) returns int64: return x + n

function test_make_adder() returns int64:
    function(int64) returns int64 add5 = make_adder(5)
    return add5(10)

verify test_make_adder:
    assert test_make_adder() == 15

# --- Closure captures multiple values ---

function make_linear(a: int64, b: int64) returns function(int64) returns int64:
    return function(x: int64) returns int64: return a * x + b

function test_linear() returns int64:
    function(int64) returns int64 f = make_linear(3, 7)
    return f(10)

verify test_linear:
    assert test_linear() == 37

# --- Closure used with higher-order list builtins (captures threshold) ---

function count_above(items: list[int64], threshold: int64) returns int64:
    return list.length[int64](list.filter[int64](items, function(x: int64) returns bool: return x > threshold))

function test_count_above() returns int64:
    return count_above(list(1, 5, 3, 8, 2, 9), 4)

verify test_count_above:
    assert test_count_above() == 3

# --- Nested closures ---

function make_adder_chain(a: int64) returns function(int64) returns function(int64) returns int64:
    return function(b: int64) returns function(int64) returns int64:
        int64 sum = a + b
        return function(c: int64) returns int64: return sum + c

function test_nested_closures() returns int64:
    function(int64) returns function(int64) returns int64 step1 = make_adder_chain(10)
    function(int64) returns int64 step2 = step1(20)
    return step2(5)

verify test_nested_closures:
    assert test_nested_closures() == 35

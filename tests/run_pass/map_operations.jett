namespace test

function map_has_true_test() returns bool:
    map[string, int64] scores = map("alice": 10, "bob": 20, "carol": 30)
    return map.has(scores, "alice")

verify map_has_true_test:
    assert map_has_true_test() == true

function map_has_false_test() returns bool:
    map[string, int64] scores = map("alice": 10, "bob": 20, "carol": 30)
    return map.has(scores, "dave")

verify map_has_false_test:
    assert map_has_false_test() == false

function map_length_test() returns int64:
    map[string, int64] scores = map("alice": 10, "bob": 20, "carol": 30)
    return map.length(scores)

verify map_length_test:
    assert map_length_test() == 3

function map_get_found_test() returns int64:
    map[string, int64] scores = map("alice": 10, "bob": 20, "carol": 30)
    optional[int64] v = map.get(scores, "alice")
    return v handle:
        default 0

verify map_get_found_test:
    assert map_get_found_test() == 10

function map_get_missing_test() returns int64:
    map[string, int64] scores = map("alice": 10, "bob": 20, "carol": 30)
    optional[int64] v = map.get(scores, "dave")
    return v handle:
        default 0

verify map_get_missing_test:
    assert map_get_missing_test() == 0

function map_insert_has_test() returns bool:
    map[string, int64] scores = map("alice": 10, "bob": 20, "carol": 30)
    map[string, int64] updated = map.insert(scores, "dave", 40)
    return map.has(updated, "dave")

verify map_insert_has_test:
    assert map_insert_has_test() == true

function map_insert_length_test() returns int64:
    map[string, int64] scores = map("alice": 10, "bob": 20, "carol": 30)
    map[string, int64] updated = map.insert(scores, "dave", 40)
    return map.length(updated)

verify map_insert_length_test:
    assert map_insert_length_test() == 4

function map_remove_test() returns bool:
    map[string, int64] scores = map("alice": 10, "bob": 20, "carol": 30)
    map[string, int64] updated = map.insert(scores, "dave", 40)
    map[string, int64] removed = map.remove(updated, "bob")
    return map.has(removed, "bob")

verify map_remove_test:
    assert map_remove_test() == false

function map_keys_length_test() returns int64:
    map[string, int64] scores = map("alice": 10, "bob": 20, "carol": 30)
    list[string] keys = map.keys(scores)
    return list.length(keys)

verify map_keys_length_test:
    assert map_keys_length_test() == 3

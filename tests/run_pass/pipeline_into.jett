namespace app

struct PipelineUser:
    name: string

function plus_one(value: int64) returns int64:
    return value + 1

function add(value: int64, amount: int64) returns int64:
    return value + amount

function passthrough[T](value: T) returns T:
    return value

function pipeline_single_line_test() returns string:
    return "  Hello  " into string.trim into string.lower

verify pipeline_single_line_test:
    assert pipeline_single_line_test() == "hello"

function pipeline_multi_line_test() returns string:
    return "  Hello World  "
        into string.trim
        into string.lower

verify pipeline_multi_line_test:
    assert pipeline_multi_line_test() == "hello world"

function pipeline_replace_test() returns string:
    return "hello world"
        into string.replace("world", "jett")

verify pipeline_replace_test:
    assert pipeline_replace_test() == "hello jett"

function pipeline_multi_step_test() returns string:
    return "  HELLO WORLD  "
        into string.trim
        into string.lower
        into string.replace("world", "jett")

verify pipeline_multi_step_test:
    assert pipeline_multi_step_test() == "hello jett"

function pipeline_builtin_result_type_test() returns int64:
    return "  hello  " into string.trim into string.length

verify pipeline_builtin_result_type_test:
    assert pipeline_builtin_result_type_test() == 5

function pipeline_user_function_test() returns int64:
    return 41 into plus_one

verify pipeline_user_function_test:
    assert pipeline_user_function_test() == 42

function pipeline_user_function_extra_arg_test() returns int64:
    return 40 into add(2)

verify pipeline_user_function_extra_arg_test:
    assert pipeline_user_function_extra_arg_test() == 42

function pipeline_math_abs_int_test() returns int64:
    return -5 into math.abs

function pipeline_math_min_int_test() returns int64:
    return 7 into math.min(3)

function pipeline_math_max_float_test() returns float64:
    return 3.0 into math.max(7.0)

function pipeline_generic_builtin_type_arg_test() returns int64:
    list[int64] values = list(1, 2, 3)
    return values into list.length[int64]()

function pipeline_view_json_serialize_test() returns string:
    PipelineUser user = PipelineUser(name: "Ada")
    return user into view json.serialize[PipelineUser]()

function pipeline_generic_user_function_test() returns string:
    return "agent" into passthrough[string]()

function pipeline_handle_result_default_test() returns int64:
    return "oops"
        into int64.from_string() handle error:
            default 41
        into plus_one

function pipeline_handle_optional_default_test() returns string:
    list[string] values = list()
    return values
        into list.first[string]() handle:
            default "empty"
        into string.upper

function pipeline_handle_result_return_test(raw: string) returns result[int64, string]:
    int64 value = raw
        into int64.from_string() handle error:
            return fail("bad parse")
        into plus_one
    return ok(value)

function pipeline_handle_result_return_summary() returns string:
    result[int64, string] failed = pipeline_handle_result_return_test("not an int")
    int64 fallback = failed handle error:
        default -1
    result[int64, string] parsed = pipeline_handle_result_return_test("41")
    int64 value = parsed handle error:
        default -1
    return "{fallback}:{value}"

verify pipeline_math_numeric_intrinsic_test:
    assert pipeline_math_abs_int_test() == 5
    assert pipeline_math_min_int_test() == 3
    assert pipeline_math_max_float_test() == 7.0
    assert pipeline_generic_builtin_type_arg_test() == 3
    assert pipeline_view_json_serialize_test() == "{{\"name\":\"Ada\"}}"
    assert pipeline_generic_user_function_test() == "agent"
    assert pipeline_handle_result_default_test() == 42
    assert pipeline_handle_optional_default_test() == "EMPTY"
    assert pipeline_handle_result_return_summary() == "-1:42"

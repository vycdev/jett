namespace test
enum Direction:
    north
    south
struct Profile:
    display_name: string serialize "displayName"
    note: string
enum Shape:
    circle(radius: float64)
    profile(profile: Profile)
    raw(payload: json.JsonTree)
    empty
enum Protocol:
    tcp = 6
    udp = 17
bitfield Header:
    version: 4 bits
    protocol: 8 bits as Protocol
bitfield WideHeader:
    sequence: 64 bits
bitfield Packet:
    kind: 8 bits
    payload: list[uint8]
function parse_exact_unit_enum_success() returns bool:
    Direction direction = json.parse_exact[Direction]("\"north\"") handle error:
        return false
    return direction == Direction.north
function parse_exact_unit_enum_empty_payload_object_success() returns bool:
    Shape shape = json.parse_exact[Shape]("{{\"empty\":[]}}") handle error:
        return false
    return shape == Shape.empty
function parse_exact_unit_enum_unknown_error() returns string:
    Direction direction = json.parse_exact[Direction]("\"east\"") handle error:
        return error
    return "{direction == Direction.north}"
function parse_exact_payload_enum_string_error() returns string:
    Shape shape = json.parse_exact[Shape]("\"circle\"") handle error:
        return error
    return json.serialize[Shape](view shape)
function parse_exact_enum_object_multiple_keys_error() returns string:
    Shape shape = json.parse_exact[Shape]("{{\"circle\":[2.5],\"empty\":[]}}") handle error:
        return error
    return json.serialize[Shape](view shape)
function parse_exact_enum_non_object_error() returns string:
    Shape shape = json.parse_exact[Shape]("true") handle error:
        return error
    return json.serialize[Shape](view shape)
function parse_exact_enum_payload_not_array_error() returns string:
    Shape shape = json.parse_exact[Shape]("{{\"circle\":2.5}}") handle error:
        return error
    return json.serialize[Shape](view shape)
function parse_exact_enum_payload_arity_error() returns string:
    Shape shape = json.parse_exact[Shape]("{{\"circle\":[]}}") handle error:
        return error
    return json.serialize[Shape](view shape)
function parse_exact_enum_payload_nested_extra_error() returns string:
    string raw = "{{\"profile\":[{{\"displayName\":\"Ada\",\"note\":\"ok\",\"extra\":true}}]}}"
    Shape shape = json.parse_exact[Shape](raw) handle error:
        return error
    return json.serialize[Shape](view shape)
function parse_exact_enum_raw_payload_keeps_extras() returns string:
    Shape shape = json.parse_exact[Shape]("{{\"raw\":[{{\"extra\":\"kept\"}}]}}") handle error:
        return error
    match shape:
        raw(payload):
            json.JsonTree extra = json.require_field(view payload, "extra") handle error:
                return error
            return json.as_string(view extra) handle error:
                default error
        circle(radius):
            return "{radius}"
        profile(profile):
            return profile.display_name
        empty:
            return "empty"
function parse_exact_bitfield_success() returns string:
    Header header = json.parse_exact[Header]("{{\"version\":4,\"protocol\":\"tcp\"}}") handle error:
        return error
    bool tcp = header.protocol == Protocol.tcp
    return "{header.version}:{tcp}"
function parse_exact_bitfield_enum_numeric_shape_error() returns string:
    Header header = json.parse_exact[Header]("{{\"version\":4,\"protocol\":6}}") handle error:
        return error
    return "{header.version}"
function parse_exact_wide_bitfield_success() returns string:
    WideHeader header = json.parse_exact[WideHeader]("{{\"sequence\":18446744073709551615}}") handle error:
        return error
    return string.from_uint64(header.sequence)
function parse_exact_wide_bitfield_extra_error() returns string:
    WideHeader header = json.parse_exact[WideHeader]("{{\"sequence\":18446744073709551615,\"extra\":1}}") handle error:
        return error
    return string.from_uint64(header.sequence)
function parse_exact_payload_bitfield_success() returns string:
    Packet packet = json.parse_exact[Packet]("{{\"kind\":42,\"payload\":[1,127,255]}}") handle error:
        return error
    uint8 first = list.get[uint8](view packet.payload, 0) handle:
        default 0
    uint8 third = list.get[uint8](view packet.payload, 2) handle:
        default 0
    return "{packet.kind}:{first}:{third}:{list.length[uint8](view packet.payload)}"
function parse_exact_payload_bitfield_extra_error() returns string:
    Packet packet = json.parse_exact[Packet]("{{\"kind\":42,\"payload\":[1],\"extra\":true}}") handle error:
        return error
    return "{packet.kind}"
function parse_exact_payload_bitfield_item_range_error() returns string:
    Packet packet = json.parse_exact[Packet]("{{\"kind\":42,\"payload\":[256]}}") handle error:
        return error
    return "{packet.kind}"
function serialize_top_level_unit_enum() returns string:
    Direction direction = Direction.north
    return json.serialize[Direction](view direction)
function serialize_top_level_payload_enum() returns string:
    Shape shape = Shape.circle(2.5)
    return json.serialize[Shape](view shape)
function serialize_top_level_bitfield() returns string:
    Header header = Header(version: 4, protocol: Protocol.tcp)
    return json.serialize[Header](view header)
function serialize_top_level_wide_bitfield() returns string:
    WideHeader header = WideHeader(sequence: 18446744073709551615)
    return json.serialize[WideHeader](view header)
function serialize_top_level_payload_bitfield() returns string:
    Packet packet = json.parse[Packet]("{{\"kind\":42,\"payload\":[1,127,255]}}") handle error:
        return error
    return json.serialize[Packet](view packet)
verify json_enum_bitfield_exact_edges:
    assert parse_exact_unit_enum_success() == true
    assert parse_exact_unit_enum_empty_payload_object_success() == true
    assert parse_exact_unit_enum_unknown_error() == "unknown enum variant 'test.Direction.east'"
    assert parse_exact_payload_enum_string_error() == "enum variant 'test.Shape.circle' expects 1 payload field(s)"
    assert parse_exact_enum_object_multiple_keys_error() == "expected enum object with exactly one variant key"
    assert parse_exact_enum_non_object_error() == "expected enum string or object, got bool"
    assert parse_exact_enum_payload_not_array_error() == "expected array payload for enum variant 'test.Shape.circle', got number"
    assert parse_exact_enum_payload_arity_error() == "enum variant 'test.Shape.circle' expects 1 payload field(s), got 0"
    assert parse_exact_enum_payload_nested_extra_error() == "profile.profile: unknown field 'extra' for test.Profile"
    assert parse_exact_enum_raw_payload_keeps_extras() == "kept"
    assert parse_exact_bitfield_success() == "4:true"
    assert parse_exact_bitfield_enum_numeric_shape_error() == "protocol: expected enum string or object, got number"
    assert parse_exact_wide_bitfield_success() == "18446744073709551615"
    assert parse_exact_wide_bitfield_extra_error() == "unknown field 'extra' for test.WideHeader"
    assert parse_exact_payload_bitfield_success() == "42:1:255:3"
    assert parse_exact_payload_bitfield_extra_error() == "unknown field 'extra' for test.Packet"
    assert parse_exact_payload_bitfield_item_range_error() == "payload: 0: expected uint8 in range 0..255"
    assert serialize_top_level_unit_enum() == "\"north\""
    assert serialize_top_level_payload_enum() == "{{\"circle\":[2.5]}}"
    assert serialize_top_level_bitfield() == "{{\"version\":4,\"protocol\":\"tcp\"}}"
    assert serialize_top_level_wide_bitfield() == "{{\"sequence\":18446744073709551615}}"
    assert serialize_top_level_payload_bitfield() == "{{\"kind\":42,\"payload\":[1,127,255]}}"

namespace test

enum Direction:
    north
    south

enum Shape:
    circle(radius: float64)
    rect(width: float64, height: float64)

enum OtherShape:
    circle(radius: float64)
    rect(width: float64, height: float64)

function shape_area(shape: Shape) returns float64:
    match shape:
        circle(radius):
            return radius
        rect(width, height):
            return width * height

function construct_unit_variant() returns bool:
    for variant in type.variants[Direction]():
        if variant.name == "south":
            TypeConstruction builder = type.construct_variant_start[Direction](view variant) handle error:
                return false
            Direction built = type.construct_finish[Direction](builder) handle error:
                return false
            return built == Direction.south
    return false

function construct_payload_variant_area() returns float64:
    for variant in type.variants[Shape]():
        if variant.name != "rect":
            continue
        mutable TypeConstruction builder = type.construct_variant_start[Shape](view variant) handle error:
            return -1.0
        for field in variant.fields:
            comptime type Field = field.type_info:
                mutable Field value = 0.0
                if field.name == "width":
                    value = 3.0
                if field.name == "height":
                    value = 4.0
                builder = type.construct_put[Shape, Field](builder, view field, value) handle error:
                    return -2.0
        Shape built = type.construct_finish[Shape](builder) handle error:
            return -3.0
        return shape_area(built)
    return -4.0

function missing_payload_message() returns string:
    for variant in type.variants[Shape]():
        if variant.name != "rect":
            continue
        mutable TypeConstruction builder = type.construct_variant_start[Shape](view variant) handle error:
            return error
        for field in variant.fields:
            if field.name != "width":
                continue
            comptime type Field = field.type_info:
                Field value = 3.0
                builder = type.construct_put[Shape, Field](builder, view field, value) handle error:
                    return error
        Shape built = type.construct_finish[Shape](builder) handle error:
            return error
        return "unexpected success"
    return "missing variant"

function shape_variant_owner_type() returns string:
    TypeVariant variant = list.get[TypeVariant](type.variants[Shape](), 1) handle:
        return "missing variant"
    return variant.owner_type

function mismatched_variant_owner_message() returns string:
    TypeVariant variant = list.get[TypeVariant](type.variants[OtherShape](), 1) handle:
        return "missing variant"
    TypeConstruction builder = type.construct_variant_start[Shape](view variant) handle error:
        return error
    return "unexpected success"

function mismatched_variant_field_owner_message() returns string:
    TypeVariant variant = list.get[TypeVariant](type.variants[Shape](), 1) handle:
        return "missing variant"
    mutable TypeConstruction builder = type.construct_variant_start[Shape](view variant) handle error:
        return error
    TypeVariant other_variant = list.get[TypeVariant](type.variants[OtherShape](), 1) handle:
        return "missing other variant"
    TypeField field = list.get[TypeField](other_variant.fields, 0) handle:
        return "missing other field"
    builder = type.construct_put[Shape, float64](builder, view field, 3.0) handle error:
        return error
    return "unexpected success"

function mismatched_variant_field_member_message() returns string:
    TypeVariant variant = list.get[TypeVariant](type.variants[Shape](), 1) handle:
        return "missing variant"
    mutable TypeConstruction builder = type.construct_variant_start[Shape](view variant) handle error:
        return error
    TypeVariant other_variant = list.get[TypeVariant](type.variants[Shape](), 0) handle:
        return "missing other variant"
    TypeField field = list.get[TypeField](other_variant.fields, 0) handle:
        return "missing other field"
    builder = type.construct_put[Shape, float64](builder, view field, 3.0) handle error:
        return error
    return "unexpected success"

verify type_construction_enum:
    assert construct_unit_variant() == true
    assert construct_payload_variant_area() == 12.0
    assert string.contains(missing_payload_message(), "missing required payload field 'height'") == true
    assert shape_variant_owner_type() == "test.Shape"
    assert string.contains(mismatched_variant_owner_message(), "belongs to 'test.OtherShape', expected 'test.Shape'") == true
    assert string.contains(mismatched_variant_field_owner_message(), "belongs to 'test.OtherShape.rect', expected 'test.Shape.rect'") == true
    assert string.contains(mismatched_variant_field_member_message(), "belongs to 'test.Shape.circle', expected 'test.Shape.rect'") == true

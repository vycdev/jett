namespace test
struct RawReflectionHolder:
    bare: JsonValue
    alias: json.JsonValue
    tree: json.JsonTree
    bare_list: list[JsonValue]
    alias_list: list[json.JsonValue]
function holder_field_name_at(field_index: int64) returns string:
    list[TypeField] fields = type.fields[RawReflectionHolder]()
    TypeField field = list.get[TypeField](fields, field_index) handle:
        return "missing field"
    return field.name
function holder_field_kind_at(field_index: int64) returns string:
    list[TypeField] fields = type.fields[RawReflectionHolder]()
    TypeField field = list.get[TypeField](fields, field_index) handle:
        return "missing field"
    return field.type_info.kind
function holder_field_type_name_at(field_index: int64) returns string:
    list[TypeField] fields = type.fields[RawReflectionHolder]()
    TypeField field = list.get[TypeField](fields, field_index) handle:
        return "missing field"
    return field.type_info.type_name
function holder_field_primitive_is_at(field_index: int64, expected: TypePrimitive) returns bool:
    list[TypeField] fields = type.fields[RawReflectionHolder]()
    TypeField field = list.get[TypeField](fields, field_index) handle:
        return false
    TypePrimitive primitive = field.type_info.primitive_tag handle:
        return false
    return primitive == expected
function holder_field_arg_count_at(field_index: int64) returns int64:
    list[TypeField] fields = type.fields[RawReflectionHolder]()
    TypeField field = list.get[TypeField](fields, field_index) handle:
        return -1
    return list.length(field.type_info.args)
function holder_field_arg_kind_at(field_index: int64, target: int64) returns string:
    list[TypeField] fields = type.fields[RawReflectionHolder]()
    TypeField field = list.get[TypeField](fields, field_index) handle:
        return "missing field"
    TypeInfo arg = list.get[TypeInfo](field.type_info.args, target) handle:
        return "missing arg"
    return arg.kind
function holder_field_arg_type_name_at(field_index: int64, target: int64) returns string:
    list[TypeField] fields = type.fields[RawReflectionHolder]()
    TypeField field = list.get[TypeField](fields, field_index) handle:
        return "missing field"
    TypeInfo arg = list.get[TypeInfo](field.type_info.args, target) handle:
        return "missing arg"
    return arg.type_name
function holder_field_arg_primitive_is_at(field_index: int64, target: int64, expected: TypePrimitive) returns bool:
    list[TypeField] fields = type.fields[RawReflectionHolder]()
    TypeField field = list.get[TypeField](fields, field_index) handle:
        return false
    TypeInfo arg = list.get[TypeInfo](field.type_info.args, target) handle:
        return false
    TypePrimitive primitive = arg.primitive_tag handle:
        return false
    return primitive == expected
function holder_field_nested_arg_kind_at(field_index: int64, outer_target: int64, inner_target: int64) returns string:
    list[TypeField] fields = type.fields[RawReflectionHolder]()
    TypeField field = list.get[TypeField](fields, field_index) handle:
        return "missing field"
    TypeInfo outer = list.get[TypeInfo](field.type_info.args, outer_target) handle:
        return "missing outer"
    TypeInfo inner = list.get[TypeInfo](outer.args, inner_target) handle:
        return "missing inner"
    return inner.kind
function holder_field_nested_arg_type_name_at(field_index: int64, outer_target: int64, inner_target: int64) returns string:
    list[TypeField] fields = type.fields[RawReflectionHolder]()
    TypeField field = list.get[TypeField](fields, field_index) handle:
        return "missing field"
    TypeInfo outer = list.get[TypeInfo](field.type_info.args, outer_target) handle:
        return "missing outer"
    TypeInfo inner = list.get[TypeInfo](outer.args, inner_target) handle:
        return "missing inner"
    return inner.type_name
verify json_value_reflection_container_metadata:
    assert holder_field_name_at(0) == "bare"
    assert holder_field_kind_at(0) == "primitive"
    assert holder_field_type_name_at(0) == "JsonValue"
    assert holder_field_primitive_is_at(0, TypePrimitive.json_value_type) == true
    assert holder_field_name_at(1) == "alias"
    assert holder_field_kind_at(1) == "alias"
    assert holder_field_type_name_at(1) == "json.JsonValue"
    assert holder_field_arg_count_at(1) == 1
    assert holder_field_arg_kind_at(1, 0) == "enum"
    assert holder_field_arg_type_name_at(1, 0) == "json.JsonTree"
    assert holder_field_name_at(2) == "tree"
    assert holder_field_kind_at(2) == "enum"
    assert holder_field_type_name_at(2) == "json.JsonTree"
    assert holder_field_name_at(3) == "bare_list"
    assert holder_field_kind_at(3) == "list"
    assert holder_field_arg_count_at(3) == 1
    assert holder_field_arg_kind_at(3, 0) == "primitive"
    assert holder_field_arg_type_name_at(3, 0) == "JsonValue"
    assert holder_field_arg_primitive_is_at(3, 0, TypePrimitive.json_value_type) == true
    assert holder_field_name_at(4) == "alias_list"
    assert holder_field_kind_at(4) == "list"
    assert holder_field_arg_count_at(4) == 1
    assert holder_field_arg_kind_at(4, 0) == "alias"
    assert holder_field_arg_type_name_at(4, 0) == "json.JsonValue"
    assert holder_field_nested_arg_kind_at(4, 0, 0) == "enum"
    assert holder_field_nested_arg_type_name_at(4, 0, 0) == "json.JsonTree"

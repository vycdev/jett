namespace test

struct Box[T]:
    value: T

struct User:
    id: string
    age: int64

struct ListBox:
    values: list[int64]

type NameList = list[string]
type NonEmpty = string where string.char_count(value) > 0

function bound_type_name() returns string:
    string found = "missing"
    comptime type Bound = type.info[int64]():
        found = type.name[Bound]()
    return found

function bound_generic_field_kind() returns string:
    string found = "missing"
    comptime type Bound = type.info[Box[string]]():
        list[TypeField] fields = type.fields[Bound]()
        for field in fields:
            if field.name == "value":
                found = field.kind
    return found

function bound_generic_field_type_name() returns string:
    string found = "missing"
    comptime type Bound = type.info[Box[string]]():
        list[TypeField] fields = type.fields[Bound]()
        for field in fields:
            if field.name == "value":
                found = field.type_info.type_name
    return found

function bound_reflected_field_types_for[T](view value: T) returns string:
    list[string] parts = list.new[string]()
    for field in type.fields[T]():
        comptime type Field = field.type_info:
            Field field_value = type.field_value[T, Field](view value, view field)
            string type_name = type.name[Field]()
            parts = list.append[string](parts, "{field.name}:{type_name}")
    return string.join(parts, ";")

function bound_reflected_field_types() returns string:
    User user = User(id: "u1", age: 42)
    return bound_reflected_field_types_for[User](view user)

function bound_reflected_generic_field_type() returns string:
    Box[list[int64]] box = Box[list[int64]](value: list(1, 2, 3))
    string found = "missing"
    for field in type.fields[Box[list[int64]]]():
        comptime type Field = field.type_info:
            Field field_value = type.field_value[Box[list[int64]], Field](view box, view field)
            found = type.name[Field]()
    return found

function bound_direct_arg_type() returns string:
    string found = "missing"
    for arg in type.info[list[string]]().args:
        comptime type Arg = arg:
            found = type.name[Arg]()
    return found

function reflected_arg_type_info_name() returns string:
    TypeInfo info = type.arg[map[string, list[int64]]](1)
    return info.type_name

function bound_direct_type_arg() returns string:
    string found = "missing"
    comptime type Value = type.arg[map[string, list[int64]]](1):
        found = type.name[Value]()
    return found

function bound_alias_base_arg() returns string:
    string found = "missing"
    comptime type Base = type.arg[NameList](0):
        found = type.name[Base]()
    return found

function bound_refinement_base_arg() returns string:
    string found = "missing"
    comptime type Base = type.arg[NonEmpty](0):
        found = type.name[Base]()
    return found

function bound_nested_arg_type() returns string:
    string found = "missing"
    for outer in type.info[list[optional[string]]]().args:
        comptime type Outer = outer:
            for inner in outer.args:
                comptime type Inner = inner:
                    found = type.name[Inner]()
    return found

function bound_field_arg_type() returns string:
    ListBox box = ListBox(values: list(1, 2, 3))
    string found = "missing"
    for field in type.fields[ListBox]():
        for arg in field.type_info.args:
            comptime type Arg = arg:
                list[Arg] values = type.field_value[ListBox, list[Arg]](view box, view field)
                string type_name = type.name[Arg]()
                int64 length = list.length(values)
                found = "{type_name}:{length}"
    return found

verify comptime_type_bind:
    assert bound_type_name() == "int64"
    assert bound_generic_field_kind() == "primitive"
    assert bound_generic_field_type_name() == "string"
    assert bound_reflected_field_types() == "id:string;age:int64"
    assert bound_reflected_generic_field_type() == "list[int64]"
    assert bound_direct_arg_type() == "string"
    assert reflected_arg_type_info_name() == "list[int64]"
    assert bound_direct_type_arg() == "list[int64]"
    assert bound_alias_base_arg() == "list[string]"
    assert bound_refinement_base_arg() == "string"
    assert bound_nested_arg_type() == "string"
    assert bound_field_arg_type() == "int64:3"

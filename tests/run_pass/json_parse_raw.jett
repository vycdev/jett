namespace test

function raw_user_name(root: JsonValue) returns string:
    JsonValue user = json.field(root, "user") handle:
        return "missing user"
    JsonValue name_raw = json.field(user, "name") handle:
        return "missing name"
    return json.as_string(name_raw) handle error:
        default error

function raw_user_score_summary(root: JsonValue) returns string:
    JsonValue user = json.field(root, "user") handle:
        return "missing user"
    JsonValue scores = json.field(user, "scores") handle:
        return "missing scores"
    int64 score_count = json.array_length(scores) handle error:
        return error
    JsonValue second_score = json.index(scores, 1) handle:
        return "missing score"
    int64 score = json.as_int64(second_score) handle error:
        return error
    return "{score_count}:{score}"

function raw_user_active(root: JsonValue) returns bool:
    JsonValue user = json.field(root, "user") handle:
        return false
    JsonValue active_raw = json.field(user, "active") handle:
        return false
    return json.as_bool(active_raw) handle error:
        default false

function raw_user_missing_is_null(root: JsonValue) returns bool:
    JsonValue user = json.field(root, "user") handle:
        return false
    JsonValue missing_raw = json.field(user, "missing") handle:
        return false
    return json.is_null(missing_raw)

function raw_summary() returns string:
    JsonValue root = json.parse_raw("{{\"user\":{{\"name\":\"Ada\",\"scores\":[3,5],\"active\":true,\"missing\":null}},\"version\":1}}") handle error:
        return error
    string name = raw_user_name(root)
    string score = raw_user_score_summary(root)
    bool active = raw_user_active(root)
    if raw_user_missing_is_null(root) == false:
        return "not null"
    return "{name}:{score}:{active}"

function raw_object_keys() returns int64:
    JsonValue root = json.parse_raw("{{\"user\":{{\"name\":\"Ada\"}},\"version\":1}}") handle error:
        return 0
    list[string] keys = json.object_keys(root) handle error:
        return 0
    return list.length[string](keys)

function raw_kind_predicates() returns string:
    JsonValue root = json.parse_raw("{{\"name\":\"Ada\",\"score\":5,\"ratio\":2.5,\"active\":true,\"items\":[1],\"missing\":null}}") handle error:
        return error
    JsonValue name = json.field(root, "name") handle:
        return "missing name"
    JsonValue score = json.field(root, "score") handle:
        return "missing score"
    JsonValue ratio = json.field(root, "ratio") handle:
        return "missing ratio"
    JsonValue active = json.field(root, "active") handle:
        return "missing active"
    JsonValue items = json.field(root, "items") handle:
        return "missing items"
    JsonValue missing = json.field(root, "missing") handle:
        return "missing null"
    return "{json.is_object(root)}:{json.is_string(name)}:{json.is_number(score)}:{json.is_number(ratio)}:{json.is_bool(active)}:{json.is_array(items)}:{json.is_null(missing)}"

function raw_invalid_message() returns string:
    JsonValue root = json.parse_raw("{{\"name\":\"Ada\"}}") handle error:
        return error
    int64 length = json.array_length(root) handle error:
        return error
    return "{length}"

function raw_roundtrip() returns string:
    JsonValue root = json.parse_raw("{{\"name\":\"Ada\",\"score\":5}}") handle error:
        return error
    return json.serialize_raw(root)

verify json_parse_raw:
    assert raw_summary() == "Ada:2:5:true"
    assert raw_object_keys() == 2
    assert raw_kind_predicates() == "true:true:true:true:true:true:true"
    assert raw_invalid_message() == "expected array, got object"
    assert string.contains(raw_roundtrip(), "\"name\":\"Ada\"") == true

namespace test
function raw_user_name(view root: json.JsonTree) returns string:
    json.JsonTree user = json.field(view root, "user") handle:
        return "missing user"
    json.JsonTree name_raw = json.field(view user, "name") handle:
        return "missing name"
    return json.as_string(view name_raw) handle error:
        default error
function raw_user_score_summary(view root: json.JsonTree) returns string:
    json.JsonTree user = json.field(view root, "user") handle:
        return "missing user"
    json.JsonTree scores = json.field(view user, "scores") handle:
        return "missing scores"
    int64 score_count = json.array_length(view scores) handle error:
        return error
    json.JsonTree second_score = json.index(view scores, 1) handle:
        return "missing score"
    int64 score = json.as_int64(view second_score) handle error:
        return error
    return "{score_count}:{score}"
function raw_user_active(view root: json.JsonTree) returns bool:
    json.JsonTree user = json.field(view root, "user") handle:
        return false
    json.JsonTree active_raw = json.field(view user, "active") handle:
        return false
    return json.as_bool(view active_raw) handle error:
        default false
function raw_user_missing_is_null(view root: json.JsonTree) returns bool:
    json.JsonTree user = json.field(view root, "user") handle:
        return false
    json.JsonTree missing_raw = json.field(view user, "missing") handle:
        return false
    return json.is_null(view missing_raw)
function raw_summary() returns string:
    json.JsonTree root = json.parse_raw("{{\"user\":{{\"name\":\"Ada\",\"scores\":[3,5],\"active\":true,\"missing\":null}},\"version\":1}}") handle error:
        return error
    string name = raw_user_name(view root)
    string score = raw_user_score_summary(view root)
    bool active = raw_user_active(view root)
    if raw_user_missing_is_null(view root) == false:
        return "not null"
    return "{name}:{score}:{active}"
function raw_object_keys() returns int64:
    json.JsonTree root = json.parse_raw("{{\"user\":{{\"name\":\"Ada\"}},\"version\":1}}") handle error:
        return 0
    list[string] keys = json.object_keys(view root) handle error:
        return 0
    return list.length[string](view keys)
function raw_kind_predicates() returns string:
    json.JsonTree root = json.parse_raw("{{\"name\":\"Ada\",\"score\":5,\"ratio\":2.5,\"active\":true,\"items\":[1],\"missing\":null}}") handle error:
        return error
    json.JsonTree name = json.field(view root, "name") handle:
        return "missing name"
    json.JsonTree score = json.field(view root, "score") handle:
        return "missing score"
    json.JsonTree ratio = json.field(view root, "ratio") handle:
        return "missing ratio"
    json.JsonTree active = json.field(view root, "active") handle:
        return "missing active"
    json.JsonTree items = json.field(view root, "items") handle:
        return "missing items"
    json.JsonTree missing = json.field(view root, "missing") handle:
        return "missing null"
    return "{json.is_object(view root)}:{json.is_string(view name)}:{json.is_number(view score)}:{json.is_number(view ratio)}:{json.is_bool(view active)}:{json.is_array(view items)}:{json.is_null(view missing)}"
function raw_invalid_message() returns string:
    json.JsonTree root = json.parse_raw("{{\"name\":\"Ada\"}}") handle error:
        return error
    int64 length = json.array_length(view root) handle error:
        return error
    return "{length}"
function raw_roundtrip() returns string:
    json.JsonTree root = json.parse_raw("{{\"name\":\"Ada\",\"score\":5}}") handle error:
        return error
    return json.serialize_raw(view root)
function raw_decoded_key_lookup_and_serialize() returns string:
    json.JsonTree root = json.parse_raw("{{\"\\u0061\\n\":\"line\\rnext\",\"slash\\/key\":true}}") handle error:
        return error
    json.JsonTree text_raw = json.require_field(view root, "a\n") handle error:
        return error
    string text = json.as_string(view text_raw) handle error:
        return error
    json.JsonTree slash_raw = json.require_field(view root, "slash/key") handle error:
        return error
    bool slash = json.as_bool(view slash_raw) handle error:
        return error
    string raw = json.serialize_raw(view root)
    bool normalized_text = string.contains(raw, "\"a\\n\":\"line\\rnext\"")
    bool normalized_slash = string.contains(raw, "\"slash/key\":true")
    return "{bytes.to_hex(bytes.from_string(text))}:{slash}:{normalized_text}:{normalized_slash}"
verify json_parse_raw:
    assert raw_summary() == "Ada:2:5:true"
    assert raw_object_keys() == 2
    assert raw_kind_predicates() == "true:true:true:true:true:true:true"
    assert raw_invalid_message() == "expected array, got object"
    assert string.contains(raw_roundtrip(), "\"name\":\"Ada\"") == true
    assert raw_decoded_key_lookup_and_serialize() == "6c696e650d6e657874:true:true:true"

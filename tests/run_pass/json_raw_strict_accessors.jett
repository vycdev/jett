namespace test
function strict_root() returns json.JsonTree:
    return json.parse_raw("{{\"name\":\"Ada\",\"scores\":[3,5],\"missing\":null}}") handle error:
        default json.JsonTree.string_value(error)
function strict_required_field_value() returns string:
    json.JsonTree root = strict_root()
    json.JsonTree name = json.require_field(view root, "name") handle error:
        return error
    return json.as_string(view name) handle error:
        default error
function strict_optional_missing_field() returns string:
    json.JsonTree root = strict_root()
    optional[json.JsonTree] maybe = json.object_field(view root, "absent") handle error:
        return error
    json.JsonTree item = maybe handle:
        return "absent"
    return json.kind(view item)
function strict_present_null_field() returns string:
    json.JsonTree root = strict_root()
    optional[json.JsonTree] maybe = json.object_field(view root, "missing") handle error:
        return error
    json.JsonTree item = maybe handle:
        return "absent"
    return json.kind(view item)
function strict_field_wrong_shape() returns string:
    json.JsonTree text = json.parse_raw("\"Ada\"") handle error:
        default json.JsonTree.string_value(error)
    optional[json.JsonTree] maybe = json.object_field(view text, "name") handle error:
        return error
    json.JsonTree item = maybe handle:
        return "absent"
    return json.kind(view item)
function strict_field_array_wrong_shape() returns string:
    json.JsonTree values = json.parse_raw("[1,2]") handle error:
        default json.JsonTree.string_value(error)
    optional[json.JsonTree] maybe = json.object_field(view values, "name") handle error:
        return error
    json.JsonTree item = maybe handle:
        return "absent"
    return json.kind(view item)
function strict_required_field_missing() returns string:
    json.JsonTree root = strict_root()
    json.JsonTree item = json.require_field(view root, "absent") handle error:
        return error
    return json.kind(view item)
function strict_array_index_value() returns string:
    json.JsonTree root = strict_root()
    json.JsonTree scores = json.require_field(view root, "scores") handle error:
        return error
    json.JsonTree second = json.require_index(view scores, 1) handle error:
        return error
    int64 value = json.as_int64(view second) handle error:
        default -1
    return "{value}"
function strict_array_index_absent() returns string:
    json.JsonTree root = strict_root()
    json.JsonTree scores = json.require_field(view root, "scores") handle error:
        return error
    optional[json.JsonTree] maybe = json.array_index(view scores, 9) handle error:
        return error
    json.JsonTree item = maybe handle:
        return "absent"
    return json.kind(view item)
function strict_array_index_negative_absent() returns string:
    json.JsonTree root = strict_root()
    json.JsonTree scores = json.require_field(view root, "scores") handle error:
        return error
    optional[json.JsonTree] maybe = json.array_index(view scores, -1) handle error:
        return error
    json.JsonTree item = maybe handle:
        return "absent"
    return json.kind(view item)
function strict_required_index_missing() returns string:
    json.JsonTree root = strict_root()
    json.JsonTree scores = json.require_field(view root, "scores") handle error:
        return error
    json.JsonTree item = json.require_index(view scores, 9) handle error:
        return error
    return json.kind(view item)
function strict_required_negative_index_missing() returns string:
    json.JsonTree root = strict_root()
    json.JsonTree scores = json.require_field(view root, "scores") handle error:
        return error
    json.JsonTree item = json.require_index(view scores, -1) handle error:
        return error
    return json.kind(view item)
function strict_index_wrong_shape() returns string:
    json.JsonTree root = strict_root()
    optional[json.JsonTree] maybe = json.array_index(view root, 0) handle error:
        return error
    json.JsonTree item = maybe handle:
        return "absent"
    return json.kind(view item)
function strict_index_scalar_wrong_shape() returns string:
    json.JsonTree text = json.parse_raw("\"Ada\"") handle error:
        default json.JsonTree.string_value(error)
    optional[json.JsonTree] maybe = json.array_index(view text, 0) handle error:
        return error
    json.JsonTree item = maybe handle:
        return "absent"
    return json.kind(view item)
function strict_accessors_accept_legacy_value() returns string:
    JsonValue root = json.parse_raw("{{\"name\":\"Grace\"}}") handle error:
        return error
    JsonValue name = json.require_field(view root, "name") handle error:
        return error
    return json.as_string(name) handle error:
        default error
function strict_accessors_accept_namespaced_value() returns string:
    json.JsonValue root = json.parse_raw("{{\"name\":\"Lin\",\"scores\":[3,5]}}") handle error:
        return error
    json.JsonValue name = json.require_field(view root, "name") handle error:
        return error
    json.JsonValue scores = json.require_field(view root, "scores") handle error:
        return error
    json.JsonValue second = json.require_index(view scores, 1) handle error:
        return error
    string name_text = json.as_string(view name) handle error:
        return error
    int64 score = json.as_int64(view second) handle error:
        default -1
    return "{name_text}:{score}"
function strict_optional_accessors_accept_namespaced_value() returns string:
    json.JsonValue root = json.parse_raw("{{\"scores\":[3,5]}}") handle error:
        return error
    optional[json.JsonValue] missing_field = json.object_field(view root, "absent") handle error:
        return error
    json.JsonValue field = missing_field handle:
        default json.JsonTree.string_value("field absent")
    json.JsonValue scores = json.require_field(view root, "scores") handle error:
        return error
    optional[json.JsonValue] missing_index = json.array_index(view scores, 9) handle error:
        return error
    json.JsonValue item = missing_index handle:
        default json.JsonTree.string_value("index absent")
    string field_text = json.as_string(view field) handle error:
        return error
    string item_text = json.as_string(view item) handle error:
        return error
    return "{field_text}:{item_text}"
verify json_raw_strict_accessors:
    assert strict_required_field_value() == "Ada"
    assert strict_optional_missing_field() == "absent"
    assert strict_present_null_field() == "null"
    assert strict_field_wrong_shape() == "expected object, got string"
    assert strict_field_array_wrong_shape() == "expected object, got array"
    assert strict_required_field_missing() == "missing object field 'absent'"
    assert strict_array_index_value() == "5"
    assert strict_array_index_absent() == "absent"
    assert strict_array_index_negative_absent() == "absent"
    assert strict_required_index_missing() == "missing array item 9"
    assert strict_required_negative_index_missing() == "missing array item -1"
    assert strict_index_wrong_shape() == "expected array, got object"
    assert strict_index_scalar_wrong_shape() == "expected array, got string"
    assert strict_accessors_accept_legacy_value() == "Grace"
    assert strict_accessors_accept_namespaced_value() == "Lin:5"
    assert strict_optional_accessors_accept_namespaced_value() == "field absent:index absent"

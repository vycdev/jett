namespace test

type NonEmpty = string where string.char_count(value) > 0

struct User:
    id: string
    age: int64

struct Box[T]:
    value: T
    label: string

struct RefinedUser:
    name: NonEmpty

struct Other:
    id: string
    age: int64

function clone_user_by_reflection() returns bool:
    User source = User(id: "u1", age: 42)
    mutable TypeConstruction builder = type.construct_start[User]()
    for field in type.fields[User]():
        comptime type Field = field.type_info:
            Field value = type.field_value[User, Field](view source, view field)
            builder = type.construct_put[User, Field](builder, view field, value) handle error:
                return false
    User built = type.construct_finish[User](builder) handle error:
        return false
    return built.id == "u1" and built.age == 42

function clone_generic_box_by_reflection() returns bool:
    Box[string] source = Box[string](value: "payload", label: "name")
    mutable TypeConstruction builder = type.construct_start[Box[string]]()
    for field in type.fields[Box[string]]():
        comptime type Field = field.type_info:
            Field value = type.field_value[Box[string], Field](view source, view field)
            builder = type.construct_put[Box[string], Field](builder, view field, value) handle error:
                return false
    Box[string] built = type.construct_finish[Box[string]](builder) handle error:
        return false
    return built.value == "payload" and built.label == "name"

function clone_refined_user_by_reflection() returns string:
    NonEmpty name = "Ada" handle error:
        return error
    RefinedUser source = RefinedUser(name: name) handle error:
        return error
    mutable TypeConstruction builder = type.construct_start[RefinedUser]()
    for field in type.fields[RefinedUser]():
        comptime type Field = field.type_info:
            Field value = type.field_value[RefinedUser, Field](view source, view field)
            builder = type.construct_put[RefinedUser, Field](builder, view field, value) handle error:
                return error
    RefinedUser built = type.construct_finish[RefinedUser](builder) handle error:
        return error
    return coarsen built.name

function missing_field_message() returns string:
    User source = User(id: "u1", age: 42)
    mutable TypeConstruction builder = type.construct_start[User]()
    for field in type.fields[User]():
        if field.name != "age":
            comptime type Field = field.type_info:
                Field value = type.field_value[User, Field](view source, view field)
                builder = type.construct_put[User, Field](builder, view field, value) handle error:
                    return error
    User built = type.construct_finish[User](builder) handle error:
        return error
    return built.id

function duplicate_field_message() returns string:
    User source = User(id: "u1", age: 42)
    mutable TypeConstruction builder = type.construct_start[User]()
    for field in type.fields[User]():
        comptime type Field = field.type_info:
            Field value = type.field_value[User, Field](view source, view field)
            builder = type.construct_put[User, Field](builder, view field, value) handle error:
                return error
            if field.name == "id":
                Field duplicate_value = type.field_value[User, Field](view source, view field)
                builder = type.construct_put[User, Field](builder, view field, duplicate_value) handle error:
                    return error
    return "no duplicate"

function mismatched_metadata_message() returns string:
    User source = User(id: "u1", age: 42)
    mutable TypeConstruction builder = type.construct_start[Other]()
    for field in type.fields[User]():
        comptime type Field = field.type_info:
            Field value = type.field_value[User, Field](view source, view field)
            builder = type.construct_put[Other, Field](builder, view field, value) handle error:
                return error
    Other built = type.construct_finish[Other](builder) handle error:
        return error
    return built.id

verify type_construction_builder:
    assert clone_user_by_reflection() == true
    assert clone_generic_box_by_reflection() == true
    assert clone_refined_user_by_reflection() == "Ada"
    assert string.contains(missing_field_message(), "missing required field 'age'") == true
    assert string.contains(duplicate_field_message(), "provided more than once") == true
    assert string.contains(mismatched_metadata_message(), "belongs to 'test.User', expected 'test.Other'") == true

namespace app
function main(stdout: Stdout) returns nothing:
    string tab = "a\tb"
    string newline = "line1\nline2"
    string quoted = "say \"hello\""
    string backslash = "back\\slash"
    Stdout.write(view stdout, tab)
    Stdout.write(view stdout, newline)
    Stdout.write(view stdout, quoted)
    Stdout.write(view stdout, backslash)
    string name = "world"
    Stdout.write(view stdout, "hello\t{name}")

namespace test

type NonEmpty = string where string.char_count(value) > 0
type NameList = list[string]
type SecretText = secret[string]

enum Direction:
    north
    south

enum Protocol:
    icmp = 1
    tcp = 6
    udp = 17

enum SecretChoice:
    token(value: secret[string])
    empty

bitfield Header:
    version: 4 bits

bitfield Packet:
    version: 4 bits
    header_length: 4 bits
    protocol: 8 bits as Protocol
    payload: list[uint8]

bitfield network NetworkPacket:
    version: 4 bits
    header_length: 4 bits

struct User:
    id: string

struct Complex:
    names: list[string]
    lookup: map[string, result[int64, string]]
    maybe_user: optional[User]
    secret_items: list[secret[string]]

struct Pair[T, U]:
    first: T
    second: U

function type_info_kind[T]() returns string:
    TypeInfo info = type.info[T]()
    return info.kind

function type_info_kind_tag_is[T](expected: TypeKind) returns bool:
    TypeInfo info = type.info[T]()
    return info.kind_tag == expected

function direct_type_kind_tag_is[T](expected: TypeKind) returns bool:
    return type.kind_tag[T]() == expected

function type_info_primitive_tag_is[T](expected: TypePrimitive) returns bool:
    TypeInfo info = type.info[T]()
    TypePrimitive primitive = info.primitive_tag handle:
        return false
    return primitive == expected

function direct_type_primitive_tag_is[T](expected: TypePrimitive) returns bool:
    TypePrimitive primitive = type.primitive_tag[T]() handle:
        return false
    return primitive == expected

function type_info_has_no_primitive_tag[T]() returns bool:
    TypeInfo info = type.info[T]()
    TypePrimitive primitive = info.primitive_tag handle:
        return true
    return primitive == TypePrimitive.unknown_type

function type_info_arg_primitive_tag_is[T](target: int64, expected: TypePrimitive) returns bool:
    TypeInfo info = type.info[T]()
    bool found = false
    int64 index = 0
    for arg in info.args:
        if index == target:
            TypePrimitive primitive = arg.primitive_tag handle:
                return false
            found = primitive == expected
        index = index + 1
    return found

function type_info_arg_count[T]() returns int64:
    TypeInfo info = type.info[T]()
    return list.length(info.args)

function type_info_arg_kind[T](target: int64) returns string:
    TypeInfo info = type.info[T]()
    string found = "missing"
    int64 index = 0
    for arg in info.args:
        if index == target:
            found = arg.kind
        index = index + 1
    return found

function type_info_arg_type_name[T](target: int64) returns string:
    TypeInfo info = type.info[T]()
    string found = "missing"
    int64 index = 0
    for arg in info.args:
        if index == target:
            found = arg.type_name
        index = index + 1
    return found

function type_info_nested_arg_kind[T](outer_target: int64, inner_target: int64) returns string:
    TypeInfo info = type.info[T]()
    string found = "missing"
    int64 outer_index = 0
    for outer in info.args:
        if outer_index == outer_target:
            int64 inner_index = 0
            for inner in outer.args:
                if inner_index == inner_target:
                    found = inner.kind
                inner_index = inner_index + 1
        outer_index = outer_index + 1
    return found

function type_info_nested_arg_type_name[T](outer_target: int64, inner_target: int64) returns string:
    TypeInfo info = type.info[T]()
    string found = "missing"
    int64 outer_index = 0
    for outer in info.args:
        if outer_index == outer_target:
            int64 inner_index = 0
            for inner in outer.args:
                if inner_index == inner_target:
                    found = inner.type_name
                inner_index = inner_index + 1
        outer_index = outer_index + 1
    return found

function complex_field_arg_count(field_name: string) returns int64:
    list[TypeField] fields = type.fields[Complex]()
    int64 found = -1
    for field in fields:
        if field.name == field_name:
            found = list.length(field.type_info.args)
    return found

function field_count[T]() returns int64:
    list[TypeField] fields = type.fields[T]()
    return list.length(fields)

function field_kind[T](field_name: string) returns string:
    list[TypeField] fields = type.fields[T]()
    string found = "missing"
    for field in fields:
        if field.name == field_name:
            found = field.kind
    return found

function field_kind_tag_is[T](field_name: string, expected: TypeKind) returns bool:
    list[TypeField] fields = type.fields[T]()
    bool found = false
    for field in fields:
        if field.name == field_name:
            found = field.kind_tag == expected
    return found

function complex_field_arg_kind(field_name: string, target: int64) returns string:
    list[TypeField] fields = type.fields[Complex]()
    string found = "missing"
    for field in fields:
        if field.name == field_name:
            int64 index = 0
            for arg in field.type_info.args:
                if index == target:
                    found = arg.kind
                index = index + 1
    return found

function nested_arg_kind_from_info(info: TypeInfo, outer_target: int64, inner_target: int64) returns string:
    string found = "missing"
    int64 outer_index = 0
    for outer in info.args:
        if outer_index == outer_target:
            int64 inner_index = 0
            for inner in outer.args:
                if inner_index == inner_target:
                    found = inner.kind
                inner_index = inner_index + 1
        outer_index = outer_index + 1
    return found

function complex_field_nested_arg_kind(field_name: string, outer_target: int64, inner_target: int64) returns string:
    list[TypeField] fields = type.fields[Complex]()
    string found = "missing"
    for field in fields:
        if field.name == field_name:
            found = nested_arg_kind_from_info(field.type_info, outer_target, inner_target)
    return found

function complex_field_type_info_secret(field_name: string) returns bool:
    list[TypeField] fields = type.fields[Complex]()
    bool found = false
    for field in fields:
        if field.name == field_name:
            found = field.type_info.has_secret
    return found

function complex_field_type_info_matches_legacy(field_name: string) returns bool:
    list[TypeField] fields = type.fields[Complex]()
    bool found = false
    for field in fields:
        if field.name == field_name:
            found = field.type_info.type_name == field.type_name and field.type_info.kind == field.kind and field.type_info.has_secret == field.has_secret
    return found

function pair_field_arg_type_name(field_name: string, target: int64) returns string:
    list[TypeField] fields = type.fields[Pair[list[int64], optional[string]]]()
    string found = "missing"
    for field in fields:
        if field.name == field_name:
            int64 index = 0
            for arg in field.type_info.args:
                if index == target:
                    found = arg.type_name
                index = index + 1
    return found

function header_version_by_reflection() returns int64:
    Header header = Header(version: 4)
    list[TypeField] fields = type.fields[Header]()
    int64 found = -1
    for field in fields:
        if field.name == "version":
            found = type.field_value[Header, int64](view header, view field)
    return found

function bitfield_field_count[T]() returns int64:
    list[TypeBitfieldField] fields = type.bitfield_fields[T]()
    return list.length(fields)

function bitfield_metadata_field_count[T]() returns int64:
    TypeBitfield info = type.bitfield_layout[T]()
    return list.length(info.fields)

function bitfield_metadata_network_order[T]() returns bool:
    TypeBitfield info = type.bitfield_layout[T]()
    return info.network_order

function bitfield_field_shape[T](field_name: string) returns string:
    list[TypeBitfieldField] fields = type.bitfield_fields[T]()
    string found = "missing"
    for field in fields:
        if field.name == field_name:
            found = field.shape
    return found

function bitfield_field_shape_tag_is[T](field_name: string, expected: TypeBitfieldFieldShape) returns bool:
    list[TypeBitfieldField] fields = type.bitfield_fields[T]()
    bool found = false
    for field in fields:
        if field.name == field_name:
            found = field.shape_tag == expected
    return found

function bitfield_field_width[T](field_name: string) returns int64:
    list[TypeBitfieldField] fields = type.bitfield_fields[T]()
    int64 found = -1
    for field in fields:
        if field.name == field_name:
            found = field.width
    return found

function bitfield_field_type_name[T](field_name: string) returns string:
    list[TypeBitfieldField] fields = type.bitfield_fields[T]()
    string found = "missing"
    for field in fields:
        if field.name == field_name:
            found = field.type_info.type_name
    return found

function bitfield_field_type_kind[T](field_name: string) returns string:
    list[TypeBitfieldField] fields = type.bitfield_fields[T]()
    string found = "missing"
    for field in fields:
        if field.name == field_name:
            found = field.type_info.kind
    return found

function bitfield_field_enum_kind[T](field_name: string) returns string:
    list[TypeBitfieldField] fields = type.bitfield_fields[T]()
    string found = "missing"
    for field in fields:
        if field.name == field_name:
            TypeInfo info = field.enum_type handle:
                default field.type_info
            found = info.kind
    return found

function variant_count[T]() returns int64:
    list[TypeVariant] variants = type.variants[T]()
    return list.length(variants)

function variant_field_count[T](variant_name: string) returns int64:
    list[TypeVariant] variants = type.variants[T]()
    int64 found = -1
    for variant in variants:
        if variant.name == variant_name:
            found = list.length(variant.fields)
    return found

function variant_discriminant[T](variant_name: string) returns int64:
    list[TypeVariant] variants = type.variants[T]()
    int64 found = -1
    for variant in variants:
        if variant.name == variant_name:
            found = variant.discriminant
    return found

function variant_has_secret[T](variant_name: string) returns bool:
    list[TypeVariant] variants = type.variants[T]()
    bool found = false
    for variant in variants:
        if variant.name == variant_name:
            found = variant.has_secret
    return found

function variant_field_kind[T](variant_name: string, target: int64) returns string:
    list[TypeVariant] variants = type.variants[T]()
    string found = "missing"
    for variant in variants:
        if variant.name == variant_name:
            int64 index = 0
            for field in variant.fields:
                if index == target:
                    found = field.kind
                index = index + 1
    return found

function variant_field_type_name[T](variant_name: string, target: int64) returns string:
    list[TypeVariant] variants = type.variants[T]()
    string found = "missing"
    for variant in variants:
        if variant.name == variant_name:
            int64 index = 0
            for field in variant.fields:
                if index == target:
                    found = field.type_name
                index = index + 1
    return found

verify type_info_reflection:
    assert type_info_kind[int64]() == "primitive"
    assert direct_type_kind_tag_is[int64](TypeKind.primitive_type) == true
    assert type_info_primitive_tag_is[int64](TypePrimitive.int64_type) == true
    assert direct_type_primitive_tag_is[int64](TypePrimitive.int64_type) == true
    assert type_info_primitive_tag_is[string](TypePrimitive.string_type) == true
    assert type_info_primitive_tag_is[JsonValue](TypePrimitive.json_value_type) == true
    assert type_info_kind[NonEmpty]() == "refinement"
    assert type_info_kind_tag_is[NonEmpty](TypeKind.refinement_type) == true
    assert type_info_has_no_primitive_tag[NonEmpty]() == true
    assert type_info_arg_count[NonEmpty]() == 1
    assert type_info_arg_kind[NonEmpty](0) == "primitive"
    assert type_info_arg_primitive_tag_is[NonEmpty](0, TypePrimitive.string_type) == true
    assert type_info_kind[NameList]() == "alias"
    assert type_info_kind_tag_is[NameList](TypeKind.alias_type) == true
    assert type_info_has_no_primitive_tag[NameList]() == true
    assert type_info_arg_kind[NameList](0) == "list"
    assert type_info_nested_arg_type_name[NameList](0, 0) == "string"
    assert type.has_secret[SecretText]() == true
    assert type_info_arg_kind[SecretText](0) == "secret"
    assert type_info_kind_tag_is[SecretText](TypeKind.alias_type) == true
    assert type_info_kind[Direction]() == "enum"
    assert type_info_kind_tag_is[Direction](TypeKind.enum_type) == true
    assert type_info_kind[Header]() == "bitfield"
    assert type_info_kind_tag_is[Header](TypeKind.bitfield_type) == true
    assert field_count[Header]() == 1
    assert field_kind[Header]("version") == "primitive"
    assert field_kind_tag_is[Complex]("names", TypeKind.list_type) == true
    assert header_version_by_reflection() == 4
    assert bitfield_field_count[Packet]() == 4
    assert bitfield_metadata_field_count[Packet]() == 4
    assert bitfield_metadata_network_order[Packet]() == false
    assert bitfield_metadata_network_order[NetworkPacket]() == true
    assert bitfield_field_shape[Packet]("version") == "bits"
    assert bitfield_field_shape_tag_is[Packet]("version", TypeBitfieldFieldShape.bits_field) == true
    assert bitfield_field_width[Packet]("version") == 4
    assert bitfield_field_type_kind[Packet]("protocol") == "enum"
    assert bitfield_field_enum_kind[Packet]("protocol") == "enum"
    assert bitfield_field_enum_kind[Packet]("version") == "primitive"
    assert bitfield_field_shape[Packet]("payload") == "payload"
    assert bitfield_field_shape_tag_is[Packet]("payload", TypeBitfieldFieldShape.payload_field) == true
    assert bitfield_field_width[Packet]("payload") == 0
    assert bitfield_field_type_name[Packet]("payload") == "list[uint8]"
    assert type_info_arg_count[int64]() == 0
    assert type.has_secret[SecretChoice]() == true
    assert variant_count[Direction]() == 2
    assert variant_discriminant[Direction]("north") == 0
    assert variant_discriminant[Direction]("south") == 1
    assert variant_discriminant[SecretChoice]("token") == 0
    assert variant_discriminant[SecretChoice]("empty") == 1
    assert variant_discriminant[Protocol]("tcp") == 6
    assert variant_discriminant[Protocol]("udp") == 17
    assert variant_field_count[Direction]("north") == 0
    assert variant_field_count[SecretChoice]("token") == 1
    assert variant_field_kind[SecretChoice]("token", 0) == "secret"
    assert variant_field_type_name[SecretChoice]("token", 0) == "secret[string]"
    assert variant_has_secret[SecretChoice]("token") == true
    assert variant_has_secret[SecretChoice]("empty") == false
    assert type_info_kind[list[optional[User]]]() == "list"
    assert type_info_arg_count[list[optional[User]]]() == 1
    assert type_info_arg_kind[list[optional[User]]](0) == "optional"
    assert type_info_nested_arg_kind[list[optional[User]]](0, 0) == "struct"
    assert type_info_nested_arg_type_name[list[optional[User]]](0, 0) == "User"
    assert type_info_arg_count[map[string, result[int64, string]]]() == 2
    assert type_info_arg_type_name[map[string, result[int64, string]]](0) == "string"
    assert type_info_arg_kind[map[string, result[int64, string]]](1) == "result"
    assert type_info_nested_arg_type_name[map[string, result[int64, string]]](1, 0) == "int64"
    assert type_info_nested_arg_type_name[map[string, result[int64, string]]](1, 1) == "string"
    assert complex_field_arg_count("names") == 1
    assert complex_field_arg_kind("names", 0) == "primitive"
    assert complex_field_arg_count("lookup") == 2
    assert complex_field_arg_kind("lookup", 1) == "result"
    assert complex_field_nested_arg_kind("lookup", 1, 0) == "primitive"
    assert complex_field_type_info_secret("secret_items") == true
    assert complex_field_type_info_matches_legacy("lookup") == true
    assert complex_field_type_info_matches_legacy("secret_items") == true
    assert pair_field_arg_type_name("first", 0) == "int64"
    assert pair_field_arg_type_name("second", 0) == "string"

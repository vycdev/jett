namespace test
function parse_tree_summary(raw: string) returns string:
    json.JsonTree tree = json.json_tree_parse(raw) handle error:
        return error
    return json.json_tree_serialize(tree)
function parse_string_value(raw: string) returns string:
    json.JsonTree tree = json.json_tree_parse(raw) handle error:
        return error
    match tree:
        string_value(value):
            return value
        null:
            return "not string"
        bool_value(value):
            return "not string"
        number_value(value):
            return "not string"
        array_value(items):
            return "not string"
        object_value(fields):
            return "not string"
function parse_string_hex(raw: string) returns string:
    string value = parse_string_value(raw)
    return bytes.to_hex(bytes.from_string(value))
function raw_from_hex(hex: string) returns string:
    bytes raw = bytes.from_hex(hex) handle error:
        return error
    return bytes.to_string(raw) handle error:
        default error
verify json_tree_parse_scalar:
    assert parse_tree_summary("") == "expected JSON value"
    assert parse_tree_summary("   ") == "expected JSON value"
    assert parse_tree_summary(raw_from_hex("09200a0d310d0a2009")) == "1"
    assert parse_tree_summary(raw_from_hex("0c31")) == "expected JSON scalar"
    assert parse_tree_summary(raw_from_hex("310c")) == "invalid JSON number"
    assert parse_tree_summary(" null ") == "null"
    assert parse_tree_summary("true") == "true"
    assert parse_tree_summary("false") == "false"
    assert parse_tree_summary("0") == "0"
    assert parse_tree_summary("-0") == "-0"
    assert parse_tree_summary(" -12.5 ") == "-12.5"
    assert parse_tree_summary("0.125") == "0.125"
    assert parse_tree_summary("-0.5e+2") == "-0.5e+2"
    assert parse_tree_summary("6.02E23") == "6.02E23"
    assert parse_tree_summary("\"Ada\"") == "\"Ada\""
    assert parse_tree_summary("\"line\\nnext\"") == "\"line\\nnext\""
    assert parse_tree_summary("\"slash\\/path\"") == "\"slash/path\""
    assert parse_tree_summary("\"back\\bspace\"") == "\"back\\bspace\""
    assert parse_tree_summary("\"form\\ffeed\"") == "\"form\\ffeed\""
    assert parse_tree_summary("\"line\\u000anext\"") == "\"line\\nnext\""
    assert parse_tree_summary("\"\\u0041\"") == "\"A\""
    assert parse_string_value("\"line\\nnext\"") == "line\nnext"
    assert parse_string_value("\"line\\u000anext\"") == "line\nnext"
    assert parse_string_hex("\"\\b\\f\"") == "080c"
    assert parse_string_hex("\"\\r\\t\"") == "0d09"
    assert parse_string_hex("\"\\u00e9\"") == "c3a9"
    assert parse_string_hex("\"\\u20ac\"") == "e282ac"
    assert parse_string_hex("\"\\uD834\\uDD1E\"") == "f09d849e"
    assert parse_string_hex("\"\\ud834\\udd1e\"") == "f09d849e"
    assert parse_tree_summary("\"bad") == "unterminated JSON string"
    assert parse_tree_summary("\"Ada\" trailing") == "unexpected trailing characters after JSON value"
    assert parse_tree_summary("\"\\") == "unterminated escape in JSON string"
    assert parse_tree_summary("\"\\q\"") == "unsupported JSON string escape"
    assert parse_tree_summary("\"line\nnext\"") == "unescaped control character in JSON string"
    assert parse_tree_summary("\"\\u00xz\"") == "invalid unicode escape in JSON string"
    assert parse_tree_summary("\"\\u004\"") == "unterminated unicode escape in JSON string"
    assert parse_tree_summary("\"\\ud834\"") == "unterminated surrogate pair in JSON string"
    assert parse_tree_summary("\"\\udd1e\"") == "unexpected low surrogate unicode escape"
    assert parse_tree_summary("\"\\ud834\\u0041\"") == "expected low surrogate unicode escape"
    assert parse_tree_summary("\"\\ud834abcdef\"") == "expected low surrogate unicode escape"
    assert parse_tree_summary("\"\\ud834\\uddxz\"") == "invalid unicode escape in JSON string"
    assert parse_tree_summary("01") == "invalid JSON number"
    assert parse_tree_summary("00") == "invalid JSON number"
    assert parse_tree_summary("-01") == "invalid JSON number"
    assert parse_tree_summary("+1") == "invalid JSON number"
    assert parse_tree_summary("-") == "invalid JSON number"
    assert parse_tree_summary(":") == "expected JSON scalar"
    assert parse_tree_summary("1.") == "invalid JSON number"
    assert parse_tree_summary("1 2") == "invalid JSON number"
    assert parse_tree_summary("0x1") == "invalid JSON number"
    assert parse_tree_summary("1e") == "invalid JSON number"
    assert parse_tree_summary("1e+") == "invalid JSON number"
    assert parse_tree_summary("1E-") == "invalid JSON number"
    assert parse_tree_summary("nullx") == "unexpected trailing characters after JSON literal"
    assert parse_tree_summary("falsex") == "unexpected trailing characters after JSON literal"
    assert parse_tree_summary("true false") == "unexpected trailing characters after JSON literal"
    assert parse_tree_summary("tru") == "invalid JSON literal"
    assert parse_tree_summary("fal") == "invalid JSON literal"
    assert parse_tree_summary("nope") == "invalid JSON literal"

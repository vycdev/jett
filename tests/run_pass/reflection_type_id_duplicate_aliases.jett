namespace accounts
export struct Record:
    id: string serialize "accountId"
export type RecordAlias = Record
export struct AliasHolder:
    record: RecordAlias serialize "recordData"
namespace audit
export struct Record:
    attempts: int64
export type RecordAlias = Record
export struct AliasHolder:
    record: RecordAlias serialize "recordData"
namespace app
function alias_reflection_summary() returns string:
    TypeInfo account = type.info[accounts.RecordAlias]()
    TypeInfo account_base = list.get[TypeInfo](account.args, 0) handle:
        return "missing account base"
    TypeInfo audit_info = type.info[audit.RecordAlias]()
    TypeInfo audit_base = list.get[TypeInfo](audit_info.args, 0) handle:
        return "missing audit base"
    comptime type AccountBase = type.arg[accounts.RecordAlias](0):
        comptime type AuditBase = type.arg[audit.RecordAlias](0):
            TypeField account_field = list.get[TypeField](type.fields[AccountBase](), 0) handle:
                return "missing account field"
            TypeField audit_field = list.get[TypeField](type.fields[AuditBase](), 0) handle:
                return "missing audit field"
            return "{account.kind}:{account.type_name}:{account_base.type_name}:{type.name[AccountBase]()}:{account_field.name}:{audit_info.kind}:{audit_info.type_name}:{audit_base.type_name}:{type.name[AuditBase]()}:{audit_field.name}"
function account_alias_holder_exact_error() returns string:
    string raw = "{{\"recordData\":{{\"accountId\":\"a2\",\"extra\":true}}}}"
    accounts.AliasHolder holder = json.parse_exact[accounts.AliasHolder](raw) handle error:
        return error
    return holder.record.id
function audit_alias_holder_exact_error() returns string:
    string raw = "{{\"recordData\":{{\"attempts\":7,\"extra\":true}}}}"
    audit.AliasHolder holder = json.parse_exact[audit.AliasHolder](raw) handle error:
        return error
    return "{holder.record.attempts}"
function account_alias_json_summary() returns string:
    accounts.RecordAlias record = json.parse[accounts.RecordAlias]("{{\"accountId\":\"a1\"}}") handle error:
        return error
    string raw = json.serialize[accounts.RecordAlias](view record)
    bool has_id = string.contains(raw, "\"accountId\":\"a1\"")
    string exact_error = account_alias_holder_exact_error()
    return "{record.id}:{has_id}:{exact_error}"
function audit_alias_json_summary() returns string:
    audit.RecordAlias record = json.parse[audit.RecordAlias]("{{\"attempts\":5}}") handle error:
        return error
    string raw = json.serialize[audit.RecordAlias](view record)
    bool has_attempts = string.contains(raw, "\"attempts\":5")
    string exact_error = audit_alias_holder_exact_error()
    return "{record.attempts}:{has_attempts}:{exact_error}"
verify reflection_type_id_duplicate_aliases:
    assert alias_reflection_summary() == "alias:accounts.RecordAlias:accounts.Record:accounts.Record:id:alias:audit.RecordAlias:audit.Record:audit.Record:attempts"
    assert account_alias_json_summary() == "a1:true:recordData: unknown field 'extra' for accounts.Record"
    assert audit_alias_json_summary() == "5:true:recordData: unknown field 'extra' for audit.Record"

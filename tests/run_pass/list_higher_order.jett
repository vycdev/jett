namespace app

function is_even(n: int64) returns bool:
    return n modulo 2 == 0

function square(n: int64) returns int64:
    return n * n

function gt_three(n: int64) returns bool:
    return n > 3

function negate(n: int64) returns int64:
    return 0 - n

function gt_zero(n: int64) returns bool:
    return n > 0

function gt_five(n: int64) returns bool:
    return n > 5

function gt_ten(n: int64) returns bool:
    return n > 10

function main(view stdout: Stdout) returns nothing:
    list[int64] nums = list(1, 2, 3, 4, 5, 6)

    # filter: keep evens
    list[int64] evens = list.filter[int64](nums, is_even)
    assert list.length[int64](evens) == 3

    # map: square each
    list[int64] squares = list.map[int64, int64](nums, square)
    assert list.length[int64](squares) == 6
    int64 first_sq = list.get[int64](squares, 0) handle:
        return nothing
    assert first_sq == 1
    int64 last_sq = list.get[int64](squares, 5) handle:
        return nothing
    assert last_sq == 36

    # find: first > 3
    optional[int64] found = list.find[int64](nums, gt_three)
    int64 val = found handle:
        return nothing
    assert val == 4

    # sort_by: descending by value
    list[int64] sorted = list.sort_by[int64](nums, negate)
    int64 first_sorted = list.get[int64](sorted, 0) handle:
        return nothing
    assert first_sorted == 6

    # all: all positive?
    bool all_pos = list.all[int64](nums, gt_zero)
    assert all_pos == true

    # any: any > 5?
    bool any_big = list.any[int64](nums, gt_five)
    assert any_big == true

    # any: any > 10? (false case)
    bool any_huge = list.any[int64](nums, gt_ten)
    assert any_huge == false

    # count: how many even?
    int64 even_count = list.count[int64](nums, is_even)
    assert even_count == 3

    # sum
    int64 total = list.sum[int64](nums)
    assert total == 21

    Stdout.write(view stdout, "ok")

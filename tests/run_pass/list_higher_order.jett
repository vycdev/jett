namespace app

function is_even(n: int64) returns bool:
    return n modulo 2 == 0

function square(n: int64) returns int64:
    return n * n

function gt_three(n: int64) returns bool:
    return n > 3

function negate(n: int64) returns int64:
    return 0 - n

function gt_zero(n: int64) returns bool:
    return n > 0

function gt_five(n: int64) returns bool:
    return n > 5

function gt_ten(n: int64) returns bool:
    return n > 10

function filter_evens_count() returns int64:
    list[int64] nums = list(1, 2, 3, 4, 5, 6)
    return list.length[int64](list.filter[int64](nums, is_even))

verify filter_evens_count:
    assert filter_evens_count() == 3

function map_squares_length() returns int64:
    list[int64] nums = list(1, 2, 3, 4, 5, 6)
    return list.length[int64](list.map[int64, int64](nums, square))

verify map_squares_length:
    assert map_squares_length() == 6

function map_squares_first() returns int64:
    list[int64] nums = list(1, 2, 3, 4, 5, 6)
    list[int64] squares = list.map[int64, int64](nums, square)
    return list.get[int64](squares, 0) handle:
        default 0

verify map_squares_first:
    assert map_squares_first() == 1

function map_squares_last() returns int64:
    list[int64] nums = list(1, 2, 3, 4, 5, 6)
    list[int64] squares = list.map[int64, int64](nums, square)
    return list.get[int64](squares, 5) handle:
        default 0

verify map_squares_last:
    assert map_squares_last() == 36

function find_gt_three() returns int64:
    list[int64] nums = list(1, 2, 3, 4, 5, 6)
    optional[int64] found = list.find[int64](nums, gt_three)
    return found handle:
        default 0

verify find_gt_three:
    assert find_gt_three() == 4

function sort_by_desc_first() returns int64:
    list[int64] nums = list(1, 2, 3, 4, 5, 6)
    list[int64] sorted = list.sort_by[int64](nums, negate)
    return list.get[int64](sorted, 0) handle:
        default 0

verify sort_by_desc_first:
    assert sort_by_desc_first() == 6

function all_positive_test() returns bool:
    list[int64] nums = list(1, 2, 3, 4, 5, 6)
    return list.all[int64](nums, gt_zero)

verify all_positive_test:
    assert all_positive_test() == true

function any_big_test() returns bool:
    list[int64] nums = list(1, 2, 3, 4, 5, 6)
    return list.any[int64](nums, gt_five)

verify any_big_test:
    assert any_big_test() == true

function any_huge_test() returns bool:
    list[int64] nums = list(1, 2, 3, 4, 5, 6)
    return list.any[int64](nums, gt_ten)

verify any_huge_test:
    assert any_huge_test() == false

function count_evens_test() returns int64:
    list[int64] nums = list(1, 2, 3, 4, 5, 6)
    return list.count[int64](nums, is_even)

verify count_evens_test:
    assert count_evens_test() == 3

function sum_test() returns int64:
    return list.sum[int64](list(1, 2, 3, 4, 5, 6))

verify sum_test:
    assert sum_test() == 21

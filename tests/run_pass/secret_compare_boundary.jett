namespace test
function equal_strings() returns bool:
    secret[string] left = "agent-key"
    secret[string] right = "agent-key"
    return secret.compare(left, right)
function unequal_strings() returns bool:
    secret[string] left = "agent-key"
    secret[string] right = "agent-kex"
    return secret.compare(left, right)
function different_length_strings() returns bool:
    secret[string] left = "agent-key"
    secret[string] right = "agent-key-longer"
    return secret.compare(left, right)
function equal_unicode_strings() returns bool:
    secret[string] left = "Jett 🚀"
    secret[string] right = "Jett 🚀"
    return secret.compare(left, right)
function equal_strings_pipeline() returns bool:
    secret[string] left = "pipeline"
    secret[string] right = "pipeline"
    return left into secret.compare(right)
function equal_bytes() returns bool:
    secret[bytes] left = bytes.from_string("payload")
    secret[bytes] right = bytes.from_string("payload")
    return secret.compare(left, right)
function unequal_bytes() returns bool:
    secret[bytes] left = bytes.from_string("payload")
    secret[bytes] right = bytes.from_string("payloae")
    return secret.compare(left, right)
function equal_empty_bytes() returns bool:
    secret[bytes] left = bytes.new()
    secret[bytes] right = bytes.new()
    return secret.compare(left, right)
verify secret_compare_boundary:
    assert equal_strings()
    assert not unequal_strings()
    assert not different_length_strings()
    assert equal_unicode_strings()
    assert equal_strings_pipeline()
    assert equal_bytes()
    assert not unequal_bytes()
    assert equal_empty_bytes()

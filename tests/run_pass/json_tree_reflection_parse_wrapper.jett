namespace test

type TreeScores = map[string, int64]
type TreeNonEmpty = string where string.char_count(value) > 0

enum TreeDirection:
    north
    south

enum TreeProtocol:
    tcp = 6
    udp = 17

enum TreeShape:
    empty
    point(x: int64, y: int64)

struct TreeProfile:
    city: string
    visits: list[int64]

struct TreeCredential:
    name: string
    token: secret[string]

bitfield TreeHeader:
    version: 4 bits
    header_length: 4 bits
    protocol: 8 bits as TreeProtocol

struct TreeUser:
    id: string serialize "userId"
    active: bool
    profile: TreeProfile
    direction: TreeDirection
    tags: list[string]
    nickname: optional[string]
    missing: optional[string]
    scores: TreeScores

struct TreeFull:
    header: TreeHeader
    shape: TreeShape
    lucky: set[int64]
    display: TreeNonEmpty
    outcome: result[int64, string]
    failed: result[int64, string]
    credential: TreeCredential
    data: bytes

function tree_reflected_parse_summary() returns string:
    TreeUser user = json.json_tree_parse_reflected[TreeUser]("{{\"userId\":\"u1\",\"active\":true,\"profile\":{{\"city\":\"Cluj\",\"visits\":[3,5]}},\"direction\":\"south\",\"tags\":[\"admin\",\"beta\"],\"nickname\":\"ally\",\"scores\":{{\"wins\":3}}}}") handle error:
        return error
    string nick = user.nickname handle:
        default "none"
    string missing = user.missing handle:
        default "none"
    int64 wins = map.get[string, int64](user.scores, "wins") handle:
        default 0
    bool south = user.direction == TreeDirection.south
    return "{user.id}:{user.active}:{user.profile.city}:{list.length[int64](user.profile.visits)}:{list.length[string](user.tags)}:{nick}:{missing}:{wins}:{south}"

function tree_reflected_missing_error() returns string:
    TreeUser user = json.json_tree_parse_reflected[TreeUser]("{{\"userId\":\"u1\",\"profile\":{{\"city\":\"Cluj\",\"visits\":[3]}},\"direction\":\"south\",\"tags\":[],\"scores\":{{\"wins\":3}}}}") handle error:
        return error
    return user.id

function tree_reflected_wrong_item_error() returns string:
    TreeUser user = json.json_tree_parse_reflected[TreeUser]("{{\"userId\":\"u1\",\"active\":true,\"profile\":{{\"city\":\"Cluj\",\"visits\":[3]}},\"direction\":\"south\",\"tags\":[1],\"scores\":{{\"wins\":3}}}}") handle error:
        return error
    return user.id

function tree_reflected_decode_existing_tree() returns string:
    json.JsonTree tree = json.json_tree_parse("\"Ada\"") handle error:
        return error
    string value = json.json_decode_tree_reflected[string](view tree) handle error:
        return error
    return value

function tree_reflected_full_summary() returns string:
    TreeFull item = json.json_tree_parse_reflected[TreeFull]("{{\"header\":{{\"version\":4,\"header_length\":5,\"protocol\":\"tcp\"}},\"shape\":{{\"point\":[3,4]}},\"lucky\":[11,13],\"display\":\"ready\",\"outcome\":{{\"ok\":7}},\"failed\":{{\"fail\":\"bad\"}},\"credential\":{{\"name\":\"svc\",\"token\":\"secret-token\"}},\"data\":\"0x4869\"}}") handle error:
        return error
    bool tcp = item.header.protocol == TreeProtocol.tcp
    int64 shape_total = 0
    match item.shape:
        empty:
            shape_total = -1
        point(x, y):
            shape_total = x + y
    int64 outcome = item.outcome handle error:
        default -1
    int64 lucky_count = set.length[int64](item.lucky)
    bool lucky = set.contains[int64](item.lucky, 13)
    int64 first = bytes.get(item.data, 0) handle:
        default -1
    return "{item.header.version}:{item.header.header_length}:{tcp}:{shape_total}:{lucky_count}:{lucky}:{coarsen item.display}:{outcome}:{secret.redact(item.credential.token)}:{bytes.length(item.data)}:{first}"

function tree_reflected_result_failure() returns string:
    TreeFull item = json.json_tree_parse_reflected[TreeFull]("{{\"header\":{{\"version\":4,\"header_length\":5,\"protocol\":\"tcp\"}},\"shape\":{{\"point\":[3,4]}},\"lucky\":[11,13],\"display\":\"ready\",\"outcome\":{{\"ok\":7}},\"failed\":{{\"fail\":\"bad\"}},\"credential\":{{\"name\":\"svc\",\"token\":\"secret-token\"}},\"data\":\"0x4869\"}}") handle error:
        return error
    int64 ignored = item.failed handle error:
        return error
    return "{ignored}"

function tree_reflected_invalid_refinement_message() returns string:
    TreeFull item = json.json_tree_parse_reflected[TreeFull]("{{\"header\":{{\"version\":4,\"header_length\":5,\"protocol\":\"tcp\"}},\"shape\":{{\"point\":[3,4]}},\"lucky\":[13],\"display\":\"\",\"outcome\":{{\"ok\":7}},\"failed\":{{\"fail\":\"bad\"}},\"credential\":{{\"name\":\"svc\",\"token\":\"secret-token\"}},\"data\":\"0x4869\"}}") handle error:
        return error
    return coarsen item.display

function tree_reflected_invalid_bitfield_message() returns string:
    TreeFull item = json.json_tree_parse_reflected[TreeFull]("{{\"header\":{{\"version\":16,\"header_length\":5,\"protocol\":\"tcp\"}},\"shape\":{{\"point\":[3,4]}},\"lucky\":[13],\"display\":\"ready\",\"outcome\":{{\"ok\":7}},\"failed\":{{\"fail\":\"bad\"}},\"credential\":{{\"name\":\"svc\",\"token\":\"secret-token\"}},\"data\":\"0x4869\"}}") handle error:
        return error
    return "{item.header.version}"

verify json_tree_reflection_parse_wrapper:
    assert tree_reflected_parse_summary() == "u1:true:Cluj:2:2:ally:none:3:true"
    assert tree_reflected_missing_error() == "missing required field 'active' for TreeUser"
    assert string.contains(tree_reflected_wrong_item_error(), "tags: 0: expected string") == true
    assert tree_reflected_decode_existing_tree() == "Ada"
    assert tree_reflected_full_summary() == "4:5:true:7:2:true:ready:7:***:2:72"
    assert tree_reflected_result_failure() == "bad"
    assert string.contains(tree_reflected_invalid_refinement_message(), "refinement type constraint failed") == true
    assert string.contains(tree_reflected_invalid_bitfield_message(), "bitfield 'TreeHeader' field 'version'") == true

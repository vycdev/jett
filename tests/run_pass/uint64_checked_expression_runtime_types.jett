interface Show:
    function show(view self: Show) returns string
implement Show for int64:
    function show(view self: int64) returns string:
        return "int64"
implement Show for uint64:
    function show(view self: uint64) returns string:
        return "uint64"
function constructed_list_uint64_dispatch() returns string:
    list[uint64] values = list(42)
    uint64 fallback = 0
    return Show.show(view(list.get[uint64](view values, 0) handle:
        default fallback
    ))
function appended_list_uint64_dispatch() returns string:
    list[uint64] values = list.new[uint64]()
    values = list.append[uint64](view values, 7)
    uint64 fallback = 0
    return Show.show(view(list.get[uint64](view values, 0) handle:
        default fallback
    ))
function map_value_uint64_dispatch() returns string:
    map[string, uint64] values = map("count": 9)
    optional[uint64] maybe_value = map.get[string, uint64](view values, "count")
    uint64 fallback = 0
    return Show.show(view(maybe_value handle:
        default fallback
    ))
function set_to_list_uint64_dispatch() returns string:
    mutable set[uint64] values = set.new[uint64]()
    values = set.add[uint64](values, 17)
    list[uint64] items = set.to_list[uint64](view values)
    uint64 fallback = 0
    return Show.show(view(list.get[uint64](view items, 0) handle:
        default fallback
    ))
function optional_uint64_dispatch() returns string:
    optional[uint64] maybe_value = some(11)
    uint64 fallback = 0
    return Show.show(view(maybe_value handle:
        default fallback
    ))
function result_uint64_dispatch() returns string:
    result[uint64, string] maybe_value = ok(13)
    uint64 fallback = 0
    return Show.show(view(maybe_value handle error:
        default fallback
    ))
verify uint64_checked_expression_runtime_types:
    assert constructed_list_uint64_dispatch() == "uint64"
    assert appended_list_uint64_dispatch() == "uint64"
    assert map_value_uint64_dispatch() == "uint64"
    assert set_to_list_uint64_dispatch() == "uint64"
    assert optional_uint64_dispatch() == "uint64"
    assert result_uint64_dispatch() == "uint64"

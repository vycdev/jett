namespace test

struct Profile:
    city: string

struct Session:
    id: string
    profile: Profile
    token: secret[string]

struct PublicSession:
    id: string
    profile: Profile

function session_summary(session: Session) returns string:
    return "{session.id}:{session.profile.city}:{secret.redact(session.token)}"

function public_summary(session: PublicSession) returns string:
    return "{session.id}:{session.profile.city}"

function public_serializer_matches_hook() returns bool:
    Profile profile = Profile(city: "Cluj")
    Session session = Session(id: "s1", profile: profile, token: "secret-token")
    string public_name = json.serialize_public[Session](view session)
    string hook_name = json.json_serialize_public_reflected[Session](view session)
    return public_name == hook_name

function full_serializer_matches_hook() returns bool:
    Profile profile = Profile(city: "Cluj")
    PublicSession session = PublicSession(id: "s1", profile: profile)
    string public_name = json.serialize[PublicSession](view session)
    string hook_name = json.json_serialize_reflected[PublicSession](view session)
    return public_name == hook_name

function parse_matches_hook() returns string:
    string raw = "{{\"id\":\"s1\",\"profile\":{{\"city\":\"Cluj\"}},\"token\":\"secret-token\"}}"
    Session public_name = json.parse[Session](raw) handle error:
        return error
    Session hook_name = json.json_parse_reflected[Session](raw) handle error:
        return error
    return "{session_summary(public_name)}|{session_summary(hook_name)}"

verify json_stdlib_bridge_delegation:
    assert public_serializer_matches_hook() == true
    assert full_serializer_matches_hook() == true
    assert parse_matches_hook() == "s1:Cluj:***|s1:Cluj:***"

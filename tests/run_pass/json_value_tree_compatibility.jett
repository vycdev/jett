namespace test
struct RawHolder:
    raw: json.JsonTree
function raw_name(raw: json.JsonTree) returns string:
    json.JsonTree name = json.field(raw, "name") handle:
        return "missing name"
    return json.as_string(name) handle error:
        default error
function tree_name(view tree: json.JsonTree) returns string:
    json.JsonTree name = json.json_tree_field(view tree, "name") handle:
        return "missing name"
    return json.json_tree_as_string(view name) handle error:
        default error
function raw_from_tree_assignment() returns string:
    json.JsonTree tree = json.json_tree_parse("{{\"name\":\"Ada\"}}") handle error:
        return error
    json.JsonTree raw = tree
    return raw_name(raw)
function tree_from_raw_assignment() returns string:
    json.JsonTree raw = json.parse_raw("{{\"name\":\"Grace\"}}") handle error:
        return error
    json.JsonTree tree = raw
    return tree_name(view tree)
function raw_param_accepts_tree() returns string:
    json.JsonTree tree = json.json_tree_parse("{{\"name\":\"Lin\"}}") handle error:
        return error
    return raw_name(tree)
function tree_param_accepts_raw() returns string:
    json.JsonTree raw = json.parse_raw("{{\"name\":\"Edsger\"}}") handle error:
        return error
    return tree_name(view raw)
function raw_builtin_accepts_tree() returns string:
    json.JsonTree tree = json.json_tree_parse("{{\"name\":\"Barbara\"}}") handle error:
        return error
    json.JsonTree name = json.field(tree, "name") handle:
        return "missing name"
    return json.as_string(name) handle error:
        default error
function raw_kind_accepts_tree() returns string:
    json.JsonTree tree = json.json_tree_parse("{{\"name\":\"Katherine\"}}") handle error:
        return error
    return json.kind(tree)
function list_tree_to_raw_compatibility() returns string:
    json.JsonTree tree = json.json_tree_parse("\"Margaret\"") handle error:
        return error
    list[json.JsonTree] trees = list(tree)
    list[json.JsonTree] raws = trees
    json.JsonTree raw = list.get[json.JsonTree](view raws, 0) handle:
        return "missing"
    return json.as_string(raw) handle error:
        default error
function optional_tree_to_raw_compatibility() returns string:
    json.JsonTree tree = json.json_tree_parse("\"Dorothy\"") handle error:
        return error
    optional[json.JsonTree] maybe_tree = some(tree)
    optional[json.JsonTree] maybe_raw = maybe_tree
    json.JsonTree raw = maybe_raw handle:
        return "none"
    return json.as_string(raw) handle error:
        default error
function result_tree_to_raw_compatibility() returns string:
    json.JsonTree tree = json.json_tree_parse("\"Evelyn\"") handle error:
        return error
    result[json.JsonTree, string] tree_result = ok(tree)
    result[json.JsonTree, string] raw_result = tree_result
    json.JsonTree raw = raw_result handle error:
        return error
    return json.as_string(raw) handle error:
        default error
function list_raw_to_tree_compatibility() returns string:
    json.JsonTree raw = json.parse_raw("\"Frances\"") handle error:
        return error
    list[json.JsonTree] raws = list(raw)
    list[json.JsonTree] trees = raws
    json.JsonTree tree = list.get[json.JsonTree](view trees, 0) handle:
        return "missing"
    return json.json_tree_as_string(view tree) handle error:
        default error
function optional_raw_to_tree_compatibility() returns string:
    json.JsonTree raw = json.parse_raw("\"Mary\"") handle error:
        return error
    optional[json.JsonTree] maybe_raw = some(raw)
    optional[json.JsonTree] maybe_tree = maybe_raw
    json.JsonTree tree = maybe_tree handle:
        return "none"
    return json.json_tree_as_string(view tree) handle error:
        default error
function result_raw_to_tree_compatibility() returns string:
    json.JsonTree raw = json.parse_raw("\"Rachel\"") handle error:
        return error
    result[json.JsonTree, string] raw_result = ok(raw)
    result[json.JsonTree, string] tree_result = raw_result
    json.JsonTree tree = tree_result handle error:
        return error
    return json.json_tree_as_string(view tree) handle error:
        default error
function map_tree_to_raw_compatibility() returns string:
    json.JsonTree tree = json.json_tree_parse("\"Annie\"") handle error:
        return error
    map[string, json.JsonTree] trees = map("item": tree)
    map[string, json.JsonTree] raws = trees
    json.JsonTree raw = map.get[string, json.JsonTree](view raws, "item") handle:
        return "missing"
    return json.as_string(raw) handle error:
        default error
function map_raw_to_tree_compatibility() returns string:
    json.JsonTree raw = json.parse_raw("\"Ruth\"") handle error:
        return error
    map[string, json.JsonTree] raws = map("item": raw)
    map[string, json.JsonTree] trees = raws
    json.JsonTree tree = map.get[string, json.JsonTree](view trees, "item") handle:
        return "missing"
    return json.json_tree_as_string(view tree) handle error:
        default error
function set_tree_to_raw_compatibility() returns string:
    json.JsonTree tree = json.json_tree_parse("\"Karen\"") handle error:
        return error
    mutable set[json.JsonTree] trees = set.new[json.JsonTree]()
    trees = set.add[json.JsonTree](trees, tree)
    set[json.JsonTree] raws = trees
    list[json.JsonTree] raw_items = set.to_list[json.JsonTree](raws)
    json.JsonTree raw = list.get[json.JsonTree](view raw_items, 0) handle:
        return "missing"
    return json.as_string(raw) handle error:
        default error
function set_raw_to_tree_compatibility() returns string:
    json.JsonTree raw = json.parse_raw("\"Sophie\"") handle error:
        return error
    mutable set[json.JsonTree] raws = set.new[json.JsonTree]()
    raws = set.add[json.JsonTree](raws, raw)
    set[json.JsonTree] trees = raws
    list[json.JsonTree] tree_items = set.to_list[json.JsonTree](trees)
    json.JsonTree tree = list.get[json.JsonTree](view tree_items, 0) handle:
        return "missing"
    return json.json_tree_as_string(view tree) handle error:
        default error
function secret_tree_to_raw_compatibility() returns string:
    json.JsonTree tree = json.json_tree_parse("\"Hedy\"") handle error:
        return error
    secret[json.JsonTree] tree_secret = tree
    secret[json.JsonTree] raw_secret = tree_secret
    return secret.redact(raw_secret)
function secret_raw_to_tree_compatibility() returns string:
    json.JsonTree raw = json.parse_raw("\"Elizebeth\"") handle error:
        return error
    secret[json.JsonTree] raw_secret = raw
    secret[json.JsonTree] tree_secret = raw_secret
    return secret.redact(tree_secret)
function return_raw_from_tree() returns json.JsonTree:
    json.JsonTree tree = json.json_tree_parse("\"Ida\"") handle error:
        return json.JsonTree.string_value(error)
    return tree
function return_tree_from_raw() returns json.JsonTree:
    json.JsonTree raw = json.parse_raw("\"Radia\"") handle error:
        return json.JsonTree.string_value(error)
    return raw
function return_raw_from_tree_text() returns string:
    return json.as_string(return_raw_from_tree()) handle error:
        default error
function return_tree_from_raw_text() returns string:
    return json.json_tree_as_string(view return_tree_from_raw()) handle error:
        default error
function struct_field_accepts_tree() returns string:
    json.JsonTree tree = json.json_tree_parse("\"Joan\"") handle error:
        return error
    RawHolder holder = RawHolder(raw: tree)
    return json.as_string(holder.raw) handle error:
        default error
function sample_object_tree() returns json.JsonTree:
    json.JsonTree object_tree = json.json_tree_parse("{{\"name\":\"Barbara\",\"scores\":[3,5],\"active\":true,\"ratio\":2.5,\"missing\":null}}") handle error:
        return json.JsonTree.string_value(error)
    return object_tree
function raw_index_accepts_tree() returns int64:
    json.JsonTree object_tree = sample_object_tree()
    json.JsonTree scores = json.field(object_tree, "scores") handle:
        return 0
    json.JsonTree second = json.index(scores, 1) handle:
        return 0
    return json.as_int64(second) handle error:
        default 0
function raw_array_length_accepts_tree() returns int64:
    json.JsonTree object_tree = sample_object_tree()
    json.JsonTree scores = json.field(object_tree, "scores") handle:
        return 0
    return json.array_length(scores) handle error:
        default 0
function raw_object_keys_accepts_tree() returns int64:
    list[string] keys = json.object_keys(sample_object_tree()) handle error:
        return 0
    return list.length[string](view keys)
function raw_as_string_accepts_tree() returns string:
    json.JsonTree tree = json.json_tree_parse("\"Barbara\"") handle error:
        return error
    return json.as_string(tree) handle error:
        default error
function raw_as_bool_accepts_tree() returns bool:
    json.JsonTree object_tree = sample_object_tree()
    json.JsonTree active_raw = json.field(object_tree, "active") handle:
        return false
    return json.as_bool(active_raw) handle error:
        default false
function raw_as_float64_accepts_tree() returns float64:
    json.JsonTree object_tree = sample_object_tree()
    json.JsonTree ratio_raw = json.field(object_tree, "ratio") handle:
        return 0.0
    return json.as_float64(ratio_raw) handle error:
        default 0.0
function raw_as_uint64_accepts_tree() returns string:
    json.JsonTree object_tree = json.json_tree_parse("{{\"serial\":18446744073709551615}}") handle error:
        return error
    json.JsonTree serial_raw = json.field(object_tree, "serial") handle:
        return "missing serial"
    uint64 serial = json.as_uint64(serial_raw) handle error:
        return error
    return string.from_uint64(serial)
function raw_is_null_accepts_tree() returns bool:
    json.JsonTree object_tree = sample_object_tree()
    json.JsonTree missing = json.field(object_tree, "missing") handle:
        return false
    return json.is_null(missing)
function raw_is_object_accepts_tree() returns bool:
    return json.is_object(sample_object_tree())
function raw_is_array_accepts_tree() returns bool:
    json.JsonTree array_tree = json.json_tree_parse("[1]") handle error:
        return false
    return json.is_array(array_tree)
function raw_is_number_accepts_tree() returns bool:
    json.JsonTree number_tree = json.json_tree_parse("5") handle error:
        return false
    return json.is_number(number_tree)
function raw_is_bool_accepts_tree() returns bool:
    json.JsonTree bool_tree = json.json_tree_parse("true") handle error:
        return false
    return json.is_bool(bool_tree)
function raw_is_string_accepts_tree() returns bool:
    json.JsonTree string_tree = json.json_tree_parse("\"Barbara\"") handle error:
        return false
    return json.is_string(string_tree)
function raw_serialize_accepts_tree() returns bool:
    string raw = json.serialize_raw(sample_object_tree())
    return string.contains(raw, "Barbara")
function raw_helpers_view_tree_without_consuming() returns string:
    json.JsonTree tree = sample_object_tree()
    string kind = json.kind(tree)
    bool is_object = json.is_object(tree)
    list[string] keys = json.object_keys(tree) handle error:
        return error
    json.JsonTree name_raw = json.field(tree, "name") handle:
        return "missing name"
    string raw = json.serialize_raw(tree)
    string name = json.as_string(name_raw) handle error:
        return error
    bool serialized = string.contains(raw, "Barbara")
    string tree_kind = json.json_tree_kind(view tree)
    return "{kind}:{is_object}:{list.length[string](view keys)}:{name}:{serialized}:{tree_kind}"
function legacy_json_value_public_parse_bridge() returns string:
    json.JsonTree raw = json.parse[json.JsonTree]("{{\"name\":\"Ada\",\"score\":5}}") handle error:
        return error
    json.JsonTree name = json.field(raw, "name") handle:
        return "missing"
    return json.as_string(name) handle error:
        default error
function legacy_json_value_public_serialize_bridge() returns string:
    json.JsonTree raw = json.parse_raw("{{\"name\":\"Ada\",\"score\":5}}") handle error:
        return error
    return json.serialize[json.JsonTree](view raw)
function namespaced_json_value_alias_roundtrip() returns string:
    json.JsonValue raw = json.parse_raw("{{\"name\":\"Alice\"}}") handle error:
        return error
    json.JsonValue name = json.require_field(view raw, "name") handle error:
        return error
    json.JsonTree tree = name
    return json.json_tree_as_string(view tree) handle error:
        default error
function namespaced_json_value_alias_uint64_accessor() returns string:
    json.JsonValue raw = json.parse_raw("18446744073709551615") handle error:
        return error
    uint64 value = json.as_uint64(view raw) handle error:
        return error
    return string.from_uint64(value)
function namespaced_json_value_alias_to_legacy() returns string:
    json.JsonValue raw = json.json_tree_parse("\"Carol\"") handle error:
        return error
    json.JsonTree legacy = raw
    return json.as_string(legacy) handle error:
        default error
function namespaced_json_value_alias_container_bridge() returns string:
    json.JsonValue raw = json.parse_raw("\"Alice\"") handle error:
        return error
    list[json.JsonValue] aliases = list(raw)
    list[json.JsonTree] trees = aliases
    json.JsonTree tree = list.get[json.JsonTree](view trees, 0) handle:
        return "missing"
    list[json.JsonTree] legacies = aliases
    json.JsonTree legacy = list.get[json.JsonTree](view legacies, 0) handle:
        return "missing"
    string tree_text = json.json_tree_as_string(view tree) handle error:
        return error
    string legacy_text = json.as_string(legacy) handle error:
        return error
    return "{tree_text}:{legacy_text}"
function namespaced_json_value_alias_recursive_bridge() returns string:
    json.JsonValue raw = json.parse_raw("\"Dina\"") handle error:
        return error
    optional[json.JsonValue] maybe_alias = some(raw)
    optional[json.JsonTree] maybe_tree = maybe_alias
    json.JsonTree tree = maybe_tree handle:
        return "none"
    result[json.JsonValue, string] alias_result = ok(raw)
    result[json.JsonTree, string] legacy_result = alias_result
    json.JsonTree legacy = legacy_result handle error:
        return error
    map[string, json.JsonValue] alias_map = map("item": raw)
    map[string, json.JsonTree] tree_map = alias_map
    json.JsonTree mapped = map.get[string, json.JsonTree](view tree_map, "item") handle:
        return "missing"
    secret[json.JsonValue] alias_secret = raw
    secret[json.JsonTree] tree_secret = alias_secret
    string tree_text = json.json_tree_as_string(view tree) handle error:
        return error
    string legacy_text = json.as_string(legacy) handle error:
        return error
    string mapped_text = json.json_tree_as_string(view mapped) handle error:
        return error
    return "{tree_text}:{legacy_text}:{mapped_text}:{secret.redact(tree_secret)}"
verify json_value_tree_compatibility:
    assert raw_from_tree_assignment() == "Ada"
    assert tree_from_raw_assignment() == "Grace"
    assert raw_param_accepts_tree() == "Lin"
    assert tree_param_accepts_raw() == "Edsger"
    assert raw_builtin_accepts_tree() == "Barbara"
    assert raw_kind_accepts_tree() == "object"
    assert list_tree_to_raw_compatibility() == "Margaret"
    assert optional_tree_to_raw_compatibility() == "Dorothy"
    assert result_tree_to_raw_compatibility() == "Evelyn"
    assert list_raw_to_tree_compatibility() == "Frances"
    assert optional_raw_to_tree_compatibility() == "Mary"
    assert result_raw_to_tree_compatibility() == "Rachel"
    assert map_tree_to_raw_compatibility() == "Annie"
    assert map_raw_to_tree_compatibility() == "Ruth"
    assert set_tree_to_raw_compatibility() == "Karen"
    assert set_raw_to_tree_compatibility() == "Sophie"
    assert secret_tree_to_raw_compatibility() == "***"
    assert secret_raw_to_tree_compatibility() == "***"
    assert return_raw_from_tree_text() == "Ida"
    assert return_tree_from_raw_text() == "Radia"
    assert struct_field_accepts_tree() == "Joan"
    assert raw_index_accepts_tree() == 5
    assert raw_array_length_accepts_tree() == 2
    assert raw_object_keys_accepts_tree() == 5
    assert raw_as_string_accepts_tree() == "Barbara"
    assert raw_as_bool_accepts_tree() == true
    assert raw_as_float64_accepts_tree() == 2.5
    assert raw_as_uint64_accepts_tree() == "18446744073709551615"
    assert raw_is_null_accepts_tree() == true
    assert raw_is_object_accepts_tree() == true
    assert raw_is_array_accepts_tree() == true
    assert raw_is_number_accepts_tree() == true
    assert raw_is_bool_accepts_tree() == true
    assert raw_is_string_accepts_tree() == true
    assert raw_serialize_accepts_tree() == true
    assert raw_helpers_view_tree_without_consuming() == "object:true:5:Barbara:true:object"
    assert legacy_json_value_public_parse_bridge() == "Ada"
    string legacy_serialized = legacy_json_value_public_serialize_bridge()
    assert string.contains(legacy_serialized, "\"name\":\"Ada\"") == true
    assert string.contains(legacy_serialized, "\"score\":5") == true
    assert namespaced_json_value_alias_roundtrip() == "Alice"
    assert namespaced_json_value_alias_uint64_accessor() == "18446744073709551615"
    assert namespaced_json_value_alias_to_legacy() == "Carol"
    assert namespaced_json_value_alias_container_bridge() == "Alice:Alice"
    assert namespaced_json_value_alias_recursive_bridge() == "Dina:Dina:Dina:***"

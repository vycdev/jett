namespace test
function tree_parse_error(raw: string) returns string:
    json.JsonTree tree = json.json_tree_parse(raw) handle error:
        return error
    return json.json_tree_serialize(tree)
function raw_parse_error(raw: string) returns string:
    json.JsonTree tree = json.parse_raw(raw) handle error:
        return error
    return json.serialize_raw(view tree)
function typed_json_value_error(raw: string) returns string:
    JsonValue value = json.parse[JsonValue](raw) handle error:
        return error
    return json.serialize_raw(view value)
function typed_json_value_alias_error(raw: string) returns string:
    json.JsonValue value = json.parse[json.JsonValue](raw) handle error:
        return error
    return json.serialize_raw(view value)
function typed_json_tree_error(raw: string) returns string:
    json.JsonTree value = json.parse[json.JsonTree](raw) handle error:
        return error
    return json.serialize_raw(view value)
function exact_json_value_error(raw: string) returns string:
    JsonValue value = json.parse_exact[JsonValue](raw) handle error:
        return error
    return json.serialize_raw(view value)
function exact_json_value_alias_error(raw: string) returns string:
    json.JsonValue value = json.parse_exact[json.JsonValue](raw) handle error:
        return error
    return json.serialize_raw(view value)
function exact_json_tree_error(raw: string) returns string:
    json.JsonTree value = json.parse_exact[json.JsonTree](raw) handle error:
        return error
    return json.serialize_raw(view value)
function parse_errors_match(raw: string) returns bool:
    string tree_error = tree_parse_error(raw)
    string raw_error = raw_parse_error(raw)
    string legacy_typed_error = typed_json_value_error(raw)
    string alias_typed_error = typed_json_value_alias_error(raw)
    string tree_typed_error = typed_json_tree_error(raw)
    string legacy_exact_error = exact_json_value_error(raw)
    string alias_exact_error = exact_json_value_alias_error(raw)
    string tree_exact_error = exact_json_tree_error(raw)
    if tree_error != raw_error:
        return false
    if tree_error != legacy_typed_error:
        return false
    if tree_error != alias_typed_error:
        return false
    if tree_error != tree_typed_error:
        return false
    if tree_error != legacy_exact_error:
        return false
    if tree_error != alias_exact_error:
        return false
    if tree_error != tree_exact_error:
        return false
    return true
function raw_from_hex(hex: string) returns string:
    bytes raw = bytes.from_hex(hex) handle error:
        return error
    return bytes.to_string(raw) handle error:
        default error
verify json_parse_error_parity:
    assert tree_parse_error("") == "expected JSON value"
    assert tree_parse_error("   ") == "expected JSON value"
    assert tree_parse_error(raw_from_hex("0c31")) == "expected JSON scalar"
    assert tree_parse_error("\"bad") == "unterminated JSON string"
    assert tree_parse_error("[1,]") == "expected JSON value"
    assert tree_parse_error("{{\"name\":1") == "unterminated JSON object"
    assert tree_parse_error("01") == "invalid JSON number"
    assert parse_errors_match("") == true
    assert parse_errors_match("   ") == true
    assert parse_errors_match(raw_from_hex("0c31")) == true
    assert parse_errors_match(raw_from_hex("310c")) == true
    assert parse_errors_match("\"bad") == true
    assert parse_errors_match("\"Ada\" trailing") == true
    assert parse_errors_match("\"\\") == true
    assert parse_errors_match("\"\\q\"") == true
    assert parse_errors_match("\"line\nnext\"") == true
    assert parse_errors_match(raw_from_hex("220022")) == true
    assert parse_errors_match(raw_from_hex("221f22")) == true
    assert parse_errors_match("\"\\u00xz\"") == true
    assert parse_errors_match("\"\\u004\"") == true
    assert parse_errors_match("\"\\ud800\"") == true
    assert parse_errors_match("\"\\ud834\"") == true
    assert parse_errors_match("\"\\udc00\"") == true
    assert parse_errors_match("\"\\udd1e\"") == true
    assert parse_errors_match("\"\\udfff\"") == true
    assert parse_errors_match("\"\\ud800\\ud800\"") == true
    assert parse_errors_match("\"\\ud800\\ud7ff\"") == true
    assert parse_errors_match("\"\\ud800\\ue000\"") == true
    assert parse_errors_match("\"\\ud834\\u0041\"") == true
    assert parse_errors_match("\"\\ud834abcdef\"") == true
    assert parse_errors_match("\"\\ud834\\uddxz\"") == true
    assert parse_errors_match("\"\\udbff\"") == true
    assert parse_errors_match("\"\\udbff\\ue000\"") == true
    assert parse_errors_match("[1,]") == true
    assert parse_errors_match("[,1]") == true
    assert parse_errors_match("[1,,2]") == true
    assert parse_errors_match("[1") == true
    assert parse_errors_match("[\"bad]") == true
    assert parse_errors_match("[1 2]") == true
    assert parse_errors_match("[\"a\" \"b\"]") == true
    assert parse_errors_match("[true false]") == true
    assert parse_errors_match("[[1] [2]]") == true
    assert parse_errors_match("[1] trailing") == true
    assert parse_errors_match("[1}}") == true
    assert parse_errors_match("{{]") == true
    assert parse_errors_match("{{name:1}}") == true
    assert parse_errors_match("{{:1}}") == true
    assert parse_errors_match("{{\"name\"}}") == true
    assert parse_errors_match("{{\"name\":}}") == true
    assert parse_errors_match("{{\"a\":1 \"b\":2}}") == true
    assert parse_errors_match("{{\"a\":\"x\" \"b\":2}}") == true
    assert parse_errors_match("{{\"a\":[1] \"b\":2}}") == true
    assert parse_errors_match("{{\"name\":1,}}") == true
    assert parse_errors_match("{{,\"a\":1}}") == true
    assert parse_errors_match("{{\"a\":1,,\"b\":2}}") == true
    assert parse_errors_match("{{\"a\":1,\"a\":2}}") == true
    assert parse_errors_match("{{\"\\u0061\":1,\"a\":2}}") == true
    assert parse_errors_match("{{\"a/b\":1,\"a\\/b\":2}}") == true
    assert parse_errors_match("{{\"a\\\"b\":1,\"a\\u0022b\":2}}") == true
    assert parse_errors_match(raw_from_hex("7b22636166c3a9223a312c226361665c7530306539223a327d")) == true
    assert parse_errors_match("{{\"name\":1") == true
    assert parse_errors_match("{{\"name\":1}} trailing") == true
    assert parse_errors_match("{{\"name\":1]") == true
    assert parse_errors_match("[{{\"a\":1]]") == true
    assert parse_errors_match("[{{\"a\":1]}}") == true
    assert parse_errors_match("[1]]") == true
    assert parse_errors_match("]") == true
    assert parse_errors_match("}}") == true
    assert parse_errors_match(raw_from_hex("5b310c5d")) == true
    assert parse_errors_match(raw_from_hex("7b2261223a0c317d")) == true
    assert parse_errors_match("01") == true
    assert parse_errors_match("00") == true
    assert parse_errors_match("-01") == true
    assert parse_errors_match("+1") == true
    assert parse_errors_match("-") == true
    assert parse_errors_match(":") == true
    assert parse_errors_match("1.") == true
    assert parse_errors_match("1 2") == true
    assert parse_errors_match("0x1") == true
    assert parse_errors_match("1e") == true
    assert parse_errors_match("1e+") == true
    assert parse_errors_match("1E-") == true
    assert parse_errors_match("nullx") == true
    assert parse_errors_match("falsex") == true
    assert parse_errors_match("true false") == true
    assert parse_errors_match("tru") == true
    assert parse_errors_match("fal") == true
    assert parse_errors_match("nope") == true

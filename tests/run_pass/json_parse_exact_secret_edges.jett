namespace test
struct SecretProfile:
    display_name: string serialize "displayName"
    note: string
struct SecretEnvelope:
    id: string
    credential: secret[SecretProfile]
function parse_exact_secret_profile_accepts_closed_shape() returns string:
    secret[SecretProfile] profile = json.parse_exact[secret[SecretProfile]]("{{\"displayName\":\"Ada\",\"note\":\"ok\"}}") handle error:
        return error
    return secret.redact(profile)
function parse_exact_secret_profile_rejects_extra_field() returns string:
    secret[SecretProfile] profile = json.parse_exact[secret[SecretProfile]]("{{\"displayName\":\"Ada\",\"note\":\"ok\",\"extra\":true}}") handle error:
        return error
    return secret.redact(profile)
function parse_exact_optional_secret_null_accepts() returns string:
    optional[secret[SecretProfile]] profile = json.parse_exact[optional[secret[SecretProfile]]]("null") handle error:
        return error
    secret[SecretProfile] item = profile handle:
        return "none"
    return secret.redact(item)
function parse_exact_optional_secret_rejects_extra_field() returns string:
    optional[secret[SecretProfile]] profile = json.parse_exact[optional[secret[SecretProfile]]]("{{\"displayName\":\"Ada\",\"note\":\"ok\",\"extra\":true}}") handle error:
        return error
    secret[SecretProfile] item = profile handle:
        return "none"
    return secret.redact(item)
function parse_exact_result_ok_secret_rejects_extra_field() returns string:
    result[secret[SecretProfile], string] parsed = json.parse_exact[result[secret[SecretProfile], string]]("{{\"ok\":{{\"displayName\":\"Ada\",\"note\":\"ok\",\"extra\":true}}}}") handle error:
        return error
    secret[SecretProfile] item = parsed handle error:
        return error
    return secret.redact(item)
function parse_exact_result_fail_secret_rejects_extra_field() returns string:
    result[string, secret[SecretProfile]] parsed = json.parse_exact[result[string, secret[SecretProfile]]]("{{\"fail\":{{\"displayName\":\"Ada\",\"note\":\"ok\",\"extra\":true}}}}") handle error:
        return error
    string item = parsed handle error:
        return secret.redact(error)
    return item
function parse_exact_secret_field_rejects_extra_field() returns string:
    string raw = "{{\"id\":\"env\",\"credential\":{{\"displayName\":\"Ada\",\"note\":\"ok\",\"extra\":true}}}}"
    SecretEnvelope envelope = json.parse_exact[SecretEnvelope](raw) handle error:
        return error
    return "{envelope.id}:{secret.redact(envelope.credential)}"
function parse_exact_secret_json_tree_accepts_open_payload() returns string:
    secret[json.JsonTree] raw = json.parse_exact[secret[json.JsonTree]]("{{\"extra\":true,\"nested\":{{\"kept\":1}}}}") handle error:
        return error
    return secret.redact(raw)
function parse_exact_secret_legacy_json_value_accepts_open_payload() returns string:
    secret[JsonValue] raw = json.parse_exact[secret[JsonValue]]("{{\"extra\":true,\"nested\":{{\"kept\":2}}}}") handle error:
        return error
    return secret.redact(raw)
function parse_exact_secret_namespaced_json_value_accepts_open_payload() returns string:
    secret[json.JsonValue] raw = json.parse_exact[secret[json.JsonValue]]("{{\"extra\":true,\"nested\":{{\"kept\":3}}}}") handle error:
        return error
    return secret.redact(raw)
verify json_parse_exact_secret_edges:
    assert parse_exact_secret_profile_accepts_closed_shape() == "***"
    assert parse_exact_secret_profile_rejects_extra_field() == "unknown field 'extra' for test.SecretProfile"
    assert parse_exact_optional_secret_null_accepts() == "none"
    assert parse_exact_optional_secret_rejects_extra_field() == "unknown field 'extra' for test.SecretProfile"
    assert parse_exact_result_ok_secret_rejects_extra_field() == "ok: unknown field 'extra' for test.SecretProfile"
    assert parse_exact_result_fail_secret_rejects_extra_field() == "fail: unknown field 'extra' for test.SecretProfile"
    assert parse_exact_secret_field_rejects_extra_field() == "credential: unknown field 'extra' for test.SecretProfile"
    assert parse_exact_secret_json_tree_accepts_open_payload() == "***"
    assert parse_exact_secret_legacy_json_value_accepts_open_payload() == "***"
    assert parse_exact_secret_namespaced_json_value_accepts_open_payload() == "***"

namespace models
export type NonEmpty = string where string.char_count(value) > 0
export enum Color:
    blue
    rgb(red: int64, green: int64, blue: int64)
export enum HeaderColor:
    blue = 1
    red = 2
export bitfield Header:
    version: 4 bits
    color: 8 bits as models.HeaderColor
export struct Profile:
    city: string
    visits: list[int64]
export struct User:
    id: string serialize "userId"
    profile: models.Profile
export struct Box[T]:
    value: T
namespace app
function qualified_type_summary() returns string:
    use models
    models.Profile profile = models.Profile(city: "Cluj", visits: list(2, 3))
    models.User user = models.User(id: "u1", profile: profile)
    models.Box[int64] box = models.Box[int64](value: 42)
    models.Color color = models.Color.blue
    models.Color rich = models.Color.rgb(1, 2, 3)
    models.Header header = models.Header(version: 4, color: models.HeaderColor.blue)
    string raw = json.serialize[models.User](view user)
    models.User decoded = json.parse[models.User](raw) handle error:
        return error
    return "{decoded.id}:{decoded.profile.city}:{list.length[int64](decoded.profile.visits)}:{box.value}:{color == models.Color.blue}:{rich == models.Color.rgb(1, 2, 3)}:{header.color == models.HeaderColor.blue}:{type.name[models.User]()}:{type.name[models.Box[int64]]()}"
function qualified_reflection_summary() returns string:
    use models
    models.Profile profile = models.Profile(city: "Iasi", visits: list(5))
    models.User user = models.User(id: "u2", profile: profile)
    TypeField id = list.get[TypeField](type.fields[models.User](), 0) handle:
        return "missing"
    string reflected = type.field_value[models.User, string](view user, view id)
    TypeInfo info = type.info[models.User]()
    return "{reflected}:{info.type_name}:{id.type_name}"
function qualified_alias_summary() returns string:
    use models
    models.NonEmpty label = "ready" handle error:
        return error
    return coarsen label
verify namespace_qualified_types:
    assert qualified_type_summary() == "u1:Cluj:2:42:true:true:true:models.User:models.Box[int64]"
    assert qualified_reflection_summary() == "u2:models.User:string"
    assert qualified_alias_summary() == "ready"

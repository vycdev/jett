namespace app

function filter_inline_test() returns int64:
    list[int64] nums = list(1, 2, 3, 4, 5)
    list[int64] big = list.filter[int64](nums, function(n: int64) returns bool: return n > 2)
    return list.length[int64](big)

verify filter_inline_test:
    assert filter_inline_test() == 3

function map_inline_first_test() returns int64:
    list[int64] nums = list(1, 2, 3, 4, 5)
    list[int64] doubled = list.map[int64, int64](nums, function(n: int64) returns int64: return n * 2)
    return list.get[int64](doubled, 0) handle:
        default 0

verify map_inline_first_test:
    assert map_inline_first_test() == 2

function map_inline_last_test() returns int64:
    list[int64] nums = list(1, 2, 3, 4, 5)
    list[int64] doubled = list.map[int64, int64](nums, function(n: int64) returns int64: return n * 2)
    return list.get[int64](doubled, 4) handle:
        default 0

verify map_inline_last_test:
    assert map_inline_last_test() == 10

function find_inline_test() returns int64:
    list[int64] nums = list(1, 2, 3, 4, 5)
    optional[int64] maybe = list.find[int64](nums, function(n: int64) returns bool: return n == 3)
    return maybe handle:
        default 0

verify find_inline_test:
    assert find_inline_test() == 3

function all_inline_test() returns bool:
    list[int64] nums = list(1, 2, 3, 4, 5)
    return list.all[int64](nums, function(n: int64) returns bool: return n > 0)

verify all_inline_test:
    assert all_inline_test() == true

function any_inline_false_test() returns bool:
    list[int64] nums = list(1, 2, 3, 4, 5)
    return list.any[int64](nums, function(n: int64) returns bool: return n < 0)

verify any_inline_false_test:
    assert any_inline_false_test() == false

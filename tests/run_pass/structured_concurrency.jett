namespace test

function compute(x: int64) returns int64:
    return x * x

function may_fail(x: int64) returns result[int64, string]:
    if x < 0:
        return fail("negative input")
    return ok(x + 1)

function join_resolved_values() returns bool:
    int64 resolved = 7
    int64 joined = join resolved handle error:
        return false
    int64 expression = join compute(3) handle error:
        return false
    int64 joined_again = join joined handle error:
        return false
    return joined_again == 7 && expression == 9

verify join_resolved_values:
    assert join_resolved_values()

function reassign_task() returns nothing:
    mutable int64 task = 0
    task = run compute(1)
    cancel task
    int64 parenthesized = (run compute(2))
    cancel (parenthesized)
    return nothing

function main() returns nothing:
    reassign_task()
    int64 task1 = run compute(5)
    int64 task2 = run compute(7)

    int64 result1 = join task1 handle error:
        return nothing
    int64 result2 = join task2 handle error:
        return nothing

    result[int64, string] task3 = run may_fail(3)
    int64 r3 = join task3 handle error:
        return nothing

    int64 task4 = run compute(10)
    cancel task4

    return nothing

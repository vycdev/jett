namespace test
struct Session:
    id: string
    user_name: string serialize "userName"
    token: secret[string]
struct SecretBox[T]:
    value: T
    label: string serialize "displayLabel"
struct RawPayload:
    tree: json.JsonTree
    alias: json.JsonValue
function public_session_json() returns string:
    Session session = Session(id: "s1", user_name: "alice", token: "secret-token")
    return json.serialize_public[Session](view session)
function public_secret_box_json() returns string:
    SecretBox[secret[string]] box = SecretBox[secret[string]](value: "secret-token", label: "shown")
    return json.serialize_public[SecretBox[secret[string]]](view box)
function public_session_list_json() returns string:
    Session first = Session(id: "s1", user_name: "alice", token: "secret-token")
    Session second = Session(id: "s2", user_name: "bob", token: "other-token")
    list[Session] sessions = list(first, second)
    return json.serialize_public[list[Session]](view sessions)
function public_primitive_json() returns string:
    return json.serialize_public[int64](42)
function public_tree_json() returns string:
    json.JsonTree tree = json.json_tree_parse("[1,true,null]") handle error:
        return error
    return json.serialize_public[json.JsonTree](view tree)
function public_json_value_alias_json() returns string:
    json.JsonValue raw = json.parse[json.JsonValue]("{{\"visible\":true,\"score\":7}}") handle error:
        return error
    return json.serialize_public[json.JsonValue](view raw)
function public_bare_json_value_json() returns string:
    JsonValue raw = json.parse[JsonValue]("{{\"visible\":true,\"score\":8}}") handle error:
        return error
    return json.serialize_public[JsonValue](view raw)
function utf8_fixture_text() returns string:
    bytes raw = bytes.from_hex("c3a9e282acf09f9880") handle error:
        return error
    return bytes.to_string(raw) handle error:
        default error
function public_raw_payload_utf8_json() returns string:
    string text = utf8_fixture_text()
    json.JsonTree tree = json.JsonTree.string_value(text)
    json.JsonValue alias = json.JsonTree.string_value(text)
    RawPayload payload = RawPayload(tree: tree, alias: alias)
    string raw = json.serialize_public[RawPayload](view payload)
    json.JsonTree parsed = json.parse_raw(raw) handle error:
        return "parse:{error}"
    json.JsonTree tree_field = json.require_field(view parsed, "tree") handle error:
        return "tree:{error}"
    json.JsonTree alias_field = json.require_field(view parsed, "alias") handle error:
        return "alias:{error}"
    string tree_text = json.as_string(view tree_field) handle error:
        return "tree value:{error}"
    string alias_text = json.as_string(view alias_field) handle error:
        return "alias value:{error}"
    return "{bytes.to_hex(bytes.from_string(tree_text))}:{bytes.to_hex(bytes.from_string(alias_text))}"
verify serialize_public_omits_secret_fields:
    string raw = public_session_json()
    assert string.contains(raw, "id") == true
    assert string.contains(raw, "userName") == true
    assert string.contains(raw, "user_name") == false
    assert string.contains(raw, "token") == false
    assert string.contains(raw, "secret-token") == false
verify serialize_public_uses_generic_secret_type:
    string raw = public_secret_box_json()
    assert string.contains(raw, "displayLabel") == true
    assert string.contains(raw, "shown") == true
    assert string.contains(raw, "value") == false
    assert string.contains(raw, "secret-token") == false
verify serialize_public_projects_records_inside_lists:
    string raw = public_session_list_json()
    assert string.contains(raw, "\"id\":\"s1\"") == true
    assert string.contains(raw, "\"id\":\"s2\"") == true
    assert string.contains(raw, "userName") == true
    assert string.contains(raw, "token") == false
    assert string.contains(raw, "secret-token") == false
    assert string.contains(raw, "other-token") == false
verify serialize_public_allows_copy_primitives:
    assert public_primitive_json() == "42"
verify serialize_public_treats_json_tree_as_raw:
    assert public_tree_json() == "[1,true,null]"
verify serialize_public_treats_json_value_alias_as_raw:
    string raw = public_json_value_alias_json()
    assert string.contains(raw, "\"visible\":true") == true
    assert string.contains(raw, "\"score\":7") == true
verify serialize_public_treats_bare_json_value_as_raw:
    string raw = public_bare_json_value_json()
    assert string.contains(raw, "\"visible\":true") == true
    assert string.contains(raw, "\"score\":8") == true
verify serialize_public_treats_nested_raw_payload_utf8_as_raw:
    assert public_raw_payload_utf8_json() == "c3a9e282acf09f9880:c3a9e282acf09f9880"

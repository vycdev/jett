namespace test

struct Profile:
    display_name: string serialize "displayName"
    note: string

struct User:
    id: string
    profile: Profile serialize "profileData"
    tags: list[string]
    scores: map[string, int64]
    maybe_name: optional[string] serialize "maybeName"
    missing: optional[string]
    outcome: result[int64, string]
    failed: result[int64, string]

enum Protocol:
    tcp = 6
    udp = 17

bitfield Header:
    version: 4 bits
    protocol: 8 bits as Protocol

function json_int_test() returns string:
    return json.serialize[int64](42)

verify json_int_test:
    assert json_int_test() == "42"

function json_true_test() returns string:
    return json.serialize[bool](true)

verify json_true_test:
    assert json_true_test() == "true"

function json_false_test() returns string:
    return json.serialize[bool](false)

verify json_false_test:
    assert json_false_test() == "false"

function json_null_test() returns string:
    return json.serialize[nothing](nothing)

verify json_null_test:
    assert json_null_test() == "null"

function json_list_test() returns string:
    list[int64] values = list(1, 2, 3)
    return json.serialize[list[int64]](view values)

verify json_list_test:
    assert json_list_test() == "[1,2,3]"

function json_bytes_test() returns string:
    bytes value = bytes.from_string("Hi")
    return json.serialize[bytes](view value)

verify json_bytes_test:
    assert json_bytes_test() == "\"0x4869\""

function json_string_escape_test() returns string:
    return json.serialize[string]("quote \" backslash \\ newline \n tab \t nul \0")

verify json_string_escape_test:
    assert json_string_escape_test() == "\"quote \\\" backslash \\\\ newline \\n tab \\t nul \\u0000\""

function json_nested_struct_test() returns string:
    Profile profile = Profile(display_name: "Alice", note: "line\nbreak")
    User user = User(id: "u1", profile: profile, tags: list("admin", "beta"), scores: map("wins": 3, "losses": 1), maybe_name: some("ally"), missing: none, outcome: ok(7), failed: fail("bad"))
    return json.serialize[User](view user)

verify json_nested_struct_test:
    assert json_nested_struct_test() == "{{\"id\":\"u1\",\"profileData\":{{\"displayName\":\"Alice\",\"note\":\"line\\nbreak\"}},\"tags\":[\"admin\",\"beta\"],\"scores\":{{\"wins\":3,\"losses\":1}},\"maybeName\":\"ally\",\"missing\":null,\"outcome\":{{\"ok\":7}},\"failed\":{{\"fail\":\"bad\"}}}}"

function json_bitfield_test() returns string:
    Header header = Header(version: 4, protocol: Protocol.tcp)
    return json.serialize[Header](view header)

verify json_bitfield_test:
    assert json_bitfield_test() == "{{\"version\":4,\"protocol\":\"tcp\"}}"

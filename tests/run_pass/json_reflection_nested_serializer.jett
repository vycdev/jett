namespace test

type Labels = list[string]
type NonEmpty = string where string.char_count(value) > 0

enum Direction:
    north
    south

enum Shape:
    circle(radius: float64)
    rect(width: float64, height: float64)

bitfield Packet:
    version: 4 bits
    direction: 8 bits as Direction

struct Profile:
    city: string
    visits: list[int64]

struct AliasRefined:
    labels: Labels
    display: NonEmpty

struct EnumPayload:
    direction: Direction
    shape: Shape

struct User:
    id: string serialize "userId"
    active: bool
    note: string
    payload: bytes
    profile: Profile
    tags: list[string]
    lucky: set[int64]
    scores: map[string, int64]
    nickname: optional[string]
    missing: optional[string]
    outcome: result[int64, string]
    failed: result[int64, string]
    token: secret[string]
    audit_tokens: list[secret[string]]

function json_quote(raw: string) returns string:
    string escaped = string.replace(raw, "\\", "\\\\")
    escaped = string.replace(escaped, "\"", "\\\"")
    escaped = string.replace(escaped, "\n", "\\n")
    escaped = string.replace(escaped, "\r", "\\r")
    escaped = string.replace(escaped, "\t", "\\t")
    escaped = string.replace(escaped, "\0", "\\u0000")
    return "\"{escaped}\""

function serialize_reflected[T](view value: T) returns string:
    TypeKind kind = type.kind_tag[T]()
    string type_name = type.name[T]()

    if type_name == "string":
        string item = value
        return json_quote(item)

    if type_name == "int64":
        int64 item = value
        return "{item}"

    if type_name == "float64":
        float64 item = value
        return "{item}"

    if type_name == "bool":
        bool item = value
        return "{item}"

    if type_name == "bytes":
        bytes item = value
        return json_quote("0x{bytes.to_hex(item)}")

    if kind == TypeKind.alias_type:
        comptime type Base = type.arg[T](0):
            Base item = value
            return serialize_reflected[Base](view item)

    if kind == TypeKind.refinement_type:
        comptime type Base = type.arg[T](0):
            Base item = coarsen value
            return serialize_reflected[Base](view item)

    if kind == TypeKind.enum_type:
        TypeVariant variant = type.variant_value[T](view value)
        if list.length(variant.fields) == 0:
            return json_quote(variant.name)

        list[string] parts = list.new[string]()
        for field in type.variant_value[T](view value).fields:
            comptime type Field = field.type_info:
                Field item = type.variant_field_value[T, Field](view value, view field)
                parts = list.append[string](parts, serialize_reflected[Field](view item))
        string body = string.join(parts, ",")
        return "{{{json_quote(variant.name)}:[{body}]}}"

    if kind == TypeKind.list_type:
        comptime type Elem = type.arg[T](0):
            list[Elem] items = value
            list[string] parts = list.new[string]()
            for item in items:
                parts = list.append[string](parts, serialize_reflected[Elem](view item))
            string body = string.join(parts, ",")
            return "[{body}]"

    if kind == TypeKind.set_type:
        comptime type Elem = type.arg[T](0):
            set[Elem] items = value
            list[string] parts = list.new[string]()
            for item in items:
                parts = list.append[string](parts, serialize_reflected[Elem](view item))
            string body = string.join(parts, ",")
            return "[{body}]"

    if kind == TypeKind.map_type:
        comptime type Val = type.arg[T](1):
            map[string, Val] entries = value
            list[string] parts = list.new[string]()
            for key, item in entries:
                parts = list.append[string](parts, "{json_quote(key)}:{serialize_reflected[Val](view item)}")
            string body = string.join(parts, ",")
            return "{{{body}}}"

    if kind == TypeKind.optional_type:
        comptime type Inner = type.arg[T](0):
            Inner item = value handle:
                return "null"
            return serialize_reflected[Inner](view item)

    if kind == TypeKind.result_type:
        comptime type Ok = type.arg[T](0):
            Ok item = value handle error:
                comptime type Err = type.arg[T](1):
                    Err failure = error
                    return "{{{json_quote("fail")}:{serialize_reflected[Err](view failure)}}}"
            return "{{{json_quote("ok")}:{serialize_reflected[Ok](view item)}}}"

    list[string] fields = list.new[string]()
    for field in type.fields[T]():
        if field.has_secret == false:
            comptime type Field = field.type_info:
                Field item = type.field_value[T, Field](view value, view field)
                string encoded = serialize_reflected[Field](view item)
                fields = list.append[string](fields, "{json_quote(field.serialize_name)}:{encoded}")
    string body = string.join(fields, ",")
    return "{{{body}}}"

function reflected_user_json() returns string:
    Profile profile = Profile(city: "Cluj", visits: list(3, 5))
    bytes payload = bytes.from_string("Hi")
    mutable set[int64] lucky = set.new[int64]()
    lucky = set.add[int64](lucky, 11)
    lucky = set.add[int64](lucky, 13)
    secret[string] audit_a = "audit-a"
    secret[string] audit_b = "audit-b"
    User user = User(id: "u1", active: true, note: "quote \" slash \\ newline \n carriage \r tab \t nul \0", payload: payload, profile: profile, tags: list("admin", "beta"), lucky: lucky, scores: map("wins": 3, "losses": 1), nickname: some("ally"), missing: none, outcome: ok(7), failed: fail("bad"), token: "secret-token", audit_tokens: list(audit_a, audit_b))
    return serialize_reflected[User](view user)

function reflected_alias_refinement_json() returns string:
    Labels labels = list("core", "edge")
    NonEmpty display = "ready" handle error:
        return "invalid"
    AliasRefined payload = AliasRefined(labels: labels, display: display) handle error:
        return "invalid"
    return serialize_reflected[AliasRefined](view payload)

function reflected_enum_json() returns string:
    EnumPayload payload = EnumPayload(direction: Direction.north, shape: Shape.circle(2.5))
    return serialize_reflected[EnumPayload](view payload)

function reflected_bitfield_json() returns string:
    Packet packet = Packet(version: 4, direction: Direction.south)
    return serialize_reflected[Packet](view packet)

verify json_reflection_nested_serializer:
    string raw = reflected_user_json()
    assert string.contains(raw, "userId") == true
    assert string.contains(raw, "u1") == true
    assert string.contains(raw, "active") == true
    assert string.contains(raw, "true") == true
    assert string.contains(raw, "quote \\\" slash \\\\ newline \\n carriage \\r tab \\t nul \\u0000") == true
    assert string.contains(raw, "payload") == true
    assert string.contains(raw, "0x4869") == true
    assert string.contains(raw, "profile") == true
    assert string.contains(raw, "Cluj") == true
    assert string.contains(raw, "visits") == true
    assert string.contains(raw, "[3,5]") == true
    assert string.contains(raw, "tags") == true
    assert string.contains(raw, "[\"admin\",\"beta\"]") == true
    assert string.contains(raw, "lucky") == true
    assert string.contains(raw, "11") == true
    assert string.contains(raw, "13") == true
    assert string.contains(raw, "scores") == true
    assert string.contains(raw, "wins") == true
    assert string.contains(raw, "nickname") == true
    assert string.contains(raw, "ally") == true
    assert string.contains(raw, "missing") == true
    assert string.contains(raw, "null") == true
    assert string.contains(raw, "outcome") == true
    assert string.contains(raw, "\"ok\":7") == true
    assert string.contains(raw, "failed") == true
    assert string.contains(raw, "\"fail\":\"bad\"") == true
    assert string.contains(raw, "token") == false
    assert string.contains(raw, "secret-token") == false
    assert string.contains(raw, "audit_tokens") == false
    assert string.contains(raw, "audit-a") == false

    string alias_raw = reflected_alias_refinement_json()
    assert string.contains(alias_raw, "labels") == true
    assert string.contains(alias_raw, "[\"core\",\"edge\"]") == true
    assert string.contains(alias_raw, "display") == true
    assert string.contains(alias_raw, "\"ready\"") == true

    string enum_raw = reflected_enum_json()
    assert string.contains(enum_raw, "direction") == true
    assert string.contains(enum_raw, "\"north\"") == true
    assert string.contains(enum_raw, "shape") == true
    assert string.contains(enum_raw, "circle") == true
    assert string.contains(enum_raw, "[2.5]") == true

    string bitfield_raw = reflected_bitfield_json()
    assert string.contains(bitfield_raw, "version") == true
    assert string.contains(bitfield_raw, "4") == true
    assert string.contains(bitfield_raw, "direction") == true
    assert string.contains(bitfield_raw, "\"south\"") == true

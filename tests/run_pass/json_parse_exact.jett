namespace test
struct Profile:
    display_name: string serialize "displayName"
    note: string
struct User:
    id: string
    profile: Profile serialize "profileData"
type ProfileAlias = Profile
enum Wrapped:
    profile_item(profile: Profile)
enum Protocol:
    tcp = 6
    udp = 17
bitfield Header:
    version: 4 bits
    protocol: 8 bits as Protocol
function parse_exact_accepts_matching_shape() returns string:
    string raw = "{{\"id\":\"u1\",\"profileData\":{{\"displayName\":\"Alice\",\"note\":\"ok\"}}}}"
    User user = json.parse_exact[User](raw) handle error:
        return error
    return "{user.id}:{user.profile.display_name}:{user.profile.note}"
function parse_exact_rejects_extra_top_level() returns string:
    string raw = "{{\"id\":\"u1\",\"profileData\":{{\"displayName\":\"Alice\",\"note\":\"ok\"}},\"extra\":\"nope\"}}"
    User user = json.parse_exact[User](raw) handle error:
        return error
    return user.id
function parse_exact_rejects_extra_nested() returns string:
    string raw = "{{\"id\":\"u1\",\"profileData\":{{\"displayName\":\"Alice\",\"note\":\"ok\",\"extra\":\"nope\"}}}}"
    User user = json.parse_exact[User](raw) handle error:
        return error
    return user.id
function parse_exact_uses_serialize_name() returns string:
    string raw = "{{\"id\":\"u1\",\"profileData\":{{\"displayName\":\"Alice\",\"display_name\":\"Wrong\",\"note\":\"ok\"}}}}"
    User user = json.parse_exact[User](raw) handle error:
        return error
    return user.profile.display_name
function parse_exact_validates_list_items() returns string:
    string raw = "[{{\"displayName\":\"Alice\",\"note\":\"ok\",\"extra\":\"nope\"}}]"
    list[Profile] profiles = json.parse_exact[list[Profile]](raw) handle error:
        return error
    return "{list.length[Profile](view profiles)}"
function parse_exact_validates_map_values() returns string:
    string raw = "{{\"primary\":{{\"displayName\":\"Alice\",\"note\":\"ok\",\"extra\":\"nope\"}}}}"
    map[string, Profile] profiles = json.parse_exact[map[string, Profile]](raw) handle error:
        return error
    return "{map.length[string, Profile](view profiles)}"
function parse_exact_validates_alias_base() returns string:
    string raw = "{{\"displayName\":\"Alice\",\"note\":\"ok\",\"extra\":\"nope\"}}"
    ProfileAlias profile = json.parse_exact[ProfileAlias](raw) handle error:
        return error
    return profile.display_name
function parse_exact_validates_optional_value() returns string:
    string raw = "{{\"displayName\":\"Alice\",\"note\":\"ok\",\"extra\":\"nope\"}}"
    optional[Profile] profile = json.parse_exact[optional[Profile]](raw) handle error:
        return error
    Profile item = profile handle:
        return "none"
    return item.display_name
function parse_exact_accepts_optional_null() returns string:
    optional[Profile] profile = json.parse_exact[optional[Profile]]("null") handle error:
        return error
    Profile item = profile handle:
        return "none"
    return item.display_name
function parse_exact_validates_result_ok() returns string:
    string raw = "{{\"ok\":{{\"displayName\":\"Alice\",\"note\":\"ok\",\"extra\":\"nope\"}}}}"
    result[Profile, string] parsed = json.parse_exact[result[Profile, string]](raw) handle error:
        return error
    Profile item = parsed handle error:
        return error
    return item.display_name
function parse_exact_validates_enum_payload() returns string:
    string raw = "{{\"profile_item\":[{{\"displayName\":\"Alice\",\"note\":\"ok\",\"extra\":\"nope\"}}]}}"
    Wrapped wrapped = json.parse_exact[Wrapped](raw) handle error:
        return error
    match wrapped:
        profile_item(profile):
            return profile.display_name
function parse_exact_validates_bitfield_fields() returns string:
    string raw = "{{\"version\":4,\"protocol\":\"tcp\",\"extra\":1}}"
    Header header = json.parse_exact[Header](raw) handle error:
        return error
    return "{header.version}"
function parse_exact_accepts_json_tree_payload() returns string:
    string raw = "{{\"answer\":42,\"extra\":{{\"nested\":true}}}}"
    json.JsonTree tree = json.parse_exact[json.JsonTree](raw) handle error:
        return error
    json.JsonTree answer = json.require_field(view tree, "answer") handle error:
        return error
    int64 value = json.as_int64(view answer) handle error:
        return error
    return "{value}:{json.is_object(view tree)}"
function parse_exact_accepts_legacy_json_value_payload() returns string:
    string raw = "{{\"answer\":43,\"extra\":{{\"nested\":true}}}}"
    JsonValue tree = json.parse_exact[JsonValue](raw) handle error:
        return error
    JsonValue answer = json.field(tree, "answer") handle:
        return "missing"
    int64 value = json.as_int64(answer) handle error:
        return error
    return "{value}:{json.is_object(tree)}"
function parse_exact_accepts_namespaced_json_value_payload() returns string:
    string raw = "{{\"answer\":44,\"extra\":{{\"nested\":true}}}}"
    json.JsonValue tree = json.parse_exact[json.JsonValue](raw) handle error:
        return error
    json.JsonTree answer = json.require_field(view tree, "answer") handle error:
        return error
    int64 value = json.as_int64(view answer) handle error:
        return error
    return "{value}:{json.is_object(view tree)}"
verify json_parse_exact:
    assert parse_exact_accepts_matching_shape() == "u1:Alice:ok"
    assert parse_exact_rejects_extra_top_level() == "unknown field 'extra' for test.User"
    assert parse_exact_rejects_extra_nested() == "profileData: unknown field 'extra' for test.Profile"
    assert parse_exact_uses_serialize_name() == "profileData: unknown field 'display_name' for test.Profile"
    assert parse_exact_validates_list_items() == "0: unknown field 'extra' for test.Profile"
    assert parse_exact_validates_map_values() == "primary: unknown field 'extra' for test.Profile"
    assert parse_exact_validates_alias_base() == "unknown field 'extra' for test.Profile"
    assert parse_exact_validates_optional_value() == "unknown field 'extra' for test.Profile"
    assert parse_exact_accepts_optional_null() == "none"
    assert parse_exact_validates_result_ok() == "ok: unknown field 'extra' for test.Profile"
    assert parse_exact_validates_enum_payload() == "profile_item.profile: unknown field 'extra' for test.Profile"
    assert parse_exact_validates_bitfield_fields() == "unknown field 'extra' for test.Header"
    assert parse_exact_accepts_json_tree_payload() == "42:true"
    assert parse_exact_accepts_legacy_json_value_payload() == "43:true"
    assert parse_exact_accepts_namespaced_json_value_payload() == "44:true"

namespace external.models
export struct ExactProfile:
    display_name: string serialize "displayName"
    note: string
export struct ExactEnvelope:
    id: string
    profile: ExactProfile
    payload: json.JsonValue
    token: secret[string]
namespace test
struct Profile:
    display_name: string serialize "displayName"
    note: string
struct Utf8Named:
    value: string serialize "café"
    note: string
struct User:
    id: string
    profile: Profile serialize "profileData"
struct OptionalUser:
    id: string
    profile: optional[Profile] serialize "profileData"
    nickname: optional[string]
struct RawTreeEnvelope:
    id: string
    payload: json.JsonTree
struct RawLegacyEnvelope:
    id: string
    payload: JsonValue
struct RawAliasEnvelope:
    id: string
    payload: json.JsonValue
type ProfileAlias = Profile
struct AliasHolder:
    profile: ProfileAlias serialize "profileData"
enum Wrapped:
    profile_item(profile: Profile)
enum Protocol:
    tcp = 6
    udp = 17
bitfield Header:
    version: 4 bits
    protocol: 8 bits as Protocol
function parse_exact_accepts_matching_shape() returns string:
    string raw = "{{\"id\":\"u1\",\"profileData\":{{\"displayName\":\"Alice\",\"note\":\"ok\"}}}}"
    User user = json.parse_exact[User](raw) handle error:
        return error
    return "{user.id}:{user.profile.display_name}:{user.profile.note}"
function parse_exact_accepts_missing_optional_fields() returns string:
    string raw = "{{\"id\":\"u1\"}}"
    OptionalUser user = json.parse_exact[OptionalUser](raw) handle error:
        return error
    Profile profile = user.profile handle:
        string missing_nickname = user.nickname handle:
            default "none"
        return "{user.id}:none:{missing_nickname}"
    string nickname = user.nickname handle:
        default "none"
    return "{user.id}:{profile.display_name}:{nickname}"
function parse_exact_rejects_extra_top_level() returns string:
    string raw = "{{\"id\":\"u1\",\"profileData\":{{\"displayName\":\"Alice\",\"note\":\"ok\"}},\"extra\":\"nope\"}}"
    User user = json.parse_exact[User](raw) handle error:
        return error
    return user.id
function parse_exact_rejects_extra_nested() returns string:
    string raw = "{{\"id\":\"u1\",\"profileData\":{{\"displayName\":\"Alice\",\"note\":\"ok\",\"extra\":\"nope\"}}}}"
    User user = json.parse_exact[User](raw) handle error:
        return error
    return user.id
function parse_exact_uses_serialize_name() returns string:
    string raw = "{{\"id\":\"u1\",\"profileData\":{{\"displayName\":\"Alice\",\"display_name\":\"Wrong\",\"note\":\"ok\"}}}}"
    User user = json.parse_exact[User](raw) handle error:
        return error
    return user.profile.display_name
function parse_exact_rejects_source_name_when_serialize_name_exists() returns string:
    string raw = "{{\"id\":\"u1\",\"profileData\":{{\"displayName\":\"Alice\",\"note\":\"ok\"}},\"profile\":{{\"displayName\":\"Wrong\",\"note\":\"ignored\"}}}}"
    User user = json.parse_exact[User](raw) handle error:
        return error
    return user.profile.display_name
function parse_exact_uses_utf8_serialize_name() returns string:
    Utf8Named item = json.parse_exact[Utf8Named]("{{\"café\":\"déjà\",\"note\":\"ok\"}}") handle error:
        return error
    string raw = json.serialize[Utf8Named](view item)
    bool serialized_name = string.contains(raw, "\"café\":\"déjà\"")
    return "{item.value}:{item.note}:{serialized_name}"
function parse_exact_validates_list_items() returns string:
    string raw = "[{{\"displayName\":\"Alice\",\"note\":\"ok\",\"extra\":\"nope\"}}]"
    list[Profile] profiles = json.parse_exact[list[Profile]](raw) handle error:
        return error
    return "{list.length[Profile](view profiles)}"
function parse_exact_validates_map_values() returns string:
    string raw = "{{\"primary\":{{\"displayName\":\"Alice\",\"note\":\"ok\",\"extra\":\"nope\"}}}}"
    map[string, Profile] profiles = json.parse_exact[map[string, Profile]](raw) handle error:
        return error
    return "{map.length[string, Profile](view profiles)}"
function parse_exact_accepts_set_shape() returns string:
    set[int64] values_for_length = json.parse_exact[set[int64]]("[1,2,2]") handle error:
        return error
    set[int64] values_for_contains = json.parse_exact[set[int64]]("[1,2,2]") handle error:
        return error
    int64 length = set.length[int64](values_for_length)
    bool has_two = set.contains[int64](values_for_contains, 2)
    return "{length}:{has_two}"
function parse_exact_rejects_set_non_array() returns string:
    set[int64] values = json.parse_exact[set[int64]]("{{\"value\":1}}") handle error:
        return error
    int64 length = set.length[int64](values)
    return "{length}"
function parse_exact_validates_alias_base() returns string:
    string raw = "{{\"displayName\":\"Alice\",\"note\":\"ok\",\"extra\":\"nope\"}}"
    ProfileAlias profile = json.parse_exact[ProfileAlias](raw) handle error:
        return error
    return profile.display_name
function parse_exact_validates_alias_field_base() returns string:
    string raw = "{{\"profileData\":{{\"displayName\":\"Alice\",\"note\":\"ok\",\"extra\":\"nope\"}}}}"
    AliasHolder holder = json.parse_exact[AliasHolder](raw) handle error:
        return error
    return holder.profile.display_name
function parse_exact_validates_optional_value() returns string:
    string raw = "{{\"displayName\":\"Alice\",\"note\":\"ok\",\"extra\":\"nope\"}}"
    optional[Profile] profile = json.parse_exact[optional[Profile]](raw) handle error:
        return error
    Profile item = profile handle:
        return "none"
    return item.display_name
function parse_exact_accepts_optional_null() returns string:
    optional[Profile] profile = json.parse_exact[optional[Profile]]("null") handle error:
        return error
    Profile item = profile handle:
        return "none"
    return item.display_name
function parse_exact_validates_result_ok() returns string:
    string raw = "{{\"ok\":{{\"displayName\":\"Alice\",\"note\":\"ok\",\"extra\":\"nope\"}}}}"
    result[Profile, string] parsed = json.parse_exact[result[Profile, string]](raw) handle error:
        return error
    Profile item = parsed handle error:
        return error
    return item.display_name
function parse_exact_validates_enum_payload() returns string:
    string raw = "{{\"profile_item\":[{{\"displayName\":\"Alice\",\"note\":\"ok\",\"extra\":\"nope\"}}]}}"
    Wrapped wrapped = json.parse_exact[Wrapped](raw) handle error:
        return error
    match wrapped:
        profile_item(profile):
            return profile.display_name
function parse_exact_validates_bitfield_fields() returns string:
    string raw = "{{\"version\":4,\"protocol\":\"tcp\",\"extra\":1}}"
    Header header = json.parse_exact[Header](raw) handle error:
        return error
    return "{header.version}"
function parse_exact_accepts_json_tree_payload() returns string:
    string raw = "{{\"answer\":42,\"extra\":{{\"nested\":true}}}}"
    json.JsonTree tree = json.parse_exact[json.JsonTree](raw) handle error:
        return error
    json.JsonTree answer = json.require_field(view tree, "answer") handle error:
        return error
    int64 value = json.as_int64(view answer) handle error:
        return error
    return "{value}:{json.is_object(view tree)}"
function parse_exact_accepts_legacy_json_value_payload() returns string:
    string raw = "{{\"answer\":43,\"extra\":{{\"nested\":true}}}}"
    JsonValue tree = json.parse_exact[JsonValue](raw) handle error:
        return error
    JsonValue answer = json.field(tree, "answer") handle:
        return "missing"
    int64 value = json.as_int64(answer) handle error:
        return error
    return "{value}:{json.is_object(tree)}"
function parse_exact_accepts_namespaced_json_value_payload() returns string:
    string raw = "{{\"answer\":44,\"extra\":{{\"nested\":true}}}}"
    json.JsonValue tree = json.parse_exact[json.JsonValue](raw) handle error:
        return error
    json.JsonTree answer = json.require_field(view tree, "answer") handle error:
        return error
    int64 value = json.as_int64(view answer) handle error:
        return error
    return "{value}:{json.is_object(view tree)}"
function parse_exact_accepts_json_tree_field_payload() returns string:
    string raw = "{{\"id\":\"doc\",\"payload\":{{\"answer\":45,\"extra\":{{\"nested\":true}}}}}}"
    RawTreeEnvelope envelope = json.parse_exact[RawTreeEnvelope](raw) handle error:
        return error
    json.JsonTree answer = json.require_field(view envelope.payload, "answer") handle error:
        return error
    int64 value = json.as_int64(view answer) handle error:
        return error
    return "{envelope.id}:{value}:{json.is_object(view envelope.payload)}"
function parse_exact_accepts_legacy_json_value_field_payload() returns string:
    string raw = "{{\"id\":\"doc\",\"payload\":{{\"answer\":46,\"extra\":{{\"nested\":true}}}}}}"
    RawLegacyEnvelope envelope = json.parse_exact[RawLegacyEnvelope](raw) handle error:
        return error
    JsonValue answer = json.require_field(view envelope.payload, "answer") handle error:
        return error
    int64 value = json.as_int64(view answer) handle error:
        return error
    return "{envelope.id}:{value}:{json.is_object(view envelope.payload)}"
function parse_exact_accepts_namespaced_json_value_field_payload() returns string:
    string raw = "{{\"id\":\"doc\",\"payload\":{{\"answer\":47,\"extra\":{{\"nested\":true}}}}}}"
    RawAliasEnvelope envelope = json.parse_exact[RawAliasEnvelope](raw) handle error:
        return error
    json.JsonValue answer = json.require_field(view envelope.payload, "answer") handle error:
        return error
    int64 value = json.as_int64(view answer) handle error:
        return error
    return "{envelope.id}:{value}:{json.is_object(view envelope.payload)}"
function parse_exact_accepts_json_tree_list_payload_extras() returns string:
    string raw = "[{{\"extra\":48}},{{\"nested\":{{\"unknown\":true}}}}]"
    list[json.JsonTree] items = json.parse_exact[list[json.JsonTree]](raw) handle error:
        return error
    json.JsonTree first = list.get[json.JsonTree](view items, 0) handle:
        return "missing first"
    json.JsonTree extra = json.require_field(view first, "extra") handle error:
        return error
    int64 value = json.as_int64(view extra) handle error:
        return error
    return "{list.length[json.JsonTree](view items)}:{value}:{json.is_object(view first)}"
function parse_exact_accepts_json_value_map_payload_extras() returns string:
    string raw = "{{\"primary\":{{\"extra\":\"kept\"}}}}"
    map[string, json.JsonValue] entries = json.parse_exact[map[string, json.JsonValue]](raw) handle error:
        return error
    json.JsonValue payload = map.get[string, json.JsonValue](view entries, "primary") handle:
        return "missing"
    json.JsonTree extra = json.require_field(view payload, "extra") handle error:
        return error
    string value = json.as_string(view extra) handle error:
        return error
    return "{map.length[string, json.JsonValue](view entries)}:{value}"
function parse_exact_accepts_json_value_set_payload_extras() returns string:
    set[json.JsonValue] items = json.parse_exact[set[json.JsonValue]]("[{{\"extra\":\"kept\"}}]") handle error:
        return error
    int64 length = set.length[json.JsonValue](view items)
    for item in items:
        json.JsonTree extra = json.require_field(view item, "extra") handle error:
            return error
        string value = json.as_string(view extra) handle error:
            return error
        return "{length}:{value}"
    return "missing"
function parse_exact_accepts_legacy_json_value_optional_payload_extras() returns string:
    optional[JsonValue] maybe_payload = json.parse_exact[optional[JsonValue]]("{{\"extra\":\"kept\"}}") handle error:
        return error
    JsonValue payload = maybe_payload handle:
        return "none"
    JsonValue extra = json.require_field(view payload, "extra") handle error:
        return error
    return json.as_string(view extra) handle error:
        default error
function parse_exact_accepts_json_tree_result_payload_extras() returns string:
    result[json.JsonTree, Profile] parsed = json.parse_exact[result[json.JsonTree, Profile]]("{{\"ok\":{{\"extra\":\"kept\"}}}}") handle error:
        return error
    json.JsonTree payload = parsed handle error:
        return error.display_name
    json.JsonTree extra = json.require_field(view payload, "extra") handle error:
        return error
    return json.as_string(view extra) handle error:
        default error
function parse_exact_result_keeps_reflected_fail_payload_closed() returns string:
    string raw = "{{\"fail\":{{\"displayName\":\"Ada\",\"note\":\"bad\",\"extra\":true}}}}"
    result[json.JsonTree, Profile] parsed = json.parse_exact[result[json.JsonTree, Profile]](raw) handle error:
        return error
    json.JsonTree payload = parsed handle error:
        return error.display_name
    return json.kind(view payload)
function parse_exact_qualified_raw_boundary_accepts_payload_extras() returns string:
    string raw = "{{\"id\":\"e1\",\"profile\":{{\"displayName\":\"Ada\",\"note\":\"ok\"}},\"payload\":{{\"extra\":\"kept\",\"nested\":{{\"unknown\":true}}}},\"token\":\"secret-token\"}}"
    external.models.ExactEnvelope envelope = json.parse_exact[external.models.ExactEnvelope](raw) handle error:
        return error
    json.JsonValue extra = json.require_field(view envelope.payload, "extra") handle error:
        return error
    string extra_text = json.as_string(view extra) handle error:
        return error
    string public_raw = json.serialize_public[external.models.ExactEnvelope](view envelope)
    bool public_has_token = string.contains(public_raw, "token")
    bool public_keeps_payload = string.contains(public_raw, "\"extra\":\"kept\"")
    return "{envelope.id}:{envelope.profile.display_name}:{extra_text}:{secret.redact(envelope.token)}:{public_has_token}:{public_keeps_payload}"
function parse_exact_qualified_raw_boundary_rejects_profile_extras() returns string:
    string raw = "{{\"id\":\"e1\",\"profile\":{{\"displayName\":\"Ada\",\"note\":\"ok\",\"extra\":\"nope\"}},\"payload\":{{\"extra\":\"kept\"}},\"token\":\"secret-token\"}}"
    external.models.ExactEnvelope envelope = json.parse_exact[external.models.ExactEnvelope](raw) handle error:
        return error
    return envelope.id
verify json_parse_exact:
    assert parse_exact_accepts_matching_shape() == "u1:Alice:ok"
    assert parse_exact_accepts_missing_optional_fields() == "u1:none:none"
    assert parse_exact_rejects_extra_top_level() == "unknown field 'extra' for test.User"
    assert parse_exact_rejects_extra_nested() == "profileData: unknown field 'extra' for test.Profile"
    assert parse_exact_uses_serialize_name() == "profileData: unknown field 'display_name' for test.Profile"
    assert parse_exact_rejects_source_name_when_serialize_name_exists() == "unknown field 'profile' for test.User"
    assert parse_exact_uses_utf8_serialize_name() == "déjà:ok:true"
    assert parse_exact_validates_list_items() == "0: unknown field 'extra' for test.Profile"
    assert parse_exact_validates_map_values() == "primary: unknown field 'extra' for test.Profile"
    assert parse_exact_accepts_set_shape() == "2:true"
    assert parse_exact_rejects_set_non_array() == "expected array, got object"
    assert parse_exact_validates_alias_base() == "unknown field 'extra' for test.Profile"
    assert parse_exact_validates_alias_field_base() == "profileData: unknown field 'extra' for test.Profile"
    assert parse_exact_validates_optional_value() == "unknown field 'extra' for test.Profile"
    assert parse_exact_accepts_optional_null() == "none"
    assert parse_exact_validates_result_ok() == "ok: unknown field 'extra' for test.Profile"
    assert parse_exact_validates_enum_payload() == "profile_item.profile: unknown field 'extra' for test.Profile"
    assert parse_exact_validates_bitfield_fields() == "unknown field 'extra' for test.Header"
    assert parse_exact_accepts_json_tree_payload() == "42:true"
    assert parse_exact_accepts_legacy_json_value_payload() == "43:true"
    assert parse_exact_accepts_namespaced_json_value_payload() == "44:true"
    assert parse_exact_accepts_json_tree_field_payload() == "doc:45:true"
    assert parse_exact_accepts_legacy_json_value_field_payload() == "doc:46:true"
    assert parse_exact_accepts_namespaced_json_value_field_payload() == "doc:47:true"
    assert parse_exact_accepts_json_tree_list_payload_extras() == "2:48:true"
    assert parse_exact_accepts_json_value_map_payload_extras() == "1:kept"
    assert parse_exact_accepts_json_value_set_payload_extras() == "1:kept"
    assert parse_exact_accepts_legacy_json_value_optional_payload_extras() == "kept"
    assert parse_exact_accepts_json_tree_result_payload_extras() == "kept"
    assert parse_exact_result_keeps_reflected_fail_payload_closed() == "fail: unknown field 'extra' for test.Profile"
    assert parse_exact_qualified_raw_boundary_accepts_payload_extras() == "e1:Ada:kept:***:false:true"
    assert parse_exact_qualified_raw_boundary_rejects_profile_extras() == "profile: unknown field 'extra' for external.models.ExactProfile"

namespace test

struct Pair[T, U]:
    first: T
    second: U

function swap[T, U](p: Pair[T, U]) returns Pair[U, T]:
    return Pair[U, T](first: p.second, second: p.first)

verify swap:
    Pair[int64, string] p = Pair[int64, string](first: 1, second: "hello")
    Pair[string, int64] swapped = swap[int64, string](p)
    assert swapped.first == "hello"
    assert swapped.second == 1

function identity[T](value: T) returns T:
    return value

verify identity:
    assert identity[int64](42) == 42
    assert identity[string]("world") == "world"

function list_length[T](items: list[T]) returns int64:
    return list.length[T](items)

verify expected_collection_literal_argument:
    assert list_length[int64](list()) == 0

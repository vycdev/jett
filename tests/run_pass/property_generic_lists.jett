namespace app

enum PropertyChoice:
    empty
    score(value: int64)

property string_lists_have_nonnegative_length:
    given items: list[string]
    int64 length = list.length[string](items)
    assert length >= 0

property bool_lists_have_nonnegative_length:
    given flags: list[bool]
    int64 length = list.length[bool](flags)
    assert length >= 0

property string_sets_have_nonnegative_length:
    given labels: set[string]
    int64 length = set.length[string](labels)
    assert length >= 0

property string_int_maps_have_nonnegative_length:
    given scores: map[string, int64]
    int64 length = map.length[string, int64](scores)
    assert length >= 0

property bytes_have_nonnegative_length:
    given payload: bytes
    int64 length = bytes.length(payload)
    assert length >= 0

property optional_ints_can_be_handled:
    given maybe: optional[int64]
    int64 value = maybe handle:
        default 0
    assert value == value

property result_ints_can_be_handled:
    given outcome: result[int64, string]
    int64 value = outcome handle error:
        default 0
    assert value == value

property enum_variants_can_be_matched:
    given choice: PropertyChoice
    mutable bool seen = false
    match choice:
        empty:
            seen = true
        score(value):
            seen = value == value
    assert seen == true

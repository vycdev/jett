namespace app
struct Profile:
    display_name: string serialize "displayName"
    score: int64
struct User:
    id: string
    profile: Profile
    tags: list[string]
    scores: map[string, int64]
    maybe_name: optional[string]
    missing: optional[string]
    outcome: result[int64, string]
    failed: result[int64, string]
struct ScalarKinds:
    small: int8
    narrow: uint16
    wide: uint64
    ratio: float64
    enabled: bool
    payload: bytes
    empty: nothing
function main() returns nothing:
    Profile profile = Profile(display_name: "Ada \"L\"", score: -42)
    User user = User(id: "u1", profile: profile, tags: list("writer", "coder"), scores: map("wins": 3, "losses": 1), maybe_name: some("ally"), missing: none, outcome: ok(7), failed: fail("bad"))
    println(json.serialize[User](view user))
    println(json.serialize_public[User](view user))
    list[string] direct_tags = list("direct", "values")
    println(json.serialize[list[string]](view direct_tags))
    map[string, int64] direct_scores = map("one": 1, "two": 2)
    println(json.serialize_public[map[string, int64]](view direct_scores))
    optional[string] direct_optional = none
    println(json.serialize[optional[string]](view direct_optional))
    result[int64, string] direct_result = fail("missing")
    println(json.serialize_public[result[int64, string]](view direct_result))
    ScalarKinds kinds = ScalarKinds(small: -8, narrow: 65535, wide: 18446744073709551615, ratio: 2.5, enabled: true, payload: bytes.from_string("Hi"), empty: nothing)
    println(json.serialize[ScalarKinds](view kinds))

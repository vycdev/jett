namespace app
machine Session:
    states:
        active(name: secret[string])
    transitions:
        active to active
function main() returns nothing:
    Session session = Session(active, "hidden-owner")
    TypeMachineState state = type.machine_state_value[Session](view session)
    TypeField field = list.get[TypeField](state.fields, 0) handle:
        return nothing
    Session pending_session = run Session(active, "hidden-pending-owner")
    secret[string] copied = type.machine_field_value[Session, secret[string]](view pending_session, view field)
    println(secret.redact(copied))
    return nothing

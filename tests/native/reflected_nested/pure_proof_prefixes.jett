namespace app
function positive_check(value: int64) returns bool:
    string marker = "positive"
    return value > 0
type Positive = int64 where positive_check(value)
function high_check(value: int64) returns bool:
    string marker = "high"
    return value > 10
type High = Positive where high_check(value)
function sibling_check(value: int64) returns bool:
    string marker = "sibling"
    return value >= 0
type Sibling = int64 where sibling_check(value)
struct Holder:
    raw: list[int64]
    positive: list[Positive]
    high: list[High]
    sibling: list[Sibling]
enum Event:
    first(raw: list[int64], positive: list[Positive], high: list[High], sibling: list[Sibling])
    mirror(sibling: list[Sibling], high: list[High], positive: list[Positive], raw: list[int64])
machine Session:
    states:
        first(raw: list[int64], positive: list[Positive], high: list[High], sibling: list[Sibling])
        mirror(sibling: list[Sibling], high: list[High], positive: list[Positive], raw: list[int64])
    transitions:
        first to mirror
function positive_seed(value: int64) returns Positive:
    Positive ready = value handle error:
        return positive_seed(value)
    return ready
function high_seed(view value: Positive) returns High:
    High ready = clone value handle error:
        return high_seed(view value)
    return ready
function sibling_seed(value: int64) returns Sibling:
    Sibling ready = value handle error:
        return sibling_seed(value)
    return ready
function record_seed(value: int64) returns Holder:
    Positive positive = positive_seed(value)
    High high = high_seed(view positive)
    Sibling sibling = sibling_seed(value)
    return Holder(raw: list(value), positive: list(positive), high: list(high), sibling: list(sibling))
function event_seed(value: int64, reversed: bool) returns Event:
    Positive positive = positive_seed(value)
    High high = high_seed(view positive)
    Sibling sibling = sibling_seed(value)
    if reversed:
        return Event.mirror(list(sibling), list(high), list(positive), list(value))
    return Event.first(list(value), list(positive), list(high), list(sibling))
function session_seed(value: int64, reversed: bool) returns Session:
    Positive positive = positive_seed(value)
    High high = high_seed(view positive)
    Sibling sibling = sibling_seed(value)
    if reversed:
        return Session(mirror, list(sibling), list(high), list(positive), list(value))
    return Session(first, list(value), list(positive), list(high), list(sibling))
function record_field(index: int64) returns TypeField:
    return list.get[TypeField](type.fields[Holder](), index) handle:
        return record_field(0)
function event_field(view source: Event, index: int64) returns TypeField:
    TypeVariant variant = type.variant_value[Event](view source)
    return list.get[TypeField](variant.fields, index) handle:
        return event_field(view source, 0)
function session_field(view source: Session, index: int64) returns TypeField:
    TypeMachineState state = type.machine_state_value[Session](view source)
    return list.get[TypeField](state.fields, index) handle:
        return session_field(view source, 0)
function record_read(view source: Holder, index: int64) returns list[High]:
    TypeField field = record_field(index)
    return type.field_value[Holder, list[High]](view source, view field)
function event_read(view source: Event, index: int64) returns list[High]:
    TypeField field = event_field(view source, index)
    return type.variant_field_value[Event, list[High]](view source, view field)
function session_read(view source: Session, index: int64) returns list[High]:
    TypeField field = session_field(view source, index)
    return type.machine_field_value[Session, list[High]](view source, view field)
function record_weaker(view source: Holder) returns list[Positive]:
    TypeField field = record_field(2)
    return type.field_value[Holder, list[Positive]](view source, view field)
function event_weaker(view source: Event, index: int64) returns list[Positive]:
    TypeField field = event_field(view source, index)
    return type.variant_field_value[Event, list[Positive]](view source, view field)
function session_weaker(view source: Session, index: int64) returns list[Positive]:
    TypeField field = session_field(view source, index)
    return type.machine_field_value[Session, list[Positive]](view source, view field)
function summarize(items: list[High]) returns string:
    mutable string output = ""
    for item in items:
        output = "{output}:{coarsen item}"
    return output
function summarize_weaker(items: list[Positive]) returns string:
    mutable string output = ""
    for item in items:
        output = "{output}:{coarsen item}"
    return output
function record_report(value: int64) returns string:
    Holder source = record_seed(value)
    string raw = summarize(record_read(view source, 0))
    string suffix = summarize(record_read(view source, 1))
    string exact = summarize(record_read(view source, 2))
    string sibling = summarize(record_read(view source, 3))
    string ancestor = summarize_weaker(record_weaker(view source))
    return "{raw}/{suffix}/{exact}/{sibling}/{ancestor}"
function event_report(value: int64, reversed: bool) returns string:
    Event source = event_seed(value, reversed)
    mutable int64 step = 1
    mutable int64 index = 0
    if reversed:
        step = -1
        index = 3
    string raw = summarize(event_read(view source, index))
    string suffix = summarize(event_read(view source, index + step))
    string exact = summarize(event_read(view source, index + step + step))
    string sibling = summarize(event_read(view source, index + step + step + step))
    string ancestor = summarize_weaker(event_weaker(view source, index + step + step))
    return "{raw}/{suffix}/{exact}/{sibling}/{ancestor}"
function session_report(value: int64, reversed: bool) returns string:
    Session source = session_seed(value, reversed)
    mutable int64 step = 1
    mutable int64 index = 0
    if reversed:
        step = -1
        index = 3
    string raw = summarize(session_read(view source, index))
    string suffix = summarize(session_read(view source, index + step))
    string exact = summarize(session_read(view source, index + step + step))
    string sibling = summarize(session_read(view source, index + step + step + step))
    string ancestor = summarize_weaker(session_weaker(view source, index + step + step))
    return "{raw}/{suffix}/{exact}/{sibling}/{ancestor}"
function report(value: int64, reversed: bool) returns string:
    string record = record_report(value)
    string event = event_report(value, reversed)
    string session = session_report(value, reversed)
    return "{record}|{event}|{session}"
function expected(value: int64) returns string:
    string part = ":{value}/:{value}/:{value}/:{value}/:{value}"
    return "{part}|{part}|{part}"
function main(stdout: Stdout) returns nothing:
    string baked = comptime report(12, true)
    Stdout.write(view stdout, "pure:{baked}\n")
verify reflected_proofs:
    assert report(12, true) == expected(12)
property reflected_proof_trials:
    given large: bool
    given reversed: bool
    mutable int64 value = 12
    if large:
        value = 127
    assert report(value, reversed) == expected(value)

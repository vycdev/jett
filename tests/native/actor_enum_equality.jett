namespace app
actor Counter:
    mutable int64 count = 1
    receive read responds int64:
        respond count
enum Holder:
    held(worker: Counter)
function main() returns nothing:
    Counter worker = spawn Counter()
    Holder first = Holder.held(clone worker)
    Holder second = Holder.held(clone worker)
    println(first == second, first != second)
    return nothing

    Stdout.write(view stdout, "effects:done\n")
function nested_counts() returns string:
    mutable int64 outer = 0
    mutable int64 inner_count = 0
    for inner in list(list(), list()):
        outer = outer + 1
        for value in inner:
            inner_count = inner_count + 1
    return "{outer}:{inner_count}"
function borrowed_nested_counts() returns string:
    mutable int64 outer = 0
    mutable int64 inner_count = 0
    for inner in view list(list(), list()):
        outer = outer + 1
        for value in view inner:
            inner_count = inner_count + 1
    return "{outer}:{inner_count}"
function inferred_map_count() returns int64:
    mutable int64 total = 0
    for key, value in map():
        trace key
        trace value
        total = total + 1
    for key, value in view map():
        trace key
        trace value
        total = total + 1
    return total
function contextual_counts() returns string:
    list[int64] values = list()
    map[string, int64] entries = map()
    mutable int64 total = 0
    for value in view values:
        total = total + 1
    for key, value in view entries:
        total = total + 1
    int64 list_size = list.length[int64](view values)
    int64 map_size = map.length[string, int64](view entries)
    int64 copied_count = count[int64](clone values)
    int64 owned_count = count[int64](values)
    for key, value in entries:
        total = total + 1
    return "{total}:{list_size}:{map_size}:{copied_count}:{owned_count}"

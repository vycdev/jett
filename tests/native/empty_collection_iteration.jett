function mapped_empty_count() returns int64:
    mutable int64 total = 0
    for value in list.map(list(), nothing_callback):
        trace value
        total = total + 1
    for value in list.map(list(), named_callback):
        string label = Named.name(view value)
        trace label
        total = total + 1
    return total
function join_list[T](values: list[T]) returns list[T]:
    list[T] once = join values handle error: return list()
    list[T] ready = join once handle error: return list()
    return ready
function joined_empty_count() returns int64:
    mutable int64 total = 0
    for value in join_list(run run list()):
        trace value
        total = total + 1
    map[string, int64] entries = run run map()
    map[string, int64] once = join entries handle error: return -1
    map[string, int64] ready = join once handle error: return -2
    for key, value in ready:
        trace key
        trace value
        total = total + 1
    return total
function main(stdout: Stdout) returns nothing:
    direct_empty_lists(view stdout)
    effectful_empty_lists(view stdout)
    int64 baked = comptime count(list())
    int64 baked_references = comptime dead_references()
    Stdout.write(view stdout, "generic:{count(list())}:{baked}:live:{count(list(10, 20, 30))}\n")
    Stdout.write(view stdout, "dead:{dead_references()}:{baked_references}\n")
    Stdout.write(view stdout, "nested:{nested_counts()}:borrowed:{borrowed_nested_counts()}\n")
    Stdout.write(view stdout, "maps:{inferred_map_count()}:context:{contextual_counts()}\n")
    Stdout.write(view stdout, "mapped:{mapped_empty_count()}:joined:{joined_empty_count()}\n")
verify empty_iteration:
    assert count(list()) == 0
    assert count(list(10, 20, 30)) == 3
    int64 baked = comptime count(list())
    assert baked == 0
    assert dead_references() == 7
    assert nested_counts() == "2:0"
    assert borrowed_nested_counts() == "2:0"
    assert inferred_map_count() == 0
    assert contextual_counts() == "0:0:0:0:0"
    assert mapped_empty_count() == 0
    assert joined_empty_count() == 0
property empty_iteration_trials:
    given seed: int64
    assert seed + count(list()) == seed
    assert dead_references() == 7
    assert nested_counts() == "2:0"
    assert inferred_map_count() == 0

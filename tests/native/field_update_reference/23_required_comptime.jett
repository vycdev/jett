namespace app
struct Inner:
    value: int64
struct Record:
    inner: Inner
    label: string
function nested_value() returns int64:
    mutable Record record = Record(inner: Inner(value: 1), label: "before")
    record.inner.value = 9
    return record.inner.value
function main(stdout: Stdout) returns nothing:
    int64 baked = comptime nested_value()
    Stdout.write(view stdout, "baked:{baked}\n")
verify required_field_update:
    int64 baked = comptime nested_value()
    assert baked == 9

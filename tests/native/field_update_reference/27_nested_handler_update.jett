namespace app
struct Inner:
    value: int64
struct Record:
    inner: Inner
    label: string
function report() returns string:
    mutable Record outer = Record(inner: Inner(value: 1), label: "outer")
    optional[int64] absent = none
    outer.inner.value = absent handle:
        mutable Record inner = Record(inner: Inner(value: 2), label: "stable")
        inner.inner.value = 7
        return "{outer.inner.value}:{inner.inner.value}:{inner.label}"
    return "committed-must-not-run"
function main(stdout: Stdout) returns nothing:
    Stdout.write(view stdout, "handler:{report()}\n")
verify nested_handler_places:
    assert report() == "1:7:stable"

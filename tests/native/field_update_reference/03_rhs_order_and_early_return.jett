namespace app
struct Inner:
    value: int64
struct Record:
    inner: Inner
    label: string
function make() returns Record:
    return Record(inner: Inner(value: 1), label: "before")
function replacement(view stdout: Stdout) returns int64:
    Stdout.write(view stdout, "rhs\n")
    return 9
function successful(view stdout: Stdout) returns Record:
    mutable Record record = make()
    record.inner.value = replacement(view stdout)
    return record
function handled_abort(mutable record: Record) returns Record:
    optional[int64] absent = none
    record.inner.value = absent handle:
        return record
    return record
function main(stdout: Stdout) returns nothing:
    Record changed = successful(view stdout)
    Stdout.write(view stdout, "changed:{changed.inner.value}:{changed.label}\n")
    Record unchanged = handled_abort(make())
    Stdout.write(view stdout, "unchanged:{unchanged.inner.value}:{unchanged.label}\n")
verify abort_before_commit:
    Record unchanged = handled_abort(make())
    assert unchanged.inner.value == 1
    assert unchanged.label == "before"

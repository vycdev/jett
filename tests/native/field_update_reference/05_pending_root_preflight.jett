namespace app
struct Inner:
    value: int64
struct Record:
    inner: Inner
    label: string
function make() returns Record:
    return Record(inner: Inner(value: 1), label: "before")
function replacement(view stdout: Stdout) returns int64:
    Stdout.write(view stdout, "rhs-must-not-run\n")
    return 9
function main(stdout: Stdout) returns nothing:
    mutable Record record = run run make()
    Stdout.write(view stdout, "before:root\n")
    record.inner.value = replacement(view stdout)
    Stdout.write(view stdout, "after-must-not-run\n")

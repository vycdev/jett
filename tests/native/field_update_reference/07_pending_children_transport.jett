namespace app
struct Inner:
    value: int64
struct Record:
    inner: Inner
    pending: int64
    label: string
function main(stdout: Stdout) returns nothing:
    mutable Record record = Record(inner: Inner(value: 1), pending: run run 17, label: "before")
    record.inner.value = 9
    record.label = "after"
    int64 once = join record.pending handle error:
        return nothing
    int64 ready = join once handle error:
        return nothing
    record.inner = run run Inner(value: 5)
    record.label = "again"
    Inner inner_once = join record.inner handle error:
        return nothing
    Inner inner_ready = join inner_once handle error:
        return nothing
    Stdout.write(view stdout, "children:{ready}:{inner_ready.value}:{record.label}\n")

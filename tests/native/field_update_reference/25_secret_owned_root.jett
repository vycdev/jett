namespace app
struct Inner:
    value: int64
struct Record:
    number: int64
    text: string
    inner: Inner
function summary(view hidden: secret[Record]) returns string:
    int64 number = declassify hidden.number
    string text = declassify hidden.text
    int64 nested = declassify hidden.inner.value
    return "{number}:{text}:{nested}"
function update(mutable hidden: secret[Record]) returns secret[Record]:
    hidden.number = 9
    hidden.text = "after"
    hidden.inner.value = 8
    return hidden
function report() returns string:
    secret[Record] original = Record(number: 1, text: "before", inner: Inner(value: 2))
    secret[Record] changed = update(clone original)
    return "{summary(view original)}|{summary(view changed)}|{summary(view original)}"
function main(stdout: Stdout) returns nothing:
    Stdout.write(view stdout, "secret:{report()}\n")
verify secret_owned_place:
    assert report() == "1:before:2|9:after:8|1:before:2"

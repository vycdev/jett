namespace app
struct Inner:
    value: int64
struct Record:
    inner: Inner
    items: list[int64]
    label: string
function report() returns string:
    mutable Record record = Record(inner: Inner(value: 0), items: list(0), label: "stable")
    for step in list(1, 2, 3):
        record.inner.value = record.inner.value + step
        record.items = list(step)
    return "{record.inner.value}:{list.length(view record.items)}:{record.label}"
function main(stdout: Stdout) returns nothing:
    Stdout.write(view stdout, "loop:{report()}\n")
verify for_places:
    assert report() == "6:1:stable"

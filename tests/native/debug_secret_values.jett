namespace app

type HiddenText = secret[string]
type PublicCount = uint8
struct Box[T]:
    value: T
type HiddenPositive = secret[int64] where value > 0
struct Record:
    label: string
    token: HiddenText
    numbers: list[secret[int64]]
enum Payload:
    empty
    item(value: secret[string])
    branch(next: Payload)
machine Session:
    states:
        active(token: secret[string])
        closed
    transitions:
        active to closed
struct ActiveSession:
    session: Session at active
struct Vault:
    token: secret[int64]

function scalar_values() returns nothing:
    HiddenText token = "hidden-token"
    secret[int64] pending = run run 4321
    secret[bytes] data = bytes.from_string("hidden-bytes")
    secret[int64] input = 7654
    HiddenPositive positive = input handle error:
        return nothing
    trace token
    trace pending
    trace data
    trace positive
    breakpoint
    println(secret.redact(token))
    return nothing

function collection_values() returns nothing:
    secret[string] token = "hidden-collection"
    list[secret[int64]] numbers = list(run 4321, 7654)
    map[string, secret[string]] entries = map("public-key": clone token)
    optional[secret[string]] maybe = some(clone token)
    result[secret[string], string] success = ok(clone token)
    result[string, secret[string]] failure = fail(token)
    trace numbers
    trace entries
    trace maybe
    trace success
    trace failure
    list[string] public_markers = list(run "[redacted]")
    trace public_markers
    return nothing

function aggregate_values() returns nothing:
    Record record = Record(label: "public-label", token: "hidden-record", numbers: list(4321))
    Payload payload = Payload.branch(Payload.item("hidden-enum"))
    Session session = Session(active, "hidden-machine")
    trace record
    trace payload
    trace session
    Box[HiddenText] boxed = Box[HiddenText](value: "hidden-box")
    trace boxed
    ActiveSession narrowed = ActiveSession(session: Session(active, "hidden-narrowed"))
    trace narrowed
    breakpoint
    return nothing

function builder_values() returns nothing:
    TypeField field = list.get[TypeField](type.fields[Vault](), 0) handle:
        return nothing
    secret[int64] token = run 4321
    TypeConstruction builder = type.construct_start[Vault]()
    TypeConstruction filled = type.construct_put[Vault, secret[int64]](builder, view field, token) handle error:
        return nothing
    trace filled
    list[TypeConstruction] builders = list(clone filled)
    trace builders
    Vault built = type.construct_finish[Vault](filled) handle error:
        return nothing
    trace built
    return nothing

function debug_generic[T](value: T) returns nothing:
    T local = value
    trace local
    breakpoint
    return nothing

function debug_alias_capture(value: PublicCount) returns function() returns nothing:
    return function() returns nothing:
        trace value
        breakpoint
        return nothing

function debug_member_builders() returns nothing:
    TypeVariant variant = list.get[TypeVariant](type.variants[Payload](), 1) handle:
        return nothing
    TypeField field = list.get[TypeField](variant.fields, 0) handle:
        return nothing
    TypeConstruction builder = type.construct_variant_start[Payload](view variant) handle error:
        return nothing
    TypeConstruction filled = type.construct_put[Payload, secret[string]](builder, view field, "hidden-variant-builder") handle error:
        return nothing
    trace filled
    TypeMachineState state = list.get[TypeMachineState](type.machine_states[Session](), 0) handle:
        return nothing
    TypeField token = list.get[TypeField](state.fields, 0) handle:
        return nothing
    TypeConstruction session_builder = type.construct_machine_start[Session](view state) handle error:
        return nothing
    TypeConstruction active = type.construct_put[Session, secret[string]](session_builder, view token, "hidden-state-builder") handle error:
        return nothing
    trace active
    return nothing

function debug_inferred_bindings() returns nothing:
    list[secret[string]] tokens = list("hidden-loop")
    for item in clone tokens:
        trace item
        breakpoint
    map[string, secret[string]] entries = map("public": "hidden-map-loop")
    for key, token in clone entries:
        trace key
        trace token
    Payload payload = Payload.item("hidden-match")
    match clone payload:
        item(token):
            trace token
            breakpoint
        branch(next):
            trace next
        empty:
            return nothing
    result[int64, secret[string]] failed = fail("hidden-error")
    int64 unused = clone failed handle error:
        trace error
        breakpoint
        return nothing
    return nothing

function debug_generic_loop[T](values: list[T]) returns nothing:
    for item in values:
        trace item
    return nothing

function debug_generic_error[T](failed: result[int64, T]) returns nothing:
    int64 unused = clone failed handle error:
        trace error
        breakpoint
        return nothing
    return nothing

function error_identity[T](value: result[int64, T]) returns result[int64, T]:
    return value

function debug_generic_pipeline[T](failed: result[int64, T]) returns nothing:
    int64 unused = clone failed into error_identity[T]() handle error:
        trace error
        return nothing
    return nothing

function debug_generic_join[T](failed: result[int64, T]) returns nothing:
    result[int64, T] pending = run failed
    int64 unused = join pending handle error:
        trace error
        breakpoint
        return nothing
    return nothing

function main() returns nothing:
    scalar_values()
    collection_values()
    aggregate_values()
    builder_values()
    debug_generic[HiddenText]("hidden-generic")
    debug_generic[PublicCount](7)
    function() returns nothing captured = debug_alias_capture(8)
    captured()
    debug_member_builders()
    debug_inferred_bindings()
    debug_generic_loop[secret[string]](list("hidden-generic-loop"))
    debug_generic_loop[int64](list(9))
    debug_generic_error[secret[string]](fail("hidden-generic-error"))
    debug_generic_error[string](fail("public-error"))
    debug_generic_pipeline[secret[string]](fail("hidden-pipeline-error"))
    debug_generic_pipeline[string](fail("public-pipeline-error"))
    debug_generic_join[secret[string]](fail("hidden-join-error"))
    debug_generic_join[string](fail("public-join-error"))
    return nothing

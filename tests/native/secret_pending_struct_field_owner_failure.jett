namespace app
struct Record:
    name: secret[string]
function main() returns nothing:
    Record record = run Record(name: "hidden-owner")
    TypeField field = list.get[TypeField](type.fields[Record](), 0) handle:
        return nothing
    secret[string] copied = type.field_value[Record, secret[string]](view record, view field)
    println(secret.redact(copied))
    return nothing

namespace app
function parse_secret_list() returns string:
    secret[list[int64]] value = json.parse[secret[list[int64]]]("[1,2,3]") handle error:
        return error
    list[int64] opened = declassify value
    return "{list.length[int64](view opened)}"
function parse_list_of_secrets() returns string:
    list[secret[string]] values = json.parse[list[secret[string]]]("[\"Ada\",\"Lin\"]") handle error:
        return error
    secret[string] first = list.get[secret[string]](view values, 0) handle:
        return "missing"
    return declassify first
function parse_secret_bytes_list() returns string:
    list[secret[bytes]] values = json.parse[list[secret[bytes]]]("[\"4142\",\"00\"]") handle error:
        return error
    secret[bytes] first = list.get[secret[bytes]](view values, 0) handle:
        return "missing"
    bytes opened = declassify first
    return bytes.to_hex(view opened)
function parse_map_of_secret_lists() returns string:
    map[string, secret[list[int64]]] values = json.parse[map[string, secret[list[int64]]]]("{{\"first\":[1,2]}}") handle error:
        return error
    secret[list[int64]] first = map.get[string, secret[list[int64]]](values, "first") handle:
        return "missing"
    list[int64] opened = declassify first
    return "{list.length[int64](view opened)}"
function parse_result_secret() returns string:
    result[secret[string], secret[bytes]] value = json.parse[result[secret[string], secret[bytes]]]("{{\"ok\":\"Ada\"}}") handle error:
        return error
    secret[string] opened = value handle error:
        return "failure"
    return declassify opened
function parse_optional_secret_float() returns string:
    optional[secret[float32]] value = json.parse[optional[secret[float32]]]("1.25") handle error:
        return error
    secret[float32] opened = value handle:
        return "missing"
    float32 number = declassify opened
    return "{number}"
function parse_exact_secret_error() returns string:
    map[string, secret[list[int64]]] value = json.parse_exact[map[string, secret[list[int64]]]]("{{\"first\":[1,\"bad\"]}}") handle error:
        return error
    return "unexpected {map.length[string, secret[list[int64]]](view value)}"
function main() returns nothing:
    println(parse_secret_list())
    println(parse_list_of_secrets())
    println(parse_secret_bytes_list())
    println(parse_map_of_secret_lists())
    println(parse_result_secret())
    println(parse_optional_secret_float())
    println(parse_exact_secret_error())
    return nothing

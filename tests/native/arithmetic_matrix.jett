namespace app
function signed8(value: int8) returns nothing:
    int8 minimum = -128
    int8 negative_one = -1
    println("i8", value + 1, minimum - 1, value * 2, minimum / negative_one, minimum modulo negative_one, value > minimum)
    return nothing
function signed16(value: int16) returns nothing:
    int16 minimum = -32768
    int16 negative_one = -1
    println("i16", value + 1, minimum - 1, value * 2, minimum / negative_one, minimum modulo negative_one, value > minimum)
    return nothing
function signed32(value: int32) returns nothing:
    int32 minimum = -2147483648
    int32 negative_one = -1
    println("i32", value + 1, minimum - 1, value * 2, minimum / negative_one, minimum modulo negative_one, value > minimum)
    return nothing
function signed64(value: int64) returns nothing:
    int64 minimum = -9223372036854775808
    println("i64", value + 1, minimum - 1, value * 2, minimum / -1, minimum modulo -1, value > minimum)
    return nothing
function unsigned8(value: uint8) returns nothing:
    uint8 zero = 0
    println("u8", value + 1, zero - 1, value * 2, value / 2, value modulo 2, value > zero)
    return nothing
function unsigned16(value: uint16) returns nothing:
    uint16 zero = 0
    println("u16", value + 1, zero - 1, value * 2, value / 2, value modulo 2, value > zero)
    return nothing
function unsigned32(value: uint32) returns nothing:
    uint32 zero = 0
    println("u32", value + 1, zero - 1, value * 2, value / 2, value modulo 2, value > zero)
    return nothing
function unsigned64(value: uint64) returns nothing:
    uint64 zero = 0
    println("u64", value + 1, zero - 1, value * 2, value / 2, value modulo 2, value > zero)
    return nothing
function float32_edges(zero: float32) returns nothing:
    float32 left = 1.25
    float32 right = -2.5
    float32 infinity = 1.0 / zero
    float32 not_a_number = zero / zero
    println("f32", left + right, left - right, left * right, left / right, infinity > 1.0, not_a_number != not_a_number, not_a_number == not_a_number, -zero == zero, 1.0 / -zero < 0.0)
    return nothing
function float64_edges(zero: float64) returns nothing:
    float64 left = 1.25
    float64 right = -2.5
    float64 infinity = 1.0 / zero
    float64 not_a_number = zero / zero
    println("f64", left + right, left - right, left * right, left / right, infinity > 1.0, not_a_number != not_a_number, not_a_number == not_a_number, -zero == zero, 1.0 / -zero < 0.0)
    return nothing
function main() returns nothing:
    signed8(127)
    signed16(32767)
    signed32(2147483647)
    signed64(9223372036854775807)
    unsigned8(255)
    unsigned16(65535)
    unsigned32(4294967295)
    unsigned64(18446744073709551615)
    float32_edges(0.0)
    float64_edges(0.0)

interface Named:
    function name(view self: Named) returns string
struct User:
    label: string
struct Group:
    label: string
implement Named for User:
    function name(view self: User) returns string:
        return "user:{self.label}"
implement Named for Group:
    function name(view self: Group) returns string:
        return "group:{self.label}"
implement Named for int64:
    function name(view self: int64) returns string:
        return "number:{self}"
implement Named for string:
    function name(view self: string) returns string:
        return "text:{self}"
implement Named for nothing:
    function name(view self: nothing) returns string:
        return "nothing"
function show(view item: Named) returns string:
    return Named.name(view item)
function select(flag: bool) returns Named:
    if flag:
        return User(label: "Ada")
    return Group(label: "team")
struct Holder:
    item: Named
enum Choice:
    item(value: Named)
    empty
struct Vault:
    token: secret[string]
implement Named for Vault:
    function name(view self: Vault) returns string:
        return "vault"
function secret_values() returns nothing:
    Named vault = Vault(token: "hidden-interface-token")
    trace vault
    println(show(view vault))
    Named later = run vault
    trace later
    secret[Named] hidden = later
    trace hidden
    return nothing
machine Session:
    states:
        opened(item: Named)
        closed(item: Named)
    transitions:
        opened to closed
actor Catalog(initial: Named):
    mutable Named item = initial
    receive replace(value: Named):
        item = value
    receive read responds string:
        respond show(view item)
    receive original responds string:
        respond show(view initial)
function state_values() returns nothing:
    Session at opened started = Session(opened, User(label: "session"))
    println(show(view started.item))
    Session at closed ended = Session.transition(started, closed, Group(label: "closed"))
    println(show(view ended.item))
    Catalog catalog = spawn Catalog(initial: User(label: "actor"))
    println(ask catalog.read)
    send catalog.replace(Group(label: "message"))
    println(ask catalog.read)
    println(ask catalog.original)
    return nothing
function primitive_values() returns nothing:
    Named empty = run nothing
    trace empty
    Named joined_empty = join empty handle error:
        return nothing
    println(show(view joined_empty))
    Named number = 42
    Named text = "hello"
    println(show(view number))
    println(show(view text))
    Named pending = run 17
    trace pending
    Named ready = join pending handle error:
        return nothing
    println(show(view ready))
    string source = run "later"
    Named erased = source
    trace source
    trace erased
    Named joined = join erased handle error:
        return nothing
    println(show(view joined))
    return nothing
function stored_values() returns nothing:
    Holder holder = Holder(item: User(label: "stored"))
    println(show(view holder.item))
    Holder copied = clone holder
    println(show(view copied.item))
    Choice choice = Choice.item(Group(label: "enum"))
    match choice:
        item(value):
            println(show(view value))
        empty:
            println("empty")
    Named original = User(label: "copy")
    Named copied_item = clone original
    println(show(view original))
    println(show(view copied_item))
    return nothing
function pending_values() returns nothing:
    Named pending = run run User(label: "pending")
    trace pending
    Named once = join pending handle error:
        return nothing
    trace once
    Named ready = join once handle error:
        return nothing
    println(show(view ready))
    Named erased = Group(label: "erased")
    Named later = run erased
    trace later
    Named joined = join later handle error:
        return nothing
    println(show(view joined))
    return nothing
function generic_show[T](view item: Named, marker: T) returns string:
    return Named.name(view item)
function callback_values() returns nothing:
    Named item = User(label: "callback")
    function(view Named) returns string reader = show
    println(reader(view item))
    println(generic_show[int64](view item, 1))
    return nothing
function moved_values() returns nothing:
    mutable Named original = User(label: "before move")
    Named moved = original
    breakpoint
    original = Group(label: "restored")
    breakpoint
    println(show(view moved))
    println(show(view original))
    return nothing
function collection_conversions() returns nothing:
    list[User] users = list(User(label: "converted-list"))
    list[Named] items = users
    for item in items:
        println(show(view item))
    optional[Group] group = some(Group(label: "converted-optional"))
    optional[Named] maybe = group
    Named found = maybe handle:
        return nothing
    println(show(view found))
    result[User, Group] success = ok(User(label: "converted-result"))
    result[Named, Named] converted = success
    Named value = converted handle error:
        return nothing
    println(show(view value))
    map[string, User] records = map("key": User(label: "converted-map"))
    map[string, Named] mapped = records
    trace mapped
    return nothing
function nested_collection_conversions() returns nothing:
    list[list[User]] records = list(list(User(label: "nested")))
    list[list[Named]] converted = records
    trace converted
    list[User] pending = run list(User(label: "pending-list"))
    list[Named] erased = pending
    trace erased
    list[Named] ready = join erased handle error:
        return nothing
    for item in ready:
        println(show(view item))
    result[User, Group] failed = fail(Group(label: "converted-error"))
    result[Named, Named] failure = failed
    trace failure
    optional[User] missing = none
    optional[Named] empty = missing
    trace empty
    return nothing
function empty_names() returns list[Named]:
    return list()
function empty_map() returns map[string, Named]:
    return map()
function empty_conversions() returns nothing:
    list[Named] empty = empty_names()
    list[Named] filled = list.append[Named](empty, User(label: "after-empty"))
    trace filled
    map[string, Named] entries = empty_map()
    map[string, Named] inserted = map.insert[string, Named](entries, "key", Group(label: "after-empty-map"))
    trace inserted
    return nothing
function main() returns nothing:
    empty_conversions()
    collection_conversions()
    nested_collection_conversions()
    moved_values()
    callback_values()
    primitive_values()
    state_values()
    secret_values()
    stored_values()
    pending_values()
    Named first = select(true)
    Named second = select(false)
    println(show(view first))
    println(show(view second))
    trace first
    list[Named] items = list(User(label: "Grace"), Group(label: "crew"))
    for item in items:
        println(show(view item))
    return nothing

namespace app
actor Counter:
    mutable int64 count = 1
    receive add(amount: int64):
        count = count + amount
    receive read responds int64:
        respond count
function calculate() returns int64:
    Counter counter = spawn Counter()
    send counter.add(4)
    return ask counter.read
function main() returns nothing:
    int64 live = calculate()
    int64 baked = comptime calculate()
    println("live:{live}")
    println("baked:{baked}")
    return nothing

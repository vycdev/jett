namespace app
machine Session:
    states:
        active
        inactive(count: int64)
    transitions:
        active to inactive
function main() returns nothing:
    Session session = Session(active)
    TypeMachineState other = list.get[TypeMachineState](type.machine_states[Session](), 1) handle:
        return nothing
    TypeField foreign = list.get[TypeField](other.fields, 0) handle:
        return nothing
    int64 count = type.machine_field_value[Session, int64](view session, view foreign)
    println(count)
    return nothing

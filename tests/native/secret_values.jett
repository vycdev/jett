namespace app
struct Credentials:
    label: string
    token: secret[string]
    key: secret[bytes]
function payload() returns bytes:
    return bytes.from_string("payload")
function main() returns nothing:
    secret[string] token = "agent-key"
    secret[string] same = "agent-key"
    secret[string] other = "agent-kex"
    println(secret.compare(clone token, same), secret.compare(clone token, other), secret.redact(clone token))
    secret[string] longer = "agent-key-longer"
    secret[string] unicode = "Jett 🚀"
    secret[string] unicode_same = "Jett 🚀"
    println(secret.compare(clone token, longer), secret.compare(unicode, unicode_same))
    secret[bytes] key = payload()
    secret[bytes] matching = bytes.from_string("payload")
    secret[bytes] different = bytes.from_string("payloae")
    println(secret.compare(clone key, matching), secret.compare(clone key, different), secret.redact(clone key))
    Credentials first = Credentials(label: "service", token: token, key: key)
    Credentials second = clone first
    println(first.label, secret.redact(first.token), secret.redact(second.key))

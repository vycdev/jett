namespace app
struct Inner:
    value: int64
actor Store(seed: int64):
    mutable list[int64] owned = list(seed, seed + 1)
    list[int64] immediate = view owned
    list[int64] transitive = view immediate
    mutable Inner inner = Inner(value: seed)
    receive advance(amount: int64):
        inner.value = inner.value + amount + list.sum[int64](view transitive)
    receive read responds string:
        respond "{list.length(view immediate)}:{list.sum[int64](view immediate)}:{list.length(view transitive)}:{list.sum[int64](view transitive)}:{inner.value}"
function main(stdout: Stdout) returns nothing:
    Store first = spawn Store(seed: 2)
    Store second = spawn Store(seed: 10)
    string first_before = ask first.read
    string second_before = ask second.read
    Stdout.write(view stdout, "before:{first_before}|{second_before}\n")
    send first.advance(3)
    send first.advance(4)
    send second.advance(1)
    string first_after = ask first.read
    string second_after = ask second.read
    Stdout.write(view stdout, "after:{first_after}|{second_after}\n")
    return nothing

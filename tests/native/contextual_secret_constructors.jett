namespace app
interface Named:
    function name(view self: Named) returns string
implement Named for int8:
    function name(view self: int8) returns string:
        return "small:{self}"
struct Counter:
    value: int8
implement Named for Counter:
    function name(view self: Counter) returns string:
        return "record:{self.value}"
type Selected = Named where true
implement Named for Selected:
    function name(view self: Selected) returns string:
        Named base = coarsen clone self
        return "selected:{Named.name(view base)}"
type Tiny = int8 where value != 0
function selected(value: int8) returns Selected:
    Named base = value
    Selected chosen = base handle error:
        return selected(value)
    return chosen
function increment(value: int8) returns int8:
    return value + 1
function item(view values: list[int8], index: int64) returns int8:
    return list.get[int8](view values, index) handle:
        default 0
function map_item(view values: map[int8, int8], key: int8) returns int8:
    return map.get[int8, int8](clone values, key) handle:
        default 0
function describe_optional(view candidate: optional[int8]) returns string:
    int8 found = clone candidate handle:
        return "none"
    return "some:{found}"
function describe_outcome(view outcome: result[int8, int8]) returns string:
    int8 found = clone outcome handle error:
        return "fail:{error}"
    return "ok:{found}"
function names(view values: list[Named]) returns string:
    mutable string text = ""
    for value in view values:
        text = "{text}{Named.name(view value)};"
    return text
function optional_name(view candidate: optional[Named]) returns string:
    Named found = clone candidate handle:
        return "none"
    return "some:{Named.name(view found)}"
function outcome_name(view outcome: result[Named, Named]) returns string:
    Named found = clone outcome handle error:
        return "fail:{Named.name(view error)}"
    return "ok:{Named.name(view found)}"
function map_name(view values: map[string, Named], key: string) returns string:
    Named found = map.get[string, Named](clone values, key) handle:
        return "none"
    return Named.name(view found)
function list_report() returns string:
    secret[list[int8]] hidden = list(-128, 127, -1)
    secret[list[int8]] empty = list()
    list[int8] values = declassify clone hidden
    list[int8] absent = declassify clone empty
    return "list={list.length(view values)}:{item(view values, 0)}:{item(view values, 1)}:{item(view values, 2)};empty={list.length(view absent)}"
function map_report() returns string:
    secret[map[int8, int8]] hidden = map(-128: 127, 7: -8)
    secret[map[int8, int8]] empty = map()
    map[int8, int8] values = declassify clone hidden
    map[int8, int8] absent = declassify clone empty
    return "map={map.length(view values)}:{map_item(view values, -128)}:{map_item(view values, 7)};empty={map.length(view absent)}"
function sum_report() returns string:
    secret[optional[int8]] present = some(-128)
    secret[optional[int8]] absent = none
    secret[result[int8, int8]] success = ok(127)
    secret[result[int8, int8]] failure = fail(-128)
    optional[int8] yes = declassify clone present
    optional[int8] no = declassify clone absent
    result[int8, int8] good = declassify clone success
    result[int8, int8] bad = declassify clone failure
    return "{describe_optional(view yes)}:{describe_optional(view no)}:{describe_outcome(view good)}:{describe_outcome(view bad)}"
function nested_report() returns string:
    int8 first = 7
    int8 last = -8
    secret[secret[list[int8]]] twice = list(first, last)
    secret[list[int8]] once = declassify clone twice
    list[int8] values = declassify clone once
    secret[list[secret[int8]]] hidden_children = list(7, -8)
    list[secret[int8]] children = declassify clone hidden_children
    mutable string text = ""
    for child in view children:
        int8 public = declassify child
        text = "{text}{public},"
    return "twice={list.length(view values)}:{item(view values, 0)}:{item(view values, 1)};children={text}"
function owner_report() returns string:
    secret[list[Named]] hidden = list(selected(7), Counter(value: 8))
    secret[optional[Named]] maybe = some(selected(9))
    secret[result[Named, Named]] success = ok(Counter(value: 10))
    secret[result[Named, Named]] failure = fail(selected(11))
    secret[map[string, Named]] hidden_map = map("selected": selected(12), "record": Counter(value: 13))
    list[Named] values = declassify clone hidden
    optional[Named] candidate = declassify clone maybe
    result[Named, Named] good = declassify clone success
    result[Named, Named] bad = declassify clone failure
    map[string, Named] mapping = declassify clone hidden_map
    return "{names(view values)}|{optional_name(view candidate)}|{outcome_name(view good)}|{outcome_name(view bad)}|{map_name(view mapping, "selected")}:{map_name(view mapping, "record")}"
function child_report() returns string:
    int8 first_seed = 7
    int8 last_seed = -8
    Tiny first = first_seed handle error:
        return error
    Tiny last = last_seed handle error:
        return error
    secret[list[Tiny]] hidden = list(first, last)
    list[Tiny] values = declassify clone hidden
    mutable string text = ""
    for value in view values:
        int8 public = coarsen value
        text = "{text}{public},"
    int8 offset = 3
    function(int8) returns int8 captured = function(value: int8) returns int8: return value + offset
    secret[list[function(int8) returns int8]] callbacks = list(increment, captured)
    list[function(int8) returns int8] public_callbacks = declassify clone callbacks
    function(int8) returns int8 named = list.get[function(int8) returns int8](view public_callbacks, 0) handle:
        return "missing named"
    function(int8) returns int8 closure = list.get[function(int8) returns int8](view public_callbacks, 1) handle:
        return "missing closure"
    return "refined={text};callbacks={named(127)}:{closure(4)}"
function hidden_pair[T](first: T, last: T) returns secret[list[T]]:
    return list(first, last)
function hidden_empty[T]() returns secret[list[T]]:
    return list()
function hidden_some[T](value: T) returns secret[optional[T]]:
    return some(value)
function hidden_failure[T, E](problem: E) returns secret[result[T, E]]:
    return fail(problem)
function context_report() returns string:
    secret[list[int8]] hidden = hidden_pair[int8](-8, 7)
    secret[list[int8]] empty = hidden_empty[int8]()
    secret[optional[int8]] maybe = hidden_some[int8](-128)
    secret[result[int8, int8]] failure = hidden_failure[int8, int8](-8)
    function() returns secret[map[int8, int8]] mapping = function() returns secret[map[int8, int8]]: return map(7: -8)
    function(int8) returns secret[optional[int8]] wrap = function(value: int8) returns secret[optional[int8]]: return some(value)
    list[int8] values = declassify clone hidden
    list[int8] absent = declassify clone empty
    optional[int8] candidate = declassify clone maybe
    result[int8, int8] outcome = declassify clone failure
    map[int8, int8] inline_map = declassify mapping()
    optional[int8] inline_some = declassify wrap(127)
    return "list={list.length(view values)}:{item(view values, 0)}:{item(view values, 1)};empty={list.length(view absent)};{describe_optional(view candidate)};{describe_outcome(view outcome)};map={map_item(view inline_map, 7)};inline={describe_optional(view inline_some)}"
function baked_report() returns string:
    secret[list[int8]] hidden = comptime list(-128, 127)
    secret[optional[int8]] maybe = comptime hidden_some[int8](-8)
    secret[list[Named]] hidden_owners = comptime list(selected(7), Counter(value: 8))
    list[int8] values = declassify clone hidden
    optional[int8] candidate = declassify clone maybe
    list[Named] owners = declassify clone hidden_owners
    return "list={list.length(view values)}:{item(view values, 0)}:{item(view values, 1)};{describe_optional(view candidate)};owners={names(view owners)}"
function main(stdout: Stdout) returns nothing:
    Stdout.write(view stdout, "lists:{list_report()}\n")
    Stdout.write(view stdout, "maps:{map_report()}\n")
    Stdout.write(view stdout, "sums:{sum_report()}\n")
    Stdout.write(view stdout, "nested:{nested_report()}\n")
    Stdout.write(view stdout, "owners:{owner_report()}\n")
    Stdout.write(view stdout, "children:{child_report()}\n")
    Stdout.write(view stdout, "contexts:{context_report()}\n")
    Stdout.write(view stdout, "baked:{baked_report()}\n")
    secret[list[int8]] observed = list(7, -8)
    trace observed
    list[int8] visible = declassify clone observed
    Stdout.write(view stdout, "observed:{list.length(view visible)}:{item(view visible, 0)}:{item(view visible, 1)}\n")
verify contextual_secret_values:
    assert list_report() == "list=3:-128:127:-1;empty=0"
    assert map_report() == "map=2:127:-8;empty=0"
    assert sum_report() == "some:-128:none:ok:127:fail:-128"
    assert nested_report() == "twice=2:7:-8;children=7,-8,"
    assert owner_report() == "selected:small:7;record:8;|some:selected:small:9|ok:record:10|fail:selected:small:11|selected:small:12:record:13"
    assert child_report() == "refined=7,-8,;callbacks=-128:7"
    assert context_report() == "list=2:-8:7;empty=0;some:-128;fail:-8;map=-8;inline=some:127"
    assert baked_report() == "list=2:-128:127;some:-8;owners=selected:small:7;record:8;"
property secret_constructor_trials:
    given seed: int8
    secret[list[int8]] hidden = hidden_pair[int8](seed, seed + 1)
    list[int8] values = declassify clone hidden
    assert item(view values, 0) == seed
    assert item(view values, 1) == seed + 1
    secret[map[int8, int8]] hidden_map = map(1: seed)
    map[int8, int8] mapping = declassify clone hidden_map
    assert map_item(view mapping, 1) == seed
    secret[optional[int8]] present = some(seed)
    int8 found = declassify clone present handle:
        default 0
    assert found == seed
    secret[result[int8, int8]] failure = fail(seed)
    int8 recovered = declassify clone failure handle error:
        default error
    assert recovered == seed
    assert child_report() == "refined=7,-8,;callbacks=-128:7"

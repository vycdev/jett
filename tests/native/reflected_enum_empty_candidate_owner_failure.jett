namespace app
enum Choice:
    empty
    number(value: int64)
function main() returns nothing:
    Choice selected = Choice.empty
    TypeVariant other = list.get[TypeVariant](type.variants[Choice](), 1) handle:
        return nothing
    TypeField foreign = list.get[TypeField](other.fields, 0) handle:
        return nothing
    int64 value = type.variant_field_value[Choice, int64](view selected, view foreign)
    println(value)
    return nothing

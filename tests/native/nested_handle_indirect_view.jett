namespace test
function combine(view label: string, value: int64) returns string:
    return "{label}:{value}"
function main() returns nothing:
    mutable string label = "old"
    function(view string, int64) returns string callback = combine
    optional[int64] maybe = none
    string answer = callback(view label, maybe handle:
        label = "new"
        default 2
    )
    println(answer)
    println(label)
    mutable string nested_label = "before"
    function(view string, int64) returns string nested_callback = combine
    optional[int64] nested_maybe = none
    println(nested_callback(view nested_label, nested_maybe handle:
        nested_label = "after"
        default 3
    ))
    println(nested_label)
    return nothing

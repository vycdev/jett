namespace test
actor Holder(seed: string):
    mutable string label = "{seed}!"
    receive noop:
        return nothing
function main() returns nothing:
    Holder first = spawn Holder(seed: "alpha")
    Holder second = spawn Holder(seed: "beta")
    Holder third = spawn Holder(seed: "gamma")
    list[Holder] active = list(third)
    trace first
    trace second
    trace active
    breakpoint true
    send first.noop
    send second.noop
    return nothing

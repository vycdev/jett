namespace app
function parse_ok() returns string:
    result[int64, string] parsed = json.parse[result[int64, string]]("{{\"ok\":7}}") handle error:
        return error
    int64 value = parsed handle error:
        return error
    return "{value}"
function parse_fail() returns string:
    result[int64, string] parsed = json.parse[result[int64, string]]("{{\"fail\":\"bad\"}}") handle error:
        return error
    int64 value = parsed handle error:
        return error
    return "unexpected {value}"
function parse_exact_ok() returns string:
    result[optional[int64], string] parsed = json.parse_exact[result[optional[int64], string]]("{{\"ok\":null}}") handle error:
        return error
    optional[int64] maybe = parsed handle error:
        return error
    int64 value = maybe handle:
        default -1
    return "{value}"
function parse_exact_fail() returns string:
    result[int64, string] parsed = json.parse_exact[result[int64, string]]("{{\"fail\":\"exact\"}}") handle error:
        return error
    int64 value = parsed handle error:
        return error
    return "unexpected {value}"
function parse_nested() returns string:
    list[result[int64, string]] values = json.parse[list[result[int64, string]]]("[{{\"ok\":1}},{{\"fail\":\"x\"}}]") handle error:
        return error
    return "{list.length[result[int64, string]](view values)}"
function parse_exact_nested() returns string:
    map[string, result[int64, string]] values = json.parse_exact[map[string, result[int64, string]]]("{{\"first\":{{\"ok\":1}}}}") handle error:
        return error
    return "{map.length[string, result[int64, string]](view values)}"
function parse_multiple_keys_error() returns string:
    result[int64, string] value = json.parse[result[int64, string]]("{{\"ok\":1,\"fail\":\"bad\"}}") handle error:
        return error
    int64 item = value handle error:
        return error
    return "unexpected {item}"
function parse_exact_payload_error() returns string:
    result[int64, string] value = json.parse_exact[result[int64, string]]("{{\"ok\":true}}") handle error:
        return error
    int64 item = value handle error:
        return error
    return "unexpected {item}"
function main() returns nothing:
    println(parse_ok())
    println(parse_fail())
    println(parse_exact_ok())
    println(parse_exact_fail())
    println(parse_nested())
    println(parse_exact_nested())
    println(parse_multiple_keys_error())
    println(parse_exact_payload_error())

namespace app
struct Store:
    items: list[int64]
function first_or_zero(view items: list[int64]) returns int64:
    return list.get[int64](view items, 0) handle:
        default 0
function add_first(view items: list[int64], extra: int64) returns int64:
    return first_or_zero(view items) + extra
function main() returns nothing:
    mutable Store store = Store(items: list(3))

namespace app
struct Vault:
    token: secret[string]
function main() returns nothing:
    TypeField field = list.get[TypeField](type.fields[Vault](), 0) handle:
        return nothing
    TypeConstruction builder = type.construct_start[Vault]()
    TypeConstruction filled = type.construct_put[Vault, secret[string]](builder, view field, "hidden-builder") handle error:
        return nothing
    TypeConstruction pending = run filled
    TypeConstruction unused = type.construct_put[Vault, secret[string]](pending, view field, "hidden-second") handle error:
        return nothing
    return nothing

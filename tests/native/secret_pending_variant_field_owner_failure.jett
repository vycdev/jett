namespace app
enum Message:
    named(value: secret[string])
function main() returns nothing:
    TypeVariant variant = list.get[TypeVariant](type.variants[Message](), 0) handle:
        return nothing
    TypeField field = list.get[TypeField](variant.fields, 0) handle:
        return nothing
    Message pending_message = run Message.named("hidden-owner")
    secret[string] copied = type.variant_field_value[Message, secret[string]](view pending_message, view field)
    println(secret.redact(copied))
    return nothing

namespace app
struct Credential:
    name: string
    token: secret[string]
machine TokenLifecycle:
    states:
        issued(token: secret[string], public_id: string serialize "publicId")
        revoked
    transitions:
        issued to revoked
function parse_secret() returns string:
    secret[string] token = json.parse[secret[string]]("\"key\"") handle error:
        return error
    return secret.redact(token)
function parse_record() returns string:
    Credential credential = json.parse[Credential]("{{\"name\":\"svc\",\"token\":\"key\"}}") handle error:
        return error
    return "{credential.name}:{secret.redact(credential.token)}:{json.serialize_public[Credential](view credential)}"
function parse_exact_extra() returns string:
    Credential credential = json.parse_exact[Credential]("{{\"name\":\"svc\",\"token\":\"key\",\"extra\":true}}") handle error:
        return error
    return credential.name
function parse_exact_secret_record() returns string:
    secret[Credential] credential = json.parse_exact[secret[Credential]]("{{\"name\":\"svc\",\"token\":\"key\"}}") handle error:
        return error
    return secret.redact(credential)
function parse_raw_secret() returns string:
    secret[json.JsonTree] tree = json.parse[secret[json.JsonTree]]("{{\"open\":true}}") handle error:
        return error
    return secret.redact(tree)
function parse_exact_raw_secret() returns string:
    secret[json.JsonTree] tree = json.parse_exact[secret[json.JsonTree]]("{{\"open\":true,\"nested\":{{\"kept\":1}}}}") handle error:
        return error
    return secret.redact(tree)
function parse_raw_secret_error() returns string:
    secret[json.JsonTree] tree = json.parse_exact[secret[json.JsonTree]]("[1,") handle error:
        return error
    return secret.redact(tree)
function parse_machine() returns string:
    TokenLifecycle token = json.parse[TokenLifecycle]("{{\"state\":\"issued\",\"payload\":{{\"token\":\"key\",\"publicId\":\"tok-1\"}}}}") handle error:
        return error
    return json.serialize_public[TokenLifecycle](view token)
function main() returns nothing:
    println(parse_secret())
    println(parse_record())
    println(parse_exact_extra())
    println(parse_exact_secret_record())
    println(parse_raw_secret())
    println(parse_exact_raw_secret())
    println(parse_raw_secret_error())
    println(parse_machine())

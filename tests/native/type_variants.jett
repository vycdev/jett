namespace app
enum Choice:
    token(value: secret[string])
    score(count: int64)
    empty
type ChoiceAlias = Choice
function main() returns nothing:
    list[TypeVariant] variants = type.variants[Choice]()
    for variant in variants:
        println(variant.index, variant.owner_type, variant.name, variant.discriminant, variant.has_secret)
        for field in variant.fields:
            string member = clone field.owner_member handle:
                default "missing"
            println(field.index, field.owner_type, member, field.name, field.type_name, field.type_info.type_name)
            for arg in field.type_info.args:
                println(arg.type_name)
        println(variant.name)
    list[TypeVariant] aliases = type.variants[ChoiceAlias]()
    println(list.length[TypeVariant](view aliases))
    list[TypeVariant] primitive = type.variants[int64]()
    println(list.length[TypeVariant](view primitive))
    Choice scored = Choice.score(42)
    TypeVariant selected = type.variant_value[Choice](view scored)
    println(selected.index, selected.owner_type, selected.name, selected.discriminant, selected.has_secret)
    for field in selected.fields:
        println(field.name, field.type_name)
    TypeVariant empty = type.variant_value[Choice](Choice.empty)
    println(empty.index, empty.name, list.length[TypeField](empty.fields))

namespace app
enum Choice:
    token(value: secret[string])
    score(count: int64)
    batch(items: list[int64])
    empty
type ChoiceAlias = Choice
function reflected_score() returns nothing:
    Choice scored = Choice.score(42)
    TypeVariant selected = type.variant_value[Choice](view scored)
    println(selected.index, selected.owner_type, selected.name, selected.discriminant, selected.has_secret)
    for field in selected.fields:
        println(field.name, field.type_name)
        if field.name == "count":
            int64 count = type.variant_field_value[Choice, int64](view scored, view field)
            println(count)
    TypeVariant empty = type.variant_value[Choice](Choice.empty)
    println(empty.index, empty.name, list.length[TypeField](empty.fields))
function reflected_token() returns nothing:
    Choice token_value = Choice.token("key")
    TypeVariant token_variant = type.variant_value[Choice](view token_value)
    for field in token_variant.fields:
        if field.name == "value":
            secret[string] copied = type.variant_field_value[Choice, secret[string]](view token_value, view field)
            println(secret.redact(copied), token_variant.name)
function reflected_batch() returns nothing:
    Choice batch = Choice.batch(list(3, 5))
    TypeVariant batch_variant = type.variant_value[Choice](view batch)
    for field in batch_variant.fields:
        if field.name == "items":
            mutable list[int64] items = type.variant_field_value[Choice, list[int64]](view batch, view field)
            items = list.append[int64](items, 7)
            println(batch_variant.name, list.length[int64](view items))
function main() returns nothing:
    list[TypeVariant] variants = type.variants[Choice]()
    for variant in variants:
        println(variant.index, variant.owner_type, variant.name, variant.discriminant, variant.has_secret)
        for field in variant.fields:
            string member = clone field.owner_member handle:
                default "missing"
            println(field.index, field.owner_type, member, field.name, field.type_name, field.type_info.type_name)
            for arg in field.type_info.args:
                println(arg.type_name)
        println(variant.name)
    list[TypeVariant] aliases = type.variants[ChoiceAlias]()
    println(list.length[TypeVariant](view aliases))
    list[TypeVariant] primitive = type.variants[int64]()
    println(list.length[TypeVariant](view primitive))
    reflected_score()
    reflected_token()
    reflected_batch()

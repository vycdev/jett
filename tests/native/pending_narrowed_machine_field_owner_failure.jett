namespace app
machine Session:
    states:
        active(name: string)
    transitions:
        active to active
function main() returns nothing:
    Session at active session = run Session(active, "Ada")
    TypeMachineState state = list.get[TypeMachineState](type.machine_states[Session](), 0) handle:
        return nothing
    TypeField field = list.get[TypeField](state.fields, 0) handle:
        return nothing
    string copied = type.machine_field_value[Session at active, string](view session, view field)
    println(copied)
    return nothing

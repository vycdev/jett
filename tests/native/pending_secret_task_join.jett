namespace app
function main() returns nothing:
    secret[string] text = "agent"
    secret[string] pending_text = run text
    secret[string] joined_text = join pending_text handle error:
        return nothing
    secret[string] expected_text = "agent"
    println(secret.compare(joined_text, expected_text))
    secret[string] contextual_text = run "agent"
    secret[string] joined_contextual = join contextual_text handle error:
        return nothing
    secret[string] second_expected = "agent"
    println(secret.compare(joined_contextual, second_expected))
    secret[bytes] data = bytes.from_string("key")
    secret[bytes] pending_data = run data
    secret[bytes] joined_data = join pending_data handle error:
        return nothing
    secret[bytes] expected_data = bytes.from_string("key")
    println(secret.compare(joined_data, expected_data))
    return nothing

namespace app
machine Portfolio:
    states:
        active(rows: map[string, string], title: string)
        closed
    transitions:
        active to closed
function inspect(view portfolio: Portfolio at active) returns int64:
    mutable int64 total = 0
    for key, item in view portfolio.rows:
        println(key, item)
        total = total + 1
    for character in view portfolio.title:
        println(character)
        total = total + 1
    return total
function main() returns nothing:
    Portfolio at active portfolio = Portfolio(active, map("a": "Ada", "b": "Lin"), "A🚀é")
    println(inspect(view portfolio), inspect(view portfolio))
    return nothing

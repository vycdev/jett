namespace app
function qualified_project_summary() returns string:
    use shared.models
    models.Account account = models.Account(id: "a1", visits: list(2, 3))
    string raw = json.serialize[models.Account](view account)
    models.Account decoded = json.parse[models.Account](raw) handle error:
        return error
    return models.account_summary(view decoded)
verify project_sibling_verify:
    assert qualified_project_summary() == "a1:2"

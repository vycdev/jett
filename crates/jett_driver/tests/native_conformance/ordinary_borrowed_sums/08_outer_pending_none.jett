namespace app
function inspect(view stdout: Stdout, view source: optional[list[int64]]) returns nothing:
    Stdout.write(view stdout, "before\n")
    list[int64] alias = view((view source) handle:
        Stdout.write(view stdout, "unexpected handler\n")
        return nothing
    )
    list[int64] forwarded = alias
    Stdout.write(view stdout, "afteralias\n")
    int64 total = list.sum[int64](view forwarded)
    Stdout.write(view stdout, "unexpected sum:{total}\n")
    return nothing
function main(stdout: Stdout) returns nothing:
    optional[list[int64]] source = run run none
    inspect(view stdout, view source)
    return nothing

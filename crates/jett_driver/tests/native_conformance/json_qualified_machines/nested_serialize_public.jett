namespace app
machine Session:
    states:
        ready(count: int64)
        cached(entries: map[int64, int64])
    transitions:
        ready to cached
type Ready = Session at ready
function main(stdout: Stdout) returns nothing:
    list[Ready] values = list(Session(ready, 21), Session(ready, 22))
    string encoded = values into view json.serialize_public[list[Ready]]()
    Stdout.write(view stdout, "{encoded}\n")
    for value in view values:
        Stdout.write(view stdout, "{value.count},")
    Stdout.write(view stdout, "\n")

namespace app
machine Session:
    states:
        ready(count: int64)
        cached(entries: map[int64, int64])
    transitions:
        ready to cached
function optional_count(view value: optional[Session at ready]) returns string:
    Session at ready item = clone value handle:
        return "none"
    return "{item.count}"
function main(stdout: Stdout) returns nothing:
    string first_raw = "{{\"state\":\"ready\",\"payload\":{{\"count\":41}}}}"
    optional[Session at ready] first = json.parse_exact[optional[Session at ready]](first_raw) handle error:
        return Stdout.write(view stdout, "first error:{error}\n")
    string second_raw = "null"
    optional[Session at ready] second = json.parse_exact[optional[Session at ready]](second_raw) handle error:
        return Stdout.write(view stdout, "second error:{error}\n")
    Stdout.write(view stdout, "parsed:{optional_count(view first)}:{optional_count(view second)}\n")

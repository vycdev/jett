namespace app
machine Session:
    states:
        ready(count: int64)
        cached(entries: map[int64, int64])
    transitions:
        ready to cached
function main(stdout: Stdout) returns nothing:
    Session at ready value = Session(ready, 8)
    string encoded = json.serialize_public[Session at ready](view value)
    Stdout.write(view stdout, "{encoded}\n")
    Stdout.write(view stdout, "alive:{value.count}\n")

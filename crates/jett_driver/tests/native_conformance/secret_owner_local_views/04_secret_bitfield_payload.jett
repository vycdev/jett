namespace app
bitfield network Packet:
    version: 4 bits
    flags: 4 bits
    payload: list[uint8]
function main(stdout: Stdout) returns nothing:
    uint8 first = 7
    uint8 second = 255
    uint8 added = 9
    secret[Packet] hidden = Packet(version: 4, flags: 0, payload: list(first, second))
    secret[list[uint8]] borrowed = view hidden.payload
    secret[list[uint8]] forwarded = view borrowed
    mutable list[uint8] copied = clone declassify forwarded
    copied = list.append[uint8](copied, added)
    bytes encoded = Packet.to_bytes(clone declassify hidden)
    Stdout.write(view stdout, "bitfield:{list.length(view declassify forwarded)}:{list.length(view copied)}:{list.length(view declassify hidden.payload)}:{bytes.to_hex(view encoded)}\n")
    return nothing

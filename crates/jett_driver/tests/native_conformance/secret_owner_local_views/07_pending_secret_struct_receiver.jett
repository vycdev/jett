namespace app
struct Payload:
    data: bytes
struct Packet:
    payload: Payload
function main(stdout: Stdout) returns nothing:
    secret[Packet] hidden = run run Packet(payload: Payload(data: bytes.from_string("AB")))
    Stdout.write(view stdout, "before:secret\n")
    secret[Payload] aggregate = view hidden.payload
    Stdout.write(view stdout, "after:aggregate\n")
    secret[bytes] borrowed = view aggregate.data
    Stdout.write(view stdout, "after:data\n")
    bytes copied = clone declassify borrowed
    Stdout.write(view stdout, "after:length:{bytes.length(view copied)}\n")
    return nothing

namespace app
struct Payload:
    data: bytes
struct Packet:
    payload: Payload
function main(stdout: Stdout) returns nothing:
    bytes data = bytes.from_hex("4344") handle error:
        return nothing
    secret[Packet] hidden = Packet(payload: Payload(data: data))
    secret[Payload] aggregate = view hidden.payload
    secret[Payload] forwarded_aggregate = view aggregate
    secret[bytes] borrowed = view forwarded_aggregate.data
    secret[bytes] forwarded = view borrowed
    bytes copied = clone declassify forwarded
    Stdout.write(view stdout, "nested:{bytes.to_hex(view copied)}:{bytes.length(view copied)}:{bytes.to_hex(view declassify hidden.payload.data)}\n")
    return nothing

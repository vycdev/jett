namespace app
struct Packet:
    data: bytes
function main(stdout: Stdout) returns nothing:
    secret[Packet] hidden = Packet(data: bytes.from_hex("4142") handle error:
        return nothing
    )
    secret[bytes] borrowed = view hidden.data
    bytes copied = clone declassify borrowed
    Stdout.write(view stdout, "direct:{bytes.to_hex(view copied)}:{bytes.length(view copied)}:{bytes.to_hex(view declassify hidden.data)}\n")
    return nothing

namespace app
struct Payload:
    data: bytes
struct Packet:
    payload: Payload
function main(stdout: Stdout) returns nothing:
    bytes data = bytes.from_hex("4344") handle error:
        return nothing
    secret[Packet] hidden = Packet(payload: Payload(data: data))
    bytes copied = clone declassify hidden.payload.data
    Stdout.write(view stdout, "owned:{bytes.to_hex(view copied)}:{bytes.length(view copied)}:{bytes.to_hex(view declassify hidden.payload.data)}\n")
    return nothing

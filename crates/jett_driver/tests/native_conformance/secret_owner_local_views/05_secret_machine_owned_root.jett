namespace app
machine Packet:
    states:
        ready(data: bytes, items: list[int64])
        empty
function main(stdout: Stdout) returns nothing:
    secret[Packet at ready] hidden = Packet(ready, bytes.from_string("AB"), list(2, 3))
    secret[bytes] borrowed_data = view hidden.data
    secret[bytes] forwarded_data = view borrowed_data
    secret[list[int64]] borrowed_items = view hidden.items
    secret[list[int64]] forwarded_items = view borrowed_items
    bytes copied_data = clone declassify forwarded_data
    mutable list[int64] copied_items = clone declassify forwarded_items
    copied_items = list.append[int64](copied_items, 5)
    Stdout.write(view stdout, "owned:{bytes.to_hex(view copied_data)}:{list.length(view copied_items)}:{bytes.to_hex(view declassify forwarded_data)}:{list.length(view declassify forwarded_items)}\n")
    Stdout.write(view stdout, "owner:{bytes.to_hex(view declassify hidden.data)}:{list.length(view declassify hidden.items)}\n")
    return nothing

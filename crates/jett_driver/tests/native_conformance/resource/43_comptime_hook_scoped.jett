namespace app
function choose() returns function(resource_probe.TestHandle) returns nothing:
    use resource_probe
    comptime type Inner = type.info[int64]():
        return resource_probe.descriptor()
    return resource_probe.descriptor()
export function main(net: Network) returns nothing:
    use resource_probe
    function(resource_probe.TestHandle) returns nothing dispose = comptime choose()
    resource_probe.TestHandle token = resource_probe.create(view net, 761) handle error:
        return nothing
    dispose(token)
    return nothing

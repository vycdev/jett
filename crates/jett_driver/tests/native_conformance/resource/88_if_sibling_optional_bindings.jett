namespace app
function observe_optional(view net: Network, view first_outcome: optional[resource_probe.TestHandle], view second_outcome: optional[resource_probe.TestHandle], choose_first: bool) returns int64:
    use resource_probe
    mutable int64 observed = 0
    if choose_first:
        resource_probe.TestHandle token = view((view first_outcome) handle:
            return 0
        )
        observed = resource_probe.borrow(view net, view token) handle error:
            return 0
    else:
        resource_probe.TestHandle token = view((view second_outcome) handle:
            return 0
        )
        observed = resource_probe.borrow(view net, view token) handle error:
            return 0
    return observed
export function main(net: Network) returns nothing:
    use resource_probe
    resource_probe.TestHandle first_owner = resource_probe.create(view net, 891) handle error:
        return nothing
    optional[resource_probe.TestHandle] first_held = some(first_owner)
    resource_probe.TestHandle second_owner = resource_probe.create(view net, 892) handle error:
        return nothing
    optional[resource_probe.TestHandle] second_held = some(second_owner)
    int64 first_observed = observe_optional(view net, view first_held, view second_held, true)
    if first_observed != 17:
        int64 ignored = resource_probe.terminal_label()
    int64 second_observed = observe_optional(view net, view first_held, view second_held, false)
    if second_observed != 17:
        int64 ignored = resource_probe.terminal_label()
    resource_probe.TestHandle first_token = first_held handle:
        return nothing
    resource_probe.close(first_token)
    resource_probe.TestHandle second_token = second_held handle:
        return nothing
    resource_probe.close(second_token)
    return nothing

namespace app
function observe_result(view net: Network, view first_outcome: result[resource_probe.TestHandle, string], view second_outcome: result[resource_probe.TestHandle, string]) returns int64:
    use resource_probe
    mutable int64 observed = 0
    comptime type Left = type.info[int64]():
        resource_probe.TestHandle token = view((view first_outcome) handle error:
            if error != "empty":
                int64 ignored = resource_probe.terminal_label()
            return 0
        )
        observed = resource_probe.borrow(view net, view token) handle error:
            return 0
    comptime type Right = type.info[int64]():
        resource_probe.TestHandle token = view((view second_outcome) handle error:
            if error != "empty":
                int64 ignored = resource_probe.terminal_label()
            return 0
        )
        int64 current = resource_probe.borrow(view net, view token) handle error:
            return 0
        observed = observed + current
    return observed
export function main(net: Network) returns nothing:
    use resource_probe
    resource_probe.TestHandle first_owner = resource_probe.create(view net, 891) handle error:
        return nothing
    result[resource_probe.TestHandle, string] first_held = ok(first_owner)
    resource_probe.TestHandle second_owner = resource_probe.create(view net, 892) handle error:
        return nothing
    result[resource_probe.TestHandle, string] second_held = ok(second_owner)
    int64 observed = observe_result(view net, view first_held, view second_held)
    if observed != 34:
        int64 ignored = resource_probe.terminal_label()
    resource_probe.TestHandle first_token = first_held handle error:
        return nothing
    resource_probe.close(first_token)
    resource_probe.TestHandle second_token = second_held handle error:
        return nothing
    resource_probe.close(second_token)
    return nothing

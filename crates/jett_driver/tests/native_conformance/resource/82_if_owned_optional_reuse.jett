namespace app
function exercise_optional(view net: Network, label: int64, enabled: bool) returns nothing:
    use resource_probe
    resource_probe.TestHandle owner = resource_probe.create(view net, label) handle error:
        return nothing
    optional[resource_probe.TestHandle] held = some(owner)
    mutable int64 observed = 0
    if enabled:
        resource_probe.TestHandle token = view((view held) handle:
            return nothing
        )
        observed = resource_probe.borrow(view net, view token) handle error:
            return nothing
    if enabled:
        if observed != 17:
            int64 ignored = resource_probe.terminal_label()
    else:
        if observed != 0:
            int64 ignored = resource_probe.terminal_label()
    resource_probe.TestHandle final_token = held handle:
        return nothing
    resource_probe.close(final_token)
    return nothing
export function main(net: Network) returns nothing:
    exercise_optional(view net, 871, false)
    exercise_optional(view net, 872, true)
    return nothing

namespace app
function observe_optional(view net: Network, view outcome: optional[resource_probe.TestHandle]) returns int64:
    use resource_probe
    mutable int64 observed = 0
    comptime type Inner = type.info[int64]():
        resource_probe.TestHandle token = view((view outcome) handle:
            return 0
        )
        observed = resource_probe.borrow(view net, view token) handle error:
            if error != "borrow sentinel":
                int64 ignored = resource_probe.terminal_label()
            default 0
    return observed
export function main(net: Network) returns nothing:
    use resource_probe
    resource_probe.TestHandle owner = resource_probe.create(view net, 871) handle error:
        return nothing
    optional[resource_probe.TestHandle] held = some(owner)
    int64 observed = observe_optional(view net, view held)
    if observed != 0:
        int64 ignored = resource_probe.terminal_label()
    resource_probe.TestHandle final_token = held handle:
        return nothing
    resource_probe.close(final_token)
    return nothing

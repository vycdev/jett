namespace app
export function main(net: Network) returns nothing:
    use resource_probe
    function(view Network, view resource_probe.TestHandle) returns result[int64, string] inspect = comptime resource_probe.borrow_descriptor()
    resource_probe.TestHandle token = resource_probe.create(view net, 781) handle error:
        return nothing
    int64 observed = inspect(view net, view token) handle error:
        default 0
    if observed != 17:
        int64 ignored = resource_probe.terminal_label()
    resource_probe.close(token)
    return nothing

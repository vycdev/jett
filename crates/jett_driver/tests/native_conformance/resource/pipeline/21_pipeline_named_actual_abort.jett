namespace app
function stage_owned(view net: Network, token: resource_probe.TestHandle) returns resource_probe.TestHandle:
    use resource_probe
    int64 observed = resource_probe.borrow(view net, view token) handle error:
        return token
    return token
function accept_staged(token: resource_probe.TestHandle, marker: int64, view net: Network) returns nothing:
    use resource_probe
    int64 observed = resource_probe.borrow(view net, view token) handle error:
        return nothing
    resource_probe.close(token)
    return nothing
function fail_marker() returns result[int64, string]:
    return fail("later marker")
export function scenario(view net: Network) returns nothing:
    use resource_probe
    resource_probe.TestHandle token = resource_probe.create(view net, 2101) handle error:
        return nothing
    stage_owned(view net, token) into accept_staged(net: view net, marker: fail_marker() handle error:
        return nothing
    )
    return nothing
export function main(net: Network) returns nothing:
    scenario(view net)
    return nothing

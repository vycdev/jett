namespace app
export function scenario(view net: Network) returns nothing:
    use resource_probe
    function(resource_probe.TestHandle) returns nothing close_token = resource_probe.descriptor()
    resource_probe.TestHandle token = resource_probe.create(view net, 2301) handle error:
        return nothing
    token into close_token
    return nothing
export function main(net: Network) returns nothing:
    scenario(view net)
    return nothing

namespace app
function observe_optional(view net: Network, view outcome: optional[resource_probe.TestHandle]) returns int64:
    use resource_probe
    resource_probe.TestHandle token = view((view outcome) handle:
        return 0
    )
    return resource_probe.borrow(view net, view token) handle error:
        return 0
export function main(net: Network) returns nothing:
    use resource_probe
    resource_probe.TestHandle owner = resource_probe.create(view net, 831) handle error:
        return nothing
    optional[resource_probe.TestHandle] held = some(owner)
    int64 observed = observe_optional(view net, view held)
    if observed != 17:
        int64 ignored = resource_probe.terminal_label()
    resource_probe.TestHandle token = held handle:
        return nothing
    resource_probe.close(token)
    return nothing

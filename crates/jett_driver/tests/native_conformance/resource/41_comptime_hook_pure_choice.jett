namespace app
function choose(flag: bool) returns function(resource_probe.TestHandle) returns nothing:
    use resource_probe
    if flag:
        return resource_probe.descriptor()
    return resource_probe.descriptor()
export function main(net: Network) returns nothing:
    use resource_probe
    function(resource_probe.TestHandle) returns nothing dispose = comptime choose(true)
    resource_probe.TestHandle token = resource_probe.create(view net, 761) handle error:
        return nothing
    dispose(token)
    return nothing

namespace app
struct IterationShape:
    first: int64
    second: int64
function field_ordinal_total() returns int64:
    mutable int64 total = 0
    for field in type.fields[IterationShape]():
        comptime type Element = field.type_info:
            Element observed = 17
            if field.index == 0:
                total = total + observed
            else:
                total = total + observed + 1
    return total
export function main(net: Network) returns nothing:
    use resource_probe
    resource_probe.TestHandle owner = resource_probe.create(view net, 871) handle error:
        return nothing
    optional[resource_probe.TestHandle] held = some(owner)
    mutable int64 total = 0
    for field in type.fields[IterationShape]():
        comptime type Element = field.type_info:
            resource_probe.TestHandle token = view((view held) handle:
                return nothing
            )
            Element observed = resource_probe.borrow(view net, view token) handle error:
                return nothing
            total = total + observed
    if field_ordinal_total() != 35:
        int64 ignored = resource_probe.terminal_label()
    if total != 34:
        int64 ignored = resource_probe.terminal_label()
    resource_probe.TestHandle final_token = held handle:
        return nothing
    resource_probe.close(final_token)
    return nothing

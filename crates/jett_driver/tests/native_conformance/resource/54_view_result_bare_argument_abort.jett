namespace app
function observe_result(view net: Network, filler: resource_probe.TestHandle, view outcome: result[resource_probe.TestHandle, string]) returns int64:
    use resource_probe
    resource_probe.TestHandle token = view((view outcome) handle error:
        resource_probe.close(filler)
        return 0
    )
    int64 observed = resource_probe.borrow(view net, view token) handle error:
        default 0
    resource_probe.close(filler)
    return observed
export function main(net: Network) returns nothing:
    use resource_probe
    resource_probe.TestHandle owner = resource_probe.create(view net, 851) handle error:
        return nothing
    result[resource_probe.TestHandle, string] held = ok(owner)
    int64 observed = observe_result(view net, outcome: held, filler: resource_probe.create(view net, 852) handle error:
        return nothing
    )
    if observed != 17:
        int64 ignored = resource_probe.terminal_label()
    return nothing

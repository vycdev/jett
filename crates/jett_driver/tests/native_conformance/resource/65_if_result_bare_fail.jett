namespace app
function observe_result(view net: Network, view outcome: result[resource_probe.TestHandle, string], enabled: bool) returns int64:
    use resource_probe
    mutable int64 observed = 0
    if enabled:
        resource_probe.TestHandle token = view((view outcome) handle error:
            if error != "empty":
                int64 ignored = resource_probe.terminal_label()
            return 0
        )
        observed = resource_probe.borrow(view net, view token) handle error:
            return 0
    return observed
export function main(net: Network) returns nothing:
    use resource_probe
    result[resource_probe.TestHandle, string] disabled_held = fail("empty")
    int64 disabled = observe_result(view net, disabled_held, false)
    if disabled != 0:
        int64 ignored = resource_probe.terminal_label()
    result[resource_probe.TestHandle, string] held = fail("empty")
    int64 observed = observe_result(view net, held, true)
    if observed != 0:
        int64 ignored = resource_probe.terminal_label()
    return nothing

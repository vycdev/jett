namespace app
function observe_optional(view net: Network, view outcome: optional[resource_probe.TestHandle], enabled: bool) returns int64:
    use resource_probe
    mutable int64 observed = 0
    if enabled:
        resource_probe.TestHandle token = view((view outcome) handle:
            return 0
        )
        observed = resource_probe.borrow(view net, view token) handle error:
            return 0
    return observed
export function main(net: Network) returns nothing:
    use resource_probe
    optional[resource_probe.TestHandle] disabled_held = none
    int64 disabled = observe_optional(view net, disabled_held, false)
    if disabled != 0:
        int64 ignored = resource_probe.terminal_label()
    optional[resource_probe.TestHandle] held = none
    int64 observed = observe_optional(view net, held, true)
    if observed != 0:
        int64 ignored = resource_probe.terminal_label()
    return nothing

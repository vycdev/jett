namespace app
struct Hidden:
    token: secret[string]
function main(stdout: Stdout) returns nothing:
    optional[Hidden] candidate = run run some(Hidden(token: "pending-secret-field"))
    Stdout.write(view stdout, "before\n")
    Hidden unused = candidate handle:
        Stdout.write(view stdout, "unexpected handler\n")
        return nothing
    Stdout.write(view stdout, "unexpected success\n")
    return nothing

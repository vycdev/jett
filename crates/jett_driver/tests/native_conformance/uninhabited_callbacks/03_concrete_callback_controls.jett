namespace app
function mapped_report[T](values: list[T]) returns string:
    function(T) returns int64 mapper = function(ignored: T) returns int64: return 7
    list[int64] mapped = list.map[T, int64](values, mapper)
    int64 first = list.get[int64](view mapped, 0) handle:
        default -1
    return "{list.length[int64](view mapped)}:{first}"
function make_size[T](view values: list[T]) returns function(T) returns int64:
    int64 size = list.length[T](view values)
    return function(ignored: T) returns int64: return size
function captured_report[T](values: list[T]) returns string:
    function(T) returns int64 mapper = make_size[T](view values)
    list[int64] mapped = list.map[T, int64](values, mapper)
    int64 first = list.get[int64](view mapped, 0) handle:
        default -1
    return "{list.length[int64](view mapped)}:{first}"
function main(stdout: Stdout) returns nothing:
    Stdout.write(view stdout, "direct:{mapped_report(list(1, 2))}:captured:{captured_report(list(3, 4, 5))}\n")

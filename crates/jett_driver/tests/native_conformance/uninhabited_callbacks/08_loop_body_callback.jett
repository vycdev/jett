namespace app
function loop_report[T](values: list[T]) returns string:
    function(T) returns int64 callback = function(ignored: T) returns int64:
        mutable int64 total = 0
        for item in list(1, 2):
            total = total + item
        return total
    list[int64] mapped = list.map[T, int64](values, callback)
    int64 first = list.get[int64](view mapped, 0) handle:
        default -1
    return "{list.length[int64](view mapped)}:{first}"
function main(stdout: Stdout) returns nothing:
    Stdout.write(view stdout, "loop:{loop_report(list())}:{loop_report(list(9))}\n")

namespace app
function make_size[T](view values: list[T]) returns function(T) returns int64:
    int64 size = list.length[T](view values)
    return function(ignored: T) returns int64: return size
function pending_report[T](values: list[T]) returns string:
    function(T) returns int64 callback = make_size[T](view values)
    function(T) returns int64 pending = run run clone callback
    list[int64] mapped = list.map[T, int64](values, clone pending)
    function(T) returns int64 once = join pending handle error:
        return "first:{error}"
    function(T) returns int64 ready = join once handle error:
        return "second:{error}"
    list[int64] joined = list.map[T, int64](list.new[T](), ready)
    return "{list.length[int64](view mapped)}:{list.length[int64](view joined)}"
function main(stdout: Stdout) returns nothing:
    Stdout.write(view stdout, "pending:{pending_report(list())}\n")

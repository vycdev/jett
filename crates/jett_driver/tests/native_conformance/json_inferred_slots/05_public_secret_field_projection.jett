namespace app
struct Envelope[T]:
    items: list[T]
    token: secret[string]
function encode[T](view values: list[T]) returns string:
    use json
    secret[string] token = "private-token"
    Envelope[T] envelope = Envelope[T](items: clone values, token: token)
    return json.serialize_public[Envelope[T]](view envelope)
function main(stdout: Stdout) returns nothing:
    Stdout.write(view stdout, "{encode(view list())}\n")
    return nothing

namespace call_probe
export function pair(view left: list[int64], view right: list[int64]) returns int64:
    return list.length[int64](view left) + list.length[int64](view right)
namespace app
function main(stdout: Stdout) returns nothing:
    use call_probe
    list[int64] left = list(1, 2)
    list[int64] right = list(3, 4, 5)
    int64 answer = call_probe.pair(right: right, left: left)
    Stdout.write(view stdout, "named:{answer}\n")
    return nothing

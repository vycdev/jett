namespace app
function positive_check(value: int64) returns bool:
    string marker = "predicate"
    trace marker
    return value > 0
type Positive = int64 where positive_check(value)
struct Holder:
    callback: function() returns int64
function source_five() returns int64:
    string marker = "source"
    trace marker
    return 5
function source_zero() returns int64:
    string marker = "source"
    trace marker
    return 0
function source_pending() returns int64:
    string marker = "source"
    trace marker
    return run 5
function selected_field() returns TypeField:
    return list.get[TypeField](type.fields[Holder](), 0) handle:
        return selected_field()
struct OptionalHolder:
    callback: function() returns optional[int64]
function some_five() returns optional[int64]:
    string marker = "source"
    trace marker
    return some(5)
function optional_field() returns TypeField:
    return list.get[TypeField](type.fields[OptionalHolder](), 0) handle:
        return optional_field()
function main(stdout: Stdout) returns nothing:
    OptionalHolder holder = OptionalHolder(callback: some_five)
    TypeField field = optional_field()
    function() returns optional[Positive] observed = type.field_value[OptionalHolder, function() returns optional[Positive]](view holder, view field)
    Positive returned = observed() handle:
        return nothing
    Stdout.write(view stdout, "{coarsen returned}\n")
    return nothing

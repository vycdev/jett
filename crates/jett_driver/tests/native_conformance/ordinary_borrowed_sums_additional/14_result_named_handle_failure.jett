namespace app
function consume(extra: int64, amount: int64, view values: list[int64], view stdout: Stdout) returns nothing:
    Stdout.write(view stdout, "unexpected consume\n")
    return nothing
function observe(view values: list[int64], view stdout: Stdout) returns int64:
    Stdout.write(view stdout, "prefix:result:{list.sum[int64](view values)}\n")
    return list.length[int64](view values)
function later(view stdout: Stdout) returns optional[int64]:
    Stdout.write(view stdout, "later:result\n")
    return none
function failing(view stdout: Stdout) returns int64:
    Stdout.write(view stdout, "failure:result\n")
    list[string] broken = list.remove_at[string](list("owned", "other"), -1)
    return list.length[string](broken)
function main(stdout: Stdout) returns nothing:
    bytes earlier = bytes.from_string("retained")
    result[list[int64], string] source = ok(list(5, 7))
    list[int64] alias = view((view source) handle error:
        return nothing
    )
    list[int64] forwarded = alias
    Stdout.write(view stdout, "before:result:{bytes.length(view earlier)}\n")
    consume(values: view forwarded, amount: observe(view forwarded, view stdout), stdout: view stdout, extra: later(view stdout) handle:
        Stdout.write(view stdout, "default:result\n")
        default failing(view stdout)
    )
    Stdout.write(view stdout, "unexpected after\n")
    return nothing

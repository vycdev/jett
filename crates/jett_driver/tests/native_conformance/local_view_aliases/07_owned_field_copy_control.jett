namespace app
struct Packet:
    data: bytes
function main(stdout: Stdout) returns nothing:
    Packet packet = Packet(data: bytes.from_string("AB"))
    bytes copied = packet.data
    bytes grown = bytes.concat(copied, bytes.from_string("C"))
    Stdout.write(view stdout, "{bytes.to_hex(view grown)}:{bytes.to_hex(view packet.data)}\n")

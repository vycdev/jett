namespace app
interface Named:
    function name(view self: Named) returns string
implement Named for int64:
    function name(view self: int64) returns string:
        return "value:{self}"
struct Packet:
    member: Named
function report(view item: Named, extra: int64) returns string:
    return "{Named.name(view item)}:{extra}"
function fallback(view stdout: Stdout) returns int64:
    Stdout.write(view stdout, "later:indirect\n")
    return 3
function main(stdout: Stdout) returns nothing:
    Packet packet = Packet(member: 7)
    function(view Named, int64) returns string callback = report
    optional[int64] absent = none
    Stdout.write(view stdout, "before:indirect\n")
    string answer = callback(view packet.member, absent handle:
        default fallback(view stdout)
    )
    Stdout.write(view stdout, "{answer}\n")
    Packet consumed = packet
    Stdout.write(view stdout, "consumed:{Named.name(view consumed.member)}\n")
    return nothing

namespace app
function inspect[Value, Failure](view shape: result[Value, Failure], raw: string) returns string:
    use json
    result[Value, Failure] parsed = raw into json.parse[result[Value, Failure]]() handle error:
        return "decode-error:{error}"
    Value occupied = parsed handle error:
        return "failure:{type.name[Failure]()}"
    return "success:{type.name[Value]()}"
function main(stdout: Stdout) returns nothing:
    string valid = inspect(view ok(7), "{{\"ok\":8}}")
    Stdout.write(view stdout, "valid:{valid}\n")
    string occupied = inspect(view ok(7), "{{\"fail\":\"bad\"}}")
    Stdout.write(view stdout, "occupied:{occupied}\n")
    string malformed = inspect(view ok(7), "{{\"ok\":8,\"fail\":\"bad\"}}")
    Stdout.write(view stdout, "malformed:{malformed}\n")
    return nothing

namespace app
function inspect[T](view shape: list[T], raw: string) returns string:
    use json
    list[T] parsed = json.parse[list[T]](raw) handle error:
        return "decode-error:{error}"
    return "length:{list.length[T](view parsed)}"
function main(stdout: Stdout) returns nothing:
    string valid = inspect(view list(), "[]")
    Stdout.write(view stdout, "valid:{valid}\n")
    string occupied = inspect(view list(), "[7]")
    Stdout.write(view stdout, "occupied:{occupied}\n")
    string malformed = inspect(view list(), "[")
    Stdout.write(view stdout, "malformed:{malformed}\n")
    return nothing

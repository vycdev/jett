namespace app
actor Counter:
    mutable int64 count = 1
    receive add(amount: int64):
        count = count + amount
    receive read responds int64:
        respond count
struct Pair:
    left: Counter
    right: Counter
function create() returns Pair:
    Counter worker = spawn Counter()
    send worker.add(4)
    return Pair(left: clone worker, right: worker)
function baked() returns Pair:
    return comptime create()
function repeated() returns nothing:
    mutable int64 index = 0
    while index < 2:
        Pair current = baked()
        println(ask current.left.read)
        index = index + 1
    return nothing
function main() returns nothing:
    Pair first = baked()
    Pair second = baked()
    println(first.left == first.right, first.left == second.left)
    send first.left.add(3)
    println(ask first.right.read, ask second.left.read)
    repeated()
    return nothing

namespace app
function wrong_target(token: resource_probe.TestHandle) returns nothing:
    use resource_probe
    int64 marker = resource_probe.terminal_label()
    return nothing
function close_selected(token: resource_probe.TestHandle) returns nothing:
    use resource_probe
    resource_probe.close(token)
    return nothing
export function main(net: Network) returns nothing:
    use resource_probe
    function(resource_probe.TestHandle) returns nothing selected = close_selected
    function(resource_probe.TestHandle) returns nothing dispose = selected
    resource_probe.TestHandle token = resource_probe.create(view net, 701) handle error:
        return nothing
    dispose(token)
    return nothing

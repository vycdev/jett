namespace app
export function main(net: Network) returns nothing:
    use resource_probe
    mutable optional[resource_probe.TestHandle] token = none
    token = resource_probe.empty()
    resource_probe.TestHandle first = resource_probe.create(view net, 2501) handle error:
        return nothing
    token = some(first)
    token = none
    resource_probe.TestHandle second = resource_probe.create(view net, 2502) handle error:
        return nothing
    token = some(second)
    resource_probe.TestHandle third = resource_probe.create(view net, 2503) handle error:
        return nothing
    token = some(third)
    resource_probe.TestHandle final = token handle:
        return nothing
    int64 observed = resource_probe.borrow(view net, view final) handle error:
        return nothing
    resource_probe.close(final)
    return nothing

namespace app
function accept_staged(marker: int64, view token: resource_probe.TestHandle, view net: Network) returns nothing:
    use resource_probe
    int64 observed = resource_probe.borrow(view net, view token) handle error:
        return nothing
    return nothing
function fail_marker() returns result[int64, string]:
    return fail("later marker")
export function main(net: Network) returns nothing:
    use resource_probe
    resource_probe.TestHandle token = resource_probe.create(view net, 502) handle error:
        return nothing
    accept_staged(token: token, marker: fail_marker() handle error:
        return nothing
    , net: view net)
    return nothing

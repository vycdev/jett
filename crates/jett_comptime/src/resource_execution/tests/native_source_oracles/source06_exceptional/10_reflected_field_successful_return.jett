namespace app
struct IterationShape:
    first: int64
    second: int64
    third: int64
export function main(net: Network) returns nothing:
    use resource_probe
    resource_probe.TestHandle owner = resource_probe.create(view net, 881) handle error:
        return nothing
    optional[resource_probe.TestHandle] held = some(owner)
    for field in type.fields[IterationShape]():
        comptime type Element = field.type_info:
            resource_probe.TestHandle token = view((view held) handle:
                return nothing
            )
            Element observed = resource_probe.borrow(view net, view token) handle error:
                return nothing
            if observed == 17:
                return nothing
            if observed == 17:
                int64 skipped_after_return = resource_probe.terminal_label()
        if field.index != 0:
            int64 skipped_after_body = resource_probe.terminal_label()
    int64 skipped_after_loop = resource_probe.terminal_label()
    return nothing

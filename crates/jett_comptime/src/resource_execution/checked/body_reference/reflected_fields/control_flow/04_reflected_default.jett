namespace app
type Count = int64
struct FlowShape:
    first: int64
    second: int64
    named: Count
function selected_or_failure(index: int64) returns result[int64, string]:
    if index == 1:
        return fail("selected middle field")
    return ok(index + 1)
export function scenario() returns int64:
    mutable int64 path = 0
    for field in type.fields[FlowShape]():
        comptime type Element = field.type_info:
            Element observed = selected_or_failure(field.index) handle error:
                default 9
            Element resumed = observed
            path = path * 10 + resumed
            if type.name[Element]() == "app.Count":
                path = path + 1000
    return path

namespace app
function consume_at_view_boundary(view net: Network, view token: resource_probe.TestHandle) returns nothing:
    use resource_probe
    int64 observed = resource_probe.borrow(view net, view token) handle error:
        return nothing
    return nothing
export function scenario(view net: Network) returns nothing:
    use resource_probe
    resource_probe.TestHandle first = resource_probe.create(view net, 1201) handle error:
        return nothing
    resource_probe.TestHandle second = resource_probe.create(view net, 1202) handle error:
        return nothing
    int64 observed = resource_probe.borrow(view net, view first) handle error:
        return nothing
    consume_at_view_boundary(view net, second)
    return nothing

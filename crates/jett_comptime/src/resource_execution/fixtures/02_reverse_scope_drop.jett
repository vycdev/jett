namespace app
export function scenario(view net: Network) returns nothing:
    use resource_probe
    resource_probe.TestHandle first = resource_probe.create(view net, 201) handle error:
        return nothing
    resource_probe.TestHandle second = resource_probe.create(view net, 202) handle error:
        return nothing
    int64 observed = resource_probe.borrow(view net, view first) handle error:
        return nothing
    int64 later = resource_probe.borrow(view net, view second) handle error:
        return nothing
    return nothing

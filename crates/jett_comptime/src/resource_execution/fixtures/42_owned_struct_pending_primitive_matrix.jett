namespace app
struct PendingMatrix:
    token: resource_probe.TestHandle
    signed8: int8
    signed16: int16
    signed32: int32
    signed64: int64
    unsigned8: uint8
    unsigned16: uint16
    unsigned32: uint32
    unsigned64: uint64
    rounded: float32
    wide: float64
    marker: string
    enabled: bool
    unit: nothing
function expect(condition: bool) returns nothing:
    use resource_companion_probe
    if not condition:
        resource_companion_probe.terminal_failure()
    return nothing
function ready[T](value: T) returns T:
    T once = join value handle error: default value
    return join once handle error: default once
function retire_pending_matrix(token: resource_probe.TestHandle) returns nothing:
    PendingMatrix held = PendingMatrix(unsigned64: run run 18446744073709551615, rounded: run run 16777217.0, token: token, signed8: run run -128, signed16: run run -32768, signed32: run run -2147483648, signed64: run run -9223372036854775808, unsigned8: run run 255, unsigned16: run run 65535, unsigned32: run run 4294967295, wide: run run 16777217.0, marker: run run "retained", enabled: run run true, unit: run run nothing)
    int8 expected_signed8 = -128
    expect(ready[int8](held.signed8) == expected_signed8)
    int16 expected_signed16 = -32768
    expect(ready[int16](held.signed16) == expected_signed16)
    int32 expected_signed32 = -2147483648
    expect(ready[int32](held.signed32) == expected_signed32)
    int64 expected_signed64 = -9223372036854775808
    expect(ready[int64](held.signed64) == expected_signed64)
    uint8 expected_unsigned8 = 255
    expect(ready[uint8](held.unsigned8) == expected_unsigned8)
    uint16 expected_unsigned16 = 65535
    expect(ready[uint16](held.unsigned16) == expected_unsigned16)
    uint32 expected_unsigned32 = 4294967295
    expect(ready[uint32](held.unsigned32) == expected_unsigned32)
    uint64 expected_unsigned64 = 18446744073709551615
    expect(ready[uint64](held.unsigned64) == expected_unsigned64)
    float32 expected_rounded = 16777216.0
    expect(ready[float32](held.rounded) == expected_rounded)
    float64 expected_wide = 16777217.0
    expect(ready[float64](held.wide) == expected_wide)
    string expected_marker = "retained"
    expect(ready[string](held.marker) == expected_marker)
    expect(ready[bool](held.enabled))
    nothing expected_unit = nothing
    expect(ready[nothing](held.unit) == expected_unit)
    return nothing
export function main(net: Network) returns nothing:
    use resource_probe
    resource_probe.TestHandle token = resource_probe.create(view net, 1106) handle error:
        return nothing
    retire_pending_matrix(token)
    return nothing

namespace app
export function clean(view net: Network) returns int64:
    use resource_probe
    comptime type Token = type.info[resource_probe.TestHandle]():
        Token token = resource_probe.create(view net, 1801) handle error:
            return -1
        int64 observed = resource_probe.borrow(view net, view token) handle error:
            return -2
        resource_probe.close(token)
        return observed
    return -3
export function terminal_error(view net: Network) returns nothing:
    use resource_probe
    comptime type Token = type.info[resource_probe.TestHandle]():
        Token token = resource_probe.create(view net, 1802) handle error:
            return nothing
        int64 observed = resource_probe.borrow(view net, view token) handle error:
            return nothing
        resource_probe.terminal_failure()
    return nothing

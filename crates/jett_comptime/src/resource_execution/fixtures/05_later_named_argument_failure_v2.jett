namespace app
function stage_owned(view net: Network, token: resource_probe.TestHandle) returns resource_probe.TestHandle:
    use resource_probe
    int64 observed = resource_probe.borrow(view net, view token) handle error:
        return token
    return token
function accept_staged(marker: int64, view token: resource_probe.TestHandle, view net: Network) returns nothing:
    use resource_probe
    int64 observed = resource_probe.borrow(view net, view token) handle error:
        return nothing
    return nothing
function fail_marker() returns result[int64, string]:
    return fail("later marker")
export function scenario(view net: Network) returns nothing:
    use resource_probe
    resource_probe.TestHandle token = resource_probe.create(view net, 501) handle error:
        return nothing
    accept_staged(token: stage_owned(view net, token), marker: fail_marker() handle error:
        return nothing
    , net: view net)
    return nothing

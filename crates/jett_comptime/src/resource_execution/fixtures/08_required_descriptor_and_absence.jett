namespace app
export function descriptor_storage() returns nothing:
    use resource_probe
    function(resource_probe.TestHandle) returns nothing dispose = comptime resource_probe.close_descriptor()
    return nothing
export function absent_close_path() returns nothing:
    use resource_probe
    optional[resource_probe.TestHandle] empty = comptime resource_probe.empty()
    resource_probe.TestHandle token = empty handle:
        return nothing
    resource_probe.close(token)
    return nothing
verify descriptor_verify_control:
    use resource_probe
    function(resource_probe.TestHandle) returns nothing dispose = resource_probe.close_descriptor()
    assert true
property descriptor_property_control:
    given marker: int64
    use resource_probe
    function(resource_probe.TestHandle) returns nothing dispose = resource_probe.close_descriptor()
    assert marker == marker

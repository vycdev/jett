namespace app
function carry_result(outcome: result[resource_probe.TestHandle, string]) returns result[resource_probe.TestHandle, string]:
    return outcome
function acquire(view net: Network) returns result[resource_probe.TestHandle, string]:
    use resource_probe
    return carry_result(resource_probe.create(view net, 601))
export function scenario(view net: Network) returns nothing:
    use resource_probe
    result[resource_probe.TestHandle, string] held = acquire(view net)
    resource_probe.TestHandle token = held handle error:
        return nothing
    int64 observed = resource_probe.borrow(view net, view token) handle error:
        return nothing
    resource_probe.close(token)
    return nothing

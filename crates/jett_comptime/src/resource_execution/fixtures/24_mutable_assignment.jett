namespace app
function observe_previous(view net: Network, view token: resource_probe.TestHandle) returns nothing:
    use resource_probe
    int64 observed = resource_probe.borrow(view net, view token) handle error:
        return nothing
    return nothing
export function replace_live(view net: Network) returns nothing:
    use resource_probe
    mutable resource_probe.TestHandle token = resource_probe.create(view net, 2401) handle error:
        return nothing
    token = resource_probe.create(view net, 2402) handle error:
        return nothing
    int64 observed = resource_probe.borrow(view net, view token) handle error:
        return nothing
    resource_probe.close(token)
    return nothing
export function rebind_after_close(view net: Network) returns nothing:
    use resource_probe
    mutable resource_probe.TestHandle token = resource_probe.create(view net, 2411) handle error:
        return nothing
    resource_probe.close(token)
    token = resource_probe.create(view net, 2412) handle error:
        return nothing
    resource_probe.close(token)
    return nothing
export function rebind_self(view net: Network) returns nothing:
    use resource_probe
    mutable resource_probe.TestHandle token = resource_probe.create(view net, 2421) handle error:
        return nothing
    token = token
    resource_probe.close(token)
    return nothing
export function failed_rhs_keeps_owner(view net: Network) returns nothing:
    use resource_probe
    mutable resource_probe.TestHandle token = resource_probe.create(view net, 2431) handle error:
        return nothing
    token = resource_probe.create(view net, 2432) handle error:
        observe_previous(view net, view token)
        return nothing
    resource_probe.close(token)
    return nothing

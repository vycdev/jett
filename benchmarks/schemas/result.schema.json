{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://jett.dev/schemas/benchmark-result-v0.5.json",
  "title": "Jett LLM benchmark result",
  "type": "object",
  "required": ["run_id", "task_id", "task_version", "language", "track", "reasoning_effort", "repetition", "status", "passed"],
  "properties": {
    "run_id": {"type": "string"},
    "task_id": {"type": "string"},
    "task_version": {"type": "string"},
    "language": {"type": "string"},
    "adapter_version": {"type": "string"},
    "track": {"enum": ["zero_shot", "onboarding", "skill_assisted"]},
    "model": {"type": ["string", "null"]},
    "model_snapshot": {"type": ["string", "null"]},
    "backend": {"type": "string"},
    "model_alias_is_rolling": {"type": "boolean"},
    "codex_cli_version": {"type": ["string", "null"]},
    "subscription_login": {"type": "string"},
    "completed_at_utc": {"type": "string"},
    "raw_event_log_sha256": {"type": "string"},
    "response_id": {"type": ["string", "null"]},
    "reasoning_effort": {"enum": ["low", "medium", "high"]},
    "repetition": {"type": "integer", "minimum": 1},
    "prompt_sha256": {"type": "string"},
    "starter_sha256": {"type": ["string", "null"]},
    "skill_sha256": {"type": ["string", "null"]},
    "skill_bytes": {"type": "integer", "minimum": 0},
    "status": {"enum": ["planned", "generated", "extraction_error", "policy_error", "compile_error", "test_failure", "timeout", "harness_error", "passed", "api_error", "backend_error"]},
    "passed": {"type": "boolean"},
    "compile_succeeded": {"type": ["boolean", "null"]},
    "input_tokens": {"type": ["integer", "null"]},
    "output_tokens": {"type": ["integer", "null"]},
    "reasoning_tokens": {"type": ["integer", "null"]},
    "estimated_cost_usd": {"type": ["number", "null"]},
    "latency_ms": {"type": ["number", "null"]},
    "grader_runtime_ms": {"type": ["number", "null"]},
    "repair_attempt": {"type": "integer", "minimum": 0},
    "evaluation_mode": {"enum": ["one_shot", "compile_repair"]},
    "parent_run_id": {"type": "string"},
    "parent_response_id": {"type": ["string", "null"]},
    "repair_feedback_kind": {"enum": ["compiler_diagnostic", "normalized_compile", "public_policy", "response_format", "private_test_summary"]},
    "tool_calls": {"type": ["integer", "null"]},
    "source_bytes": {"type": ["integer", "null"]},
    "source_lines": {"type": ["integer", "null"]},
    "complexity_proxy": {"type": ["integer", "null"]}
  },
  "additionalProperties": true
}

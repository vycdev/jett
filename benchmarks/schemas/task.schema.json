{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://jett.dev/schemas/benchmark-task-v0.1.json",
  "title": "Jett LLM benchmark task",
  "type": "object",
  "required": ["id", "version", "title", "statement", "constraints", "adapters"],
  "properties": {
    "id": {"type": "string", "pattern": "^[a-z][a-z0-9_]*$"},
    "version": {"type": "string"},
    "title": {"type": "string"},
    "statement": {"type": "string"},
    "constraints": {"type": "array", "items": {"type": "string"}},
    "adapters": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "required": ["signature", "baseline", "hidden", "candidate", "grade_mode", "commands"],
        "properties": {
          "signature": {"type": "string"},
          "baseline": {"type": "string"},
          "hidden": {"type": "string"},
          "candidate": {"type": "string"},
          "grade_mode": {"enum": ["append", "separate"]},
          "commands": {
            "type": "array",
            "minItems": 1,
            "items": {"type": "array", "minItems": 1, "items": {"type": "string"}}
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}

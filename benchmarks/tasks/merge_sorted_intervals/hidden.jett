function interval_label(intervals: list[Interval]) returns string:
    mutable string label = ""
    for interval in intervals:
        label = "{label}{interval.start}:{interval.end};"
    return label
verify merge_sorted_intervals_hidden:
    assert interval_label(merge_sorted_intervals(list())) == ""
    assert interval_label(merge_sorted_intervals(list(Interval(start: 1, end: 3)))) == "1:3;"
    assert interval_label(merge_sorted_intervals(list(Interval(start: 1, end: 3), Interval(start: 2, end: 6), Interval(start: 8, end: 10)))) == "1:6;8:10;"
    assert interval_label(merge_sorted_intervals(list(Interval(start: 1, end: 10), Interval(start: 2, end: 3), Interval(start: 10, end: 12)))) == "1:12;"
    assert interval_label(merge_sorted_intervals(list(Interval(start: -5, end: -2), Interval(start: -2, end: 0), Interval(start: 4, end: 4)))) == "-5:0;4:4;"

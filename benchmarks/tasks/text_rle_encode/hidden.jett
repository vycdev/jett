verify hidden_case_0:
    assert solve("") == ""
verify hidden_case_1:
    assert solve("A") == "1A"
verify hidden_case_2:
    assert solve("AA") == "2A"
verify hidden_case_3:
    assert solve("AB") == "1A1B"
verify hidden_case_4:
    assert solve("AAABB") == "3A2B"
verify hidden_case_5:
    assert solve("ABBA") == "1A2B1A"
verify hidden_case_6:
    assert solve("ZZZZZZZZZZZZ") == "12Z"
verify hidden_case_7:
    assert solve("ABCABC") == "1A1B1C1A1B1C"
verify hidden_case_8:
    assert solve("AAAABCCCC") == "4A1B4C"
verify hidden_case_9:
    assert solve("AZZA") == "1A2Z1A"
verify hidden_case_10:
    assert solve("") == "1000A"
verify hidden_case_11:
    assert solve("XXYYYZ") == "2X3Y1Z"

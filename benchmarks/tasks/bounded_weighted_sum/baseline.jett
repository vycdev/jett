namespace benchmark

function bounded_weighted_sum(values: list[int64], cap: int64) returns int64:
    int64 total = 0
    int64 weight = 1
    for value in values:
        int64 bounded = value
        if bounded > cap:
            bounded = cap
        else:
            if bounded < 0 - cap:
                bounded = 0 - cap
        total = total + (bounded * weight)
        weight = weight + 1
    return total

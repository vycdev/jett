function hidden_pair(value: TextPair) returns string:
    return "{string.length(value.first)}:{value.first}{string.length(value.second)}:{value.second}"
verify hidden_case_0:
    assert hidden_pair(solve("a=b")) == "1:a1:b"
verify hidden_case_1:
    assert hidden_pair(solve(" a = b ")) == "1:a1:b"
verify hidden_case_2:
    assert hidden_pair(solve("a=")) == "1:a0:"
verify hidden_case_3:
    assert hidden_pair(solve("a=  ")) == "1:a0:"
verify hidden_case_4:
    assert hidden_pair(solve("a=b=c")) == "1:a3:b=c"
verify hidden_case_5:
    assert hidden_pair(solve("a==")) == "1:a1:="
verify hidden_case_6:
    assert hidden_pair(solve("x y=z z")) == "3:x y3:z z"
verify hidden_case_7:
    assert hidden_pair(solve("\ta\t=\tb\t")) == "3:\ta\t3:\tb\t"
verify hidden_case_8:
    assert hidden_pair(solve("x= a  b ")) == "1:x4:a  b"
verify hidden_case_9:
    assert hidden_pair(solve("KEY=value")) == "3:KEY5:value"
verify hidden_case_10:
    assert hidden_pair(solve("a= = ")) == "1:a1:="
verify hidden_case_11:
    assert hidden_pair(solve("  k  = v=x ")) == "1:k3:v=x"

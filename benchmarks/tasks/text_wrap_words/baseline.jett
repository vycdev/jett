namespace benchmark
function from_ascii_hex(text: string) returns string:
    bytes encoded = bytes.from_hex(text) handle error:
        return ""
    string decoded = bytes.to_string(view encoded) handle error:
        return ""
    return decoded
function concat(left: string, right: string) returns string:
    return "{left}{right}"
function length(text: string) returns int64:
    return string.length(text)
function char_read(text: string, pos: int64) returns string:
    string ch = string.char_at(text, pos) handle:
        default ""
    return ch
function part(text: string, start: int64, end: int64) returns string:
    return string.slice(text, start, end)
function contains(text: string, needle: string) returns bool:
    return string.contains(text, needle)
function lower(text: string) returns string:
    return string.lower(text)
function upper(text: string) returns string:
    return string.upper(text)
function render(value: int64) returns string:
    return string.from_int64(value)
function compact(text: string) returns string:
    mutable string out = ""
    mutable bool pending = false
    mutable int64 pos = 0
    while (pos < length(text)):
        mutable string ch = char_read(text, pos)
        if (ch == " "):
            pending =(length(out) > 0)
        else:
            if pending:
                out = concat(out, " ")
            out = concat(out, ch)
            pending = false
        pos =(pos + 1)
    return out
function append_word(out: string, word: string, used: int64, width: int64) returns string:
    if (out == ""):
        return word
    if (((used + 1) + length(word)) <= width):
        return concat(concat(out, " "), word)
    return concat(concat(out, "\n"), word)
function solve(text: string, width: int64) returns string:
    mutable string clean = compact(text)
    mutable string out = ""
    mutable int64 used = 0
    mutable int64 start = 0
    mutable int64 pos = 0
    while (pos <= length(clean)):
        if ((char_read(clean, pos) == " ") or(pos == length(clean))):
            mutable string word = part(clean, start, pos)
            out = append_word(out, word, used, width)
            if ((used == 0) or(((used + 1) + length(word)) > width)):
                used = length(word)
            else:
                used =((used + 1) + length(word))
            start =(pos + 1)
        pos =(pos + 1)
    return out

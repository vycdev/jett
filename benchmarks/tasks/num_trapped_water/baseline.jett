namespace benchmark
function nth(view values: list[int64], index: int64) returns int64:
    int64 item = list.get[int64](view values, index) handle:
        default 0
    return item
function trapped_water(heights: list[int64]) returns int64:
    mutable list[int64] left_peaks = list.new[int64]()
    mutable int64 peak = 0
    mutable int64 index = 0
    while (index < list.length[int64](view heights)):
        mutable int64 height = nth(view heights, index)
        if (height > peak):
            peak = height
        left_peaks = list.append[int64](left_peaks, peak)
        index = (index + 1)
    peak = 0
    mutable int64 volume = 0
    while (index > 0):
        index = (index - 1)
        mutable int64 height = nth(view heights, index)
        if (height > peak):
            peak = height
        mutable int64 ceiling = nth(view left_peaks, index)
        if (peak < ceiling):
            ceiling = peak
        volume = ((volume + ceiling) - height)
    return volume

namespace benchmark
function nth(view values: list[int64], index: int64) returns int64:
    int64 item = list.get[int64](view values, index) handle:
        default 0
    return item
function max_product_pair(values: list[int64]) returns optional[int64]:
    if (list.length[int64](view values) < 2):
        return none
    mutable int64 best = (nth(view values, 0) * nth(view values, 1))
    mutable int64 first = 0
    while (first < list.length[int64](view values)):
        mutable int64 second = (first + 1)
        while (second < list.length[int64](view values)):
            mutable int64 candidate = (nth(view values, first) * nth(view values, second))
            if (candidate > best):
                best = candidate
            second = (second + 1)
        first = (first + 1)
    return some(best)

namespace benchmark
function nth(view values: list[int64], index: int64) returns int64:
    int64 item = list.get[int64](view values, index) handle:
        default 0
    return item
function equilibrium_index(values: list[int64]) returns optional[int64]:
    mutable int64 remaining = 0
    mutable int64 index = 0
    while (index < list.length[int64](view values)):
        remaining = (remaining + nth(view values, index))
        index = (index + 1)
    mutable int64 before = 0
    index = 0
    while (index < list.length[int64](view values)):
        mutable int64 value = nth(view values, index)
        remaining = (remaining - value)
        if (before == remaining):
            return some(index)
        before = (before + value)
        index = (index + 1)
    return none

namespace benchmark
function nth(view values: list[int64], index: int64) returns int64:
    int64 item = list.get[int64](view values, index) handle:
        default 0
    return item
function prefix_balances(values: list[int64], opening: int64) returns list[int64]:
    mutable list[int64] balances = list(opening)
    mutable int64 balance = opening
    mutable int64 index = 0
    while (index < list.length[int64](view values)):
        balance = (balance + nth(view values, index))
        balances = list.append[int64](balances, balance)
        index = (index + 1)
    return balances

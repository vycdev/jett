{
  "id": "text_palindrome_filter",
  "version": "1.0.0",
  "title": "Palindrome filter",
  "category": "text_transformation",
  "difficulty": "easy",
  "statement": "Discard every ASCII character except letters and digits, lowercase the remaining letters, then return whether that sequence is a palindrome. Empty filtered text is a palindrome.",
  "constraints": [
    "All text is ASCII; unless a narrower task bound is stated, each input string has at most 1000 characters.",
    "Preserve the exact declared public types and solve signature. Helpers are allowed.",
    "No input/output, exception throwing, panic, tests, or static diagnostic suppression in the submitted source."
  ],
  "adapters": {
    "jett": {
      "signature": "namespace benchmark\n\nfunction solve(text: string) returns bool",
      "baseline": "baseline.jett",
      "hidden": "hidden.jett",
      "candidate": "solution.jett",
      "grade_mode": "append",
      "commands": [
        [
          "{jett}",
          "build",
          "{candidate}"
        ],
        [
          "{jett}",
          "test",
          "{candidate}"
        ]
      ],
      "forbidden_patterns": []
    },
    "python": {
      "signature": "def solve(text: str) -> bool",
      "baseline": "baseline.py",
      "hidden": "hidden.py",
      "support_files": [
        "pyrightconfig.json"
      ],
      "candidate": "solution.py",
      "grade_mode": "separate",
      "commands": [
        [
          "{pyright}",
          "--project",
          "pyrightconfig.json"
        ],
        [
          "python",
          "hidden.py"
        ]
      ],
      "forbidden_patterns": [
        {
          "pattern": "\\bAny\\b|#\\s*(?:type:\\s*ignore|pyright:\\s*ignore)|\\bcast\\s*\\(",
          "message": "Python type bypasses such as Any, casts, and ignored diagnostics are forbidden"
        },
        {
          "pattern": "\\braise\\b",
          "message": "raising exceptions is forbidden; use the declared return type"
        }
      ]
    },
    "typescript": {
      "signature": "export function solve(text: string): boolean",
      "baseline": "baseline.ts",
      "hidden": "hidden.ts",
      "candidate": "solution.ts",
      "grade_mode": "separate",
      "commands": [
        [
          "npx",
          "tsc",
          "--strict",
          "--noImplicitReturns",
          "--target",
          "ES2022",
          "--module",
          "NodeNext",
          "--moduleResolution",
          "NodeNext",
          "solution.ts",
          "hidden.ts",
          "--outDir",
          "out"
        ],
        [
          "node",
          "out/hidden.js"
        ]
      ],
      "forbidden_patterns": [
        {
          "pattern": "\\bany\\b|@ts-(?:ignore|nocheck)|\\bas\\s+(?:const|[A-Za-z_$][A-Za-z0-9_$]*)\\b",
          "message": "TypeScript type bypasses such as any, suppressed diagnostics, and unchecked assertions are forbidden"
        },
        {
          "pattern": "\\bthrow\\b",
          "message": "throwing exceptions is forbidden; use the declared return type"
        }
      ]
    },
    "go": {
      "signature": "package benchmark\n\nfunc solve(text string) bool",
      "baseline": "baseline.go",
      "hidden": "hidden_test.go",
      "candidate": "solution.go",
      "grade_mode": "separate",
      "commands": [
        [
          "go",
          "test",
          "-run",
          "^$",
          "solution.go",
          "hidden_test.go"
        ],
        [
          "go",
          "test",
          "solution.go",
          "hidden_test.go"
        ]
      ],
      "forbidden_patterns": [
        {
          "pattern": "\\bany\\b|interface\\s*\\{\\s*\\}",
          "message": "Go type erasure through any or interface{} is forbidden"
        },
        {
          "pattern": "\\bpanic\\s*\\(",
          "message": "panic is forbidden; use the declared return type"
        }
      ]
    },
    "rust": {
      "signature": "pub fn solve(text: String) -> bool",
      "baseline": "baseline.rs",
      "hidden": "hidden.rs",
      "candidate": "solution.rs",
      "grade_mode": "separate",
      "commands": [
        [
          "rustc",
          "--edition=2024",
          "--test",
          "hidden.rs",
          "-o",
          "{executable}"
        ],
        [
          "{executable}"
        ]
      ],
      "forbidden_patterns": [
        {
          "pattern": "\\bunsafe\\b|\\b(?:transmute|unreachable_unchecked)\\b",
          "message": "unsafe Rust and unchecked type escapes are forbidden"
        },
        {
          "pattern": "\\bpanic\\s*!",
          "message": "panic is forbidden; use the declared return type"
        }
      ]
    }
  }
}


verify numerical_cases_0:
    assert coin_change(list(), 0) == 0
    assert coin_change(list(), 1) == -1
    assert coin_change(list(1), 0) == 0
    assert coin_change(list(1), 7) == 7
    assert coin_change(list(2), 3) == -1
    assert coin_change(list(2), 8) == 4
    assert coin_change(list(1, 3, 4), 6) == 2
    assert coin_change(list(5, 2), 11) == 4
verify numerical_cases_1:
    assert coin_change(list(3, 7), 10) == 2
    assert coin_change(list(3, 7), 5) == -1
    assert coin_change(list(2, 2, 4), 8) == 2
    assert coin_change(list(50), 100) == 2
    assert coin_change(list(7, 10, 25), 99) == 6
    assert coin_change(list(9, 6, 5, 1), 11) == 2

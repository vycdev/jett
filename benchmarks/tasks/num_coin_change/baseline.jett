namespace benchmark
function nth(view values: list[int64], index: int64) returns int64:
    int64 item = list.get[int64](view values, index) handle:
        default 0
    return item
function coin_change(coins: list[int64], amount: int64) returns int64:
    mutable list[int64] costs = list(0)
    mutable int64 total = 1
    while (total <= amount):
        mutable int64 best = 1000
        mutable int64 index = 0
        while (index < list.length[int64](view coins)):
            mutable int64 coin = nth(view coins, index)
            if (coin <= total):
                mutable int64 prior = nth(view costs, (total - coin))
                if ((prior + 1) < best):
                    best = (prior + 1)
            index = (index + 1)
        costs = list.append[int64](costs, best)
        total = (total + 1)
    mutable int64 answer = nth(view costs, amount)
    if (answer == 1000):
        return -(1)
    return answer

namespace benchmark
struct Entry:
    score: int64
    penalty: int64
struct Report:
    selected: int64
    rank_sum: int64
    tie_groups: int64
function ahead(score: int64, penalty: int64, other_score: int64, other_penalty: int64) returns bool:
    return((other_score > score) or((other_score == score) and(other_penalty < penalty)))
function solve(view rows: list[Entry], limit: int64) returns Report:
    mutable int64 selected = 0
    mutable int64 rank_sum = 0
    mutable int64 groups = 0
    mutable int64 index = 0
    for row in view rows:
        mutable int64 rank = 1
        mutable int64 ties = 0
        mutable int64 first = index
        mutable int64 other_index = 0
        for other in view rows:
            if ahead(row.score, row.penalty, other.score, other.penalty):
                rank =(rank + 1)
            if ((row.score == other.score) and(row.penalty == other.penalty)):
                ties =(ties + 1)
                if (other_index < first):
                    first = other_index
            other_index =(other_index + 1)
        if (rank <= limit):
            selected =(selected + 1)
            rank_sum =(rank_sum + rank)
        if ((ties > 1) and(first == index)):
            groups =(groups + 1)
        index =(index + 1)
    return Report(selected: selected, rank_sum: rank_sum, tie_groups: groups)

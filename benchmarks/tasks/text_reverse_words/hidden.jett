verify hidden_case_0:
    assert solve("") == ""
verify hidden_case_1:
    assert solve(" ") == ""
verify hidden_case_2:
    assert solve("a") == "a"
verify hidden_case_3:
    assert solve("a b") == "b a"
verify hidden_case_4:
    assert solve(" a  b c ") == "c b a"
verify hidden_case_5:
    assert solve("one two three") == "three two one"
verify hidden_case_6:
    assert solve("a a b") == "b a a"
verify hidden_case_7:
    assert solve("! ?") == "? !"
verify hidden_case_8:
    assert solve("a\tb c") == "c a\tb"
verify hidden_case_9:
    assert solve("word  ") == "word"
verify hidden_case_10:
    assert solve("  x") == "x"
verify hidden_case_11:
    assert solve("ab cd ef gh") == "gh ef cd ab"

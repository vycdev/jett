function hidden_error(error: TextError) returns string:
    match error:
        empty:
            return "empty"
        malformed:
            return "malformed"
        range:
            return "range"
function hidden_outcome(outcome: TextOutcome) returns string:
    match outcome:
        accepted(value):
            return "accepted:{value}"
        rejected(error):
            return "rejected:{hidden_error(error)}"
verify hidden_case_0:
    assert hidden_outcome(solve("00:00:00")) == "accepted:0"
verify hidden_case_1:
    assert hidden_outcome(solve("23:59:59")) == "accepted:86399"
verify hidden_case_2:
    assert hidden_outcome(solve("12:34:56")) == "accepted:45296"
verify hidden_case_3:
    assert hidden_outcome(solve("01:02:03")) == "accepted:3723"
verify hidden_case_4:
    assert hidden_outcome(solve("24:00:00")) == "rejected:range"
verify hidden_case_5:
    assert hidden_outcome(solve("00:60:00")) == "rejected:range"
verify hidden_case_6:
    assert hidden_outcome(solve("00:00:60")) == "rejected:range"
verify hidden_case_7:
    assert hidden_outcome(solve("0:00:00")) == "rejected:malformed"
verify hidden_case_8:
    assert hidden_outcome(solve("00-00-00")) == "rejected:malformed"
verify hidden_case_9:
    assert hidden_outcome(solve("aa:00:00")) == "rejected:malformed"
verify hidden_case_10:
    assert hidden_outcome(solve("99:xx:00")) == "rejected:malformed"
verify hidden_case_11:
    assert hidden_outcome(solve("")) == "rejected:malformed"

namespace benchmark
function nth(view values: list[int64], index: int64) returns int64:
    int64 item = list.get[int64](view values, index) handle:
        default 0
    return item
function longest_positive_run(values: list[int64]) returns int64:
    mutable int64 current = 0
    mutable int64 best = 0
    mutable int64 index = 0
    while (index < list.length[int64](view values)):
        if (nth(view values, index) > 0):
            current = (current + 1)
            if (current > best):
                best = current
        else:
            current = 0
        index = (index + 1)
    return best

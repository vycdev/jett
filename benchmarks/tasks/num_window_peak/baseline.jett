namespace benchmark
function nth(view values: list[int64], index: int64) returns int64:
    int64 item = list.get[int64](view values, index) handle:
        default 0
    return item
function window_peak(values: list[int64], width: int64) returns optional[int64]:
    if (width == 0):
        return none
    if (width > list.length[int64](view values)):
        return none
    mutable int64 total = 0
    mutable int64 index = 0
    while (index < width):
        total = (total + nth(view values, index))
        index = (index + 1)
    mutable int64 best = total
    while (index < list.length[int64](view values)):
        total = ((total + nth(view values, index)) - nth(view values, (index - width)))
        if (total > best):
            best = total
        index = (index + 1)
    return some(best)

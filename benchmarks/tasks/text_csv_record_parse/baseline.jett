namespace benchmark
function from_ascii_hex(text: string) returns string:
    bytes encoded = bytes.from_hex(text) handle error:
        return ""
    string decoded = bytes.to_string(view encoded) handle error:
        return ""
    return decoded
function concat(left: string, right: string) returns string:
    return "{left}{right}"
function length(text: string) returns int64:
    return string.length(text)
function char_read(text: string, pos: int64) returns string:
    string ch = string.char_at(text, pos) handle:
        default ""
    return ch
function part(text: string, start: int64, end: int64) returns string:
    return string.slice(text, start, end)
function contains(text: string, needle: string) returns bool:
    return string.contains(text, needle)
function lower(text: string) returns string:
    return string.lower(text)
function upper(text: string) returns string:
    return string.upper(text)
function render(value: int64) returns string:
    return string.from_int64(value)
function new_words() returns list[string]:
    return list.new[string]()
function push(values: list[string], value: string) returns list[string]:
    return list.append[string](values, value)
enum TextError:
    empty
    malformed
    range
enum TextOutcome:
    accepted(value: list[string])
    rejected(error: TextError)
function quoted_end(text: string, start: int64) returns int64:
    mutable int64 pos =(start + 1)
    while (pos < length(text)):
        if (char_read(text, pos) == "\""):
            if (char_read(text,(pos + 1)) == "\""):
                pos =(pos + 2)
            else:
                return(pos + 1)
        else:
            pos =(pos + 1)
    return(-1)
function field_end(text: string, start: int64) returns int64:
    if (char_read(text, start) == "\""):
        return quoted_end(text, start)
    mutable int64 pos = start
    while ((pos < length(text)) and(char_read(text, pos) != ",")):
        if (char_read(text, pos) == "\""):
            return(-1)
        pos =(pos + 1)
    return pos
function decoded_field(text: string, start: int64, end: int64) returns string:
    if (char_read(text, start) != "\""):
        return part(text, start, end)
    mutable string out = ""
    mutable int64 pos =(start + 1)
    while (pos <(end - 1)):
        mutable string ch = char_read(text, pos)
        out = concat(out, ch)
        if (ch == "\""):
            pos =(pos + 1)
        pos =(pos + 1)
    return out
function solve(text: string) returns TextOutcome:
    mutable int64 pos = 0
    mutable list[string] fields = new_words()
    while (pos <= length(text)):
        mutable int64 end = field_end(text, pos)
        if (end < 0):
            return TextOutcome.rejected(TextError.malformed)
        fields = push(fields, decoded_field(text, pos, end))
        if (end == length(text)):
            return TextOutcome.accepted(fields)
        if (char_read(text, end) != ","):
            return TextOutcome.rejected(TextError.malformed)
        pos =(end + 1)
    return TextOutcome.rejected(TextError.malformed)

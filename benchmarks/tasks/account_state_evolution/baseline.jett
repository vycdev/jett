namespace benchmark
enum AccountState:
    active
    suspended(reason: string)
    locked(failed_attempts: int64)
    closed
function can_sign_in(state: AccountState) returns bool:
    match state:
        active:
            return true
        suspended(reason):
            return false
        locked(failed_attempts):
            return false
        closed:
            return false
function status_label(state: AccountState) returns string:
    match state:
        active:
            return "active"
        suspended(reason):
            return "suspended:{reason}"
        locked(failed_attempts):
            return "locked:{failed_attempts}"
        closed:
            return "closed"
function suspend(state: AccountState, reason: string) returns AccountState:
    match state:
        active:
            return AccountState.suspended(reason)
        suspended(existing_reason):
            return AccountState.suspended(existing_reason)
        locked(failed_attempts):
            return AccountState.locked(failed_attempts)
        closed:
            return AccountState.closed

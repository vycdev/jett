namespace benchmark
struct Entry:
    resource_id: int64
    timestamp: int64
    duration: int64
struct Report:
    accepted: int64
    rejected: int64
    expires_sum: int64
function solve(view rows: list[Entry]) returns Report:
    mutable map[int64, int64] expiries = map.new[int64, int64]()
    mutable int64 accepted = 0
    mutable int64 rejected = 0
    mutable int64 total = 0
    for row in view rows:
        mutable int64 prior = map.get_or[int64, int64](clone expiries, row.resource_id, 0)
        if ((row.timestamp >= prior) and(row.duration > 0)):
            mutable int64 next_expiry =(row.timestamp + row.duration)
            total =((total + next_expiry) - prior)
            mutable int64 updated_value_0 = next_expiry
            expiries = map.set[int64, int64](expiries, row.resource_id, updated_value_0)
            accepted =(accepted + 1)
        else:
            rejected =(rejected + 1)
    return Report(accepted: accepted, rejected: rejected, expires_sum: total)

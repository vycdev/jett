
verify numerical_cases_0:
    assert divisor_sum(1) == 1
    assert divisor_sum(2) == 3
    assert divisor_sum(3) == 4
    assert divisor_sum(4) == 7
    assert divisor_sum(6) == 12
    assert divisor_sum(12) == 28
    assert divisor_sum(16) == 31
    assert divisor_sum(25) == 31
verify numerical_cases_1:
    assert divisor_sum(36) == 91
    assert divisor_sum(49) == 57
    assert divisor_sum(64) == 127
    assert divisor_sum(97) == 98
    assert divisor_sum(120) == 360
    assert divisor_sum(360) == 1170
    assert divisor_sum(99991) == 99992
    assert divisor_sum(100000) == 246078

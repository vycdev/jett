namespace benchmark
struct Entry:
    job: int64
    prerequisite: int64
    cost: int64
struct Report:
    ready: int64
    blocked: int64
    total_cost: int64
function ready_job(view rows: list[Entry], job: int64) returns bool:
    mutable int64 current = job
    while (current != 0):
        mutable int64 parent =(-1)
        for row in view rows:
            if (row.job == current):
                parent = row.prerequisite
        if (parent ==(-1)):
            return false
        current = parent
    return true
function solve(view rows: list[Entry]) returns Report:
    mutable int64 ready = 0
    mutable int64 blocked = 0
    mutable int64 total = 0
    for row in view rows:
        if ready_job(view rows, row.job):
            ready =(ready + 1)
            total =(total + row.cost)
        else:
            blocked =(blocked + 1)
    return Report(ready: ready, blocked: blocked, total_cost: total)

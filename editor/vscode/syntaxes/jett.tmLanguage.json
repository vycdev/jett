{
    "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
    "name": "Jett",
    "scopeName": "source.jett",
    "fileTypes": [".jett"],
    "patterns": [
        { "include": "#comments" },
        { "include": "#strings" },
        { "include": "#function-definition" },
        { "include": "#type-alias-definition" },
        { "include": "#struct-definition" },
        { "include": "#enum-definition" },
        { "include": "#machine-definition" },
        { "include": "#actor-definition" },
        { "include": "#namespace-declaration" },
        { "include": "#interface-definition" },
        { "include": "#bitfield-definition" },
        { "include": "#verify-definition" },
        { "include": "#qualified-enum-member-access" },
        { "include": "#qualified-type-name" },
        { "include": "#enum-member-access" },
        { "include": "#builtin-namespace-access" },
        { "include": "#qualified-function-call" },
        { "include": "#field-definition" },
        { "include": "#parameter-name" },
        { "include": "#local-variable-definition" },
        { "include": "#boolean-literals" },
        { "include": "#capability-types" },
        { "include": "#type-keywords" },
        { "include": "#custom-types" },
        { "include": "#control-keywords" },
        { "include": "#operators" },
        { "include": "#other-keywords" },
        { "include": "#function-call" },
        { "include": "#number-literals" },
        { "include": "#punctuation" },
        { "include": "#field-access" }
    ],
    "repository": {
        "comments": {
            "patterns": [
                {
                    "name": "comment.line.number-sign.jett",
                    "match": "#.*$"
                }
            ]
        },
        "strings": {
            "patterns": [
                {
                    "name": "string.quoted.double.jett",
                    "begin": "\"",
                    "end": "\"",
                    "patterns": [
                        {
                            "name": "constant.character.escape.jett",
                            "match": "\\\\(?:[\"\\\\nrtbf0{}]|u[0-9a-fA-F]{4})"
                        },
                        {
                            "name": "meta.interpolation.jett",
                            "begin": "\\{",
                            "end": "\\}",
                            "beginCaptures": {
                                "0": { "name": "punctuation.section.interpolation.begin.jett" }
                            },
                            "endCaptures": {
                                "0": { "name": "punctuation.section.interpolation.end.jett" }
                            },
                            "contentName": "string.interpolated.jett",
                            "patterns": [
                                { "include": "source.jett" }
                            ]
                        }
                    ]
                }
            ]
        },
        "function-definition": {
            "patterns": [
                {
                    "match": "\\b(?:(export)\\s+)?(function)\\s+([a-zA-Z_][a-zA-Z0-9_]*)\\s*(?=\\(|\\[)",
                    "captures": {
                        "1": { "name": "keyword.other.jett" },
                        "2": { "name": "keyword.control.jett" },
                        "3": { "name": "entity.name.function.jett" }
                    }
                }
            ]
        },
        "type-alias-definition": {
            "patterns": [
                {
                    "match": "\\b(?:(export)\\s+)?(type)\\s+([A-Z][a-zA-Z0-9_]*)",
                    "captures": {
                        "1": { "name": "keyword.other.jett" },
                        "2": { "name": "keyword.other.jett" },
                        "3": { "name": "entity.name.type.jett" }
                    }
                }
            ]
        },
        "struct-definition": {
            "patterns": [
                {
                    "match": "\\b(?:(export)\\s+)?(struct)\\s+([a-zA-Z_][a-zA-Z0-9_]*)",
                    "captures": {
                        "1": { "name": "keyword.other.jett" },
                        "2": { "name": "keyword.control.jett" },
                        "3": { "name": "entity.name.type.jett" }
                    }
                }
            ]
        },
        "enum-definition": {
            "patterns": [
                {
                    "match": "\\b(?:(export)\\s+)?(enum)\\s+([a-zA-Z_][a-zA-Z0-9_]*)",
                    "captures": {
                        "1": { "name": "keyword.other.jett" },
                        "2": { "name": "keyword.control.jett" },
                        "3": { "name": "entity.name.type.jett" }
                    }
                }
            ]
        },
        "machine-definition": {
            "patterns": [
                {
                    "match": "\\b(machine)\\s+([a-zA-Z_][a-zA-Z0-9_]*)",
                    "captures": {
                        "1": { "name": "keyword.control.jett" },
                        "2": { "name": "entity.name.type.jett" }
                    }
                }
            ]
        },
        "actor-definition": {
            "patterns": [
                {
                    "match": "\\b(actor)\\s+([a-zA-Z_][a-zA-Z0-9_]*)",
                    "captures": {
                        "1": { "name": "keyword.control.jett" },
                        "2": { "name": "entity.name.type.jett" }
                    }
                }
            ]
        },
        "namespace-declaration": {
            "patterns": [
                {
                    "match": "\\b(namespace)\\s+([a-zA-Z_][a-zA-Z0-9_]*(?:\\.[a-zA-Z_][a-zA-Z0-9_]*)*)",
                    "captures": {
                        "1": { "name": "keyword.control.jett" },
                        "2": { "name": "entity.name.namespace.jett" }
                    }
                }
            ]
        },
        "interface-definition": {
            "patterns": [
                {
                    "match": "\\b(?:(export)\\s+)?(interface)\\s+([a-zA-Z_][a-zA-Z0-9_]*)",
                    "captures": {
                        "1": { "name": "keyword.other.jett" },
                        "2": { "name": "keyword.control.jett" },
                        "3": { "name": "entity.name.type.jett" }
                    }
                }
            ]
        },
        "bitfield-definition": {
            "patterns": [
                {
                    "match": "\\b(?:(export)\\s+)?(?:(network)\\s+)?(bitfield)\\s+(?:(network)\\s+)?([a-zA-Z_][a-zA-Z0-9_]*)",
                    "captures": {
                        "1": { "name": "keyword.other.jett" },
                        "2": { "name": "keyword.other.jett" },
                        "3": { "name": "keyword.control.jett" },
                        "4": { "name": "keyword.other.jett" },
                        "5": { "name": "entity.name.type.jett" }
                    }
                }
            ]
        },
        "verify-definition": {
            "patterns": [
                {
                    "match": "\\b(verify)\\s+([a-zA-Z_][a-zA-Z0-9_]*)",
                    "captures": {
                        "1": { "name": "keyword.other.jett" },
                        "2": { "name": "entity.name.function.jett" }
                    }
                }
            ]
        },
        "qualified-enum-member-access": {
            "patterns": [
                {
                    "match": "\\b((?:[a-zA-Z_][a-zA-Z0-9_]*\\.)*)([A-Z][a-zA-Z0-9_]*)(\\.)([a-zA-Z_][a-zA-Z0-9_]*)\\b",
                    "captures": {
                        "1": { "name": "entity.name.namespace.jett" },
                        "2": { "name": "entity.name.type.jett" },
                        "3": { "name": "punctuation.accessor.jett" },
                        "4": { "name": "constant.other.enum.jett" }
                    }
                }
            ]
        },
        "qualified-type-name": {
            "patterns": [
                {
                    "match": "\\b([a-zA-Z_][a-zA-Z0-9_]*(?:\\.[a-zA-Z_][a-zA-Z0-9_]*)*)(\\.)([A-Z][a-zA-Z0-9_]*)\\b",
                    "captures": {
                        "1": { "name": "entity.name.namespace.jett" },
                        "2": { "name": "punctuation.accessor.jett" },
                        "3": { "name": "entity.name.type.jett" }
                    }
                }
            ]
        },
        "enum-member-access": {
            "patterns": [
                {
                    "match": "\\b([A-Z][a-zA-Z0-9_]*)(\\.)([a-zA-Z_][a-zA-Z0-9_]*)",
                    "captures": {
                        "1": { "name": "entity.name.type.jett" },
                        "2": { "name": "punctuation.accessor.jett" },
                        "3": { "name": "constant.other.enum.jett" }
                    }
                }
            ]
        },
        "builtin-namespace-access": {
            "patterns": [
                {
                    "name": "entity.name.namespace.jett",
                    "match": "\\b(json|type|list|map|set|string|bytes|math|encoding|crypto|time|os|env|process|secret)(?=\\.)"
                }
            ]
        },
        "qualified-function-call": {
            "patterns": [
                {
                    "match": "(\\.)([a-zA-Z_][a-zA-Z0-9_]*)\\s*(?=\\[|\\()",
                    "captures": {
                        "1": { "name": "punctuation.accessor.jett" },
                        "2": { "name": "entity.name.function.call.jett" }
                    }
                }
            ]
        },
        "field-definition": {
            "patterns": [
                {
                    "match": "^\\s*([a-zA-Z_][a-zA-Z0-9_]*)\\s*(?=:)",
                    "captures": {
                        "1": { "name": "variable.other.member.definition.jett" }
                    }
                }
            ]
        },
        "parameter-name": {
            "patterns": [
                {
                    "match": "\\b([a-zA-Z_][a-zA-Z0-9_]*)\\s*(?=:)",
                    "captures": {
                        "1": { "name": "variable.parameter.jett" }
                    }
                }
            ]
        },
        "local-variable-definition": {
            "patterns": [
                {
                    "match": "\\b(mutable\\s+)?((?:(?:[a-zA-Z_][a-zA-Z0-9_]*\\.)*[A-Z][a-zA-Z0-9_]*|int8|int16|int32|int64|uint8|uint16|uint32|uint64|float32|float64|string|bool|bytes|list|map|set|optional|result|secret|nothing)(?:\\s*\\[[^\\]\\n]*\\])?)\\s+([a-zA-Z_][a-zA-Z0-9_]*)\\s*(?==)",
                    "captures": {
                        "1": { "name": "storage.modifier.jett" },
                        "2": { "name": "storage.type.jett" },
                        "3": { "name": "variable.other.definition.jett" }
                    }
                }
            ]
        },
        "boolean-literals": {
            "patterns": [
                {
                    "name": "constant.language.jett",
                    "match": "\\b(true|false)\\b"
                }
            ]
        },
        "capability-types": {
            "patterns": [
                {
                    "name": "support.type.jett",
                    "match": "\\b(Stdout|Stderr|Stdin|Filesystem|Network|Clock|Random|Process|Environment)\\b"
                }
            ]
        },
        "type-keywords": {
            "patterns": [
                {
                    "name": "storage.type.jett",
                    "match": "\\b(int8|int16|int32|int64|uint8|uint16|uint32|uint64|float32|float64|string|bool|bytes|list|map|set|optional|result|secret|nothing)\\b"
                }
            ]
        },
        "custom-types": {
            "patterns": [
                {
                    "name": "entity.name.type.jett",
                    "match": "\\b[A-Z][a-zA-Z0-9_]*\\b"
                }
            ]
        },
        "control-keywords": {
            "patterns": [
                {
                    "name": "keyword.control.jett",
                    "match": "\\b(function|return|returns|if|else|for|in|into|while|match|handle|error|default|break|continue)\\b"
                }
            ]
        },
        "other-keywords": {
            "patterns": [
                {
                    "name": "keyword.other.jett",
                    "match": "\\b(struct|enum|use|mutable|result|ok|fail|clone|view|type|where|machine|states|transitions|to|at|is|actor|receive|send|ask|respond|spawn|run|join|cancel|comptime|verify|property|given|trace|breakpoint|secret|declassify|coarsen|serialize|namespace|export|bitfield|bit|bits|network|implement|interface|mutual|assert|some|none|nothing|modulo|as|and|within|self|value|transition|optional|other|not)\\b"
                }
            ]
        },
        "number-literals": {
            "patterns": [
                {
                    "name": "constant.numeric.float.jett",
                    "match": "\\b[0-9]+\\.[0-9]+\\b"
                },
                {
                    "name": "constant.numeric.integer.jett",
                    "match": "\\b[0-9]+\\b"
                }
            ]
        },
        "operators": {
            "patterns": [
                {
                    "name": "keyword.operator.word.jett",
                    "match": "\\b(and|or|not|modulo)\\b"
                },
                {
                    "name": "keyword.operator.comparison.jett",
                    "match": "==|!=|<=|>="
                },
                {
                    "name": "keyword.operator.logical.jett",
                    "match": "&&|\\|\\|"
                },
                {
                    "name": "keyword.operator.arithmetic.jett",
                    "match": "[+\\-*/]"
                },
                {
                    "name": "keyword.operator.assignment.jett",
                    "match": "(?<![=!<>])=(?!=)"
                },
                {
                    "name": "keyword.operator.comparison.jett",
                    "match": "(?<!=)[<>](?!=)"
                },
                {
                    "name": "keyword.operator.logical.jett",
                    "match": "!"
                }
            ]
        },
        "function-call": {
            "patterns": [
                {
                    "match": "\\b([a-z_][a-zA-Z0-9_]*)\\s*(?=\\[|\\()",
                    "captures": {
                        "1": { "name": "entity.name.function.call.jett" }
                    }
                }
            ]
        },
        "punctuation": {
            "patterns": [
                {
                    "name": "punctuation.separator.jett",
                    "match": "[,:]"
                },
                {
                    "name": "punctuation.section.brackets.jett",
                    "match": "[\\[\\]\\(\\){}]"
                }
            ]
        },
        "field-access": {
            "patterns": [
                {
                    "match": "(\\.)([a-zA-Z_][a-zA-Z0-9_]*)",
                    "captures": {
                        "1": { "name": "punctuation.accessor.jett" },
                        "2": { "name": "variable.other.member.jett" }
                    }
                }
            ]
        }
    }
}

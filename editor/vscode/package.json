{
    "name": "jett-lang",
    "displayName": "Jett Language",
    "description": "Syntax highlighting for the Jett programming language",
    "version": "0.1.0",
    "engines": {
        "vscode": "^1.70.0"
    },
    "categories": [
        "Programming Languages"
    ],
    "contributes": {
        "languages": [
            {
                "id": "jett",
                "aliases": [
                    "Jett",
                    "jett"
                ],
                "extensions": [
                    ".jett"
                ],
                "configuration": "./language-configuration.json"
            }
        ],
        "grammars": [
            {
                "language": "jett",
                "scopeName": "source.jett",
                "path": "./syntaxes/jett.tmLanguage.json"
            }
        ]
    }
}

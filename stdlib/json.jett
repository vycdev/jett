function json_tree_serialize(value: JsonTree) returns string:
    match value:
        null:
            return "null"
        bool_value(item):
            return "{item}"
        number_value(raw):
            return raw
        string_value(item):
            return json_stdlib_quote(item)
        array_value(items):
            return json_tree_serialize_array(items)
        object_value(fields):
            return json_tree_serialize_object(fields)
function json_tree_serialize_array(items: list[JsonTree]) returns string:
    mutable list[string] parts = list.new[string]()
    for item in items:
        parts = list.append[string](parts, json_tree_serialize(item))
    string body = string.join(parts, ",")
    return "[{body}]"
function json_tree_serialize_object(fields: map[string, JsonTree]) returns string:
    mutable list[string] parts = list.new[string]()
    for key, item in fields:
        string encoded = json_tree_serialize(item)
        parts = list.append[string](parts, "{json_stdlib_quote(key)}:{encoded}")
    string body = string.join(parts, ",")
    return "{{{body}}}"
function json_serialize_public_reflected[T](view value: T) returns string:
    TypeInfo info = type.info[T]()
    TypeKind kind = info.kind_tag
    TypePrimitive primitive = info.primitive_tag handle:
        default TypePrimitive.unknown_type
    if primitive != TypePrimitive.unknown_type:
        return json_serialize_public_primitive[T](view value, primitive)
    if kind == TypeKind.alias_type:
        comptime type Base = type.arg[T](0):
            Base item = value
            return json_serialize_public_reflected[Base](view item)
    if kind == TypeKind.refinement_type:
        comptime type Base = type.arg[T](0):
            Base item = coarsen value
            return json_serialize_public_reflected[Base](view item)
    if kind == TypeKind.enum_type:
        return json_serialize_public_enum_reflected[T](view value)
    return json_serialize_public_non_enum_reflected[T](view value, kind)
function json_serialize_public_primitive[T](view value: T, primitive: TypePrimitive) returns string:
    if primitive == TypePrimitive.string_type:
        string item = value
        return json_stdlib_quote(item)
    if primitive == TypePrimitive.int64_type:
        int64 item = value
        return "{item}"
    if primitive == TypePrimitive.float64_type:
        float64 item = value
        return "{item}"
    if primitive == TypePrimitive.bool_type:
        bool item = value
        return "{item}"
    if primitive == TypePrimitive.nothing_type:
        return "null"
    if primitive == TypePrimitive.bytes_type:
        bytes item = value
        return json_stdlib_quote("0x{bytes.to_hex(item)}")
    if primitive == TypePrimitive.json_value_type:
        JsonValue item = value
        return json.serialize_raw(item)
    return "null"
function json_serialize_public_enum_reflected[T](view value: T) returns string:
    TypeVariant selected = type.variant_value[T](view value)
    for variant in type.variants[T]():
        if variant.name != selected.name:
            continue
        if list.length(variant.fields) == 0:
            return json_stdlib_quote(variant.name)
        list[string] parts = list.new[string]()
        for field in variant.fields:
            comptime type Field = field.type_info:
                Field item = type.variant_field_value[T, Field](view value, view field)
                string encoded = json_serialize_public_reflected[Field](view item)
                parts = list.append[string](parts, encoded)
        string body = string.join(parts, ",")
        return "{{{json_stdlib_quote(variant.name)}:[{body}]}}"
    return json_stdlib_quote(selected.name)
function json_serialize_public_non_enum_reflected[T](view value: T, kind: TypeKind) returns string:
    if kind == TypeKind.list_type:
        return json_serialize_public_list_reflected[T](view value)
    if kind == TypeKind.set_type:
        return json_serialize_public_set_reflected[T](view value)
    if kind == TypeKind.map_type:
        return json_serialize_public_map_reflected[T](view value)
    if kind == TypeKind.optional_type:
        return json_serialize_public_optional_reflected[T](view value)
    if kind == TypeKind.result_type:
        return json_serialize_public_result_reflected[T](view value)
    return json_serialize_public_record_reflected[T](view value)
function json_serialize_public_list_reflected[T](view value: T) returns string:
    comptime type Elem = type.arg[T](0):
        list[Elem] items = value
        list[string] parts = list.new[string]()
        for item in items:
            parts = list.append[string](parts, json_serialize_public_reflected[Elem](view item))
        string body = string.join(parts, ",")
        return "[{body}]"

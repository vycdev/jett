function json_tree_parse(raw: string) returns result[JsonTree, string]:
    string trimmed = string.trim(raw)
    if trimmed == "":
        return fail("expected JSON value")
    JsonTree value = json_tree_parse_value(trimmed) handle error:
        return fail(error)
    return ok(value)
function json_tree_parse_value(raw: string) returns result[JsonTree, string]:
    if string.starts_with(raw, "[") == true:
        return json_tree_parse_array(raw)
    if string.starts_with(raw, "{{") == true:
        return json_tree_parse_object(raw)
    if string.starts_with(raw, "]") == true:
        return fail("unexpected closing delimiter in JSON value")
    if string.starts_with(raw, "}}") == true:
        return fail("unexpected closing delimiter in JSON value")
    return json_tree_parse_scalar(raw)

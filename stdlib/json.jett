function json_serialize_public_map_reflected[T](view value: T) returns string:
    comptime type Val = type.arg[T](1):
        map[string, Val] entries = value
        list[string] parts = list.new[string]()
        for key, item in entries:
            string encoded = json_serialize_public_reflected[Val](view item)
            parts = list.append[string](parts, "{json_stdlib_quote(key)}:{encoded}")
        string body = string.join(parts, ",")

function json_validate_exact_reflected[T](view raw: JsonTree) returns result[nothing, string]:
    TypeInfo info = type.info[T]()
    TypeKind kind = info.kind_tag
    TypePrimitive primitive = info.primitive_tag handle:
        default TypePrimitive.unknown_type
    if json_reflected_raw_type(view info):
        return ok(nothing)
    if primitive != TypePrimitive.unknown_type:
        return ok(nothing)
    if kind == TypeKind.alias_type:
        return json_validate_exact_alias_reflected[T](view raw)
    if kind == TypeKind.refinement_type:
        return json_validate_exact_refinement_reflected[T](view raw)
    if kind == TypeKind.secret_type:
        return json_validate_exact_secret_reflected[T](view raw)
    return json_validate_exact_structured_reflected[T](view raw, view info)
function json_validate_exact_alias_reflected[T](view raw: JsonTree) returns result[nothing, string]:
    comptime type Base = type.arg[T](0):
        return json_validate_exact_reflected[Base](view raw)
function json_validate_exact_refinement_reflected[T](view raw: JsonTree) returns result[nothing, string]:
    comptime type Base = type.arg[T](0):
        return json_validate_exact_reflected[Base](view raw)
function json_validate_exact_secret_reflected[T](view raw: JsonTree) returns result[nothing, string]:
    comptime type Inner = type.arg[T](0):
        return json_validate_exact_reflected[Inner](view raw)
function json_validate_exact_structured_reflected[T](view raw: JsonTree, view info: TypeInfo) returns result[nothing, string]:
    TypeKind kind = info.kind_tag
    string type_name = info.type_name
    match kind:
        list_type:
            return json_validate_exact_sequence_reflected[T](view raw, kind)
        set_type:
            return json_validate_exact_sequence_reflected[T](view raw, kind)
        map_type:
            return json_validate_exact_sequence_reflected[T](view raw, kind)
        optional_type:
            return json_validate_exact_wrapper_reflected[T](view raw, kind)
        result_type:
            return json_validate_exact_wrapper_reflected[T](view raw, kind)
        other:
            return json_validate_exact_named_aggregate_reflected[T](view raw, kind, type_name)
function json_validate_exact_sequence_reflected[T](view raw: JsonTree, kind: TypeKind) returns result[nothing, string]:
    match kind:
        list_type:
            return json_validate_exact_list_reflected[T](view raw)
        set_type:
            return json_validate_exact_set_reflected[T](view raw)
        map_type:
            return json_validate_exact_map_reflected[T](view raw)
        other:
            return fail("unsupported reflected JSON sequence")
function json_validate_exact_wrapper_reflected[T](view raw: JsonTree, kind: TypeKind) returns result[nothing, string]:
    match kind:
        optional_type:
            return json_validate_exact_optional_reflected[T](view raw)
        result_type:
            return json_validate_exact_result_reflected[T](view raw)
        other:
            return fail("unsupported reflected JSON wrapper")
function json_validate_exact_named_aggregate_reflected[T](view raw: JsonTree, kind: TypeKind, type_name: string) returns result[nothing, string]:
    match kind:
        enum_type:
            return json_validate_exact_enum_reflected[T](view raw, type_name)
        machine_type:
            return json_validate_exact_machine_reflected[T](view raw, type_name)
        machine_state_type:
            return json_validate_exact_machine_reflected[T](view raw, type_name)
        struct_type:
            return json_validate_exact_record_reflected[T](view raw, type_name)
        bitfield_type:
            return json_validate_exact_record_reflected[T](view raw, type_name)
        other:
            return ok(nothing)
function json_validate_exact_array_items_reflected[Elem](view raw: JsonTree) returns result[nothing, string]:
    int64 length = json_tree_array_length(view raw) handle error:
        return fail(error)
    for index in range(length):
        JsonTree raw_item = json_tree_require_index(view raw, index) handle error:
            return fail(error)
        nothing checked = json_validate_exact_reflected[Elem](view raw_item) handle error:
            return fail("{index}: {error}")
    return ok(nothing)
function json_validate_exact_list_reflected[T](view raw: JsonTree) returns result[nothing, string]:
    comptime type Elem = type.arg[T](0):
        return json_validate_exact_array_items_reflected[Elem](view raw)
function json_validate_exact_set_reflected[T](view raw: JsonTree) returns result[nothing, string]:
    comptime type Elem = type.arg[T](0):
        return json_validate_exact_array_items_reflected[Elem](view raw)
function json_validate_exact_map_reflected[T](view raw: JsonTree) returns result[nothing, string]:
    comptime type Val = type.arg[T](1):
        list[string] keys = json_tree_object_keys(view raw) handle error:
            return fail(error)
        for key in keys:
            JsonTree raw_item = json_tree_require_field(view raw, key) handle error:
                return fail(error)
            nothing checked = json_validate_exact_reflected[Val](view raw_item) handle error:
                return fail("{key}: {error}")
        return ok(nothing)
function json_validate_exact_optional_reflected[T](view raw: JsonTree) returns result[nothing, string]:
    if json_tree_is_null(view raw) == true:
        return ok(nothing)
    comptime type Inner = type.arg[T](0):
        return json_validate_exact_reflected[Inner](view raw)
function json_validate_exact_result_reflected[T](view raw: JsonTree) returns result[nothing, string]:
    JsonTreeObjectField payload = json_tree_result_payload(view raw) handle error:
        return fail(error)
    if payload.key == "ok":
        comptime type Ok = type.arg[T](0):
            nothing checked = json_validate_exact_reflected[Ok](view payload.value) handle error:
                return fail("ok: {error}")
            return ok(nothing)
    comptime type Err = type.arg[T](1):
        nothing checked = json_validate_exact_reflected[Err](view payload.value) handle error:
            return fail("fail: {error}")
        return ok(nothing)
function json_validate_exact_enum_reflected[T](view raw: JsonTree, type_name: string) returns result[nothing, string]:
    if json_tree_is_string(view raw) == true:
        return json_validate_exact_enum_string_reflected[T](view raw, type_name)
    list[string] keys = json_tree_object_keys(view raw) handle error:
        return fail("expected enum string or object, got {json_tree_kind(view raw)}")
    if list.length[string](keys) != 1:
        return fail("expected enum object with exactly one variant key")
    string variant_name = list.get[string](keys, 0) handle:
        return fail("expected enum object with exactly one variant key")
    JsonTree payload = json_tree_require_field(view raw, variant_name) handle error:
        return fail("expected enum object with exactly one variant key")
    int64 payload_count = json_tree_array_length(view payload) handle error:
        return fail("expected array payload for enum variant '{type_name}.{variant_name}', got {json_tree_kind(view payload)}")
    for variant in type.variants[T]():
        if variant.name != variant_name:
            continue
        return json_validate_exact_enum_payload_variant_reflected[T](view payload, type_name, variant, payload_count)
    return fail("unknown enum variant '{type_name}.{variant_name}'")
function json_validate_exact_enum_string_reflected[T](view raw: JsonTree, type_name: string) returns result[nothing, string]:
    string variant_name = json_tree_as_string(view raw) handle error:
        return fail(error)
    for variant in type.variants[T]():
        if variant.name != variant_name:
            continue
        int64 expected_count = list.length[TypeField](variant.fields)
        if expected_count != 0:
            return fail("enum variant '{type_name}.{variant_name}' expects {expected_count} payload field(s)")
        return ok(nothing)
    return fail("unknown enum variant '{type_name}.{variant_name}'")
function json_validate_exact_enum_payload_variant_reflected[T](view payload: JsonTree, type_name: string, variant: TypeVariant, payload_count: int64) returns result[nothing, string]:
    int64 expected_count = list.length[TypeField](variant.fields)
    if payload_count != expected_count:
        return fail("enum variant '{type_name}.{variant.name}' expects {expected_count} payload field(s), got {payload_count}")
    mutable int64 index = 0
    for field in variant.fields:
        comptime type Field = field.type_info:
            JsonTree raw_item = json_tree_require_index(view payload, index) handle error:
                return fail("missing enum payload item {index}")
            nothing checked = json_validate_exact_reflected[Field](view raw_item) handle error:
                return fail("{variant.name}.{field.name}: {error}")
        index = index + 1
    return ok(nothing)
function json_validate_exact_machine_reflected[T](view raw: JsonTree, type_name: string) returns result[nothing, string]:
    if json_tree_is_object(view raw) == false:
        return fail("expected machine envelope object, got {json_tree_kind(view raw)}")
    nothing keys = json_validate_exact_machine_envelope_keys(view raw, type_name) handle error:
        return fail(error)
    string state_name = json_tree_machine_state_name(view raw) handle error:
        return fail(error)
    JsonTree payload = json_tree_machine_payload_tree(view raw) handle error:
        return fail(error)
    for state in type.machine_states[T]():
        if state.name == state_name:
            return json_validate_exact_machine_payload_reflected[T](view payload, type_name, state)
    return fail("unknown machine state '{type_name}.{state_name}'")
function json_validate_exact_machine_envelope_keys(view raw: JsonTree, type_name: string) returns result[nothing, string]:
    list[string] keys = json_tree_object_keys(view raw) handle error:
        return fail(error)
    for key in keys:
        if key != "state" and key != "payload":
            return fail("unknown field '{key}' for {type_name} JSON envelope")
    return ok(nothing)
function json_validate_exact_machine_payload_reflected[T](view payload: JsonTree, type_name: string, state: TypeMachineState) returns result[nothing, string]:
    string state_name = state.name
    list[string] keys = json_tree_object_keys(view payload) handle error:
        return fail(error)
    for key in keys:
        if json_validate_exact_machine_payload_field_name_reflected(key, view state) == false:
            return fail("unknown field '{key}' for {type_name}.{state_name}")
    for field in state.fields:
        nothing checked = json_validate_exact_machine_payload_field_reflected[T](view payload, view field) handle error:
            return fail("{field.serialize_name}: {error}")
    return ok(nothing)
function json_validate_exact_machine_payload_field_reflected[T](view payload: JsonTree, view field: TypeField) returns result[nothing, string]:
    optional[JsonTree] maybe_field = json_tree_object_field(view payload, field.serialize_name) handle error:
        return fail(error)
    JsonTree raw_field = maybe_field handle:
        return ok(nothing)
    comptime type Field = field.type_info:
        return json_validate_exact_reflected[Field](view raw_field)
function json_validate_exact_machine_payload_field_name_reflected(key: string, view state: TypeMachineState) returns bool:
    for field in state.fields:
        if field.serialize_name == key:
            return true
    return false
function json_validate_exact_record_reflected[T](view raw: JsonTree, type_name: string) returns result[nothing, string]:
    if json_tree_is_object(view raw) == false:
        return fail("expected object, got {json_tree_kind(view raw)}")
    list[string] keys = json_tree_object_keys(view raw) handle error:
        return fail(error)
    for key in keys:
        if json_validate_exact_record_field_name_reflected[T](key) == false:
            return fail("unknown field '{key}' for {type_name}")
    for field in type.fields[T]():
        nothing checked = json_validate_exact_record_field_reflected[T](view raw, view field) handle error:
            return fail("{field.serialize_name}: {error}")
    return ok(nothing)
function json_validate_exact_record_field_reflected[T](view raw: JsonTree, view field: TypeField) returns result[nothing, string]:
    optional[JsonTree] maybe_field = json_tree_object_field(view raw, field.serialize_name) handle error:
        return fail(error)
    JsonTree raw_field = maybe_field handle:
        return ok(nothing)
    comptime type Field = field.type_info:
        return json_validate_exact_reflected[Field](view raw_field)
function json_validate_exact_record_field_name_reflected[T](key: string) returns bool:
    for field in type.fields[T]():
        if field.serialize_name == key:
            return true
    return false

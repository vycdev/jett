function json_decode_tree_float_some_reflected[T](view raw: JsonTree, primitive: TypePrimitive) returns result[optional[T], string]:
    T item = json_decode_tree_float_reflected[T](view raw, primitive) handle error:
        return fail(error)
    return ok(some(item))
function json_decode_tree_scalar_reflected[T](view raw: JsonTree, primitive: TypePrimitive) returns result[T, string]:
    if primitive == TypePrimitive.string_type:
        string item = json_tree_as_string(view raw) handle error:
            return fail(error)
        return ok(item)
    if primitive == TypePrimitive.bool_type:
        bool item = json_tree_as_bool(view raw) handle error:
            return fail(error)
        return ok(item)
    return fail("unsupported reflected JSON primitive")
function json_decode_tree_integer_reflected[T](view raw: JsonTree, primitive: TypePrimitive) returns result[T, string]:
    int64 item = json_tree_as_int64(view raw) handle error:
        if primitive == TypePrimitive.uint64_type:
            if json_tree_is_number(view raw):
                return fail("expected uint64 in range 0..9223372036854775807")
            return fail(json_tree_kind_error(view raw, "uint64"))
        return fail(error)
    string range_error = json_decode_tree_integer_range_error(item, primitive) handle:
        default ""
    if range_error != "":
        return fail(range_error)
    T typed = item
    return ok(typed)
function json_decode_tree_float_reflected[T](view raw: JsonTree, primitive: TypePrimitive) returns result[T, string]:
    float64 item = json_tree_as_float64(view raw) handle error:
        return fail(error)
    T typed = item
    return ok(typed)
function json_decode_tree_integer_range_error(value: int64, primitive: TypePrimitive) returns optional[string]:
    if primitive == TypePrimitive.int8_type:
        return json_decode_tree_range_error(value, -128, 127, "int8")
    if primitive == TypePrimitive.int16_type:
        return json_decode_tree_range_error(value, -32768, 32767, "int16")
    if primitive == TypePrimitive.int32_type:
        return json_decode_tree_range_error(value, -2147483648, 2147483647, "int32")
    if primitive == TypePrimitive.uint8_type:
        return json_decode_tree_range_error(value, 0, 255, "uint8")
    if primitive == TypePrimitive.uint16_type:
        return json_decode_tree_range_error(value, 0, 65535, "uint16")
    if primitive == TypePrimitive.uint32_type:
        return json_decode_tree_range_error(value, 0, 4294967295, "uint32")
    if primitive == TypePrimitive.uint64_type:
        return json_decode_tree_range_error(value, 0, 9223372036854775807, "uint64")
    return none
function json_decode_tree_range_error(value: int64, minimum: int64, maximum: int64, name: string) returns optional[string]:
    if value < minimum:
        return some("expected {name} in range {minimum}..{maximum}")
    if value > maximum:
        return some("expected {name} in range {minimum}..{maximum}")
    return none
function json_decode_tree_other_primitive_reflected[T](view raw: JsonTree, primitive: TypePrimitive) returns result[T, string]:
    if primitive == TypePrimitive.bytes_type:
        string raw_hex = json_tree_as_string(view raw) handle error:
            return fail(error)
        bytes item = bytes.from_hex(raw_hex) handle error:
            return fail("expected hex bytes string")
        return ok(item)
    if primitive == TypePrimitive.json_value_type:
        return json_decode_tree_raw_reflected[T](view raw)
    if primitive == TypePrimitive.nothing_type:
        if json_tree_is_null(view raw) == false:
            return fail("expected null, got {json_tree_kind(view raw)}")
        return ok(nothing)
    return fail("unsupported reflected JSON primitive")
function json_decode_tree_structured_reflected[T](view raw: JsonTree, kind: TypeKind, type_name: string) returns result[T, string]:
    match kind:
        list_type:
            return json_decode_tree_list_reflected[T](view raw)
        set_type:
            return json_decode_tree_set_reflected[T](view raw)
        map_type:
            return json_decode_tree_map_reflected[T](view raw)
        optional_type:
            return json_decode_tree_optional_reflected[T](view raw)
        result_type:
            return json_decode_tree_result_reflected[T](view raw)
        enum_type:
            return json_decode_tree_enum_reflected[T](view raw, type_name)
        struct_type:
            return json_decode_tree_record_reflected[T](view raw, type_name)
        bitfield_type:
            return json_decode_tree_record_reflected[T](view raw, type_name)
        other:
            return fail("unsupported reflected JSON type: {type_name}")
function json_decode_tree_list_reflected[T](view raw: JsonTree) returns result[T, string]:
    comptime type Elem = type.arg[T](0):
        int64 length = json_tree_array_length(view raw) handle error:
            return fail(error)
        mutable list[Elem] items = list.new[Elem]()
        for index in range(length):
            JsonTree raw_item = json_tree_index(view raw, index) handle:
                return fail("missing array item {index}")
            Elem item = json_decode_tree_reflected[Elem](view raw_item) handle error:
                return fail("{index}: {error}")
            items = list.append[Elem](items, item)
        return ok(items)
function json_decode_tree_set_reflected[T](view raw: JsonTree) returns result[T, string]:
    comptime type Elem = type.arg[T](0):
        int64 length = json_tree_array_length(view raw) handle error:
            return fail(error)
        mutable set[Elem] items = set.new[Elem]()
        for index in range(length):
            JsonTree raw_item = json_tree_index(view raw, index) handle:
                return fail("missing array item {index}")
            Elem item = json_decode_tree_reflected[Elem](view raw_item) handle error:
                return fail("{index}: {error}")
            items = set.add[Elem](items, item)
        return ok(items)
function json_decode_tree_map_reflected[T](view raw: JsonTree) returns result[T, string]:
    comptime type Val = type.arg[T](1):
        list[string] keys = json_tree_object_keys(view raw) handle error:
            return fail(error)
        mutable map[string, Val] entries = map.new[string, Val]()
        for key in keys:
            JsonTree raw_item = json_tree_field(view raw, key) handle:
                return fail("missing object field '{key}'")
            Val item = json_decode_tree_reflected[Val](view raw_item) handle error:
                return fail("{key}: {error}")
            entries = map.insert[string, Val](entries, key, item)
        return ok(entries)
function json_decode_tree_optional_reflected[T](view raw: JsonTree) returns result[T, string]:
    if json_tree_is_null(view raw) == true:
        return ok(none)
    comptime type Inner = type.arg[T](0):
        Inner item = json_decode_tree_reflected[Inner](view raw) handle error:
            return fail(error)
        return ok(some(item))
function json_tree_result_payload(view raw: JsonTree) returns result[JsonTreeResultPayload, string]:
    list[string] keys = json_tree_object_keys(view raw) handle error:
        return fail(error)
    if list.length[string](keys) != 1:
        return fail("expected result object with exactly one key")
    string key = list.get[string](keys, 0) handle:
        return fail("expected result object with exactly one key")
    if key != "ok" and key != "fail":
        return fail("expected result object with key 'ok' or 'fail'")
    JsonTree value = json_tree_field(view raw, key) handle:
        return fail("expected result object with key 'ok' or 'fail'")
    return ok(JsonTreeResultPayload(key: key, value: value))
function json_decode_tree_result_reflected[T](view raw: JsonTree) returns result[T, string]:
    JsonTreeResultPayload payload = json_tree_result_payload(view raw) handle error:
        return fail(error)
    if payload.key == "ok":
        comptime type Ok = type.arg[T](0):
            Ok item = json_decode_tree_reflected[Ok](view payload.value) handle error:
                return fail("ok: {error}")
            return ok(ok(item))
    comptime type Err = type.arg[T](1):
        Err failure = json_decode_tree_reflected[Err](view payload.value) handle error:
            return fail("fail: {error}")
        return ok(fail(failure))
function json_decode_tree_enum_reflected[T](view raw: JsonTree, type_name: string) returns result[T, string]:
    if json_tree_is_string(view raw) == true:
        return json_decode_tree_enum_string_reflected[T](view raw, type_name)
    return json_decode_tree_enum_object_reflected[T](view raw, type_name)
function json_decode_tree_enum_string_reflected[T](view raw: JsonTree, type_name: string) returns result[T, string]:
    string variant_name = json_tree_as_string(view raw) handle error:
        return fail(error)
    for variant in type.variants[T]():
        if variant.name != variant_name:
            continue
        int64 expected_count = list.length[TypeField](variant.fields)
        if expected_count != 0:
            return fail("enum variant '{type_name}.{variant_name}' expects {expected_count} payload field(s)")
        TypeConstruction builder = type.construct_variant_start[T](view variant) handle error:
            return fail(error)
        return type.construct_finish[T](builder)
    return fail("unknown enum variant '{type_name}.{variant_name}'")
function json_decode_tree_enum_object_reflected[T](view raw: JsonTree, type_name: string) returns result[T, string]:
    list[string] keys = json_tree_object_keys(view raw) handle error:
        return fail("expected enum string or object, got {json_tree_kind(view raw)}")
    if list.length[string](keys) != 1:
        return fail("expected enum object with exactly one variant key")
    string variant_name = list.get[string](keys, 0) handle:
        return fail("expected enum object with exactly one variant key")
    JsonTree payload = json_tree_field(view raw, variant_name) handle:
        return fail("missing enum payload for '{variant_name}'")
    int64 payload_count = json_tree_array_length(view payload) handle error:
        return fail("expected array payload for enum variant '{type_name}.{variant_name}', got {json_tree_kind(view payload)}")
    return json_decode_tree_enum_payload_reflected[T](view payload, type_name, variant_name, payload_count)
function json_decode_tree_enum_payload_reflected[T](view payload: JsonTree, type_name: string, variant_name: string, payload_count: int64) returns result[T, string]:
    for variant in type.variants[T]():
        if variant.name != variant_name:
            continue
        return json_decode_tree_enum_payload_variant_reflected[T](view payload, type_name, variant, payload_count)
    return fail("unknown enum variant '{type_name}.{variant_name}'")
function json_decode_tree_enum_payload_variant_reflected[T](view payload: JsonTree, type_name: string, variant: TypeVariant, payload_count: int64) returns result[T, string]:
    int64 expected_count = list.length[TypeField](variant.fields)
    if payload_count != expected_count:
        return fail("enum variant '{type_name}.{variant.name}' expects {expected_count} payload field(s), got {payload_count}")
    mutable TypeConstruction builder = type.construct_variant_start[T](view variant) handle error:
        return fail(error)
    mutable int64 index = 0
    for field in variant.fields:
        comptime type Field = field.type_info:
            JsonTree raw_item = json_tree_index(view payload, index) handle:
                return fail("missing enum payload item {index}")
            Field decoded = json_decode_tree_reflected[Field](view raw_item) handle error:
                return fail("{variant.name}.{field.name}: {error}")
            builder = type.construct_put[T, Field](builder, view field, decoded) handle error:
                return fail(error)
        index = index + 1
    return type.construct_finish[T](builder)
function json_tree_missing_field_reflected(view field: TypeField, owner_name: string) returns result[JsonTree, string]:
    if field.type_info.kind_tag == TypeKind.optional_type:
        return ok(JsonTree.null)
    return fail("missing required field '{field.serialize_name}' for {owner_name}")
function json_tree_record_field_value(view raw: JsonTree, view field: TypeField, owner_name: string) returns result[JsonTree, string]:
    JsonTree raw_field = json_tree_field(view raw, field.serialize_name) handle:
        JsonTree missing = json_tree_missing_field_reflected(view field, owner_name) handle error:
            return fail(error)
        default missing
    return ok(raw_field)
function json_decode_tree_record_reflected[T](view raw: JsonTree, type_name: string) returns result[T, string]:
    if json_tree_is_object(view raw) == false:
        return fail("expected object, got {json_tree_kind(view raw)}")
    mutable TypeConstruction builder = type.construct_start[T]()
    for field in type.fields[T]():
        comptime type Field = field.type_info:
            JsonTree raw_field = json_tree_record_field_value(view raw, view field, type_name) handle error:
                return fail(error)
            Field decoded = json_decode_tree_reflected[Field](view raw_field) handle error:
                return fail("{field.serialize_name}: {error}")
            builder = type.construct_put[T, Field](builder, view field, decoded) handle error:
                return fail(error)
    return type.construct_finish[T](builder)

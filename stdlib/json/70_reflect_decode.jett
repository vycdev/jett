function json_decode_tree_reflected[T](view raw: JsonTree) returns result[T, string]:
    TypeInfo info = type.info[T]()
    TypeKind kind = info.kind_tag
    string type_name = info.type_name
    TypePrimitive primitive = info.primitive_tag handle:
        default TypePrimitive.unknown_type
    if type_name == "json.JsonTree":
        return json_decode_tree_raw_reflected[T](view raw)
    if primitive != TypePrimitive.unknown_type:
        return json_decode_tree_primitive_reflected[T](view raw, primitive)
    if kind == TypeKind.alias_type:
        return json_decode_tree_alias_reflected[T](view raw)
    if kind == TypeKind.refinement_type:
        return json_decode_tree_refinement_reflected[T](view raw)
    if kind == TypeKind.secret_type:
        return json_decode_tree_secret_reflected[T](view raw)
    return json_decode_tree_structured_reflected[T](view raw, kind, type_name)
function json_decode_tree_raw_reflected[T](view raw: JsonTree) returns result[T, string]:
    T item = raw
    return ok(item)
function json_decode_tree_alias_reflected[T](view raw: JsonTree) returns result[T, string]:
    comptime type Base = type.arg[T](0):
        Base item = json_decode_tree_reflected[Base](view raw) handle error:
            return fail(error)
        T alias_value = item
        return ok(alias_value)
function json_decode_tree_refinement_reflected[T](view raw: JsonTree) returns result[T, string]:
    comptime type Base = type.arg[T](0):
        Base item = json_decode_tree_reflected[Base](view raw) handle error:
            return fail(error)
        T refined = item handle error:
            return fail(error)
        return ok(refined)
function json_decode_tree_secret_reflected[T](view raw: JsonTree) returns result[T, string]:
    comptime type Inner = type.arg[T](0):
        Inner item = json_decode_tree_reflected[Inner](view raw) handle error:
            return fail(error)
        T secret_value = item
        return ok(secret_value)
function json_decode_tree_primitive_reflected[T](view raw: JsonTree, primitive: TypePrimitive) returns result[T, string]:
    if primitive == TypePrimitive.string_type:
        return json_decode_tree_scalar_reflected[T](view raw, primitive)
    if primitive == TypePrimitive.bool_type:
        return json_decode_tree_scalar_reflected[T](view raw, primitive)
    optional[T] integer_item = json_decode_tree_integer_primitive_reflected[T](view raw, primitive) handle error:
        return fail(error)
    T decoded_integer = integer_item handle:
        return json_decode_tree_float_or_other_primitive_reflected[T](view raw, primitive)
    return ok(decoded_integer)
function json_decode_tree_integer_primitive_reflected[T](view raw: JsonTree, primitive: TypePrimitive) returns result[optional[T], string]:
    match primitive:
        int8_type:
            return json_decode_tree_integer_some_reflected[T](view raw, primitive)
        int16_type:
            return json_decode_tree_integer_some_reflected[T](view raw, primitive)
        int32_type:
            return json_decode_tree_integer_some_reflected[T](view raw, primitive)
        int64_type:
            return json_decode_tree_integer_some_reflected[T](view raw, primitive)
        uint8_type:
            return json_decode_tree_integer_some_reflected[T](view raw, primitive)
        uint16_type:
            return json_decode_tree_integer_some_reflected[T](view raw, primitive)
        uint32_type:
            return json_decode_tree_integer_some_reflected[T](view raw, primitive)
        uint64_type:
            return json_decode_tree_integer_some_reflected[T](view raw, primitive)
        other:
            return ok(none)
function json_decode_tree_integer_some_reflected[T](view raw: JsonTree, primitive: TypePrimitive) returns result[optional[T], string]:
    T item = json_decode_tree_integer_reflected[T](view raw, primitive) handle error:
        return fail(error)
    return ok(some(item))
function json_decode_tree_float_or_other_primitive_reflected[T](view raw: JsonTree, primitive: TypePrimitive) returns result[T, string]:
    optional[T] float_item = json_decode_tree_float_primitive_reflected[T](view raw, primitive) handle error:
        return fail(error)
    T decoded_float = float_item handle:
        return json_decode_tree_other_primitive_reflected[T](view raw, primitive)
    return ok(decoded_float)

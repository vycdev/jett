namespace json
function json_serialize_reflected[T](view value: T) returns string:
    return json_serialize_public_reflected[T](view value)
function json_parse_reflected[T](raw: string) returns result[T, string]:
    JsonTree value = json_tree_parse(raw) handle error:
        return fail(error)
    return json_decode_tree_reflected[T](view value)
function json_parse_exact_reflected[T](raw: string) returns result[T, string]:
    JsonTree value = json_tree_parse(raw) handle error:
        return fail(error)
    nothing checked = json_validate_exact_reflected[T](view value) handle error:
        return fail(error)
    return json_decode_tree_reflected[T](view value)
export function parse_raw(raw: string) returns result[JsonTree, string]:
    return json_tree_parse(raw)
export function serialize_raw(view value: JsonTree) returns string:
    return json_tree_serialize(view value)
export function kind(view value: JsonTree) returns string:
    return json_tree_kind(view value)
export function is_null(view value: JsonTree) returns bool:
    return json_tree_is_null(view value)
export function is_bool(view value: JsonTree) returns bool:
    return json_tree_is_bool(view value)
export function is_number(view value: JsonTree) returns bool:
    return json_tree_is_number(view value)
export function is_string(view value: JsonTree) returns bool:
    return json_tree_is_string(view value)
export function is_array(view value: JsonTree) returns bool:
    return json_tree_is_array(view value)
export function is_object(view value: JsonTree) returns bool:
    return json_tree_is_object(view value)
export function field(view value: JsonTree, key: string) returns optional[JsonTree]:
    return json_tree_field(view value, key)
export function index(view value: JsonTree, index: int64) returns optional[JsonTree]:
    return json_tree_index(view value, index)
export function object_field(view value: JsonTree, key: string) returns result[optional[JsonTree], string]:
    return json_tree_object_field(view value, key)
export function array_index(view value: JsonTree, index: int64) returns result[optional[JsonTree], string]:
    return json_tree_array_index(view value, index)
export function require_field(view value: JsonTree, key: string) returns result[JsonTree, string]:
    return json_tree_require_field(view value, key)
export function require_index(view value: JsonTree, index: int64) returns result[JsonTree, string]:
    return json_tree_require_index(view value, index)
export function array_length(view value: JsonTree) returns result[int64, string]:
    return json_tree_array_length(view value)
export function object_keys(view value: JsonTree) returns result[list[string], string]:
    return json_tree_object_keys(view value)
export function as_string(view value: JsonTree) returns result[string, string]:
    return json_tree_as_string(view value)
export function as_int64(view value: JsonTree) returns result[int64, string]:
    return json_tree_as_int64(view value)
export function as_uint64(view value: JsonTree) returns result[uint64, string]:
    return json_tree_as_uint64(view value)
export function as_float64(view value: JsonTree) returns result[float64, string]:
    return json_tree_as_float64(view value)
export function as_bool(view value: JsonTree) returns result[bool, string]:
    return json_tree_as_bool(view value)
export function parse[T](raw: string) returns result[T, string]:
    return json_parse_reflected[T](raw)
export function parse_exact[T](raw: string) returns result[T, string]:
    return json_parse_exact_reflected[T](raw)
export function serialize[T](view value: T) returns string:
    return json_serialize_reflected[T](view value)
export function serialize_public[T](view value: T) returns string:
    return json_serialize_public_reflected[T](view value)
function json_parse_native_string(raw: string) returns result[string, string]:
    JsonTree tree = parse_raw(raw) handle error:
        return fail(error)
    return json_tree_as_string(view tree)
function json_parse_native_bool(raw: string) returns result[bool, string]:
    JsonTree tree = parse_raw(raw) handle error:
        return fail(error)
    return json_tree_as_bool(view tree)
function json_parse_native_int64(raw: string) returns result[int64, string]:
    JsonTree tree = parse_raw(raw) handle error:
        return fail(error)
    return json_tree_as_int64(view tree)
function json_parse_native_uint64(raw: string) returns result[uint64, string]:
    JsonTree tree = parse_raw(raw) handle error:
        return fail(error)
    return json_tree_as_uint64(view tree)
function json_parse_native_float64(raw: string) returns result[float64, string]:
    JsonTree tree = parse_raw(raw) handle error:
        return fail(error)
    return json_tree_as_float64(view tree)
function json_parse_native_bytes(raw: string) returns result[bytes, string]:
    JsonTree tree = parse_raw(raw) handle error:
        return fail(error)
    string raw_hex = json_tree_as_string(view tree) handle error:
        return fail(error)
    bytes item = bytes.from_hex(raw_hex) handle error:
        return fail("expected hex bytes string")
    return ok(item)
function json_parse_native_nothing(raw: string) returns result[nothing, string]:
    JsonTree tree = parse_raw(raw) handle error:
        return fail(error)
    if json_tree_is_null(view tree) == false:
        return fail("expected null, got {json_tree_kind(view tree)}")
    return ok(nothing)
function json_parse_native_secret_tree(raw: string) returns result[secret[JsonTree], string]:
    JsonTree tree = parse_raw(raw) handle error:
        return fail(error)
    secret[JsonTree] secret_tree = tree
    return ok(secret_tree)
function json_parse_native_enum[T](raw: string) returns result[T, string]:
    JsonTree tree = parse_raw(raw) handle error:
        return fail(error)
    TypeInfo info = type.info[T]()
    return json_decode_tree_enum_reflected[T](view tree, info.type_name)
function json_parse_exact_native_enum[T](raw: string) returns result[T, string]:
    JsonTree tree = parse_raw(raw) handle error:
        return fail(error)
    TypeInfo info = type.info[T]()
    nothing checked = json_validate_exact_enum_reflected[T](view tree, info.type_name) handle error:
        return fail(error)
    return json_decode_tree_enum_reflected[T](view tree, info.type_name)
function json_serialize_native_enum[T](view value: T) returns string:
    return json_serialize_public_enum_reflected[T](view value)

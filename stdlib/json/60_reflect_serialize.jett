function json_serialize_public_reflected[T](view value: T) returns string:
    TypeInfo info = type.info[T]()
    TypeKind kind = info.kind_tag
    TypePrimitive primitive = info.primitive_tag handle:
        default TypePrimitive.unknown_type
    if json_reflected_raw_type(view info):
        return json_serialize_public_raw_reflected[T](view value)
    if primitive != TypePrimitive.unknown_type:
        return json_serialize_public_primitive[T](view value, primitive)
    if kind == TypeKind.alias_type:
        comptime type Base = type.arg[T](0):
            Base item = value
            return json_serialize_public_reflected[Base](view item)
    if kind == TypeKind.refinement_type:
        comptime type Base = type.arg[T](0):
            Base item = coarsen value
            return json_serialize_public_reflected[Base](view item)
    if kind == TypeKind.enum_type:
        return json_serialize_public_enum_reflected[T](view value)
    return json_serialize_public_non_enum_reflected[T](view value, view info)
function json_serialize_public_raw_reflected[T](view value: T) returns string:
    JsonTree item = value
    return json_tree_serialize(view item)
function json_serialize_public_primitive[T](view value: T, primitive: TypePrimitive) returns string:
    if primitive == TypePrimitive.string_type:
        string item = value
        return json_stdlib_quote(item)
    string integer_json = json_serialize_public_integer_primitive[T](view value, primitive) handle:
        default ""
    if integer_json != "":
        return integer_json
    if primitive == TypePrimitive.bool_type:
        bool item = value
        return "{item}"
    string float_json = json_serialize_public_float_primitive[T](view value, primitive) handle:
        default ""
    if float_json != "":
        return float_json
    if primitive == TypePrimitive.nothing_type:
        return "null"
    if primitive == TypePrimitive.bytes_type:
        return json_serialize_public_bytes_value[T](view value)
    return "null"
function json_serialize_public_integer_primitive[T](view value: T, primitive: TypePrimitive) returns optional[string]:
    if json_type_primitive_uses_int64_json_integer(primitive):
        return some(json_serialize_public_integer_value[T](view value))
    if primitive == TypePrimitive.uint64_type:
        return some(json_serialize_public_uint64_value[T](view value))
    return none
function json_serialize_public_float_primitive[T](view value: T, primitive: TypePrimitive) returns optional[string]:
    match primitive:
        float32_type:
            return some(json_serialize_public_float_value[T](view value))
        float64_type:
            return some(json_serialize_public_float_value[T](view value))
        other:
            return none
function json_serialize_public_integer_value[T](view value: T) returns string:
    int64 item = value
    return "{item}"
function json_serialize_public_uint64_value[T](view value: T) returns string:
    uint64 item = value
    return string.from_uint64(item)
function json_serialize_public_float_value[T](view value: T) returns string:
    float64 item = value
    return "{item}"
function json_serialize_public_bytes_value[T](view value: T) returns string:
    bytes item = value
    return json_stdlib_quote("0x{bytes.to_hex(item)}")
function json_serialize_public_enum_reflected[T](view value: T) returns string:
    TypeVariant selected = type.variant_value[T](view value)
    for variant in type.variants[T]():
        if variant.name != selected.name:
            continue
        if list.length(variant.fields) == 0:
            return json_stdlib_quote(variant.name)
        list[string] parts = list.new[string]()
        for field in variant.fields:
            comptime type Field = field.type_info:
                Field item = type.variant_field_value[T, Field](view value, view field)
                string encoded = json_serialize_public_reflected[Field](view item)
                parts = list.append[string](parts, encoded)
        string payload = json_stdlib_array_from_parts(parts)
        return json_stdlib_single_entry_object(variant.name, payload)
    return json_stdlib_quote(selected.name)
function json_serialize_public_non_enum_reflected[T](view value: T, view info: TypeInfo) returns string:
    TypeKind kind = info.kind_tag
    match kind:
        list_type:
            return json_serialize_public_list_reflected[T](view value)
        set_type:
            return json_serialize_public_set_reflected[T](view value)
        map_type:
            return json_serialize_public_map_reflected[T](view value)
        optional_type:
            return json_serialize_public_optional_reflected[T](view value)
        result_type:
            return json_serialize_public_result_reflected[T](view value)
        machine_type:
            return json_serialize_public_machine_reflected[T](view value)
        machine_state_type:
            return json_serialize_public_machine_reflected[T](view value)
        other:
            return json_serialize_public_record_reflected[T](view value)
function json_serialize_public_list_reflected[T](view value: T) returns string:
    comptime type Elem = type.arg[T](0):
        list[Elem] items = value
        list[string] parts = list.new[string]()
        for item in items:
            parts = list.append[string](parts, json_serialize_public_reflected[Elem](view item))
        return json_stdlib_array_from_parts(parts)
function json_serialize_public_set_reflected[T](view value: T) returns string:
    comptime type Elem = type.arg[T](0):
        set[Elem] items = value
        list[string] parts = list.new[string]()
        for item in items:
            parts = list.append[string](parts, json_serialize_public_reflected[Elem](view item))
        return json_stdlib_array_from_parts(parts)
function json_serialize_public_map_reflected[T](view value: T) returns string:
    comptime type Val = type.arg[T](1):
        map[string, Val] entries = value
        list[string] parts = list.new[string]()
        for key, item in entries:
            string encoded = json_serialize_public_reflected[Val](view item)
            parts = list.append[string](parts, json_stdlib_object_entry(key, encoded))
        return json_stdlib_object_from_parts(parts)
function json_serialize_public_optional_reflected[T](view value: T) returns string:
    comptime type Inner = type.arg[T](0):
        Inner item = value handle:
            return "null"
        return json_serialize_public_reflected[Inner](view item)
function json_serialize_public_result_reflected[T](view value: T) returns string:
    comptime type Ok = type.arg[T](0):
        Ok item = value handle error:
            comptime type Err = type.arg[T](1):
                Err failure = error
                string encoded = json_serialize_public_reflected[Err](view failure)
                return json_stdlib_single_entry_object("fail", encoded)
        string encoded = json_serialize_public_reflected[Ok](view item)
        return json_stdlib_single_entry_object("ok", encoded)
function json_serialize_public_machine_reflected[T](view value: T) returns string:
    TypeMachineState state = type.machine_state_value[T](view value)
    list[string] payload_fields = list.new[string]()
    for field in type.machine_state_value[T](view value).fields:
        if field.has_secret == true:
            continue
        comptime type Field = field.type_info:
            Field item = type.machine_field_value[T, Field](view value, view field)
            string encoded = json_serialize_public_reflected[Field](view item)
            payload_fields = list.append[string](payload_fields, json_stdlib_object_entry(field.serialize_name, encoded))
    string payload = json_stdlib_object_from_parts(payload_fields)
    list[string] envelope = list.new[string]()
    envelope = list.append[string](envelope, json_stdlib_object_entry("state", json_stdlib_quote(state.name)))
    envelope = list.append[string](envelope, json_stdlib_object_entry("payload", payload))
    return json_stdlib_object_from_parts(envelope)
function json_serialize_public_record_reflected[T](view value: T) returns string:
    list[string] fields = list.new[string]()
    for field in type.fields[T]():
        if field.has_secret == true:
            continue
        comptime type Field = field.type_info:
            Field item = type.field_value[T, Field](view value, view field)
            string encoded = json_serialize_public_reflected[Field](view item)
            fields = list.append[string](fields, json_stdlib_object_entry(field.serialize_name, encoded))
    return json_stdlib_object_from_parts(fields)

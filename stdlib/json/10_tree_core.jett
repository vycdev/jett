namespace json
function json_tree_parse(raw: string) returns result[JsonTree, string]:
    bytes input = bytes.from_string(raw)
    return json_tree_parse_span(view input, 0, bytes.length(view input))
function json_tree_parse_span(view input: bytes, start: int64, end: int64) returns result[JsonTree, string]:
    int64 trimmed_start = json_tree_trim_start(view input, start, end)
    int64 trimmed_end = json_tree_trim_end(view input, trimmed_start, end)
    if trimmed_start >= trimmed_end:
        return fail("expected JSON value")
    int64 first = json_tree_byte_at(view input, trimmed_start)
    if first == 91:
        return json_tree_parse_array_span(view input, trimmed_start, trimmed_end)
    if first == 123:
        return json_tree_parse_object_span(view input, trimmed_start, trimmed_end)
    if first == 93:
        return fail("unexpected closing delimiter in JSON value")
    if first == 125:
        return fail("unexpected closing delimiter in JSON value")
    if first == 34:
        string value = json_tree_parse_string_span(view input, trimmed_start, trimmed_end) handle error:
            return fail(error)
        return ok(JsonTree.string_value(value))
    string trimmed = json_tree_span_to_trimmed_string(view input, trimmed_start, trimmed_end) handle error:
        return fail(error)
    return json_tree_parse_scalar(trimmed)
function json_tree_parse_value(raw: string) returns result[JsonTree, string]:
    bytes input = bytes.from_string(raw)
    return json_tree_parse_span(view input, 0, bytes.length(view input))
function json_tree_kind(view value: JsonTree) returns string:
    match value:
        null:
            return "null"
        bool_value(item):
            return "bool"
        number_value(raw):
            return "number"
        string_value(item):
            return "string"
        array_value(items):
            return "array"
        object_value(fields):
            return "object"
function json_tree_kind_error(view value: JsonTree, expected: string) returns string:
    string actual = json_tree_kind(view value)
    return "expected {expected}, got {actual}"
function json_tree_is_null(view value: JsonTree) returns bool:
    return json_tree_kind(view value) == "null"
function json_tree_is_bool(view value: JsonTree) returns bool:
    return json_tree_kind(view value) == "bool"
function json_tree_is_number(view value: JsonTree) returns bool:
    return json_tree_kind(view value) == "number"
function json_tree_is_string(view value: JsonTree) returns bool:
    return json_tree_kind(view value) == "string"
function json_tree_is_array(view value: JsonTree) returns bool:
    return json_tree_kind(view value) == "array"
function json_tree_is_object(view value: JsonTree) returns bool:
    return json_tree_kind(view value) == "object"
function json_tree_field(view value: JsonTree, key: string) returns optional[JsonTree]:
    match value:
        object_value(fields):
            return map.get[string, JsonTree](view fields, key)
        other:
            return none
function json_tree_index(view value: JsonTree, index: int64) returns optional[JsonTree]:
    match value:
        array_value(items):
            return list.get[JsonTree](view items, index)
        other:
            return none
function json_tree_array_length(view value: JsonTree) returns result[int64, string]:
    match value:
        array_value(items):
            return ok(list.length[JsonTree](view items))
        other:
            return fail(json_tree_kind_error(view value, "array"))
function json_tree_object_keys(view value: JsonTree) returns result[list[string], string]:
    match value:
        object_value(fields):
            return ok(map.keys[string, JsonTree](view fields))
        other:
            return fail(json_tree_kind_error(view value, "object"))
function json_tree_as_string(view value: JsonTree) returns result[string, string]:
    match value:
        string_value(item):
            return ok(item)
        other:
            return fail(json_tree_kind_error(view value, "string"))
function json_tree_as_int64(view value: JsonTree) returns result[int64, string]:
    match value:
        number_value(raw):
            int64 item = int64.from_string(raw) handle error:
                return fail("expected int64, got number")
            return ok(item)
        other:
            return fail(json_tree_kind_error(view value, "int64"))
function json_tree_as_float64(view value: JsonTree) returns result[float64, string]:
    match value:
        number_value(raw):
            float64 item = float64.from_string(raw) handle error:
                return fail("expected float64, got number")
            return ok(item)
        other:
            return fail(json_tree_kind_error(view value, "float64"))
function json_tree_as_bool(view value: JsonTree) returns result[bool, string]:
    match value:

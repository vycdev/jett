namespace json
mutual:
    export function json_tree_serialize(view value: JsonTree) returns string
    function json_tree_serialize_array(view items: list[JsonTree]) returns string
    function json_tree_serialize_object(view fields: map[string, JsonTree]) returns string
function json_tree_serialize(view value: JsonTree) returns string:
    match value:
        null:
            return "null"
        bool_value(item):
            return "{item}"
        number_value(raw):
            return raw
        string_value(item):
            return json_stdlib_quote(item)
        array_value(items):
            return json_tree_serialize_array(view items)
        object_value(fields):
            return json_tree_serialize_object(view fields)
function json_tree_serialize_array(view items: list[JsonTree]) returns string:
    mutable list[string] parts = list.new[string]()
    for item in view items:
        parts = list.append[string](parts, json_tree_serialize(view item))
    return json_stdlib_array_from_parts(parts)
function json_tree_serialize_object(view fields: map[string, JsonTree]) returns string:
    mutable list[string] parts = list.new[string]()
    for key, item in view fields:
        string encoded = json_tree_serialize(view item)
        parts = list.append[string](parts, json_stdlib_object_entry(key, encoded))
    return json_stdlib_object_from_parts(parts)

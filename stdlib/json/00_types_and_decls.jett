namespace json
export enum JsonTree:
    null
    bool_value(value: bool)
    number_value(raw: string)
    string_value(value: string)
    array_value(items: list[JsonTree])
    object_value(fields: map[string, JsonTree])
export type JsonValue = JsonTree
export root type JsonValue = json.JsonTree
struct JsonTreeScan:
    depth: int64
    in_string: bool
    escaped: bool
struct JsonTreeTopLevelSeparatorStep:
    scan: JsonTreeScan
    separated: bool
struct JsonTreeSegmentValueScan:
    tree_scan: JsonTreeScan
    started: bool
    scalar: bool
    complete: bool
struct JsonTreeObjectField:
    key: string
    value: JsonTree
struct JsonTreeSegment:
    start: int64
    end: int64
struct JsonTreeStringEscape:
    value: string
    next_index: int64
struct JsonTreeResultPayload:
    key: string
    value: JsonTree
function json_stdlib_hex_digit(value: int64) returns string:
    if value < 10:
        return "{value}"
    if value == 10:
        return "a"
    if value == 11:
        return "b"
    if value == 12:
        return "c"
    if value == 13:
        return "d"
    if value == 14:
        return "e"
    return "f"
function json_stdlib_named_escape_byte(byte: int64) returns optional[string]:
    if byte == 34:
        return some("\\\"")
    if byte == 92:
        return some("\\\\")
    if byte == 8:
        return some("\\b")
    if byte == 12:
        return some("\\f")
    if byte == 10:
        return some("\\n")
    if byte == 13:
        return some("\\r")
    if byte == 9:
        return some("\\t")
    return none
function json_stdlib_escape_byte(byte: int64) returns optional[string]:
    string named = json_stdlib_named_escape_byte(byte) handle:
        default ""
    if named != "":
        return some(named)
    if byte < 32:
        string high = json_stdlib_hex_digit(byte / 16)
        string low = json_stdlib_hex_digit(byte modulo 16)
        return some("\\u00{high}{low}")
    return none
function json_stdlib_quote(raw: string) returns string:
    bytes input = bytes.from_string(raw)
    mutable bytes output = bytes.new()
    int64 length = bytes.length(view input)
    mutable int64 chunk_start = 0
    for index in range(length):
        int64 byte = bytes.get(view input, index) handle:
            default -1
        string escaped = json_stdlib_escape_byte(byte) handle:
            default ""
        if escaped != "":
            output = bytes.concat(output, bytes.slice(view input, chunk_start, index))
            output = bytes.concat(output, bytes.from_string(escaped))
            chunk_start = index + 1
    output = bytes.concat(output, bytes.slice(view input, chunk_start, length))
    string escaped = bytes.to_string(output) handle error:
        default error
    return "\"{escaped}\""
function json_stdlib_string_from_hex(hex: string) returns result[string, string]:
    bytes raw = bytes.from_hex(hex) handle error:
        return fail(error)
    string decoded = bytes.to_string(raw) handle error:
        return fail(error)
    return ok(decoded)
function json_reflected_raw_type(view info: TypeInfo) returns bool:
    if info.type_name == "json.JsonTree":
        return true
    if info.kind_tag != TypeKind.alias_type:
        return false
    TypeInfo base = list.get[TypeInfo](info.args, 0) handle:
        return false
    if base.type_name == info.type_name:
        return false
    return json_reflected_raw_type(view base)

namespace stdlib_json

function json_stdlib_hex_digit(value: int64) returns string:
    if value == 0:
        return "0"
    if value == 1:
        return "1"
    if value == 2:
        return "2"
    if value == 3:
        return "3"
    if value == 4:
        return "4"
    if value == 5:
        return "5"
    if value == 6:
        return "6"
    if value == 7:
        return "7"
    if value == 8:
        return "8"
    if value == 9:
        return "9"
    if value == 10:
        return "a"
    if value == 11:
        return "b"
    if value == 12:
        return "c"
    if value == 13:
        return "d"
    if value == 14:
        return "e"
    return "f"

function json_stdlib_escape_byte(byte: int64) returns optional[string]:
    if byte == 34:
        return some("\\\"")
    if byte == 92:
        return some("\\\\")
    if byte == 8:
        return some("\\b")
    if byte == 12:
        return some("\\f")
    if byte == 10:
        return some("\\n")
    if byte == 13:
        return some("\\r")
    if byte == 9:
        return some("\\t")
    if byte < 32:
        string high = json_stdlib_hex_digit(byte / 16)
        string low = json_stdlib_hex_digit(byte modulo 16)
        return some("\\u00{high}{low}")
    return none

function json_stdlib_quote(raw: string) returns string:
    bytes input = bytes.from_string(raw)
    mutable bytes output = bytes.new()
    int64 length = bytes.length(view input)
    mutable int64 chunk_start = 0
    for index in range(length):
        int64 byte = bytes.get(view input, index) handle:
            default -1
        string escaped = json_stdlib_escape_byte(byte) handle:
            default ""
        if escaped != "":
            output = bytes.concat(output, bytes.slice(view input, chunk_start, index))
            output = bytes.concat(output, bytes.from_string(escaped))
            chunk_start = index + 1
    output = bytes.concat(output, bytes.slice(view input, chunk_start, length))
    string escaped = bytes.to_string(output) handle error:
        default error
    return "\"{escaped}\""

function json_serialize_public_reflected[T](view value: T) returns string:
    TypeKind kind = type.kind_tag[T]()
    string type_name = type.name[T]()

    if type_name == "string":
        string item = value
        return json_stdlib_quote(item)

    if type_name == "int64":
        int64 item = value
        return "{item}"

    if type_name == "float64":
        float64 item = value
        return "{item}"

    if type_name == "bool":
        bool item = value
        return "{item}"

    if type_name == "bytes":
        bytes item = value
        return json_stdlib_quote("0x{bytes.to_hex(item)}")

    if kind == TypeKind.alias_type:
        comptime type Base = type.arg[T](0):
            Base item = value
            return json_serialize_public_reflected[Base](view item)

    if kind == TypeKind.refinement_type:
        comptime type Base = type.arg[T](0):
            Base item = coarsen value
            return json_serialize_public_reflected[Base](view item)

    if kind == TypeKind.enum_type:
        TypeVariant variant = type.variant_value[T](view value)
        if list.length(variant.fields) == 0:
            return json_stdlib_quote(variant.name)

        list[string] parts = list.new[string]()
        for field in type.variant_value[T](view value).fields:
            comptime type Field = field.type_info:
                Field item = type.variant_field_value[T, Field](view value, view field)
                parts = list.append[string](parts, json_serialize_public_reflected[Field](view item))
        string body = string.join(parts, ",")
        return "{{{json_stdlib_quote(variant.name)}:[{body}]}}"

    if kind == TypeKind.list_type:
        comptime type Elem = type.arg[T](0):
            list[Elem] items = value
            list[string] parts = list.new[string]()
            for item in items:
                parts = list.append[string](parts, json_serialize_public_reflected[Elem](view item))
            string body = string.join(parts, ",")
            return "[{body}]"

    if kind == TypeKind.set_type:
        comptime type Elem = type.arg[T](0):
            set[Elem] items = value
            list[string] parts = list.new[string]()
            for item in items:
                parts = list.append[string](parts, json_serialize_public_reflected[Elem](view item))
            string body = string.join(parts, ",")
            return "[{body}]"

    if kind == TypeKind.map_type:
        comptime type Val = type.arg[T](1):
            map[string, Val] entries = value
            list[string] parts = list.new[string]()
            for key, item in entries:
                parts = list.append[string](parts, "{json_stdlib_quote(key)}:{json_serialize_public_reflected[Val](view item)}")
            string body = string.join(parts, ",")
            return "{{{body}}}"

    if kind == TypeKind.optional_type:
        comptime type Inner = type.arg[T](0):
            Inner item = value handle:
                return "null"
            return json_serialize_public_reflected[Inner](view item)

    if kind == TypeKind.result_type:
        comptime type Ok = type.arg[T](0):
            Ok item = value handle error:
                comptime type Err = type.arg[T](1):
                    Err failure = error
                    return "{{{json_stdlib_quote("fail")}:{json_serialize_public_reflected[Err](view failure)}}}"
            return "{{{json_stdlib_quote("ok")}:{json_serialize_public_reflected[Ok](view item)}}}"

    list[string] fields = list.new[string]()
    for field in type.fields[T]():
        if field.has_secret == false:
            comptime type Field = field.type_info:
                Field item = type.field_value[T, Field](view value, view field)
                string encoded = json_serialize_public_reflected[Field](view item)
                fields = list.append[string](fields, "{json_stdlib_quote(field.serialize_name)}:{encoded}")
    string body = string.join(fields, ",")
    return "{{{body}}}"
